      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Figures</string>
          <string name="Source"><![CDATA[--[[
	Figures  (ModuleScript)  ->  ReplicatedStorage/Shared/Figures
	Die 30 originalen Brainrot-Figuren + Hilfsfunktionen.
	Neue Figuren einfach unten anhängen (Id fortlaufend, Key ohne Umlaute).
]]

local Config = require(script.Parent:WaitForChild("Config"))

local Figures = {}

local LIST = {
	-- Common
	{ Id = 1, Key = "SpagettoGecko", Name = "Spagetto Gecko", Rarity = "Common", Price = 25, Income = 1, Weight = 30, Height = 4, Color1 = "#F2D16B", Color2 = "#6BBF59" },
	{ Id = 2, Key = "SockolinoMausolino", Name = "Sockolino Mausolino", Rarity = "Common", Price = 60, Income = 2, Weight = 22, Height = 4, Color1 = "#E94F4F", Color2 = "#BDBDBD" },
	{ Id = 3, Key = "KettloFroggolo", Name = "Kettlo Froggolo", Rarity = "Common", Price = 120, Income = 3, Weight = 16, Height = 4, Color1 = "#4CAF50", Color2 = "#C0C0C0" },
	{ Id = 4, Key = "BrezelwurmBrezelini", Name = "Brezelwurm Brezelini", Rarity = "Common", Price = 200, Income = 5, Weight = 12, Height = 4, Color1 = "#A0612B", Color2 = "#F5E6C8" },
	{ Id = 5, Key = "RadieroSchneckolo", Name = "Radiero Schneckolo", Rarity = "Common", Price = 350, Income = 8, Weight = 9, Height = 4, Color1 = "#FF8FB1", Color2 = "#7CB342" },
	{ Id = 6, Key = "MopettoPinguzzo", Name = "Mopetto Pinguzzo", Rarity = "Common", Price = 500, Income = 11, Weight = 7, Height = 4, Color1 = "#263238", Color2 = "#ECEFF1" },
	{ Id = 7, Key = "WackelWobblino", Name = "Wackel Wobblino", Rarity = "Common", Price = 750, Income = 15, Weight = 4, Height = 4, Color1 = "#66E07A", Color2 = "#D32F2F" },
	-- Rare
	{ Id = 8, Key = "LampadinoFalenino", Name = "Lampadino Falenino", Rarity = "Rare", Price = 1200, Income = 20, Weight = 28, Height = 5, Color1 = "#FFF59D", Color2 = "#8D6E63" },
	{ Id = 9, Key = "CiabattoCanguro", Name = "Ciabatto Canguro", Rarity = "Rare", Price = 1800, Income = 28, Weight = 22, Height = 5, Color1 = "#C68642", Color2 = "#5C6BC0" },
	{ Id = 10, Key = "SushiHamsterini", Name = "Sushi Hamsterini", Rarity = "Rare", Price = 2700, Income = 40, Weight = 18, Height = 5, Color1 = "#FFCC80", Color2 = "#212121" },
	{ Id = 11, Key = "BurstoIgelino", Name = "Bürsto Igelino", Rarity = "Rare", Price = 4000, Income = 55, Weight = 14, Height = 5, Color1 = "#8D6E63", Color2 = "#29B6F6" },
	{ Id = 12, Key = "KaktoffelKrabbo", Name = "Kaktoffel Krabbo", Rarity = "Rare", Price = 6000, Income = 75, Weight = 10, Height = 5, Color1 = "#E64A19", Color2 = "#388E3C" },
	{ Id = 13, Key = "TrommeloDackelini", Name = "Trommelo Dackelini", Rarity = "Rare", Price = 9000, Income = 105, Weight = 8, Height = 5, Color1 = "#795548", Color2 = "#FFD54F" },
	-- Epic
	{ Id = 14, Key = "TurboTortellino", Name = "Turbo Tortellino", Rarity = "Epic", Price = 15000, Income = 150, Weight = 26, Height = 6, Color1 = "#FFE082", Color2 = "#43A047" },
	{ Id = 15, Key = "DiscomuffoMantarini", Name = "Discomuffo Mantarini", Rarity = "Epic", Price = 22000, Income = 200, Weight = 21, Height = 6, Color1 = "#7E57C2", Color2 = "#E0E0E0" },
	{ Id = 16, Key = "WaschmaschinoWalrossi", Name = "Waschmaschino Walrossi", Rarity = "Epic", Price = 32000, Income = 270, Weight = 18, Height = 6, Color1 = "#ECEFF1", Color2 = "#8D6E63" },
	{ Id = 17, Key = "FonixFohnini", Name = "Fönix Föhnini", Rarity = "Epic", Price = 45000, Income = 360, Weight = 15, Height = 6, Color1 = "#FF7043", Color2 = "#EC407A" },
	{ Id = 18, Key = "ZitronoOkapini", Name = "Zitrono Okapini", Rarity = "Epic", Price = 65000, Income = 480, Weight = 12, Height = 6, Color1 = "#FFEB3B", Color2 = "#5D4037" },
	{ Id = 19, Key = "VentilatorePelicanzo", Name = "Ventilatore Pelicanzo", Rarity = "Epic", Price = 90000, Income = 620, Weight = 8, Height = 6, Color1 = "#90CAF9", Color2 = "#FFFFFF" },
	-- Legendary
	{ Id = 20, Key = "KaiserKurbissimo", Name = "Kaiser Kürbissimo", Rarity = "Legendary", Price = 160000, Income = 950, Weight = 30, Height = 7.5, Color1 = "#FB8C00", Color2 = "#2E7D32" },
	{ Id = 21, Key = "RakettoRaclettini", Name = "Raketto Raclettini", Rarity = "Legendary", Price = 240000, Income = 1300, Weight = 25, Height = 7.5, Color1 = "#FFD54F", Color2 = "#B0BEC5" },
	{ Id = 22, Key = "GondoloGoriglione", Name = "Gondolo Goriglione", Rarity = "Legendary", Price = 350000, Income = 1750, Weight = 20, Height = 7.5, Color1 = "#424242", Color2 = "#1565C0" },
	{ Id = 23, Key = "TictacoPolpettone", Name = "Tictaco Polpettone", Rarity = "Legendary", Price = 500000, Income = 2300, Weight = 15, Height = 7.5, Color1 = "#AB47BC", Color2 = "#8D6E63" },
	{ Id = 24, Key = "DonnerdonerGreifino", Name = "Donnerdöner Greifino", Rarity = "Legendary", Price = 750000, Income = 3100, Weight = 10, Height = 7.5, Color1 = "#FFCA28", Color2 = "#455A64" },
	-- Mythic
	{ Id = 25, Key = "GalaxioGelatone", Name = "Galaxio Gelatone", Rarity = "Mythic", Price = 1500000, Income = 5500, Weight = 40, Height = 9, Color1 = "#3949AB", Color2 = "#F48FB1" },
	{ Id = 26, Key = "VulcanoWaffelotto", Name = "Vulcano Waffelotto", Rarity = "Mythic", Price = 2500000, Income = 8500, Weight = 30, Height = 9, Color1 = "#D84315", Color2 = "#FFB74D" },
	{ Id = 27, Key = "KristalloKapibarone", Name = "Kristallo Kapibarone", Rarity = "Mythic", Price = 4000000, Income = 12500, Weight = 20, Height = 9, Color1 = "#80DEEA", Color2 = "#B39DDB" },
	{ Id = 28, Key = "AstronudelNautilino", Name = "Astronudel Nautilino", Rarity = "Mythic", Price = 6500000, Income = 18500, Weight = 10, Height = 9, Color1 = "#FFE0B2", Color2 = "#26C6DA" },
	-- Secret
	{ Id = 29, Key = "IlGrandeGlitchonzo", Name = "Il Grande Glitchonzo", Rarity = "Secret", Price = 20000000, Income = 45000, Weight = 70, Height = 11, Color1 = "#00E676", Color2 = "#D500F9" },
	{ Id = 30, Key = "OmegaOmelettore", Name = "Omega Omelettore", Rarity = "Secret", Price = 50000000, Income = 100000, Weight = 30, Height = 11, Color1 = "#FFFFFF", Color2 = "#FFC107" },
}

Figures.List = LIST
Figures.ById = {}
Figures.ByRarity = {}

for _, fig in ipairs(LIST) do
	fig.Color1 = Color3.fromHex(fig.Color1)
	fig.Color2 = Color3.fromHex(fig.Color2)
	Figures.ById[fig.Id] = fig
	Figures.ByRarity[fig.Rarity] = Figures.ByRarity[fig.Rarity] or {}
	table.insert(Figures.ByRarity[fig.Rarity], fig)
end

function Figures.Get(id)
	return Figures.ById[id]
end

function Figures.Mutation(mutation)
	return Config.Mutations[mutation] or Config.Mutations.Normal
end

function Figures.Price(id, mutation)
	local fig = Figures.ById[id]
	if not fig then
		return 0
	end
	return math.floor(fig.Price * Figures.Mutation(mutation).PriceMult)
end

function Figures.Income(id, mutation)
	local fig = Figures.ById[id]
	if not fig then
		return 0
	end
	return fig.Income * Figures.Mutation(mutation).IncomeMult
end

function Figures.SellValue(id, mutation)
	return math.floor(Figures.Price(id, mutation) * Config.SellRatio)
end

function Figures.RarityRank(id)
	local fig = Figures.ById[id]
	return fig and Config.Rarities[fig.Rarity].Rank or 0
end

function Figures.DisplayName(id, mutation)
	local fig = Figures.ById[id]
	if not fig then
		return "?"
	end
	local mut = Figures.Mutation(mutation)
	if mut.Display ~= "" then
		return mut.Display .. " " .. fig.Name
	end
	return fig.Name
end

function Figures.IndexKey(id, mutation)
	return tostring(id) .. "_" .. (mutation or "Normal")
end

-- Chancen innerhalb einer Seltenheit (für die Anzeige im Shop, Pflicht bei bezahlten Zufalls-Items)
function Figures.OddsInRarity(rarity)
	local list = Figures.ByRarity[rarity] or {}
	local total = 0
	for _, fig in ipairs(list) do
		total += fig.Weight
	end
	local odds = {}
	for _, fig in ipairs(list) do
		table.insert(odds, { Name = fig.Name, Percent = fig.Weight / total * 100 })
	end
	return odds
end

return Figures
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--[[
	Format  (ModuleScript)  ->  ReplicatedStorage/Shared/Format
	Zahlen und Zeiten hübsch darstellen.
]]

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Format.Short(n)
	n = tonumber(n) or 0
	local negative = n < 0
	n = math.abs(n)
	if n < 1000 then
		local s = tostring(math.floor(n))
		return negative and ("-" .. s) or s
	end
	local index = 1
	while n >= 1000 and index < #SUFFIXES do
		n /= 1000
		index += 1
	end
	local s
	if n >= 100 then
		s = string.format("%d", math.floor(n))
	elseif n >= 10 then
		s = string.format("%.1f", math.floor(n * 10) / 10)
	else
		s = string.format("%.2f", math.floor(n * 100) / 100)
	end
	if s:find("%.") then
		s = s:gsub("0+$", "")
		s = s:gsub("%.$", "")
	end
	return (negative and "-" or "") .. s .. SUFFIXES[index]
end

function Format.Money(n)
	return "$" .. Format.Short(n)
end

function Format.Time(seconds)
	seconds = math.max(0, math.floor(seconds or 0))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

function Format.Percent(p)
	if p >= 1 then
		return string.format("%.1f %%", p)
	end
	return string.format("%.2f %%", p)
end

return Format
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="7">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="8">
      <Properties>
        <string name="Name">ServerMain</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	ServerMain  (Script)  ->  ServerScriptService/ServerMain
	Startet alle Services in der richtigen Reihenfolge.
]]

local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

-- Welt automatisch bauen, falls sie noch nicht existiert (z. B. direkt nach dem Öffnen der .rbxlx)
if not Workspace:FindFirstChild("Conveyor") or not ServerStorage:FindFirstChild("BaseTemplate") then
	local setup = ServerStorage:FindFirstChild("SetupWorld")
	if setup then
		require(setup)()
	else
		warn("[ServerMain] Welt fehlt und ServerStorage.SetupWorld ist nicht vorhanden!")
	end
end

local folder = ServerScriptService:WaitForChild("Services")

-- Reihenfolge = Reihenfolge der OnLoaded-Callbacks (Pässe vor Einkommen vor Basis …)
local ORDER = {
	"RateLimit",
	"Net",
	"EventService",
	"MonetizationService",
	"IncomeService",
	"BaseService",
	"ConveyorService",
	"StealService",
	"RebirthService",
	"RewardService",
	"LeaderboardService",
	"AnnouncementService",
	"StateService",
	"DataService", -- startet zuletzt: erst danach werden Spieler geladen
}

local Services = {}

for _, name in ipairs(ORDER) do
	local module = folder:WaitForChild(name, 10)
	if not module then
		error("[ServerMain] ModuleScript fehlt: ServerScriptService/Services/" .. name)
	end
	Services[name] = require(module)
end

for _, name in ipairs(ORDER) do
	local service = Services[name]
	if service.Init then
		service.Init(Services)
	end
end

for _, name in ipairs(ORDER) do
	local service = Services[name]
	if service.Start then
		service.Start()
	end
end

print("✅ Brainrot Bandits Server gestartet")
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="9">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">AnnouncementService</string>
          <string name="Source"><![CDATA[--[[
	AnnouncementService  (ModuleScript)  ->  ServerScriptService/Services/AnnouncementService
	Ansagen bei seltenen Funden:
	  - ab Legendary (oder Mutation): Banner im ganzen Server
	  - Secret oder Regenbogen: Banner in ALLEN Servern (MessagingService)
	Seltene Funde bei anderen sehen ist der stärkste Grund, selbst weiterzuspielen.
]]

local MessagingService = game:GetService("MessagingService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Figures = require(Shared:WaitForChild("Figures"))

local AnnouncementService = {}
local Services

local TOPIC = "BrainrotBandits_Global"
local lastGlobal = 0

function AnnouncementService.Found(player, id, mutation, verb)
	local fig = Figures.Get(id)
	if not fig then
		return
	end
	local rarity = Config.Rarities[fig.Rarity]
	local serverMin = Config.Rarities[Config.Announce.ServerMinRarity].Rank
	local globalMin = Config.Rarities[Config.Announce.GlobalMinRarity].Rank
	local special = mutation == "Diamond" or mutation == "Rainbow"
	if rarity.Rank < serverMin and not special then
		return
	end

	local text = ("✨ %s hat %s %s %s!"):format(player.DisplayName, rarity.Display, Figures.DisplayName(id, mutation), verb)
	Services.Net.Announce(text, rarity.Color)

	if (rarity.Rank >= globalMin or mutation == "Rainbow") and os.clock() - lastGlobal > 10 then
		lastGlobal = os.clock()
		task.spawn(function()
			pcall(MessagingService.PublishAsync, MessagingService, TOPIC, {
				Text = "🌍 " .. text,
				Color = rarity.Color:ToHex(),
				JobId = game.JobId,
			})
		end)
	end
end

function AnnouncementService.Init(services)
	Services = services
end

function AnnouncementService.Start()
	task.spawn(function()
		pcall(MessagingService.SubscribeAsync, MessagingService, TOPIC, function(message)
			local data = message.Data
			if type(data) ~= "table" or data.JobId == game.JobId or type(data.Text) ~= "string" then
				return
			end
			local ok, color = pcall(Color3.fromHex, data.Color)
			Services.Net.Announce(data.Text, ok and color or nil)
		end)
	end)
end

return AnnouncementService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">BaseService</string>
          <string name="Source"><![CDATA[--[[
	BaseService  (ModuleScript)  ->  ServerScriptService/Services/BaseService
	Basen vergeben, Slots darstellen, Figuren platzieren/verkaufen,
	Cash-Pad, Schloss (serverseitig durchgesetzt), Spawn in der eigenen Basis.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Figures = require(Shared:WaitForChild("Figures"))
local Format = require(Shared:WaitForChild("Format"))
local FigureBuilder = require(Shared:WaitForChild("FigureBuilder"))

local BaseService = {}
local Services

local TOTAL_SLOTS = 21
local FLOOR_COLORS = {
	Color3.fromRGB(255, 170, 200), Color3.fromRGB(170, 210, 255), Color3.fromRGB(190, 255, 190), Color3.fromRGB(255, 230, 150),
	Color3.fromRGB(220, 190, 255), Color3.fromRGB(255, 200, 160), Color3.fromRGB(160, 240, 230), Color3.fromRGB(240, 240, 240),
}

local bases = {} -- [plotIndex] = entry
local playerBase = {} -- [player] = entry
local lastEjectNotify = {}

------------------------------------------------------------------------
-- Hilfsfunktionen
------------------------------------------------------------------------
local function now()
	return os.clock()
end

local function getRoot(player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

function BaseService.GetBase(player)
	return playerBase[player]
end

function BaseService.IsInside(entry, position)
	if not entry or not entry.Model then
		return false
	end
	local zone = entry.Model:FindFirstChild("Zone")
	if not zone then
		return false
	end
	local rel = zone.CFrame:PointToObjectSpace(position)
	local half = zone.Size / 2
	return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
end

function BaseService.IsPlayerInOwnBase(player)
	local root = getRoot(player)
	return root ~= nil and BaseService.IsInside(playerBase[player], root.Position)
end

function BaseService.IsLocked(player)
	local entry = playerBase[player]
	return entry ~= nil and entry.LockedUntil > now()
end

function BaseService.GetLockRemaining(player)
	local entry = playerBase[player]
	if not entry then
		return 0
	end
	return math.max(0, entry.LockedUntil - now())
end

function BaseService.GetLockDuration(player)
	local data = Services.DataService.Get(player)
	local rebirths = data and data.Rebirths or 0
	return math.min(Config.Lock.BaseDuration + Config.Lock.PerRebirth * rebirths, Config.Lock.MaxDuration)
end

------------------------------------------------------------------------
-- Slots
------------------------------------------------------------------------
function BaseService.IsSlotUnlocked(player, index)
	local data = Services.DataService.Get(player)
	if not data then
		return false
	end
	if index <= Config.BaseSlots then
		return true
	elseif index <= Config.BaseSlots + Config.MaxRebirthSlots then
		return index - Config.BaseSlots <= math.min(data.Rebirths, Config.MaxRebirthSlots)
	elseif index <= 20 then
		return Services.MonetizationService.HasPass(player, "ExtraSlots")
	elseif index == Config.PremiumSlot then
		return Services.MonetizationService.IsPremium(player)
	end
	return false
end

function BaseService.GetCapacity(player)
	local count = 0
	for i = 1, TOTAL_SLOTS do
		if BaseService.IsSlotUnlocked(player, i) then
			count += 1
		end
	end
	return count
end

function BaseService.FindFreeSlot(player)
	local data = Services.DataService.Get(player)
	if not data then
		return nil
	end
	for i = 1, TOTAL_SLOTS do
		if BaseService.IsSlotUnlocked(player, i) and data.Slots[tostring(i)] == nil then
			return i
		end
	end
	return nil
end

local function clearSlotExtras(slotPart)
	for _, child in ipairs(slotPart:GetChildren()) do
		if child.Name == "SlotLock" or child.Name == "UpsellPrompt" then
			child:Destroy()
		end
	end
end

local function renderSlotPart(player, entry, index)
	local slotPart = entry.Model.Slots:FindFirstChild("Slot" .. index)
	if not slotPart then
		return
	end
	clearSlotExtras(slotPart)
	local unlocked = BaseService.IsSlotUnlocked(player, index)
	if index == Config.PremiumSlot then
		slotPart.Transparency = unlocked and 0 or 0.4
	else
		slotPart.Color = unlocked and Color3.new(1, 1, 1) or Color3.fromRGB(60, 60, 70)
		slotPart.Transparency = unlocked and 0 or 0.4
	end
	if unlocked then
		return
	end

	local text, upsell
	if index <= Config.BaseSlots + Config.MaxRebirthSlots then
		text = "⭐ Rebirth " .. (index - Config.BaseSlots)
	elseif index <= 20 then
		text = "🏠 Game Pass"
		upsell = { Action = "Slots holen", Object = "+5 Basis-Slots", Kind = "Pass" }
	else
		text = "👑 Premium"
		upsell = { Action = "Premium holen", Object = "Premium-Slot + 10% Cash", Kind = "Premium" }
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "SlotLock"
	gui.Size = UDim2.new(5, 0, 1.5, 0)
	gui.StudsOffset = Vector3.new(0, 1.5, 0)
	gui.MaxDistance = 50
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.Parent = gui
	gui.Parent = slotPart

	if upsell then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "UpsellPrompt"
		prompt.ActionText = upsell.Action
		prompt.ObjectText = upsell.Object
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("OwnerId", player.UserId)
		CollectionService:AddTag(prompt, "OwnerOnlyPrompt")
		prompt.Triggered:Connect(function(who)
			if who ~= player then
				return
			end
			if upsell.Kind == "Pass" then
				Services.MonetizationService.PromptPass(player, "ExtraSlots")
			else
				Services.MonetizationService.PromptPremium(player)
			end
		end)
		prompt.Parent = slotPart
	end
end

function BaseService.RenderSlot(player, index)
	local entry = playerBase[player]
	local data = Services.DataService.Get(player)
	if not entry or not entry.Model or not data then
		return
	end
	local folder = entry.Model:FindFirstChild("Figures")
	local old = folder:FindFirstChild("Fig" .. index)
	if old then
		old:Destroy()
	end
	local slotData = data.Slots[tostring(index)]
	if not slotData then
		return
	end
	local slotPart = entry.Model.Slots:FindFirstChild("Slot" .. index)
	if not slotPart then
		return
	end
	local ghost = Services.StealService.IsBeingStolen(player, index)
	local model = FigureBuilder.Build(slotData.Id, slotData.Mut, { Mode = "Base", Ghost = ghost })
	if not model then
		return
	end
	model.Name = "Fig" .. index
	FigureBuilder.PlaceOn(model, slotPart.CFrame * CFrame.new(0, slotPart.Size.Y / 2, 0))
	model.Parent = folder
	if not ghost then
		Services.StealService.AttachPrompts(model, player, index)
	end
end

function BaseService.UpdateSign(player)
	local entry = playerBase[player]
	local data = Services.DataService.Get(player)
	if not entry or not data then
		return
	end
	local label = entry.Model.Sign.SignGui.Label
	local stars = data.Rebirths > 0 and ("  ⭐" .. data.Rebirths) or ""
	label.Text = "Basis von " .. player.DisplayName .. stars
end

function BaseService.RenderAll(player)
	local entry = playerBase[player]
	if not entry then
		return
	end
	for i = 1, TOTAL_SLOTS do
		renderSlotPart(player, entry, i)
		BaseService.RenderSlot(player, i)
	end
	BaseService.UpdateSign(player)
end

function BaseService.UpdateCashPad(player, pending)
	local entry = playerBase[player]
	if not entry then
		return
	end
	local label = entry.Model.CashPad.CashGui.Label
	if Services.MonetizationService.HasPass(player, "AutoCollect") then
		label.Text = "🧲 Auto-Collect"
	else
		label.Text = Format.Money(pending)
	end
end

------------------------------------------------------------------------
-- Figuren geben / nehmen / verkaufen
------------------------------------------------------------------------
function BaseService.GiveFigure(player, id, mutation)
	local data = Services.DataService.Get(player)
	local slot = BaseService.FindFreeSlot(player)
	if not data or not slot then
		return nil
	end
	data.Slots[tostring(slot)] = { Id = id, Mut = mutation or "Normal" }
	data.Index[Figures.IndexKey(id, mutation)] = true
	BaseService.RenderSlot(player, slot)
	Services.StateService.MarkDirty(player)
	return slot
end

function BaseService.RemoveFigure(player, index)
	local data = Services.DataService.Get(player)
	if not data then
		return
	end
	data.Slots[tostring(index)] = nil
	BaseService.RenderSlot(player, index)
	Services.StateService.MarkDirty(player)
end

function BaseService.Sell(player, index)
	index = tonumber(index)
	if not index or index ~= math.floor(index) or index < 1 or index > TOTAL_SLOTS then
		return false, "Ungültiger Slot"
	end
	local data = Services.DataService.Get(player)
	local slotData = data and data.Slots[tostring(index)]
	if not slotData then
		return false, "Slot ist leer"
	end
	if Services.StealService.IsBeingStolen(player, index) then
		return false, "Wird gerade gestohlen!"
	end
	local value = Figures.SellValue(slotData.Id, slotData.Mut)
	data.Cash += value
	BaseService.RemoveFigure(player, index)
	Services.RewardService.AddProgress(player, "Sell", 1)
	Services.Net.Notify(player, ("Verkauft: %s für %s"):format(Figures.DisplayName(slotData.Id, slotData.Mut), Format.Money(value)), "cash", "Sell")
	return true
end

------------------------------------------------------------------------
-- Schloss
------------------------------------------------------------------------
local function setDoorVisual(entry, locked)
	local door = entry.Model.LaserDoor
	door.Transparency = locked and 0.35 or 1
	door.DoorGui.Enabled = locked
	entry.Model.LockButton.Color = locked and Color3.fromRGB(60, 220, 90) or Color3.fromRGB(255, 60, 60)
end

function BaseService.Lock(player)
	local entry = playerBase[player]
	if not entry then
		return false, "Keine Basis"
	end
	if entry.LockedUntil > now() then
		return false, "Schon abgeschlossen"
	end
	entry.LockedUntil = now() + BaseService.GetLockDuration(player)
	Services.RewardService.AddProgress(player, "Lock", 1)
	Services.Net.Notify(player, "🔒 Basis abgeschlossen!", "success", "Lock")
	Services.StateService.MarkDirty(player)
	return true
end

function BaseService.ExtendLock(player, seconds)
	local entry = playerBase[player]
	if not entry then
		return
	end
	entry.LockedUntil = math.max(now(), entry.LockedUntil) + seconds
	Services.StateService.MarkDirty(player)
end

local function ejectIntruders(entry)
	local outside = entry.Model:GetPivot() * CFrame.new(0, 4, -37)
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= entry.Owner then
			local root = getRoot(other)
			if root and BaseService.IsInside(entry, root.Position) then
				Services.StealService.NotifyTeleport(other)
				other.Character:PivotTo(outside)
				if not lastEjectNotify[other] or now() - lastEjectNotify[other] > 3 then
					lastEjectNotify[other] = now()
					Services.Net.Notify(other, "🔒 Diese Basis ist abgeschlossen!", "error", "Error")
				end
			end
		end
	end
end

local function lockLoop()
	while true do
		task.wait(0.2)
		for _, entry in pairs(bases) do
			local owner = entry.Owner
			if owner and entry.Model then
				local remaining = entry.LockedUntil - now()
				local locked = remaining > 0
				if locked ~= entry.WasLocked then
					entry.WasLocked = locked
					setDoorVisual(entry, locked)
					if not locked then
						Services.Net.Notify(owner, "🔓 Dein Schloss ist offen! Diebe können rein!", "warning", "Unlock", "LockExtend")
					end
					Services.StateService.MarkDirty(owner)
				end
				local lockLabel = entry.Model.LockButton.LockGui.Label
				if locked then
					local text = "🔒 " .. Format.Time(remaining)
					entry.Model.LaserDoor.DoorGui.Label.Text = text
					lockLabel.Text = text
					ejectIntruders(entry)
				else
					lockLabel.Text = "🔓 Abschließen"
				end
			end
		end
	end
end

------------------------------------------------------------------------
-- Laufgeschwindigkeit & Spawn
------------------------------------------------------------------------
function BaseService.GetNormalWalkSpeed(player)
	if Services.MonetizationService.HasPass(player, "Speed") then
		return Config.SpeedPassWalkSpeed
	end
	return Config.WalkSpeed
end

function BaseService.ApplyWalkSpeed(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and not Services.StealService.IsCarrying(player) and not Services.StealService.IsStunned(player) then
		humanoid.WalkSpeed = BaseService.GetNormalWalkSpeed(player)
	end
end

local function spawnAtBase(player, character)
	local entry = playerBase[player]
	if not entry then
		return
	end
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not root then
		return
	end
	task.wait()
	local spawnPart = entry.Model:FindFirstChild("SpawnPoint")
	if spawnPart and character.Parent then
		Services.StealService.NotifyTeleport(player)
		character:PivotTo(spawnPart.CFrame * CFrame.new(0, 3, 0))
	end
	BaseService.ApplyWalkSpeed(player)
end

------------------------------------------------------------------------
-- Zuweisen / Freigeben
------------------------------------------------------------------------
local function assignBase(player)
	local template = ServerStorage:FindFirstChild("BaseTemplate")
	if not template then
		warn("[BaseService] ServerStorage.BaseTemplate fehlt! SetupWorld ausführen.")
		return
	end
	local entry
	for i = 1, #bases do
		if not bases[i].Owner then
			entry = bases[i]
			break
		end
	end
	if not entry then
		player:Kick("Dieser Server ist voll. Bitte tritt erneut bei!")
		return
	end

	local model = template:Clone()
	model.Name = "Base" .. entry.Index
	model:PivotTo(entry.Plot.CFrame)
	local figures = Instance.new("Folder")
	figures.Name = "Figures"
	figures.Parent = model
	model.Floor.Color = FLOOR_COLORS[(entry.Index - 1) % #FLOOR_COLORS + 1]
	model:SetAttribute("OwnerId", player.UserId)
	model.Parent = Workspace:WaitForChild("Bases")

	entry.Model = model
	entry.Owner = player
	entry.LockedUntil = 0
	entry.WasLocked = false
	playerBase[player] = entry

	local connections = {}
	table.insert(connections, model.CashPad.Touched:Connect(function(hit)
		local who = Players:GetPlayerFromCharacter(hit.Parent)
		if who ~= player or not Services.RateLimit.Allow(player, "CashPad", 1, 0.5) then
			return
		end
		local root = getRoot(player)
		if root and (root.Position - model.CashPad.Position).Magnitude < 12 then
			Services.IncomeService.Collect(player)
		end
	end))
	table.insert(connections, model.LockButton.Touched:Connect(function(hit)
		local who = Players:GetPlayerFromCharacter(hit.Parent)
		if who ~= player or not Services.RateLimit.Allow(player, "LockPad", 1, 1) then
			return
		end
		local root = getRoot(player)
		if root and (root.Position - model.LockButton.Position).Magnitude < 10 and not BaseService.IsLocked(player) then
			BaseService.Lock(player)
		end
	end))
	table.insert(connections, player.CharacterAdded:Connect(function(character)
		spawnAtBase(player, character)
	end))
	entry.Connections = connections

	BaseService.RenderAll(player)
	local data = Services.DataService.Get(player)
	BaseService.UpdateCashPad(player, data and data.Pending or 0)
	if player.Character then
		task.spawn(spawnAtBase, player, player.Character)
	end
end

local function releaseBase(player)
	local entry = playerBase[player]
	if not entry then
		return
	end
	for _, connection in ipairs(entry.Connections or {}) do
		connection:Disconnect()
	end
	if entry.Model then
		entry.Model:Destroy()
	end
	entry.Model = nil
	entry.Owner = nil
	entry.LockedUntil = 0
	entry.Connections = nil
	playerBase[player] = nil
	lastEjectNotify[player] = nil
end

function BaseService.Init(services)
	Services = services
	local plots = Workspace:WaitForChild("Plots")
	for i = 1, 8 do
		local plot = plots:FindFirstChild("Plot" .. i)
		if plot then
			table.insert(bases, { Index = i, Plot = plot, LockedUntil = 0 })
		end
	end
	if #bases == 0 then
		warn("[BaseService] Keine Plots gefunden! SetupWorld ausführen.")
	end
end

function BaseService.Start()
	Services.Net.Register("ToggleLock", function(player)
		return BaseService.Lock(player)
	end, 2)
	Services.Net.Register("Sell", function(player, index)
		return BaseService.Sell(player, index)
	end, 5)

	Services.DataService.OnLoaded(assignBase)
	Services.DataService.OnReleasing(releaseBase)
	task.spawn(lockLoop)
end

return BaseService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">ConveyorService</string>
          <string name="Source"><![CDATA[--[[
	ConveyorService  (ModuleScript)  ->  ServerScriptService/Services/ConveyorService
	Spawnt Figuren auf dem Förderband (Seltenheit, Mutation, Pity, Lucky Spawn)
	und wickelt den Kauf ab. Alle Prüfungen passieren auf dem Server.
]]

local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Figures = require(Shared:WaitForChild("Figures"))
local Format = require(Shared:WaitForChild("Format"))
local FigureBuilder = require(Shared:WaitForChild("FigureBuilder"))

local ConveyorService = {}
local Services

local rng = Random.new()
local active = {} -- [model] = entry
local activeCount = 0
local luckUntil = 0
local pityCounter = 0

local conveyor, folder, startCFrame, endCFrame

------------------------------------------------------------------------
-- Zufall
------------------------------------------------------------------------
local function weightedPick(items, weightOf)
	local total = 0
	for _, item in ipairs(items) do
		total += weightOf(item)
	end
	local roll = rng:NextNumber() * total
	for _, item in ipairs(items) do
		roll -= weightOf(item)
		if roll <= 0 then
			return item
		end
	end
	return items[#items]
end

function ConveyorService.IsLucky()
	return os.time() < luckUntil or Services.EventService.IsHappyHour()
end

function ConveyorService.GetLuckRemaining()
	return math.max(0, luckUntil - os.time())
end

function ConveyorService.AddLuck(seconds)
	luckUntil = math.max(os.time(), luckUntil) + seconds
	for _, player in ipairs(Services.DataService.GetLoadedPlayers()) do
		Services.StateService.MarkDirty(player)
	end
end

local function rollRarity()
	local lucky = ConveyorService.IsLucky()
	return weightedPick(Config.RarityOrder, function(name)
		local r = Config.Rarities[name]
		return lucky and r.LuckyWeight or r.Weight
	end)
end

local function rollMutation()
	local mult = ConveyorService.IsLucky() and Config.LuckyMutationMult or 1
	local roll = rng:NextNumber() * 100
	for i = #Config.MutationOrder, 2, -1 do
		local name = Config.MutationOrder[i]
		local chance = Config.Mutations[name].Chance * mult
		if roll < chance then
			return name
		end
		roll -= chance
	end
	return "Normal"
end

local function rollFigure(rarity)
	local fig = weightedPick(Figures.ByRarity[rarity], function(f)
		return f.Weight
	end)
	return fig.Id
end

------------------------------------------------------------------------
-- Spawnen
------------------------------------------------------------------------
local function removeEntry(model)
	if active[model] then
		active[model] = nil
		activeCount -= 1
	end
	if model.Parent then
		model:Destroy()
	end
end

local function spawnFigure(id, mutation, reservedFor)
	local fig = Figures.Get(id)
	local model = FigureBuilder.Build(id, mutation, { Mode = "Conveyor" })
	if not model then
		return
	end
	local price = Figures.Price(id, mutation)
	local entry = {
		Id = id,
		Mut = mutation,
		Price = price,
		Sold = false,
		ReservedFor = reservedFor and reservedFor.UserId or nil,
		ReservedName = reservedFor and reservedFor.DisplayName or nil,
		ReservedUntil = reservedFor and (os.clock() + Config.Conveyor.ReserveSeconds) or 0,
	}

	FigureBuilder.PlaceOn(model, startCFrame)
	local root = model.PrimaryPart

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "BuyPrompt"
	prompt.ActionText = "Kaufen " .. Format.Money(price)
	prompt.ObjectText = Figures.DisplayName(id, mutation)
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = root
	prompt.Triggered:Connect(function(player)
		ConveyorService.TryBuy(player, model)
	end)

	if entry.ReservedFor then
		local info = root:FindFirstChild("Info")
		if info then
			info.RarityLabel.Text = "🔒 für " .. entry.ReservedName
		end
	end

	active[model] = entry
	activeCount += 1
	model.Parent = folder

	local travelTarget = endCFrame * startCFrame:Inverse() * root.CFrame
	local tween = TweenService:Create(root, TweenInfo.new(Config.Conveyor.TravelTime, Enum.EasingStyle.Linear), { CFrame = travelTarget })
	entry.Tween = tween
	tween.Completed:Connect(function()
		if not entry.Sold then
			removeEntry(model)
		end
	end)
	tween:Play()

	-- Hype für seltene Spawns
	local rank = Config.Rarities[fig.Rarity].Rank
	if rank >= Config.Rarities.Mythic.Rank or mutation == "Rainbow" then
		Services.Net.Announce(("🚨 %s %s ist auf dem Förderband erschienen! SCHNELL!"):format(Config.Rarities[fig.Rarity].Display, Figures.DisplayName(id, mutation)), Config.Rarities[fig.Rarity].Color)
	end
	if rank >= Config.Rarities.Legendary.Rank then
		Services.Net.EffectAll("RareSpawn", { Id = id, Mut = mutation })
	end
end

function ConveyorService.ForceSpawn(rarity, forPlayer)
	spawnFigure(rollFigure(rarity), rollMutation(), forPlayer)
end

local function spawnTick()
	if activeCount >= Config.Conveyor.MaxFigures then
		return
	end
	local rarity = rollRarity()
	pityCounter += 1
	if Config.Rarities[rarity].Rank >= Config.Rarities.Legendary.Rank then
		pityCounter = 0
	elseif pityCounter >= Config.Conveyor.PityThreshold then
		rarity = "Legendary"
		pityCounter = 0
	end
	spawnFigure(rollFigure(rarity), rollMutation(), nil)
end

------------------------------------------------------------------------
-- Kaufen
------------------------------------------------------------------------
local function suggestCashPack(player, missing)
	for _, key in ipairs({ "CashSmall", "CashMedium", "CashLarge", "CashMega" }) do
		if Services.MonetizationService.CashPackAmount(player, Config.Products[key]) >= missing then
			return key
		end
	end
	return "CashMega"
end

function ConveyorService.TryBuy(player, model)
	local entry = active[model]
	if not entry or entry.Sold then
		return
	end
	if not Services.RateLimit.Allow(player, "Buy", 4, 1) then
		return
	end
	local data = Services.DataService.Get(player)
	if not data then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not model.PrimaryPart or (root.Position - model.PrimaryPart.Position).Magnitude > Config.Conveyor.BuyDistance then
		return
	end
	if Services.StealService.IsCarrying(player) then
		Services.Net.Notify(player, "Bring erst deine Beute nach Hause!", "error", "Error")
		return
	end
	if entry.ReservedFor and entry.ReservedFor ~= player.UserId and os.clock() < entry.ReservedUntil then
		Services.Net.Notify(player, ("Reserviert für %s (noch %ds)"):format(entry.ReservedName, math.ceil(entry.ReservedUntil - os.clock())), "error", "Error")
		return
	end
	if data.Cash < entry.Price then
		local missing = entry.Price - data.Cash
		Services.Net.Notify(player, ("Dir fehlen %s!"):format(Format.Money(missing)), "error", "Error", suggestCashPack(player, missing))
		return
	end
	local slot = Services.BaseService.FindFreeSlot(player)
	if not slot then
		local offer = if Services.MonetizationService.HasPass(player, "ExtraSlots") then nil else "ExtraSlots"
		Services.Net.Notify(player, "Deine Basis ist voll! Verkaufe eine Figur (Inventar) oder hol dir mehr Slots.", "error", "Error", offer)
		return
	end

	-- Kauf gültig
	entry.Sold = true
	data.Cash -= entry.Price
	data.Slots[tostring(slot)] = { Id = entry.Id, Mut = entry.Mut }
	data.Index[Figures.IndexKey(entry.Id, entry.Mut)] = true
	data.Stats.Bought += 1
	Services.RewardService.AddProgress(player, "Buy", 1)
	if Figures.RarityRank(entry.Id) >= Config.Rarities.Rare.Rank then
		Services.RewardService.AddProgress(player, "BuyRare", 1)
	end
	Services.StateService.MarkDirty(player)

	local fig = Figures.Get(entry.Id)
	local rank = Config.Rarities[fig.Rarity].Rank
	Services.Net.Notify(player, "Gekauft: " .. Figures.DisplayName(entry.Id, entry.Mut) .. "!", "success", rank >= 4 and "Legendary" or (rank >= 2 and "Rare" or "Buy"))
	if rank >= Config.Rarities.Legendary.Rank or entry.Mut ~= "Normal" then
		Services.Net.Effect(player, "Reveal", { Id = entry.Id, Mut = entry.Mut, Text = "NEUE FIGUR!" })
	end
	Services.AnnouncementService.Found(player, entry.Id, entry.Mut, "gekauft")

	-- Figur "läuft" zur Basis
	local prompt = model.PrimaryPart:FindFirstChild("BuyPrompt")
	if prompt then
		prompt:Destroy()
	end
	if entry.Tween then
		entry.Tween:Cancel()
	end
	local base = Services.BaseService.GetBase(player)
	local slotPart = base and base.Model and base.Model.Slots:FindFirstChild("Slot" .. slot)
	if slotPart then
		local target = slotPart.CFrame * CFrame.new(0, slotPart.Size.Y / 2 + model.PrimaryPart.Size.Y / 2, 0)
		local distance = (target.Position - model.PrimaryPart.Position).Magnitude
		local walk = TweenService:Create(model.PrimaryPart, TweenInfo.new(math.clamp(distance / 40, 0.6, 2.5), Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { CFrame = target })
		walk.Completed:Connect(function()
			removeEntry(model)
			Services.BaseService.RenderSlot(player, slot)
		end)
		walk:Play()
	else
		removeEntry(model)
		Services.BaseService.RenderSlot(player, slot)
	end
end

------------------------------------------------------------------------
function ConveyorService.Init(services)
	Services = services
	conveyor = Workspace:WaitForChild("Conveyor")
	folder = Workspace:FindFirstChild("ConveyorFigures")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "ConveyorFigures"
		folder.Parent = Workspace
	end
	local belt = conveyor:WaitForChild("Belt")
	local beltTop = belt.Position.Y + belt.Size.Y / 2
	local startPos = conveyor:WaitForChild("StartPoint").Position
	local endPos = conveyor:WaitForChild("EndPoint").Position
	startPos = Vector3.new(startPos.X, beltTop, startPos.Z)
	endPos = Vector3.new(endPos.X, beltTop, endPos.Z)
	startCFrame = CFrame.lookAt(startPos, endPos)
	endCFrame = CFrame.lookAt(endPos, endPos + (endPos - startPos).Unit)
end

function ConveyorService.Start()
	task.spawn(function()
		while true do
			task.wait(Config.Conveyor.SpawnInterval)
			local ok, err = pcall(spawnTick)
			if not ok then
				warn("[Conveyor] Spawn-Fehler:", err)
			end
		end
	end)
end

return ConveyorService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	DataService  (ModuleScript)  ->  ServerScriptService/Services/DataService
	Speichert Spielerdaten sicher (ProfileService-Prinzip):
	  - Session-Lock: Daten sind nur in EINEM Server gleichzeitig offen (kein Duplizieren)
	  - UpdateAsync statt SetAsync, Retry mit Backoff
	  - Auto-Save alle 60 s, Speichern beim Verlassen und beim Server-Shutdown
	  - Standardwerte werden automatisch ergänzt (neue Felder in Updates)
	In Studio ohne API-Zugriff wird automatisch ein Test-Speicher im RAM benutzt.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))

local DataService = {}

local STORE_NAME = "BrainrotBandits_PlayerData_v1"
local LOCK_TIMEOUT = 180 -- Sekunden: älterer Lock gilt als verwaist (Server abgestürzt)
local AUTOSAVE_INTERVAL = 60
local LOAD_ATTEMPTS = 10

local DEFAULT_DATA = {
	Version = 1,
	Cash = Config.StartCash,
	Pending = 0,
	TotalEarned = 0,
	Rebirths = 0,
	Slots = {}, -- ["1"] = { Id = 3, Mut = "Gold" }
	Index = {}, -- ["3_Gold"] = true
	Daily = { Streak = 0, LastDay = 0 },
	Quests = { Day = 0, List = {} },
	Stats = { Steals = 0, Defends = 0, Bought = 0, PlayTime = 0, RobuxSpent = 0 },
	Boost2xUntil = 0,
	LastOnline = 0,
	FirstJoin = 0,
	StarterBought = false,
	OfflineReward = { Amount = 0, Boosted = true },
	Purchases = {},
}

local store
local useMock = false
local mockStore = {}

local profiles = {} -- [player] = { Key, Data }
local loadedCallbacks = {}
local releasingCallbacks = {}
local shuttingDown = false

local function deepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local copy = {}
	for k, v in pairs(t) do
		copy[k] = deepCopy(v)
	end
	return copy
end

local function reconcile(data, default)
	for k, v in pairs(default) do
		if data[k] == nil then
			data[k] = deepCopy(v)
		elseif type(v) == "table" and type(data[k]) == "table" and next(v) ~= nil then
			reconcile(data[k], v)
		end
	end
end

local function updateAsync(key, transform)
	if useMock then
		local result = transform(deepCopy(mockStore[key]))
		if result ~= nil then
			mockStore[key] = deepCopy(result)
		end
		return result
	end
	return store:UpdateAsync(key, transform)
end

local function waitForBudget(requestType)
	if useMock then
		return
	end
	local start = os.clock()
	while DataStoreService:GetRequestBudgetForRequestType(requestType) < 1 and os.clock() - start < 10 do
		task.wait(0.5)
	end
end

local function loadProfile(player)
	local key = "Player_" .. player.UserId
	for attempt = 1, LOAD_ATTEMPTS do
		if not player.Parent then
			return nil
		end
		local lockedByOther = false
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local ok, result = pcall(updateAsync, key, function(old)
			lockedByOther = false
			local data = old or deepCopy(DEFAULT_DATA)
			local lock = data.SessionLock
			if lock and lock.JobId ~= game.JobId and os.time() - (lock.Time or 0) < LOCK_TIMEOUT then
				lockedByOther = true
				return nil
			end
			data.SessionLock = { JobId = game.JobId, Time = os.time() }
			return data
		end)
		if ok and result and not lockedByOther then
			reconcile(result, DEFAULT_DATA)
			if result.FirstJoin == 0 then
				result.FirstJoin = os.time()
			end
			return { Key = key, Data = result }
		end
		if not ok then
			warn("[DataService] Laden fehlgeschlagen (Versuch " .. attempt .. "):", result)
		end
		task.wait(lockedByOther and 4 or math.min(2 ^ attempt, 10))
	end
	return nil
end

local function saveProfile(player, release)
	local profile = profiles[player]
	if not profile or not profile.Data then
		return false
	end
	profile.Data.LastOnline = os.time()
	local snapshot = deepCopy(profile.Data)

	for attempt = 1, 5 do
		local stolen = false
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local ok, err = pcall(updateAsync, profile.Key, function(old)
			stolen = false
			if old and old.SessionLock and old.SessionLock.JobId ~= game.JobId then
				stolen = true
				return nil
			end
			if release then
				snapshot.SessionLock = nil
			else
				snapshot.SessionLock = { JobId = game.JobId, Time = os.time() }
			end
			return snapshot
		end)
		if ok then
			if stolen then
				warn("[DataService] Session von anderem Server übernommen, Speichern abgebrochen:", player.Name)
				return false
			end
			return true
		end
		warn("[DataService] Speichern fehlgeschlagen (Versuch " .. attempt .. "):", err)
		task.wait(math.min(2 ^ attempt, 16))
	end
	return false
end

------------------------------------------------------------------------
-- Öffentliche API
------------------------------------------------------------------------
function DataService.Get(player)
	local profile = profiles[player]
	return profile and profile.Data or nil
end

function DataService.IsLoaded(player)
	return profiles[player] ~= nil
end

function DataService.Save(player)
	return saveProfile(player, false)
end

-- fn(player, data) wird aufgerufen, sobald die Daten eines Spielers geladen sind
function DataService.OnLoaded(fn)
	table.insert(loadedCallbacks, fn)
	for player, profile in pairs(profiles) do
		task.spawn(fn, player, profile.Data)
	end
end

-- fn(player, data) wird aufgerufen, kurz bevor die Daten beim Verlassen gespeichert werden
function DataService.OnReleasing(fn)
	table.insert(releasingCallbacks, fn)
end

function DataService.GetLoadedPlayers()
	local list = {}
	for player in pairs(profiles) do
		table.insert(list, player)
	end
	return list
end

------------------------------------------------------------------------
local function onPlayerAdded(player)
	local profile = loadProfile(player)
	if not profile then
		if player.Parent then
			player:Kick("Deine Daten werden noch in einem anderen Server gespeichert. Bitte tritt in 1 Minute erneut bei.")
		end
		return
	end
	if not player.Parent then
		-- Spieler ist während des Ladens gegangen: Lock sofort wieder freigeben
		profiles[player] = profile
		saveProfile(player, true)
		profiles[player] = nil
		return
	end
	profiles[player] = profile
	for _, fn in ipairs(loadedCallbacks) do
		local ok, err = pcall(fn, player, profile.Data)
		if not ok then
			warn("[DataService] OnLoaded-Fehler:", err)
		end
	end
end

local function onPlayerRemoving(player)
	local profile = profiles[player]
	if not profile or profile.Releasing then
		return
	end
	profile.Releasing = true
	for _, fn in ipairs(releasingCallbacks) do
		local ok, err = pcall(fn, player, profile.Data)
		if not ok then
			warn("[DataService] OnReleasing-Fehler:", err)
		end
	end
	saveProfile(player, true)
	profiles[player] = nil
end

function DataService.Init()
	local ok = pcall(function()
		store = DataStoreService:GetDataStore(STORE_NAME)
		store:GetAsync("__ping")
	end)
	if not ok then
		if RunService:IsStudio() then
			useMock = true
			warn("[DataService] Kein DataStore-Zugriff: Test-Speicher (RAM) aktiv. Für echtes Speichern: Spiel veröffentlichen + 'Enable Studio Access to API Services'.")
		else
			store = DataStoreService:GetDataStore(STORE_NAME)
		end
	end
end

function DataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while not shuttingDown do
			task.wait(AUTOSAVE_INTERVAL)
			for player in pairs(profiles) do
				task.spawn(saveProfile, player, false)
				task.wait(0.5)
			end
		end
	end)

	game:BindToClose(function()
		shuttingDown = true
		for player in pairs(profiles) do
			task.spawn(onPlayerRemoving, player)
		end
		local start = os.clock()
		while next(profiles) ~= nil and os.clock() - start < 25 do
			task.wait(0.2)
		end
	end)
end

DataService.UsingMock = function()
	return useMock
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[--[[
	EventService  (ModuleScript)  ->  ServerScriptService/Services/EventService
	Zeitlich begrenzte Events (laufen automatisch nach UTC-Zeit):
	  - Wochenende (Sa + So): 2x Cash
	  - Happy Hour täglich 18-19 Uhr UTC: Lucky Spawn gratis für alle
	Zusätzlich kann man live ein Event starten: Attribut "EventCashMult" (Zahl)
	an Workspace setzen, z. B. per Command Bar im Live-Server oder später per Admin-Tool.
]]

local Workspace = game:GetService("Workspace")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))

local EventService = {}
local Services

local function utcNow()
	return os.date("!*t", os.time())
end

function EventService.IsWeekend()
	local t = utcNow()
	return t.wday == 1 or t.wday == 7
end

function EventService.IsHappyHour()
	local t = utcNow()
	return t.hour >= Config.Events.HappyHourStartUTC and t.hour < Config.Events.HappyHourEndUTC
end

function EventService.GetCashMult()
	local mult = 1
	if EventService.IsWeekend() then
		mult *= Config.Events.WeekendCashMult
	end
	local manual = Workspace:GetAttribute("EventCashMult")
	if type(manual) == "number" and manual > 0 then
		mult *= manual
	end
	return mult
end

function EventService.GetInfo()
	local names = {}
	if EventService.IsWeekend() then
		table.insert(names, "🎉 Wochenend-Event: 2x Cash")
	end
	if EventService.IsHappyHour() then
		table.insert(names, "🍀 Happy Hour: Lucky Spawn gratis")
	end
	local manual = Workspace:GetAttribute("EventCashMult")
	if type(manual) == "number" and manual > 1 then
		table.insert(names, ("🔥 Sonder-Event: %sx Cash"):format(manual))
	end
	return { Names = names, CashMult = EventService.GetCashMult(), Luck = EventService.IsHappyHour() }
end

function EventService.Init(services)
	Services = services
end

function EventService.Start()
	task.spawn(function()
		local lastKey = ""
		while true do
			local info = EventService.GetInfo()
			local key = table.concat(info.Names, "|")
			if key ~= lastKey then
				for _, name in ipairs(info.Names) do
					Services.Net.Announce(name .. " ist jetzt aktiv!", Color3.fromRGB(255, 120, 220))
				end
				lastKey = key
				for _, player in ipairs(Services.DataService.GetLoadedPlayers()) do
					Services.StateService.MarkDirty(player)
				end
			end
			task.wait(30)
		end
	end)
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">IncomeService</string>
          <string name="Source"><![CDATA[--[[
	IncomeService  (ModuleScript)  ->  ServerScriptService/Services/IncomeService
	Passives Einkommen (jede Sekunde), Cash-Pad einsammeln, Offline-Einkommen,
	alle Multiplikatoren, leaderstats.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Figures = require(Shared:WaitForChild("Figures"))
local Format = require(Shared:WaitForChild("Format"))

local IncomeService = {}
local Services

local inGroup = {} -- [player] = bool
local friendCount = {} -- [player] = number
local leaderstats = {} -- [player] = { Cash = StringValue, Rebirths = IntValue }

function IncomeService.GetBaseIncome(data)
	local total = 0
	for _, slot in pairs(data.Slots) do
		total += Figures.Income(slot.Id, slot.Mut)
	end
	return total
end

function IncomeService.GetIndexBonus(data)
	local unique = {}
	local count = 0
	for key in pairs(data.Index) do
		local id = tonumber(string.match(key, "^(%d+)_"))
		if id and not unique[id] then
			unique[id] = true
			count += 1
		end
	end
	for _, tier in ipairs(Config.IndexBonus) do
		if count >= tier.Count then
			return tier.Bonus, count
		end
	end
	return 0, count
end

-- Gesamt-Multiplikator + Aufschlüsselung für die UI
function IncomeService.GetMultiplier(player)
	local data = Services.DataService.Get(player)
	if not data then
		return 1, {}
	end
	local M = Config.Multipliers
	local Monetization = Services.MonetizationService
	local parts = {}
	local mult = 1

	local rebirth = 1 + M.RebirthPer * data.Rebirths
	mult *= rebirth
	if data.Rebirths > 0 then
		table.insert(parts, ("⭐ Rebirth x%.1f"):format(rebirth))
	end
	if Monetization.HasPass(player, "DoubleCash") then
		mult *= M.DoubleCash
		table.insert(parts, "💰 2x Cash")
	end
	if Monetization.HasPass(player, "VIP") then
		mult *= M.VIP
		table.insert(parts, "👑 VIP +10%")
	end
	if Monetization.IsPremium(player) then
		mult *= M.Premium
		table.insert(parts, "Premium +10%")
	end
	if inGroup[player] then
		mult *= M.Group
		table.insert(parts, "👥 Gruppe +10%")
	end
	local friends = math.min(friendCount[player] or 0, M.FriendMax)
	if friends > 0 then
		mult *= 1 + M.FriendPer * friends
		table.insert(parts, ("🤝 %d Freunde +%d%%"):format(friends, friends * 10))
	end
	local indexBonus = IncomeService.GetIndexBonus(data)
	if indexBonus > 0 then
		mult *= 1 + indexBonus
		table.insert(parts, ("📖 Index +%d%%"):format(indexBonus * 100))
	end
	if data.Boost2xUntil > os.time() then
		mult *= M.Boost
		table.insert(parts, "⚡ Boost 2x")
	end
	local eventMult = Services.EventService.GetCashMult()
	if eventMult > 1 then
		mult *= eventMult
		table.insert(parts, ("🎉 Event x%s"):format(eventMult))
	end
	return mult, parts
end

function IncomeService.GetRate(player)
	local data = Services.DataService.Get(player)
	if not data then
		return 0
	end
	return IncomeService.GetBaseIncome(data) * IncomeService.GetMultiplier(player)
end

function IncomeService.Collect(player)
	local data = Services.DataService.Get(player)
	if not data or data.Pending < 1 then
		return
	end
	local amount = math.floor(data.Pending)
	data.Cash += amount
	data.Pending -= amount
	Services.Net.Notify(player, "+" .. Format.Money(amount), "cash", "Cash")
	Services.RewardService.AddProgress(player, "Collect", 1)
	Services.BaseService.UpdateCashPad(player, data.Pending)
	Services.StateService.MarkDirty(player)
end

local function giveOffline(player, data)
	if data.LastOnline <= 0 then
		return
	end
	local away = os.time() - data.LastOnline
	if away < Config.Offline.MinSeconds then
		return
	end
	local isVip = Services.MonetizationService.HasPass(player, "VIP")
	local ratio = isVip and Config.Offline.VipRatio or Config.Offline.Ratio
	local maxSeconds = isVip and Config.Offline.VipMaxSeconds or Config.Offline.MaxSeconds
	local amount = math.floor(IncomeService.GetRate(player) * ratio * math.min(away, maxSeconds))
	if amount < 1 then
		return
	end
	data.Cash += amount
	data.TotalEarned += amount
	data.OfflineReward = { Amount = amount, Boosted = false }
	Services.Net.Effect(player, "Offline", { Amount = amount, Away = away, Vip = isVip })
end

local function setupLeaderstats(player, data)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Value = Format.Money(data.Cash)
	cash.Parent = folder
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Value = data.Rebirths
	rebirths.Parent = folder
	folder.Parent = player
	leaderstats[player] = { Cash = cash, Rebirths = rebirths }
end

local function refreshFriends()
	local list = Services.DataService.GetLoadedPlayers()
	for _, player in ipairs(list) do
		local count = 0
		for _, other in ipairs(list) do
			if other ~= player then
				local ok, isFriend = pcall(player.IsFriendsWith, player, other.UserId)
				if ok and isFriend then
					count += 1
				end
			end
		end
		friendCount[player] = count
	end
end

function IncomeService.Init(services)
	Services = services
end

function IncomeService.Start()
	Services.DataService.OnLoaded(function(player, data)
		if Config.GroupId > 0 then
			local ok, member = pcall(player.IsInGroup, player, Config.GroupId)
			inGroup[player] = ok and member or false
		end
		setupLeaderstats(player, data)
		giveOffline(player, data)
		task.spawn(refreshFriends)
	end)

	Players.PlayerRemoving:Connect(function(player)
		inGroup[player] = nil
		friendCount[player] = nil
		leaderstats[player] = nil
	end)

	-- Einkommens-Tick
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Services.DataService.GetLoadedPlayers()) do
				local data = Services.DataService.Get(player)
				if data then
					local rate = IncomeService.GetRate(player)
					if Services.MonetizationService.HasPass(player, "AutoCollect") then
						data.Cash += rate
					else
						data.Pending += rate
					end
					data.TotalEarned += rate
					data.Stats.PlayTime += 1
					if data.Stats.PlayTime % 60 == 0 then
						Services.RewardService.AddProgress(player, "Play", 1)
					end
					Services.BaseService.UpdateCashPad(player, data.Pending)
					local stats = leaderstats[player]
					if stats then
						stats.Cash.Value = Format.Money(data.Cash)
						stats.Rebirths.Value = data.Rebirths
					end
					Services.StateService.MarkDirty(player)
				end
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(30)
			refreshFriends()
		end
	end)
end

return IncomeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[--[[
	LeaderboardService  (ModuleScript)  ->  ServerScriptService/Services/LeaderboardService
	Globale Bestenlisten (alle Server) über OrderedDataStore:
	  - CashBoard:    insgesamt verdientes Cash
	  - RebirthBoard: meiste Rebirths
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))

local LeaderboardService = {}
local Services

local BOARDS = {
	{ Board = "CashBoard", Store = "LB_TotalEarned_v1", Field = "TotalEarned", Format = Format.Money },
	{ Board = "RebirthBoard", Store = "LB_Rebirths_v1", Field = "Rebirths", Format = function(v)
		return "⭐ " .. tostring(v)
	end },
}
local MAX_VALUE = 9e15
local nameCache = {}

local function getName(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	nameCache[userId] = ok and name or "???"
	return nameCache[userId]
end

local function pushPlayer(player)
	local data = Services.DataService.Get(player)
	if not data then
		return
	end
	for _, board in ipairs(BOARDS) do
		if board.DataStore then
			local value = math.floor(math.clamp(data[board.Field] or 0, 0, MAX_VALUE))
			pcall(board.DataStore.SetAsync, board.DataStore, tostring(player.UserId), value)
		end
	end
end

local function renderBoard(board, entries)
	local model = Workspace:FindFirstChild("Leaderboards") and Workspace.Leaderboards:FindFirstChild(board.Board)
	local list = model and model.Screen.BoardGui.List
	if not list then
		return
	end
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	local medals = { "🥇", "🥈", "🥉" }
	for rank, entry in ipairs(entries) do
		local row = Instance.new("TextLabel")
		row.LayoutOrder = rank
		row.Size = UDim2.fromScale(1, 0.095)
		row.BackgroundTransparency = rank % 2 == 0 and 1 or 0.85
		row.BackgroundColor3 = Color3.new(1, 1, 1)
		row.Font = Enum.Font.FredokaOne
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = rank <= 3 and Color3.fromRGB(255, 220, 80) or Color3.new(1, 1, 1)
		row.Text = ("  %s %s   %s"):format(medals[rank] or ("#" .. rank), getName(tonumber(entry.key)), board.Format(entry.value))
		row.Parent = list
	end
end

local function refreshBoards()
	for _, board in ipairs(BOARDS) do
		if board.DataStore then
			local ok, pages = pcall(board.DataStore.GetSortedAsync, board.DataStore, false, 10)
			if ok and pages then
				renderBoard(board, pages:GetCurrentPage())
			end
		end
	end
end

function LeaderboardService.Init(services)
	Services = services
	for _, board in ipairs(BOARDS) do
		local ok, store = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, board.Store)
		if ok then
			board.DataStore = store
		end
	end
end

function LeaderboardService.Start()
	Services.DataService.OnReleasing(function(player)
		task.spawn(pushPlayer, player)
	end)

	task.spawn(function()
		task.wait(10)
		while true do
			for _, player in ipairs(Services.DataService.GetLoadedPlayers()) do
				pushPlayer(player)
				task.wait(1)
			end
			refreshBoards()
			task.wait(90)
		end
	end)
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[--[[
	MonetizationService  (ModuleScript)  ->  ServerScriptService/Services/MonetizationService
	Game Passes, Developer Products (ProcessReceipt), Roblox Premium.
	ProcessReceipt ist idempotent: jede PurchaseId wird nur einmal gutgeschrieben
	und erst nach erfolgreichem Speichern als "granted" bestätigt.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local Figures = require(game:GetService("ReplicatedStorage").Shared:WaitForChild("Figures"))
local Format = require(game:GetService("ReplicatedStorage").Shared:WaitForChild("Format"))

local MonetizationService = {}
local Services

local ownedPasses = {} -- [player] = { [key] = true }
local passKeyById = {}
local productKeyById = {}
local productHandlers = {}

------------------------------------------------------------------------
-- Game Passes
------------------------------------------------------------------------
function MonetizationService.HasPass(player, key)
	local owned = ownedPasses[player]
	return owned ~= nil and owned[key] == true
end

function MonetizationService.GetOwnedPasses(player)
	local result = {}
	for key in pairs(ownedPasses[player] or {}) do
		result[key] = true
	end
	return result
end

function MonetizationService.IsPremium(player)
	return player.MembershipType == Enum.MembershipType.Premium
end

local function applyPassEffects(player)
	player:SetAttribute("VIP", MonetizationService.HasPass(player, "VIP"))
	Services.BaseService.ApplyWalkSpeed(player)
	Services.BaseService.RenderAll(player)
	Services.StateService.MarkDirty(player)
end

local function loadPasses(player)
	local owned = {}
	for key, pass in pairs(Config.GamePasses) do
		if pass.Id and pass.Id > 0 then
			local ok, has = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
			if ok and has then
				owned[key] = true
			end
		end
	end
	ownedPasses[player] = owned
end

------------------------------------------------------------------------
-- Developer Products
------------------------------------------------------------------------
local function cashPackAmount(player, product)
	local rate = Services.IncomeService.GetRate(player)
	return math.max(product.Min, math.floor(rate * product.Seconds))
end
MonetizationService.CashPackAmount = cashPackAmount

local function grantCash(player, data, amount, reason)
	data.Cash += amount
	data.TotalEarned += amount
	Services.Net.Notify(player, ("%s: +%s"):format(reason, Format.Money(amount)), "success", "Reward")
end

for _, key in ipairs({ "CashSmall", "CashMedium", "CashLarge", "CashMega" }) do
	productHandlers[key] = function(player, data)
		local product = Config.Products[key]
		grantCash(player, data, cashPackAmount(player, product), product.Name)
		Services.Net.Effect(player, "Confetti")
	end
end

productHandlers.Boost2x = function(player, data)
	data.Boost2xUntil = math.max(os.time(), data.Boost2xUntil) + Config.Products.Boost2x.Seconds
	Services.Net.Notify(player, "⚡ 2x Cash aktiv! Noch " .. Format.Time(data.Boost2xUntil - os.time()), "success", "Reward")
end

productHandlers.LuckySpawn = function(player)
	Services.ConveyorService.AddLuck(Config.Products.LuckySpawn.Seconds)
	Services.Net.Announce(("🍀 %s hat LUCKY SPAWN für den ganzen Server aktiviert! Bessere Chancen für alle!"):format(player.DisplayName), Color3.fromRGB(90, 255, 120))
end

productHandlers.MythicDrop = function(player)
	Services.ConveyorService.ForceSpawn("Mythic", player)
	Services.Net.Announce(("🔥 %s hat einen MYTHIC-DROP gekauft!"):format(player.DisplayName), Config.Rarities.Mythic.Color)
end

productHandlers.LockExtend = function(player)
	Services.BaseService.ExtendLock(player, Config.Lock.ExtendSeconds)
	Services.Net.Notify(player, "🔐 Basis 5 Minuten extra gesichert!", "success", "Lock")
end

productHandlers.StarterPack = function(player, data)
	data.StarterBought = true
	local slot = Services.BaseService.GiveFigure(player, 14, "Gold")
	if not slot then
		grantCash(player, data, Figures.Price(14, "Gold"), "Basis voll, Figur als Cash")
	end
	grantCash(player, data, 25000, "Starter-Paket")
	data.Boost2xUntil = math.max(os.time(), data.Boost2xUntil) + 1800
	Services.Net.Effect(player, "Reveal", { Id = 14, Mut = "Gold", Text = "STARTER-PAKET!" })
end

productHandlers.OfflineTriple = function(player, data)
	local reward = data.OfflineReward
	if reward and reward.Amount > 0 and not reward.Boosted then
		reward.Boosted = true
		grantCash(player, data, reward.Amount * 2, "Offline-Cash x3")
	else
		grantCash(player, data, cashPackAmount(player, Config.Products.CashSmall), "Cash-Bonus")
	end
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = Services.DataService.Get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(data.Purchases, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local key = productKeyById[receipt.ProductId]
	local handler = key and productHandlers[key]
	if not handler then
		warn("[Monetization] Unbekannte ProductId:", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local ok, err = pcall(handler, player, data)
	if not ok then
		warn("[Monetization] Fehler beim Gutschreiben:", err)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	table.insert(data.Purchases, receipt.PurchaseId)
	while #data.Purchases > 100 do
		table.remove(data.Purchases, 1)
	end
	data.Stats.RobuxSpent += receipt.CurrencySpent or 0
	Services.StateService.MarkDirty(player)

	if Services.DataService.Save(player) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

------------------------------------------------------------------------
-- Server-seitige Kaufaufforderungen (z. B. gesperrte Slots in der Basis)
------------------------------------------------------------------------
function MonetizationService.PromptPass(player, key)
	local pass = Config.GamePasses[key]
	if pass and pass.Id > 0 and not MonetizationService.HasPass(player, key) then
		MarketplaceService:PromptGamePassPurchase(player, pass.Id)
	end
end

function MonetizationService.PromptPremium(player)
	if not MonetizationService.IsPremium(player) then
		pcall(MarketplaceService.PromptPremiumPurchase, MarketplaceService, player)
	end
end

------------------------------------------------------------------------
function MonetizationService.Init(services)
	Services = services
	for key, pass in pairs(Config.GamePasses) do
		if pass.Id > 0 then
			passKeyById[pass.Id] = key
		end
	end
	for key, product in pairs(Config.Products) do
		if product.Id > 0 then
			productKeyById[product.Id] = key
		end
	end
	MarketplaceService.ProcessReceipt = processReceipt
end

function MonetizationService.Start()
	Services.DataService.OnLoaded(function(player)
		loadPasses(player)
		player:SetAttribute("VIP", MonetizationService.HasPass(player, "VIP"))
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local key = passKeyById[passId]
		if not key then
			return
		end
		ownedPasses[player] = ownedPasses[player] or {}
		ownedPasses[player][key] = true
		local pass = Config.GamePasses[key]
		Services.Net.Notify(player, ("%s %s freigeschaltet! Danke ❤"):format(pass.Icon, pass.Name), "success", "Reward")
		Services.Net.Effect(player, "Confetti")
		Services.Net.Announce(("%s hat %s %s gekauft!"):format(player.DisplayName, pass.Icon, pass.Name), Color3.fromRGB(255, 215, 0))
		applyPassEffects(player)
	end)

	Players.PlayerMembershipStatusChanged:Connect(function(player)
		if Services.DataService.IsLoaded(player) then
			Services.BaseService.RenderAll(player)
			Services.StateService.MarkDirty(player)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		task.defer(function()
			ownedPasses[player] = nil
		end)
	end)
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	Net  (ModuleScript)  ->  ServerScriptService/Services/Net
	Erstellt alle Remotes und leitet Client-Anfragen an registrierte Handler weiter.
	Der Client darf nur Wünsche schicken, jede Aktion wird hier gefiltert:
	  - nur registrierte Aktionsnamen
	  - Rate-Limit pro Spieler und Aktion
	  - Fehler im Handler werden abgefangen
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}
local Services
local handlers = {}

local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not remotesFolder then
	remotesFolder = Instance.new("Folder")
	remotesFolder.Name = "Remotes"
	remotesFolder.Parent = ReplicatedStorage
end

local function remote(className, name)
	local existing = remotesFolder:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local r = Instance.new(className)
	r.Name = name
	r.Parent = remotesFolder
	return r
end

Net.StateUpdate = remote("RemoteEvent", "StateUpdate")
Net.NotifyEvent = remote("RemoteEvent", "Notify")
Net.AnnounceEvent = remote("RemoteEvent", "Announce")
Net.EffectEvent = remote("RemoteEvent", "Effect")
Net.Request = remote("RemoteFunction", "Request")

-- handler(player, payload) -> ok, message
function Net.Register(action, handler, maxPerSecond)
	handlers[action] = { Fn = handler, Max = maxPerSecond or 5 }
end

function Net.Notify(player, text, kind, sound, offer)
	Net.NotifyEvent:FireClient(player, text, kind or "info", sound, offer)
end

function Net.NotifyAll(text, kind, sound)
	Net.NotifyEvent:FireAllClients(text, kind or "info", sound)
end

function Net.Announce(text, color)
	Net.AnnounceEvent:FireAllClients(text, color or Color3.fromRGB(255, 220, 80))
end

function Net.Effect(player, kind, payload)
	Net.EffectEvent:FireClient(player, kind, payload)
end

function Net.EffectAll(kind, payload)
	Net.EffectEvent:FireAllClients(kind, payload)
end

function Net.Init(services)
	Services = services
end

function Net.Start()
	Net.Request.OnServerInvoke = function(player, action, payload)
		if type(action) ~= "string" then
			return false, "Ungültig"
		end
		local entry = handlers[action]
		if not entry then
			return false, "Unbekannte Aktion"
		end
		if not Services.RateLimit.Allow(player, "Req_" .. action, entry.Max, 1) then
			return false, "Langsamer!"
		end
		if not Services.DataService.Get(player) then
			return false, "Daten laden noch …"
		end
		local ok, result, message = pcall(entry.Fn, player, payload)
		if not ok then
			warn("[Net] Fehler in", action, result)
			return false, "Serverfehler"
		end
		return result, message
	end
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">RateLimit</string>
          <string name="Source"><![CDATA[--[[
	RateLimit  (ModuleScript)  ->  ServerScriptService/Services/RateLimit
	Begrenzt, wie oft ein Spieler eine Aktion pro Zeitfenster auslösen darf.
]]

local Players = game:GetService("Players")

local RateLimit = {}

local buckets = {} -- [player] = { [key] = { count, windowStart } }

function RateLimit.Allow(player, key, maxCount, window)
	local now = os.clock()
	local playerBuckets = buckets[player]
	if not playerBuckets then
		playerBuckets = {}
		buckets[player] = playerBuckets
	end
	local bucket = playerBuckets[key]
	if not bucket or now - bucket.Start >= window then
		playerBuckets[key] = { Count = 1, Start = now }
		return true
	end
	if bucket.Count >= maxCount then
		return false
	end
	bucket.Count += 1
	return true
end

function RateLimit.Start()
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

return RateLimit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">RebirthService</string>
          <string name="Source"><![CDATA[--[[
	RebirthService  (ModuleScript)  ->  ServerScriptService/Services/RebirthService
	Rebirth: Cash + Figuren zurücksetzen -> dauerhafter Einkommens-Multiplikator,
	+1 Slot (max. +5), längeres Schloss.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Figures = require(Shared:WaitForChild("Figures"))
local Format = require(Shared:WaitForChild("Format"))

local RebirthService = {}
local Services

function RebirthService.HasRequirement(data)
	local required = Config.Rarities[Config.RebirthRequirement(data.Rebirths)].Rank
	for _, slot in pairs(data.Slots) do
		if Figures.RarityRank(slot.Id) >= required then
			return true
		end
	end
	return false
end

function RebirthService.GetInfo(data)
	return {
		Cost = Config.RebirthCost(data.Rebirths),
		Requirement = Config.RebirthRequirement(data.Rebirths),
		HasRequirement = RebirthService.HasRequirement(data),
		CurrentMult = 1 + Config.Multipliers.RebirthPer * data.Rebirths,
		NextMult = 1 + Config.Multipliers.RebirthPer * (data.Rebirths + 1),
	}
end

local function doRebirth(player)
	local data = Services.DataService.Get(player)
	if not data then
		return false, "Daten fehlen"
	end
	local info = RebirthService.GetInfo(data)
	if data.Cash < info.Cost then
		return false, "Dir fehlen " .. Format.Money(info.Cost - data.Cash)
	end
	if not info.HasRequirement then
		return false, "Du brauchst mindestens eine " .. info.Requirement .. "-Figur in deiner Basis"
	end
	if Services.StealService.IsCarrying(player) then
		return false, "Bring erst deine Beute nach Hause"
	end

	Services.StealService.CancelForOwner(player, "Der Besitzer hat einen Rebirth gemacht")
	data.Rebirths += 1
	data.Cash = Config.StartCash
	data.Pending = 0
	data.Slots = {}

	Services.BaseService.RenderAll(player)
	Services.BaseService.UpdateCashPad(player, 0)
	Services.StateService.MarkDirty(player)
	Services.Net.Effect(player, "Rebirth", { Rebirths = data.Rebirths, Mult = info.NextMult })
	Services.Net.Notify(player, ("⭐ REBIRTH %d! Einkommen jetzt x%.1f"):format(data.Rebirths, info.NextMult), "success", "Rebirth")
	Services.Net.Announce(("⭐ %s hat REBIRTH %d erreicht!"):format(player.DisplayName, data.Rebirths), Color3.fromRGB(255, 220, 80))
	task.spawn(Services.DataService.Save, player)
	return true
end

function RebirthService.Init(services)
	Services = services
end

function RebirthService.Start()
	Services.Net.Register("Rebirth", doRebirth, 1)
end

return RebirthService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">RewardService</string>
          <string name="Source"><![CDATA[--[[
	RewardService  (ModuleScript)  ->  ServerScriptService/Services/RewardService
	Tägliche Belohnung (7-Tage-Serie), Tages-Quests, Spielzeit-Geschenke.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Figures = require(Shared:WaitForChild("Figures"))
local Format = require(Shared:WaitForChild("Format"))

local RewardService = {}
local Services

local sessionStart = {} -- [player] = os.clock()
local giftsClaimed = {} -- [player] = { [index] = true }

local function today()
	return math.floor(os.time() / 86400)
end

local function scaledCash(player, seconds, minimum)
	local rate = Services.IncomeService.GetRate(player)
	return math.max(minimum or 0, math.floor(rate * seconds))
end

local function giveCash(player, data, amount, reason)
	data.Cash += amount
	data.TotalEarned += amount
	Services.Net.Notify(player, ("%s: +%s"):format(reason, Format.Money(amount)), "success", "Reward")
end

local function giveBoost(player, data, seconds, reason)
	data.Boost2xUntil = math.max(os.time(), data.Boost2xUntil) + seconds
	Services.Net.Notify(player, ("%s: ⚡ 2x Cash für %s"):format(reason, Format.Time(seconds)), "success", "Reward")
end

------------------------------------------------------------------------
-- Tägliche Belohnung
------------------------------------------------------------------------
function RewardService.GetDailyInfo(data)
	local day = today()
	local canClaim = data.Daily.LastDay < day
	local streak = data.Daily.Streak
	if canClaim and data.Daily.LastDay ~= day - 1 then
		streak = 0 -- Serie gerissen, beginnt wieder bei Tag 1
	end
	local nextIndex = (streak % #Config.Daily) + 1
	return {
		CanClaim = canClaim,
		Streak = streak,
		NextIndex = nextIndex,
		SecondsUntilNext = (day + 1) * 86400 - os.time(),
	}
end

local function claimDaily(player)
	local data = Services.DataService.Get(player)
	local info = RewardService.GetDailyInfo(data)
	if not info.CanClaim then
		return false, "Morgen wieder!"
	end
	data.Daily.Streak = info.Streak + 1
	data.Daily.LastDay = today()

	local reward = Config.Daily[info.NextIndex]
	local vipMult = Services.MonetizationService.HasPass(player, "VIP") and 2 or 1
	local reason = "Tag " .. info.NextIndex
	if reward.Type == "Cash" then
		giveCash(player, data, scaledCash(player, reward.Seconds, reward.Min) * vipMult, reason)
	elseif reward.Type == "Boost" then
		giveBoost(player, data, reward.Seconds * vipMult, reason)
	elseif reward.Type == "Figure" then
		local list = Figures.ByRarity[reward.Rarity]
		local fig = list[math.random(1, #list)]
		local slot = Services.BaseService.GiveFigure(player, fig.Id, "Normal")
		if slot then
			Services.Net.Effect(player, "Reveal", { Id = fig.Id, Mut = "Normal", Text = "TAG 7 BELOHNUNG!" })
		else
			giveCash(player, data, fig.Price, reason .. " (Basis voll)")
		end
	end
	Services.Net.Effect(player, "Confetti")
	Services.StateService.MarkDirty(player)
	return true
end

------------------------------------------------------------------------
-- Quests
------------------------------------------------------------------------
local function ensureQuests(player, data)
	local day = today()
	if data.Quests.Day == day and #data.Quests.List > 0 then
		return
	end
	local random = Random.new(day * 1000 + player.UserId % 1000)
	local pool = table.clone(Config.QuestPool)
	local list = {}
	for _ = 1, math.min(Config.QuestsPerDay, #pool) do
		local quest = table.remove(pool, random:NextInteger(1, #pool))
		table.insert(list, { Key = quest.Key, Goal = quest.Goal, Progress = 0, Claimed = false })
	end
	data.Quests = { Day = day, List = list }
end

local function questDef(key)
	for _, quest in ipairs(Config.QuestPool) do
		if quest.Key == key then
			return quest
		end
	end
	return nil
end

function RewardService.GetQuests(player)
	local data = Services.DataService.Get(player)
	if not data then
		return {}
	end
	ensureQuests(player, data)
	local result = {}
	for i, quest in ipairs(data.Quests.List) do
		local def = questDef(quest.Key)
		if def then
			table.insert(result, {
				Index = i,
				Text = def.Text,
				Goal = quest.Goal,
				Progress = quest.Progress,
				Claimed = quest.Claimed,
				Reward = scaledCash(player, def.Seconds, def.Min),
			})
		end
	end
	return result
end

function RewardService.AddProgress(player, key, amount)
	local data = Services.DataService.Get(player)
	if not data then
		return
	end
	ensureQuests(player, data)
	for _, quest in ipairs(data.Quests.List) do
		if quest.Key == key and not quest.Claimed and quest.Progress < quest.Goal then
			quest.Progress = math.min(quest.Goal, quest.Progress + amount)
			if quest.Progress >= quest.Goal then
				Services.Net.Notify(player, "✅ Quest erledigt! Hol dir deine Belohnung.", "success", "Reward")
			end
			Services.StateService.MarkDirty(player)
		end
	end
end

local function claimQuest(player, index)
	local data = Services.DataService.Get(player)
	ensureQuests(player, data)
	index = tonumber(index)
	local quest = index and data.Quests.List[index]
	if not quest or quest.Claimed or quest.Progress < quest.Goal then
		return false, "Noch nicht fertig"
	end
	local def = questDef(quest.Key)
	quest.Claimed = true
	giveCash(player, data, scaledCash(player, def.Seconds, def.Min), "Quest")
	Services.StateService.MarkDirty(player)
	return true
end

------------------------------------------------------------------------
-- Spielzeit-Geschenke
------------------------------------------------------------------------
function RewardService.GetGifts(player)
	local start = sessionStart[player] or os.clock()
	local elapsed = os.clock() - start
	local claimed = giftsClaimed[player] or {}
	local result = {}
	for i, gift in ipairs(Config.PlaytimeGifts) do
		table.insert(result, {
			Index = i,
			Remaining = math.max(0, gift.Minutes * 60 - elapsed),
			Claimed = claimed[i] == true,
			Label = gift.Boost and ("⚡ 2x " .. Format.Time(gift.Boost)) or Format.Money(scaledCash(player, gift.Seconds, gift.Min)),
		})
	end
	return result
end

local function claimGift(player, index)
	index = tonumber(index)
	local gift = index and Config.PlaytimeGifts[index]
	if not gift then
		return false
	end
	local claimed = giftsClaimed[player]
	if not claimed or claimed[index] then
		return false, "Schon abgeholt"
	end
	if os.clock() - (sessionStart[player] or os.clock()) < gift.Minutes * 60 - 1 then
		return false, "Noch nicht bereit"
	end
	claimed[index] = true
	local data = Services.DataService.Get(player)
	if gift.Boost then
		giveBoost(player, data, gift.Boost, "Geschenk")
	else
		giveCash(player, data, scaledCash(player, gift.Seconds, gift.Min), "Geschenk")
	end
	Services.StateService.MarkDirty(player)
	return true
end

------------------------------------------------------------------------
function RewardService.Init(services)
	Services = services
end

function RewardService.Start()
	Services.Net.Register("ClaimDaily", claimDaily, 2)
	Services.Net.Register("ClaimQuest", claimQuest, 3)
	Services.Net.Register("ClaimGift", claimGift, 3)

	Services.DataService.OnLoaded(function(player, data)
		sessionStart[player] = os.clock()
		giftsClaimed[player] = {}
		ensureQuests(player, data)
	end)
	Players.PlayerRemoving:Connect(function(player)
		sessionStart[player] = nil
		giftsClaimed[player] = nil
	end)
end

return RewardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">StateService</string>
          <string name="Source"><![CDATA[--[[
	StateService  (ModuleScript)  ->  ServerScriptService/Services/StateService
	Baut den Zustand für die UI und schickt ihn an den Client, sobald sich etwas ändert.
	Der Client bekommt nur Anzeige-Daten; er kann damit nichts verändern.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Figures = require(Shared:WaitForChild("Figures"))

local StateService = {}
local Services

local dirty = {}
local joinClock = {}

function StateService.MarkDirty(player)
	dirty[player] = true
end

function StateService.Build(player)
	local data = Services.DataService.Get(player)
	if not data then
		return nil
	end
	local S = Services
	local slots = {}
	for i = 1, 21 do
		local slot = data.Slots[tostring(i)]
		local unlocked = S.BaseService.IsSlotUnlocked(player, i)
		table.insert(slots, {
			Index = i,
			Unlocked = unlocked,
			Id = slot and slot.Id or nil,
			Mut = slot and slot.Mut or nil,
			BeingStolen = slot and S.StealService.IsBeingStolen(player, i) or false,
		})
	end

	local index = {}
	for key in pairs(data.Index) do
		table.insert(index, key)
	end

	local mult, multParts = S.IncomeService.GetMultiplier(player)
	local indexBonus, indexCount = S.IncomeService.GetIndexBonus(data)
	local event = S.EventService.GetInfo()

	return {
		Cash = math.floor(data.Cash),
		Pending = math.floor(data.Pending),
		Rate = S.IncomeService.GetRate(player),
		BaseIncome = S.IncomeService.GetBaseIncome(data),
		Mult = mult,
		MultParts = multParts,
		TotalEarned = math.floor(data.TotalEarned),
		Rebirths = data.Rebirths,
		Rebirth = S.RebirthService.GetInfo(data),
		Slots = slots,
		Capacity = S.BaseService.GetCapacity(player),
		Index = index,
		IndexCount = indexCount,
		IndexBonus = indexBonus,
		Daily = S.RewardService.GetDailyInfo(data),
		Quests = S.RewardService.GetQuests(player),
		Gifts = S.RewardService.GetGifts(player),
		Passes = S.MonetizationService.GetOwnedPasses(player),
		Premium = S.MonetizationService.IsPremium(player),
		BoostRemaining = math.max(0, data.Boost2xUntil - os.time()),
		LuckRemaining = S.ConveyorService.GetLuckRemaining(),
		Lucky = S.ConveyorService.IsLucky(),
		LockRemaining = S.BaseService.GetLockRemaining(player),
		LockDuration = S.BaseService.GetLockDuration(player),
		Protection = S.StealService.GetProtectionRemaining(player),
		Carrying = S.StealService.IsCarrying(player),
		Event = event,
		StarterBought = data.StarterBought,
		OfflineReward = data.OfflineReward,
		SessionTime = os.clock() - (joinClock[player] or os.clock()),
		RobuxSpent = data.Stats.RobuxSpent,
		CashPacks = (function()
			local packs = {}
			for _, key in ipairs({ "CashSmall", "CashMedium", "CashLarge", "CashMega" }) do
				packs[key] = S.MonetizationService.CashPackAmount(player, Config.Products[key])
			end
			return packs
		end)(),
		FigureCount = Figures and #Figures.List or 0,
	}
end

function StateService.Init(services)
	Services = services
end

function StateService.Start()
	Services.Net.Register("GetState", function(player)
		return StateService.Build(player)
	end, 4)

	Services.DataService.OnLoaded(function(player)
		joinClock[player] = os.clock()
		dirty[player] = true
	end)
	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
		joinClock[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(0.25)
			for player in pairs(dirty) do
				dirty[player] = nil
				if player.Parent then
					local ok, state = pcall(StateService.Build, player)
					if ok and state then
						Services.Net.StateUpdate:FireClient(player, state)
					elseif not ok then
						warn("[StateService]", state)
					end
				end
			end
		end
	end)
end

return StateService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">StealService</string>
          <string name="Source"><![CDATA[--[[
	StealService  (ModuleScript)  ->  ServerScriptService/Services/StealService
	Diebstahl (ProximityPrompt halten -> Figur tragen -> in eigene Basis bringen),
	Verkaufen-Prompt für den Besitzer, Klatsche (Abwehr), Neuling-Schutz.
	Anti-Exploit: Haltezeit, Distanz, Cooldown, Geschwindigkeit beim Tragen.
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Figures = require(Shared:WaitForChild("Figures"))
local Format = require(Shared:WaitForChild("Format"))
local FigureBuilder = require(Shared:WaitForChild("FigureBuilder"))

local StealService = {}
local Services

local carrying = {} -- [thief] = carry entry
local beingStolen = {} -- [owner] = { [slot] = thief }
local stealCooldown = {} -- [thief] = os.clock()
local holdStart = {} -- [player] = { Prompt, Time }
local protectedUntil = {} -- [player] = os.clock()
local stunnedUntil = {} -- [player] = os.clock()
local bonkCooldown = {} -- [player] = os.clock()
local ignoreMoveUntil = {} -- [player] = os.clock()

local function getRoot(player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(player)
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

function StealService.IsCarrying(player)
	return carrying[player] ~= nil
end

function StealService.IsStunned(player)
	return (stunnedUntil[player] or 0) > os.clock()
end

function StealService.IsBeingStolen(owner, slot)
	local list = beingStolen[owner]
	return list ~= nil and list[slot] ~= nil
end

function StealService.GetProtectionRemaining(player)
	return math.max(0, (protectedUntil[player] or 0) - os.clock())
end

function StealService.NotifyTeleport(player)
	ignoreMoveUntil[player] = os.clock() + 1
	local entry = carrying[player]
	if entry then
		entry.LastPos = nil
	end
end

------------------------------------------------------------------------
-- Prompts an platzierten Figuren
------------------------------------------------------------------------
function StealService.AttachPrompts(model, owner, slot)
	local root = model.PrimaryPart
	local slotData = Services.DataService.Get(owner).Slots[tostring(slot)]
	if not slotData then
		return
	end

	local steal = Instance.new("ProximityPrompt")
	steal.Name = "StealPrompt"
	steal.ActionText = "Stehlen"
	steal.ObjectText = Figures.DisplayName(slotData.Id, slotData.Mut)
	steal.HoldDuration = Config.Steal.HoldTime
	steal.MaxActivationDistance = Config.Steal.PromptDistance
	steal.RequiresLineOfSight = false
	steal.KeyboardKeyCode = Enum.KeyCode.E
	steal:SetAttribute("OwnerId", owner.UserId)
	CollectionService:AddTag(steal, "StealPrompt")
	steal.PromptButtonHoldBegan:Connect(function(player)
		holdStart[player] = { Prompt = steal, Time = os.clock() }
	end)
	steal.Triggered:Connect(function(player)
		StealService.TryStart(player, owner, slot, steal)
	end)
	steal.Parent = root

	local sell = Instance.new("ProximityPrompt")
	sell.Name = "SellPrompt"
	sell.ActionText = "Verkaufen +" .. Format.Money(Figures.SellValue(slotData.Id, slotData.Mut))
	sell.ObjectText = Figures.DisplayName(slotData.Id, slotData.Mut)
	sell.HoldDuration = 0.6
	sell.MaxActivationDistance = 8
	sell.RequiresLineOfSight = false
	sell.KeyboardKeyCode = Enum.KeyCode.F
	sell:SetAttribute("OwnerId", owner.UserId)
	CollectionService:AddTag(sell, "OwnerOnlyPrompt")
	sell.Triggered:Connect(function(player)
		if player == owner then
			Services.BaseService.Sell(owner, slot)
		end
	end)
	sell.Parent = root
end

------------------------------------------------------------------------
-- Diebstahl starten
------------------------------------------------------------------------
local function carrySpeed(player)
	local mult = Services.MonetizationService.HasPass(player, "MasterThief") and Config.Steal.MasterCarrySpeedMult or Config.Steal.CarrySpeedMult
	return Services.BaseService.GetNormalWalkSpeed(player) * mult
end

function StealService.TryStart(thief, owner, slot, prompt)
	if thief == owner or not owner.Parent then
		return
	end
	if not Services.RateLimit.Allow(thief, "Steal", 2, 1) then
		return
	end
	local thiefData = Services.DataService.Get(thief)
	local ownerData = Services.DataService.Get(owner)
	if not thiefData or not ownerData then
		return
	end

	-- Haltezeit serverseitig prüfen (Exploiter könnten das Halten überspringen)
	local hold = holdStart[thief]
	holdStart[thief] = nil
	local required = Services.MonetizationService.HasPass(thief, "MasterThief") and Config.Steal.MasterHoldTime or Config.Steal.HoldTime
	if not hold or hold.Prompt ~= prompt or os.clock() - hold.Time < required - 0.35 then
		return
	end

	if carrying[thief] then
		Services.Net.Notify(thief, "Du trägst schon eine Figur!", "error", "Error")
		return
	end
	local cooldown = (stealCooldown[thief] or 0) - os.clock()
	if cooldown > 0 then
		Services.Net.Notify(thief, ("Warte noch %ds bis zum nächsten Diebstahl"):format(math.ceil(cooldown)), "error", "Error")
		return
	end
	if Services.BaseService.IsLocked(owner) then
		Services.Net.Notify(thief, "Diese Basis ist abgeschlossen!", "error", "Error")
		return
	end
	local protection = StealService.GetProtectionRemaining(owner)
	if protection > 0 then
		Services.Net.Notify(thief, ("🛡 %s hat noch %s Neuling-Schutz"):format(owner.DisplayName, Format.Time(protection)), "error", "Error")
		return
	end
	local slotData = ownerData.Slots[tostring(slot)]
	if not slotData or StealService.IsBeingStolen(owner, slot) then
		return
	end
	local root = getRoot(thief)
	local ownerBase = Services.BaseService.GetBase(owner)
	local figModel = ownerBase and ownerBase.Model and ownerBase.Model.Figures:FindFirstChild("Fig" .. slot)
	if not root or not figModel or not figModel.PrimaryPart or (root.Position - figModel.PrimaryPart.Position).Magnitude > Config.Steal.PromptDistance + 4 then
		return
	end
	if not Services.BaseService.FindFreeSlot(thief) then
		local offer = if Services.MonetizationService.HasPass(thief, "ExtraSlots") then nil else "ExtraSlots"
		Services.Net.Notify(thief, "Deine Basis ist voll! Verkaufe erst eine Figur.", "error", "Error", offer)
		return
	end

	-- Start
	protectedUntil[thief] = 0
	beingStolen[owner] = beingStolen[owner] or {}
	beingStolen[owner][slot] = thief

	local carryModel = FigureBuilder.Build(slotData.Id, slotData.Mut, { Mode = "Carry" })
	local character = thief.Character
	if carryModel then
		carryModel.Name = "CarriedFigure"
		carryModel:PivotTo(root.CFrame * CFrame.new(0, 4.5, 0))
		for _, part in ipairs(carryModel:GetDescendants()) do
			if part:IsA("BasePart") then
				part.Anchored = false
				part.Massless = true
				part.CanCollide = false
			end
		end
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = carryModel.PrimaryPart
		weld.Parent = carryModel.PrimaryPart
		carryModel.Parent = character
	end

	local tag = Instance.new("BillboardGui")
	tag.Name = "ThiefTag"
	tag.Size = UDim2.new(6, 0, 1.5, 0)
	tag.StudsOffset = Vector3.new(0, 7.5, 0)
	tag.AlwaysOnTop = true
	tag.MaxDistance = 200
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = "🦹 DIEB!"
	label.TextColor3 = Color3.fromRGB(255, 60, 60)
	label.TextStrokeTransparency = 0
	label.Parent = tag
	tag.Parent = root

	carrying[thief] = {
		Owner = owner,
		Slot = slot,
		Id = slotData.Id,
		Mut = slotData.Mut,
		Model = carryModel,
		Tag = tag,
		Started = os.clock(),
		LastPos = root.Position,
		LastTime = os.clock(),
	}
	thief:SetAttribute("Carrying", true)
	local humanoid = getHumanoid(thief)
	if humanoid then
		humanoid.WalkSpeed = carrySpeed(thief)
	end

	Services.BaseService.RenderSlot(owner, slot)
	local name = Figures.DisplayName(slotData.Id, slotData.Mut)
	Services.Net.Notify(thief, "Bring " .. name .. " schnell in DEINE Basis!", "warning", "Steal")
	Services.Net.Notify(owner, ("⚠ %s klaut deinen %s! Hau ihn mit der Klatsche!"):format(thief.DisplayName, name), "error", "Alarm")
	Services.Net.Effect(owner, "Alarm", { Thief = thief.DisplayName })
	Services.StateService.MarkDirty(thief)
end

------------------------------------------------------------------------
-- Diebstahl beenden
------------------------------------------------------------------------
local function cleanup(thief, entry)
	carrying[thief] = nil
	if entry.Model then
		entry.Model:Destroy()
	end
	if entry.Tag then
		entry.Tag:Destroy()
	end
	local list = beingStolen[entry.Owner]
	if list then
		list[entry.Slot] = nil
	end
	if thief.Parent then
		thief:SetAttribute("Carrying", false)
		Services.BaseService.ApplyWalkSpeed(thief)
		Services.StateService.MarkDirty(thief)
	end
end

function StealService.Fail(thief, reason)
	local entry = carrying[thief]
	if not entry then
		return
	end
	cleanup(thief, entry)
	if entry.Owner.Parent then
		Services.BaseService.RenderSlot(entry.Owner, entry.Slot)
	end
	if reason and thief.Parent then
		Services.Net.Notify(thief, "❌ Diebstahl gescheitert: " .. reason, "error", "Error")
	end
	stealCooldown[thief] = os.clock() + Config.Steal.Cooldown * 0.5
end

local function succeed(thief, entry)
	local owner = entry.Owner
	local ownerData = Services.DataService.Get(owner)
	local thiefData = Services.DataService.Get(thief)
	local current = ownerData and ownerData.Slots[tostring(entry.Slot)]
	if not thiefData or not current or current.Id ~= entry.Id or current.Mut ~= entry.Mut then
		StealService.Fail(thief, "Figur nicht mehr da")
		return
	end
	local newSlot = Services.BaseService.FindFreeSlot(thief)
	if not newSlot then
		StealService.Fail(thief, "Deine Basis ist voll")
		return
	end

	cleanup(thief, entry)
	ownerData.Slots[tostring(entry.Slot)] = nil
	thiefData.Slots[tostring(newSlot)] = { Id = entry.Id, Mut = entry.Mut }
	thiefData.Index[Figures.IndexKey(entry.Id, entry.Mut)] = true
	thiefData.Stats.Steals += 1
	stealCooldown[thief] = os.clock() + Config.Steal.Cooldown

	Services.BaseService.RenderSlot(owner, entry.Slot)
	Services.BaseService.RenderSlot(thief, newSlot)
	Services.RewardService.AddProgress(thief, "Steal", 1)
	Services.StateService.MarkDirty(owner)
	Services.StateService.MarkDirty(thief)

	local name = Figures.DisplayName(entry.Id, entry.Mut)
	Services.Net.Notify(thief, "🦹 Erfolgreich gestohlen: " .. name .. "!", "success", "Reward")
	Services.Net.Effect(thief, "Reveal", { Id = entry.Id, Mut = entry.Mut, Text = "GESTOHLEN!" })
	Services.Net.Notify(owner, ("😭 %s hat deinen %s gestohlen! Schließ deine Basis ab!"):format(thief.DisplayName, name), "error", "Alarm", "LockExtend")
	Services.AnnouncementService.Found(thief, entry.Id, entry.Mut, "von " .. owner.DisplayName .. " gestohlen")
end

function StealService.CancelForOwner(owner, reason)
	for thief, entry in pairs(carrying) do
		if entry.Owner == owner then
			StealService.Fail(thief, reason)
		end
	end
end

local function carryLoop()
	while true do
		task.wait(0.15)
		local nowTime = os.clock()
		for thief, entry in pairs(carrying) do
			local root = getRoot(thief)
			local humanoid = getHumanoid(thief)
			if not thief.Parent or not root or not humanoid or humanoid.Health <= 0 then
				StealService.Fail(thief, "Du bist gestorben")
			elseif not entry.Owner.Parent then
				StealService.Fail(thief, "Besitzer hat das Spiel verlassen")
			elseif nowTime - entry.Started > Config.Steal.MaxCarryTime then
				StealService.Fail(thief, "Zu langsam!")
			else
				-- Geschwindigkeits-Check (Speed-Hacks)
				if entry.LastPos and nowTime > (ignoreMoveUntil[thief] or 0) then
					local dt = nowTime - entry.LastTime
					local delta = root.Position - entry.LastPos
					local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
					if dt > 0 and horizontal / dt > humanoid.WalkSpeed * 1.6 + 10 then
						StealService.Fail(thief, "Unerlaubte Bewegung erkannt")
						continue
					end
				end
				entry.LastPos = root.Position
				entry.LastTime = nowTime
				if Services.BaseService.IsPlayerInOwnBase(thief) then
					succeed(thief, entry)
				end
			end
		end
	end
end

------------------------------------------------------------------------
-- Klatsche
------------------------------------------------------------------------
local function stun(target, seconds)
	stunnedUntil[target] = os.clock() + seconds
	local humanoid = getHumanoid(target)
	if humanoid then
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0
	end
	task.delay(seconds, function()
		if target.Parent and not StealService.IsStunned(target) then
			local h = getHumanoid(target)
			if h then
				h.JumpPower = 50
			end
			Services.BaseService.ApplyWalkSpeed(target)
		end
	end)
end

local function onBonk(player, tool)
	local nowTime = os.clock()
	if (bonkCooldown[player] or 0) > nowTime or StealService.IsStunned(player) then
		return
	end
	bonkCooldown[player] = nowTime + Config.Bonk.Cooldown

	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = "Slash"
	anim.Parent = tool
	game:GetService("Debris"):AddItem(anim, 1)

	local root = getRoot(player)
	if not root then
		return
	end
	local super = Services.MonetizationService.HasPass(player, "SuperBonk")
	local range = super and Config.Bonk.SuperRange or Config.Bonk.Range
	local stunTime = super and Config.Bonk.SuperStun or Config.Bonk.Stun

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local otherRoot = getRoot(other)
			if otherRoot then
				local offset = otherRoot.Position - root.Position
				local distance = offset.Magnitude
				local facing = distance < 4 or root.CFrame.LookVector:Dot(offset.Unit) > 0.2
				if distance <= range and facing then
					Services.RewardService.AddProgress(player, "Bonk", 1)
					Services.Net.Effect(other, "Bonked", { By = player.DisplayName })
					local entry = carrying[other]
					if entry then
						local name = Figures.DisplayName(entry.Id, entry.Mut)
						local ownerName = entry.Owner.DisplayName
						StealService.Fail(other, player.DisplayName .. " hat dich erwischt!")
						stun(other, stunTime)
						local data = Services.DataService.Get(player)
						if data then
							data.Stats.Defends += 1
						end
						Services.RewardService.AddProgress(player, "Defend", 1)
						Services.Net.Notify(player, "🛡 Dieb erwischt! " .. name .. " ist zurück bei " .. ownerName, "success", "Bonk")
						if entry.Owner ~= player and entry.Owner.Parent then
							Services.Net.Notify(entry.Owner, "🛡 " .. player.DisplayName .. " hat den Dieb erwischt!", "success", "Bonk")
						end
					end
				end
			end
		end
	end
end

local function watchCharacter(player, character)
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child.Name == "Klatsche" and not child:GetAttribute("Hooked") then
			child:SetAttribute("Hooked", true)
			child.Activated:Connect(function()
				if child.Parent == player.Character then
					onBonk(player, child)
				end
			end)
		end
	end)
end

------------------------------------------------------------------------
function StealService.Init(services)
	Services = services
end

function StealService.Start()
	Services.DataService.OnLoaded(function(player)
		protectedUntil[player] = os.clock() + Config.Steal.NewbieProtection
		if player.Character then
			watchCharacter(player, player.Character)
		end
		player.CharacterAdded:Connect(function(character)
			if carrying[player] then
				StealService.Fail(player, "Du bist gestorben")
			end
			watchCharacter(player, character)
		end)
	end)

	Services.DataService.OnReleasing(function(player)
		if carrying[player] then
			StealService.Fail(player, nil)
		end
		StealService.CancelForOwner(player, "Besitzer hat das Spiel verlassen")
	end)

	Players.PlayerRemoving:Connect(function(player)
		task.defer(function()
			beingStolen[player] = nil
			stealCooldown[player] = nil
			holdStart[player] = nil
			protectedUntil[player] = nil
			stunnedUntil[player] = nil
			bonkCooldown[player] = nil
			ignoreMoveUntil[player] = nil
		end)
	end)

	task.spawn(carryLoop)
end

return StealService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="24">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="ModuleScript" referent="25">
      <Properties>
        <string name="Name">SetupWorld</string>
        <string name="Source"><![CDATA[--[[
	SetupWorld  (ModuleScript)  ->  ServerStorage
	Baut die komplette Welt (Map, Förderband, 8 Plots, Basis-Vorlage,
	Leaderboards, Klatsche, Sounds, Licht, Ordner) automatisch auf.

	Ausführen (Studio, NICHT im Play-Modus):
		View -> Command Bar, dann eingeben:
		require(game.ServerStorage.SetupWorld)()

	Mehrfaches Ausführen ist erlaubt: alte Objekte werden ersetzt.
	Fehlt die Welt beim Spielstart, ruft ServerMain dieses Modul automatisch auf.
	Danach kann das Modul gelöscht werden (oder liegen bleiben, es läuft nie von selbst).
]]

local Workspace = game:GetService("Workspace")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local StarterPack = game:GetService("StarterPack")
local StarterPlayer = game:GetService("StarterPlayer")
local SoundService = game:GetService("SoundService")
local Lighting = game:GetService("Lighting")
local ChangeHistoryService = game:GetService("ChangeHistoryService")

-- Basis-Mittelpunkte: 4 Basen auf jeder Seite des Förderbands (Band liegt auf Z = 0)
local BASE_POSITIONS = {
	Vector3.new(-135, 0.5, -62), Vector3.new(-45, 0.5, -62),
	Vector3.new(45, 0.5, -62), Vector3.new(135, 0.5, -62),
	Vector3.new(-135, 0.5, 62), Vector3.new(-45, 0.5, 62),
	Vector3.new(45, 0.5, 62), Vector3.new(135, 0.5, 62),
}

local WHITE = Color3.new(1, 1, 1)
local INVISIBLE = { Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false }

local function replace(parent, className, name)
	local old = parent:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local inst = Instance.new(className)
	inst.Name = name
	inst.Parent = parent
	return inst
end

local function ensureFolder(parent, name)
	local f = parent:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = parent
	end
	return f
end

local function makePart(name, parent, size, cframe, color, material, props)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end

local function at(x, y, z)
	return CFrame.new(x, y, z)
end

local function makeLabel(parent, text, color)
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Parent = parent
	return label
end

local function billboard(parent, name, sizeStuds, offset, text, color)
	local gui = Instance.new("BillboardGui")
	gui.Name = name
	gui.Size = UDim2.new(sizeStuds.X, 0, sizeStuds.Y, 0)
	gui.StudsOffset = offset
	gui.MaxDistance = 150
	gui.LightInfluence = 0
	makeLabel(gui, text, color)
	gui.Parent = parent
	return gui
end

------------------------------------------------------------------------
-- Map
------------------------------------------------------------------------
local function buildMap()
	local oldBaseplate = Workspace:FindFirstChild("Baseplate")
	if oldBaseplate then
		oldBaseplate:Destroy()
	end
	local oldSpawn = Workspace:FindFirstChild("SpawnLocation")
	if oldSpawn then
		oldSpawn:Destroy()
	end

	local map = replace(Workspace, "Folder", "Map")
	makePart("Ground", map, Vector3.new(420, 2, 280), at(0, -1, 0), Color3.fromRGB(106, 190, 92), Enum.Material.Grass)
	makePart("Walkway", map, Vector3.new(200, 0.2, 46), at(0, 0.1, 0), Color3.fromRGB(235, 225, 200), Enum.Material.Concrete)

	-- Unsichtbare Weltgrenzen
	local h = 80
	makePart("BoundaryN", map, Vector3.new(420, h, 2), at(0, h / 2, 141), WHITE, nil, { Transparency = 1 })
	makePart("BoundaryS", map, Vector3.new(420, h, 2), at(0, h / 2, -141), WHITE, nil, { Transparency = 1 })
	makePart("BoundaryE", map, Vector3.new(2, h, 280), at(211, h / 2, 0), WHITE, nil, { Transparency = 1 })
	makePart("BoundaryW", map, Vector3.new(2, h, 280), at(-211, h / 2, 0), WHITE, nil, { Transparency = 1 })

	-- Fallback-Spawn (Spieler werden per Script in ihre Basis gesetzt)
	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name = "SpawnLocation"
	spawnLocation.Anchored = true
	spawnLocation.Size = Vector3.new(6, 1, 6)
	spawnLocation.CFrame = at(0, 0.6, -20)
	spawnLocation.Neutral = true
	spawnLocation.Duration = 0
	spawnLocation.Transparency = 0.5
	spawnLocation.Parent = Workspace

	ensureFolder(Workspace, "Bases")
	ensureFolder(Workspace, "ConveyorFigures")
end

------------------------------------------------------------------------
-- Förderband
------------------------------------------------------------------------
local function buildGate(parent, name, x, color, text)
	local gate = Instance.new("Model")
	gate.Name = name
	gate.Parent = parent
	makePart("PillarA", gate, Vector3.new(2, 14, 2), at(x, 7, -8), color, Enum.Material.Neon)
	makePart("PillarB", gate, Vector3.new(2, 14, 2), at(x, 7, 8), color, Enum.Material.Neon)
	local top = makePart("Top", gate, Vector3.new(2, 3, 18), at(x, 15.5, 0), color, Enum.Material.Neon)
	billboard(top, "GateGui", Vector2.new(14, 3), Vector3.new(0, 3.5, 0), text, WHITE)
end

local function buildConveyor()
	local conveyor = replace(Workspace, "Model", "Conveyor")
	local belt = makePart("Belt", conveyor, Vector3.new(180, 1, 12), at(0, 0.5, 0), Color3.fromRGB(45, 45, 52), Enum.Material.DiamondPlate)
	conveyor.PrimaryPart = belt

	local railColor = Color3.fromRGB(255, 200, 40)
	makePart("RailLeft", conveyor, Vector3.new(180, 1.6, 1), at(0, 1.3, -6.5), railColor, Enum.Material.Metal)
	makePart("RailRight", conveyor, Vector3.new(180, 1.6, 1), at(0, 1.3, 6.5), railColor, Enum.Material.Metal)

	local stripes = Instance.new("Folder")
	stripes.Name = "Stripes"
	stripes.Parent = conveyor
	for i = 0, 17 do
		makePart("Stripe", stripes, Vector3.new(1.5, 0.05, 10), at(-85 + i * 10, 1.03, 0), Color3.fromRGB(80, 80, 92), nil, { CanCollide = false, CanQuery = false, CanTouch = false })
	end

	makePart("StartPoint", conveyor, Vector3.new(2, 2, 2), at(-85, 1, 0), WHITE, nil, INVISIBLE)
	makePart("EndPoint", conveyor, Vector3.new(2, 2, 2), at(85, 1, 0), WHITE, nil, INVISIBLE)

	buildGate(conveyor, "SpawnGate", -92, Color3.fromRGB(166, 75, 255), "BRAINROT-FABRIK")
	buildGate(conveyor, "EndGate", 92, Color3.fromRGB(255, 60, 60), "LETZTE CHANCE!")
end

------------------------------------------------------------------------
-- Plots (Platzhalter, an denen die Basen zur Laufzeit erscheinen)
------------------------------------------------------------------------
local function buildPlots()
	local plots = replace(Workspace, "Folder", "Plots")
	for i, pos in ipairs(BASE_POSITIONS) do
		local lookTarget = Vector3.new(pos.X, pos.Y, 0) -- Tür zeigt zum Band
		local plot = makePart("Plot" .. i, plots, Vector3.new(80, 1, 60), CFrame.lookAt(pos, lookTarget), WHITE, nil, INVISIBLE)
		plot:SetAttribute("PlotIndex", i)
	end
end

------------------------------------------------------------------------
-- Basis-Vorlage (ServerStorage.BaseTemplate)
-- Lokales Koordinatensystem: Tür bei Z = -30 (Vorderseite = LookVector)
------------------------------------------------------------------------
local function buildBaseTemplate()
	local base = replace(ServerStorage, "Model", "BaseTemplate")

	local floor = makePart("Floor", base, Vector3.new(80, 1, 60), at(0, 0.5, 0), Color3.fromRGB(200, 200, 210))
	base.PrimaryPart = floor

	local walls = Instance.new("Folder")
	walls.Name = "Walls"
	walls.Parent = base
	local wallColor = Color3.fromRGB(240, 240, 245)
	makePart("BackWall", walls, Vector3.new(80, 10, 1), at(0, 6, 29.5), wallColor)
	makePart("LeftWall", walls, Vector3.new(1, 10, 60), at(-39.5, 6, 0), wallColor)
	makePart("RightWall", walls, Vector3.new(1, 10, 60), at(39.5, 6, 0), wallColor)
	makePart("FrontLeftWall", walls, Vector3.new(30, 10, 1), at(-25, 6, -29.5), wallColor)
	makePart("FrontRightWall", walls, Vector3.new(30, 10, 1), at(25, 6, -29.5), wallColor)
	makePart("DoorBeam", walls, Vector3.new(20, 2, 1), at(0, 12, -29.5), wallColor)

	-- Laser-Tür (unsichtbar = offen; der Server macht sie beim Abschließen sichtbar)
	local door = makePart("LaserDoor", base, Vector3.new(20, 10, 0.4), at(0, 6, -29.5), Color3.fromRGB(255, 40, 40), Enum.Material.Neon, {
		Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false,
	})
	local doorGui = billboard(door, "DoorGui", Vector2.new(8, 3), Vector3.new(0, 0, 0), "🔒 60", WHITE)
	doorGui.Enabled = false

	-- Besitzer-Schild über der Tür
	local sign = makePart("Sign", base, Vector3.new(24, 5, 0.6), at(0, 15.5, -29.5), Color3.fromRGB(30, 30, 40))
	local signGui = Instance.new("SurfaceGui")
	signGui.Name = "SignGui"
	signGui.Face = Enum.NormalId.Front
	signGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	signGui.PixelsPerStud = 40
	signGui.LightInfluence = 0
	signGui.Parent = sign
	makeLabel(signGui, "Freie Basis", WHITE)

	-- Slots 1-10 (Start), 11-15 (Rebirth), 16-20 (Game Pass), 21 (Premium)
	local slots = Instance.new("Folder")
	slots.Name = "Slots"
	slots.Parent = base
	for i = 1, 20 do
		local row = (i <= 10) and 0 or 1
		local col = (i - 1) % 10
		local slot = makePart("Slot" .. i, slots, Vector3.new(5, 0.4, 5), at(-31.5 + col * 7, 1.2, 6 + row * 13), WHITE)
		slot:SetAttribute("SlotIndex", i)
	end
	local premiumSlot = makePart("Slot21", slots, Vector3.new(5, 0.4, 5), at(0, 1.2, -4), Color3.fromRGB(255, 215, 0), Enum.Material.Neon)
	premiumSlot:SetAttribute("SlotIndex", 21)
	premiumSlot:SetAttribute("Premium", true)

	-- Cash-Pad (drüberlaufen = einsammeln)
	local cashPad = makePart("CashPad", base, Vector3.new(8, 0.4, 8), at(-28, 1.2, -18), Color3.fromRGB(60, 220, 90), Enum.Material.Neon)
	billboard(cashPad, "CashGui", Vector2.new(10, 3), Vector3.new(0, 3, 0), "$0", Color3.fromRGB(120, 255, 140))

	-- Schloss-Knopf
	local lockButton = makePart("LockButton", base, Vector3.new(5, 0.6, 5), at(28, 1.3, -18), Color3.fromRGB(255, 60, 60), Enum.Material.Neon)
	billboard(lockButton, "LockGui", Vector2.new(10, 3), Vector3.new(0, 3, 0), "🔓 Abschließen", WHITE)

	makePart("SpawnPoint", base, Vector3.new(4, 1, 4), at(0, 1.5, -12), WHITE, nil, INVISIBLE)
	makePart("Zone", base, Vector3.new(78, 16, 58), at(0, 9, 0), WHITE, nil, INVISIBLE)
end

------------------------------------------------------------------------
-- Leaderboards
------------------------------------------------------------------------
local function buildBoard(parent, name, x, face, title)
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent

	local dark = Color3.fromRGB(25, 25, 35)
	local screen = makePart("Screen", model, Vector3.new(1, 16, 26), at(x, 11, 0), dark)
	makePart("PostA", model, Vector3.new(1.2, 3, 1.2), at(x, 1.5, -10), dark, Enum.Material.Metal)
	makePart("PostB", model, Vector3.new(1.2, 3, 1.2), at(x, 1.5, 10), dark, Enum.Material.Metal)

	local gui = Instance.new("SurfaceGui")
	gui.Name = "BoardGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Parent = screen

	local titleLabel = makeLabel(gui, title, Color3.fromRGB(255, 220, 80))
	titleLabel.Name = "Title"
	titleLabel.Size = UDim2.fromScale(1, 0.12)

	local list = Instance.new("Frame")
	list.Name = "List"
	list.BackgroundTransparency = 1
	list.Position = UDim2.fromScale(0.03, 0.14)
	list.Size = UDim2.fromScale(0.94, 0.84)
	list.Parent = gui

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0.005, 0)
	layout.Parent = list
end

local function buildLeaderboards()
	local boards = replace(Workspace, "Folder", "Leaderboards")
	buildBoard(boards, "CashBoard", -112, Enum.NormalId.Right, "💰 Meistes Cash (gesamt)")
	buildBoard(boards, "RebirthBoard", 112, Enum.NormalId.Left, "⭐ Meiste Rebirths")
end

------------------------------------------------------------------------
-- Beschriftungen: Schild über dem Band, Spielanleitung, Chancen-Tafel
------------------------------------------------------------------------
local function surfaceText(part, face, lines, ppS)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "BoardGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = ppS or 30
	gui.LightInfluence = 0
	gui.Parent = part
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0.01, 0)
	layout.Parent = gui
	for i, line in ipairs(lines) do
		local label = Instance.new("TextLabel")
		label.LayoutOrder = i
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(0.94, line.H or 0.1)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.Text = line.Text
		label.TextColor3 = line.Color or WHITE
		label.TextStrokeTransparency = 0
		label.TextXAlignment = line.Left and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center
		label.Parent = gui
	end
	return gui
end

local function buildSigns()
	local signs = replace(Workspace, "Folder", "Signs")
	local dark = Color3.fromRGB(28, 22, 48)

	-- Großes Schild über dem Förderband (beidseitig)
	local banner = makePart("ConveyorBanner", signs, Vector3.new(44, 8, 1), at(0, 22, 0), dark)
	local bannerLines = {
		{ Text = "🛒 KAUFE FIGUREN VOM BAND!", Color = Color3.fromRGB(255, 220, 80), H = 0.5 },
		{ Text = "E drücken oder antippen  ·  je seltener, desto mehr Cash", H = 0.3 },
	}
	surfaceText(banner, Enum.NormalId.Front, bannerLines, 20)
	surfaceText(banner, Enum.NormalId.Back, bannerLines, 20)
	for _, x in ipairs({ -20, 20 }) do
		makePart("BannerPole", signs, Vector3.new(0.6, 18, 0.6), at(x, 9, 7.5), Color3.fromRGB(255, 200, 40), Enum.Material.Metal)
		makePart("BannerPole", signs, Vector3.new(0.6, 18, 0.6), at(x, 9, -7.5), Color3.fromRGB(255, 200, 40), Enum.Material.Metal)
		makePart("BannerBeam", signs, Vector3.new(0.6, 0.6, 15.6), at(x, 18, 0), Color3.fromRGB(255, 200, 40), Enum.Material.Metal)
	end

	-- Spielanleitung (links, schaut zur Mitte)
	local rules = makePart("RulesBoard", signs, Vector3.new(1, 18, 24), at(-150, 11, 0), dark)
	makePart("RulesPost", signs, Vector3.new(1.2, 2, 1.2), at(-150, 1, 0), dark, Enum.Material.Metal)
	surfaceText(rules, Enum.NormalId.Right, {
		{ Text = "📖 SO SPIELST DU", Color = Color3.fromRGB(255, 220, 80), H = 0.12 },
		{ Text = "1. Kauf Figuren am Förderband", Left = true, H = 0.08 },
		{ Text = "2. Sie bringen dir jede Sekunde Cash", Left = true, H = 0.08 },
		{ Text = "3. Lauf übers GRÜNE Feld = Cash einsammeln", Left = true, H = 0.08 },
		{ Text = "4. ROTER Knopf = Basis abschließen", Left = true, H = 0.08 },
		{ Text = "5. Stiehl bei anderen: E halten, heimrennen!", Left = true, H = 0.08 },
		{ Text = "6. Diebe mit der Klatsche hauen (Taste 1)", Left = true, H = 0.08 },
		{ Text = "7. Rebirth = dauerhaft mehr Cash", Left = true, H = 0.08 },
		{ Text = "🎉 Wochenende: 2x CASH!", Color = Color3.fromRGB(255, 120, 220), H = 0.09 },
	}, 24)

	-- Chancen-Tafel (rechts, schaut zur Mitte)
	local chances = makePart("ChancesBoard", signs, Vector3.new(1, 18, 24), at(150, 11, 0), dark)
	makePart("ChancesPost", signs, Vector3.new(1.2, 2, 1.2), at(150, 1, 0), dark, Enum.Material.Metal)
	surfaceText(chances, Enum.NormalId.Left, {
		{ Text = "🎲 CHANCEN AUF DEM BAND", Color = Color3.fromRGB(255, 220, 80), H = 0.12 },
		{ Text = "Common  62 %", Color = Color3.fromRGB(190, 190, 190), H = 0.08 },
		{ Text = "Rare  25 %", Color = Color3.fromRGB(60, 140, 255), H = 0.08 },
		{ Text = "Epic  9 %", Color = Color3.fromRGB(166, 75, 255), H = 0.08 },
		{ Text = "Legendary  3,2 %", Color = Color3.fromRGB(255, 180, 0), H = 0.08 },
		{ Text = "Mythic  0,7 %", Color = Color3.fromRGB(255, 60, 60), H = 0.08 },
		{ Text = "SECRET  0,1 %", Color = Color3.fromRGB(255, 120, 220), H = 0.08 },
		{ Text = "Mutation: Gold 4 % · Diamant 1 % · Regenbogen 0,2 %", H = 0.07 },
		{ Text = "🍀 Jeden Abend Happy Hour: bessere Chancen!", Color = Color3.fromRGB(90, 255, 120), H = 0.07 },
	}, 24)
end

------------------------------------------------------------------------
-- Klatsche (Abwehr-Tool, jeder Spieler bekommt sie)
------------------------------------------------------------------------
local function buildTool()
	local tool = replace(StarterPack, "Tool", "Klatsche")
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = "Triff Diebe!"
	tool.Grip = CFrame.new(0, -1.2, 0)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.4, 3.2, 0.4)
	handle.Color = Color3.fromRGB(150, 100, 60)
	handle.Material = Enum.Material.Wood
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(2.6, 2.6, 0.3)
	head.Color = Color3.fromRGB(255, 90, 170)
	head.Material = Enum.Material.SmoothPlastic
	head.CanCollide = false
	head.Massless = true
	head.CFrame = handle.CFrame * CFrame.new(0, 2.9, 0)
	head.Parent = tool

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = head
	weld.Parent = handle
end

------------------------------------------------------------------------
-- Sounds (SoundId später aus der Roblox-Audio-Bibliothek eintragen)
------------------------------------------------------------------------
local function buildSounds()
	local sfx = ensureFolder(SoundService, "Sfx")
	local names = {
		"Buy", "Sell", "Cash", "Steal", "Alarm", "Bonk", "Lock", "Unlock",
		"Rebirth", "Rare", "Legendary", "Secret", "Click", "Error", "Reward",
	}
	for _, name in ipairs(names) do
		if not sfx:FindFirstChild(name) then
			local s = Instance.new("Sound")
			s.Name = name
			s.Volume = 0.6
			s.Parent = sfx
		end
	end
	if not SoundService:FindFirstChild("Music") then
		local music = Instance.new("Sound")
		music.Name = "Music"
		music.Looped = true
		music.Volume = 0.25
		music.Parent = SoundService
	end
end

------------------------------------------------------------------------
-- Licht und Look (bunt, freundlich, "Brainrot")
------------------------------------------------------------------------
local function buildLighting()
	Lighting.ClockTime = 14
	Lighting.Brightness = 2.5
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 155)
	Lighting.GlobalShadows = true

	local cc = replace(Lighting, "ColorCorrectionEffect", "Vibe")
	cc.Saturation = 0.2
	cc.Contrast = 0.05

	local bloom = replace(Lighting, "BloomEffect", "Glow")
	bloom.Intensity = 0.4
	bloom.Size = 24
	bloom.Threshold = 1.5

	local atmosphere = replace(Lighting, "Atmosphere", "Air")
	atmosphere.Density = 0.25
	atmosphere.Haze = 0.5
	atmosphere.Color = Color3.fromRGB(200, 220, 255)
end

------------------------------------------------------------------------
-- Ordner für die Scripts aus Phase 3
------------------------------------------------------------------------
local function buildFolders()
	ensureFolder(ReplicatedStorage, "Shared")
	ensureFolder(ReplicatedStorage, "FigureModels")
	ensureFolder(ReplicatedStorage, "Remotes")
	ensureFolder(ServerScriptService, "Services")
	ensureFolder(StarterPlayer:WaitForChild("StarterPlayerScripts"), "ClientModules")
	pcall(function()
		Workspace.StreamingEnabled = false -- geht nur im Editor, im laufenden Spiel ignoriert
	end)
end

return function()
	buildMap()
	buildConveyor()
	buildPlots()
	buildBaseTemplate()
	buildLeaderboards()
	buildSigns()
	buildTool()
	buildSounds()
	buildLighting()
	buildFolders()
	pcall(function()
		ChangeHistoryService:SetWaypoint("Brainrot Setup")
	end)
	print("✅ Brainrot-Welt aufgebaut! Basis-Vorlage liegt in ServerStorage.BaseTemplate.")
end
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="26">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="27">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="28">
        <Properties>
          <string name="Name">ClientMain</string>
          <string name="Source"><![CDATA[--[[
	ClientMain  (LocalScript)  ->  StarterPlayer/StarterPlayerScripts/ClientMain
	Baut die UI, verbindet die Remotes und verteilt den Zustand an alle UI-Module.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local modules = script.Parent:WaitForChild("ClientModules")
local UIKit = require(modules:WaitForChild("UIKit"))
local Notify = require(modules:WaitForChild("Notify"))
local HUD = require(modules:WaitForChild("HUD"))
local Menus = require(modules:WaitForChild("Menus"))
local World = require(modules:WaitForChild("World"))
local Tutorial = require(modules:WaitForChild("Tutorial"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local StateUpdate = Remotes:WaitForChild("StateUpdate")
local NotifyEvent = Remotes:WaitForChild("Notify")
local AnnounceEvent = Remotes:WaitForChild("Announce")
local EffectEvent = Remotes:WaitForChild("Effect")
local Request = Remotes:WaitForChild("Request")

------------------------------------------------------------------------
-- ScreenGui + Skalierung (Design-Auflösung 1280x720)
------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "MainGui"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local uiScale = Instance.new("UIScale")
uiScale.Parent = gui
local function updateScale()
	local viewport = Workspace.CurrentCamera.ViewportSize
	uiScale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.5, 1.4)
end
updateScale()
Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)

------------------------------------------------------------------------
-- App: gemeinsamer Kontext für alle Module
------------------------------------------------------------------------
local App = {
	Gui = gui,
	State = nil,
	Menus = Menus,
	Notify = Notify,
}

local priceCache = {}

function App.Sound(name)
	local sfx = SoundService:FindFirstChild("Sfx")
	local sound = name and sfx and sfx:FindFirstChild(name)
	if sound and sound.SoundId ~= "" then
		SoundService:PlayLocalSound(sound)
	end
end

function App.OfferInfo(key)
	local def = Config.GamePasses[key] or Config.Products[key]
	if not def then
		return nil
	end
	return {
		Icon = def.Icon,
		Short = def.Name,
		Price = priceCache[key] or def.Price,
	}
end

function App.Buy(key)
	local pass = Config.GamePasses[key]
	local product = Config.Products[key]
	local id = (pass and pass.Id) or (product and product.Id) or 0
	if id == 0 then
		Notify.Toast("Dieses Angebot ist noch nicht eingerichtet (ID in Config fehlt).", "error")
		return
	end
	if pass then
		MarketplaceService:PromptGamePassPurchase(player, id)
	else
		MarketplaceService:PromptProductPurchase(player, id)
	end
end

function App.Request(action, payload)
	local ok, result, message = pcall(Request.InvokeServer, Request, action, payload)
	if not ok then
		return false
	end
	if result == false and message then
		Notify.Toast(message, "error")
		App.Sound("Error")
	end
	return result, message
end

-- Echte Preise aus dem Creator Dashboard laden (falls geändert)
task.spawn(function()
	for key, pass in pairs(Config.GamePasses) do
		if pass.Id > 0 then
			local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, pass.Id, Enum.InfoType.GamePass)
			if ok and info and info.PriceInRobux then
				priceCache[key] = info.PriceInRobux
			end
		end
	end
	for key, product in pairs(Config.Products) do
		if product.Id > 0 then
			local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, product.Id, Enum.InfoType.Product)
			if ok and info and info.PriceInRobux then
				priceCache[key] = info.PriceInRobux
			end
		end
	end
end)

UIKit.OnClick = function()
	App.Sound("Click")
end

Notify.Init(App)
HUD.Init(App)
Menus.Init(App)
World.Init(App)
Tutorial.Init(App)

------------------------------------------------------------------------
-- Zustand
------------------------------------------------------------------------
local starterShown = false
local favoriteShown = false

local function onState(state)
	App.State = state
	HUD.Update(state)
	Menus.Update(state)
	World.Update(state)
	Tutorial.Update(state)

	if not starterShown and not state.StarterBought and state.SessionTime >= Config.StarterOfferAfter then
		starterShown = true
		Menus.ShowStarterOffer()
	end
	if not favoriteShown and state.SessionTime >= Config.FavoriteHintAfter then
		favoriteShown = true
		Notify.Toast("Gefällt dir Brainrot Bandits? Drück ⭐ Favorit und 👍, damit du uns wiederfindest!", "info")
	end
end

StateUpdate.OnClientEvent:Connect(onState)
NotifyEvent.OnClientEvent:Connect(function(text, kind, sound, offer)
	Notify.Toast(text, kind, offer)
	App.Sound(sound)
	if kind == "cash" then
		Tutorial.OnCashCollected()
	end
end)
AnnounceEvent.OnClientEvent:Connect(function(text, color)
	Notify.Announce(text, color)
end)
EffectEvent.OnClientEvent:Connect(function(kind, payload)
	Notify.Effect(kind, payload)
end)

-- Erster Zustand (Server lädt evtl. noch)
task.spawn(function()
	for _ = 1, 60 do
		if App.State then
			return
		end
		local ok, state = pcall(Request.InvokeServer, Request, "GetState")
		if ok and type(state) == "table" then
			onState(state)
			return
		end
		task.wait(1)
	end
end)

Notify.Toast("Willkommen bei " .. Config.GameName .. "! Kauf Figuren am Förderband 💰", "info")
print("✅ Client bereit", Format.Money(0))
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="29">
        <Properties>
          <string name="Name">ClientModules</string>
        </Properties>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[--[[
	HUD  (ModuleScript)  ->  StarterPlayer/StarterPlayerScripts/ClientModules/HUD
	Dauerhaft sichtbare Anzeige: Cash, Einkommen, Menü-Buttons, Schloss,
	Boosts/Events, Spielzeit-Geschenk, Freunde einladen.
	Alles in großen Buttons (mobilfreundlich), skaliert per UIScale.
]]

local Players = game:GetService("Players")
local SocialService = game:GetService("SocialService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))

local UIKit = require(script.Parent:WaitForChild("UIKit"))
local C = UIKit.Colors

local HUD = {}
local App
local refs = {}

local function sideButton(parent, order, icon, text, color, onClick)
	local button = UIKit.button({
		Size = UDim2.fromOffset(92, 80),
		LayoutOrder = order,
		Color = color,
		Text = "",
		Parent = parent,
	}, onClick)
	UIKit.label({ Size = UDim2.new(1, 0, 0.62, 0), Text = icon, TextStrokeTransparency = 1, MaxText = 38, Parent = button })
	UIKit.label({ Size = UDim2.new(1, 0, 0.36, 0), Position = UDim2.fromScale(0, 0.64), Text = text, MaxText = 18, Parent = button })
	return button, UIKit.badge(button)
end

function HUD.Init(app)
	App = app
	local gui = app.Gui

	-- Cash-Anzeige (oben Mitte)
	local cashFrame = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(330, 80),
		BackgroundColor3 = C.Panel,
		Parent = gui,
	})
	UIKit.corner(cashFrame, 16)
	UIKit.stroke(cashFrame, C.Dark, 4)
	refs.Cash = UIKit.label({ Size = UDim2.new(1, -70, 0.62, 0), Position = UDim2.fromOffset(10, 2), Text = "$0", TextColor3 = Color3.fromRGB(120, 255, 140), MaxText = 44, Parent = cashFrame })
	refs.Rate = UIKit.label({ Size = UDim2.new(1, -70, 0.34, 0), Position = UDim2.new(0, 10, 0.62, 0), Text = "+$0/s", TextColor3 = Color3.fromRGB(255, 230, 90), MaxText = 22, Parent = cashFrame })
	UIKit.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(54, 54),
		Color = C.Robux,
		Text = "+",
		MaxText = 40,
		Parent = cashFrame,
	}, function()
		App.Menus.Open("Shop", "Cash")
	end)

	-- Linke Menüleiste
	local left = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(92, 520),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	UIKit.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center, Parent = left })
	local shopButton
	shopButton, refs.ShopBadge = sideButton(left, 1, "🛒", "Shop", C.Robux, function()
		App.Menus.Open("Shop")
	end)
	UIKit.pulse(shopButton)
	local _
	_, refs.BaseBadge = sideButton(left, 2, "🎒", "Basis", C.Blue, function()
		App.Menus.Open("Base")
	end)
	_, refs.RebirthBadge = sideButton(left, 3, "⭐", "Rebirth", C.Purple, function()
		App.Menus.Open("Rebirth")
	end)
	_, refs.DailyBadge = sideButton(left, 4, "🎁", "Täglich", C.Pink, function()
		App.Menus.Open("Daily")
	end)
	_, refs.QuestBadge = sideButton(left, 5, "📜", "Quests", Color3.fromRGB(230, 130, 40), function()
		App.Menus.Open("Quests")
	end)
	sideButton(left, 6, "👥", "+10%", Color3.fromRGB(90, 90, 120), function()
		pcall(SocialService.PromptGameInvite, SocialService, Players.LocalPlayer)
	end)

	-- Rechte Seite: Schloss + Schloss-Verlängerung + Geschenk
	local right = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.42, 0),
		Size = UDim2.fromOffset(150, 300),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	UIKit.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center, Parent = right })

	refs.Lock = UIKit.button({ Size = UDim2.fromOffset(150, 70), LayoutOrder = 1, Color = C.Red, Text = "🔓 Abschließen", MaxText = 26, Parent = right }, function()
		App.Request("ToggleLock")
	end)
	refs.LockExtend = UIKit.button({ Size = UDim2.fromOffset(150, 46), LayoutOrder = 2, Color = C.Robux, Text = "🔐 +5 Min", MaxText = 22, Parent = right }, function()
		App.Buy("LockExtend")
	end)
	refs.Gift = UIKit.button({ Size = UDim2.fromOffset(150, 60), LayoutOrder = 3, Color = C.Pink, Text = "🎁 2:00", MaxText = 24, Parent = right }, function()
		App.Menus.Open("Daily")
	end)
	refs.Boost = UIKit.button({ Size = UDim2.fromOffset(150, 52), LayoutOrder = 4, Color = C.Accent, Text = "⚡ 2x Cash", MaxText = 22, Parent = right }, function()
		App.Buy("Boost2x")
	end)

	-- Status-Chips (Boosts, Events, Schutz) oben rechts
	refs.Chips = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.fromOffset(300, 200),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	UIKit.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right, Parent = refs.Chips })
end

local function setChips(chips)
	local key = table.concat(chips, "|")
	if refs.ChipKey == key then
		return
	end
	refs.ChipKey = key
	UIKit.clear(refs.Chips)
	for i, text in ipairs(chips) do
		local chip = UIKit.label({
			Size = UDim2.fromOffset(300, 32),
			LayoutOrder = i,
			Text = text,
			BackgroundTransparency = 0.15,
			BackgroundColor3 = C.Panel,
			MaxText = 20,
			Parent = refs.Chips,
		})
		UIKit.corner(chip, 10)
	end
end

function HUD.Update(state)
	refs.Cash.Text = Format.Money(state.Cash)
	refs.Rate.Text = "+" .. Format.Money(state.Rate) .. "/s"

	-- Schloss
	if state.LockRemaining > 0 then
		refs.Lock.Text = "🔒 " .. Format.Time(state.LockRemaining)
		refs.Lock.BackgroundColor3 = C.Green
	else
		refs.Lock.Text = "🔓 Abschließen"
		refs.Lock.BackgroundColor3 = C.Red
	end

	-- Boost-Button zeigt laufenden Boost oder lädt zum Kauf ein
	if state.BoostRemaining > 0 then
		refs.Boost.Text = "⚡ 2x " .. Format.Time(state.BoostRemaining)
	else
		refs.Boost.Text = "⚡ 2x Cash kaufen"
	end

	-- Nächstes Spielzeit-Geschenk
	local nextGift
	local ready = false
	for _, gift in ipairs(state.Gifts) do
		if not gift.Claimed then
			if gift.Remaining <= 0 then
				ready = true
				break
			end
			nextGift = nextGift or gift
		end
	end
	if ready then
		refs.Gift.Text = "🎁 Abholen!"
		refs.Gift.BackgroundColor3 = C.Green
	elseif nextGift then
		refs.Gift.Text = "🎁 " .. Format.Time(nextGift.Remaining)
		refs.Gift.BackgroundColor3 = C.Pink
	else
		refs.Gift.Text = "🎁 Alle geholt"
		refs.Gift.BackgroundColor3 = Color3.fromRGB(90, 90, 120)
	end

	-- Badges
	refs.DailyBadge.Visible = state.Daily.CanClaim or ready
	local questReady = false
	for _, quest in ipairs(state.Quests) do
		if not quest.Claimed and quest.Progress >= quest.Goal then
			questReady = true
		end
	end
	refs.QuestBadge.Visible = questReady
	refs.RebirthBadge.Visible = state.Cash >= state.Rebirth.Cost and state.Rebirth.HasRequirement
	refs.ShopBadge.Visible = not state.StarterBought
	local used = 0
	for _, slot in ipairs(state.Slots) do
		if slot.Id then
			used += 1
		end
	end
	refs.BaseBadge.Visible = used >= state.Capacity

	-- Chips
	local chips = {}
	if state.Protection > 0 then
		table.insert(chips, "🛡 Neuling-Schutz " .. Format.Time(state.Protection))
	end
	if state.LuckRemaining > 0 then
		table.insert(chips, "🍀 Lucky Spawn " .. Format.Time(state.LuckRemaining))
	end
	for _, name in ipairs(state.Event.Names) do
		table.insert(chips, name)
	end
	if state.Mult > 1 then
		table.insert(chips, ("📈 Multiplikator x%.2f"):format(state.Mult))
	end
	if state.Carrying then
		table.insert(chips, "🦹 Bring die Figur in DEINE Basis!")
	end
	setChips(chips)
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Menus</string>
            <string name="Source"><![CDATA[--[[
	Menus  (ModuleScript)  ->  StarterPlayer/StarterPlayerScripts/ClientModules/Menus
	Shop, Basis/Inventar + Index, Rebirth, Tägliche Belohnung + Geschenke, Quests
	sowie die Popups "Willkommen zurück" und "Starter-Paket".
	Panels werden nur neu gebaut, wenn sich ihr Inhalt ändert (sonst nur Timer/Texte),
	damit Buttons beim Antippen nicht verschwinden.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Figures = require(Shared:WaitForChild("Figures"))
local Format = require(Shared:WaitForChild("Format"))

local UIKit = require(script.Parent:WaitForChild("UIKit"))
local C = UIKit.Colors

local Menus = {}
local App
local modal, titleLabel, content
local popup
local current, lastSig
local refs = {}
local sections = {}
local baseTab = "Base"

------------------------------------------------------------------------
-- Bausteine
------------------------------------------------------------------------
local function card(parent, size, color, order)
	local frame = UIKit.new("Frame", {
		Size = size,
		BackgroundColor3 = color or C.Card,
		LayoutOrder = order or 0,
		Parent = parent,
	})
	UIKit.corner(frame, 14)
	UIKit.stroke(frame, C.Dark, 3)
	return frame
end

local orderCounter = 0
local function nextOrder()
	orderCounter += 1
	return orderCounter
end

local function header(text, name)
	local label = UIKit.label({
		Size = UDim2.new(1, 0, 0, 40),
		Text = text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.Accent,
		LayoutOrder = nextOrder(),
		MaxText = 30,
		Parent = content,
	})
	if name then
		sections[name] = label
	end
	return label
end

local function grid(cellSize)
	local frame = UIKit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = nextOrder(),
		Parent = content,
	})
	UIKit.new("UIGridLayout", {
		CellSize = cellSize,
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = frame,
	})
	return frame
end

local function text(parent, str, size, pos, color, maxText, align)
	return UIKit.label({
		Size = size,
		Position = pos or UDim2.new(),
		Text = str,
		TextColor3 = color or C.Text,
		MaxText = maxText or 24,
		TextXAlignment = align or Enum.TextXAlignment.Center,
		Parent = parent,
	})
end

local function robuxButton(parent, key, size, pos)
	local info = App.OfferInfo(key)
	local owned = Config.GamePasses[key] and App.State and App.State.Passes[key]
	local button = UIKit.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Size = size or UDim2.new(0.9, 0, 0, 46),
		Position = pos or UDim2.new(0.5, 0, 1, -8),
		Color = owned and Color3.fromRGB(90, 90, 120) or C.Robux,
		Text = owned and "✅ Gekauft" or ("R$ " .. info.Price),
		MaxText = 26,
		Parent = parent,
	}, function()
		if not owned then
			App.Buy(key)
		end
	end)
	return button
end

local function progressBar(parent, size, pos, color)
	local back = UIKit.new("Frame", { Size = size, Position = pos, BackgroundColor3 = C.Dark, Parent = parent })
	UIKit.corner(back, 10)
	local fill = UIKit.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = color or C.Green, Parent = back })
	UIKit.corner(fill, 10)
	local label = UIKit.label({ Size = UDim2.fromScale(1, 1), Text = "", MaxText = 20, ZIndex = 2, Parent = back })
	return fill, label
end

local function setBar(fill, ratio)
	fill.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
end

------------------------------------------------------------------------
-- Shop
------------------------------------------------------------------------
local Shop = {}

function Shop.Sig(state)
	local parts = { tostring(state.StarterBought) }
	for _, key in ipairs(Config.GamePassOrder) do
		table.insert(parts, state.Passes[key] and "1" or "0")
	end
	for _, key in ipairs({ "CashSmall", "CashMedium", "CashLarge", "CashMega" }) do
		table.insert(parts, Format.Short(state.CashPacks[key]))
	end
	return table.concat(parts, ",")
end

local function productCard(parent, key, extraText, highlight)
	local def = Config.Products[key] or Config.GamePasses[key]
	local box = card(parent, UDim2.new(), highlight and Color3.fromRGB(90, 60, 20) or C.Card)
	if highlight then
		UIKit.stroke(box, C.Accent, 3)
	end
	if def.Image and def.Image ~= "" then
		UIKit.new("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 4),
			Size = UDim2.fromOffset(48, 48),
			BackgroundTransparency = 1,
			Image = def.Image,
			Parent = box,
		})
	else
		text(box, def.Icon, UDim2.new(1, 0, 0, 44), UDim2.fromOffset(0, 6), nil, 40)
	end
	text(box, def.Name, UDim2.new(1, -12, 0, 28), UDim2.fromOffset(6, 50), C.Text, 22)
	text(box, extraText or def.Desc or "", UDim2.new(1, -16, 0, 50), UDim2.fromOffset(8, 78), C.Sub, 16)
	robuxButton(box, key)
	return box
end

function Shop.Build(state)
	-- Top-Angebote
	header("🔥 Top-Angebote", "Offers")
	local offers = grid(UDim2.fromOffset(380, 200))
	if not state.StarterBought then
		local starter = productCard(offers, "StarterPack", nil, true)
		local tag = UIKit.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 6),
			Size = UDim2.fromOffset(110, 34),
			BackgroundTransparency = 0,
			BackgroundColor3 = C.Red,
			Text = "NUR 1x!",
			MaxText = 22,
			Parent = starter,
		})
		UIKit.corner(tag, 10)
	end
	productCard(offers, "Boost2x", nil, state.BoostRemaining <= 0)

	-- Cash
	header("💰 Cash-Pakete (wachsen mit deinem Einkommen)", "Cash")
	local cash = grid(UDim2.fromOffset(250, 200))
	for _, key in ipairs({ "CashSmall", "CashMedium", "CashLarge", "CashMega" }) do
		local box = productCard(cash, key, "+" .. Format.Money(state.CashPacks[key]) .. " Cash", key == "CashMega")
		if key == "CashMega" then
			local tag = UIKit.label({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -4, 0, 4),
				Size = UDim2.fromOffset(110, 28),
				BackgroundTransparency = 0,
				BackgroundColor3 = C.Accent,
				TextColor3 = C.Dark,
				Text = "BESTER WERT",
				MaxText = 18,
				Parent = box,
			})
			UIKit.corner(tag, 8)
		end
	end

	-- Game Passes
	header("🎟 Game Passes (für immer)", "Passes")
	local passes = grid(UDim2.fromOffset(250, 200))
	for _, key in ipairs(Config.GamePassOrder) do
		productCard(passes, key, nil, key == "DoubleCash")
	end

	-- Boosts
	header("⚡ Boosts & Extras", "Boosts")
	local boosts = grid(UDim2.fromOffset(250, 200))
	productCard(boosts, "LuckySpawn")
	productCard(boosts, "MythicDrop")
	productCard(boosts, "LockExtend")

	-- Pflicht-Transparenz für bezahlte Zufalls-Items
	local odds = {}
	for _, entry in ipairs(Figures.OddsInRarity("Mythic")) do
		table.insert(odds, ("%s %s"):format(entry.Name, Format.Percent(entry.Percent)))
	end
	local mutations = {}
	for i = 2, #Config.MutationOrder do
		local name = Config.MutationOrder[i]
		table.insert(mutations, ("%s %s"):format(Config.Mutations[name].Display, Format.Percent(Config.Mutations[name].Chance)))
	end
	UIKit.label({
		Size = UDim2.new(1, 0, 0, 70),
		Text = "Chancen Mythic-Drop: " .. table.concat(odds, " · ") .. "\nMutation: " .. table.concat(mutations, " · "),
		TextColor3 = C.Sub,
		MaxText = 15,
		LayoutOrder = nextOrder(),
		Parent = content,
	})
end

------------------------------------------------------------------------
-- Basis / Index
------------------------------------------------------------------------
local Base = {}

function Base.Sig(state)
	local parts = { baseTab, state.Capacity, state.IndexCount, #state.Index }
	for _, slot in ipairs(state.Slots) do
		table.insert(parts, (slot.Id or 0) .. (slot.Mut or "") .. tostring(slot.BeingStolen))
	end
	return table.concat(parts, ",")
end

local function tabs(state)
	local row = UIKit.new("Frame", { Size = UDim2.new(1, 0, 0, 54), BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = content })
	local used = 0
	for _, slot in ipairs(state.Slots) do
		if slot.Id then
			used += 1
		end
	end
	UIKit.button({ Size = UDim2.new(0.49, 0, 1, 0), Color = baseTab == "Base" and C.Blue or C.Panel2, Text = ("🏠 Meine Basis (%d/%d)"):format(used, state.Capacity), Parent = row }, function()
		baseTab = "Base"
		Menus.Refresh(true)
	end)
	UIKit.button({ Size = UDim2.new(0.49, 0, 1, 0), Position = UDim2.fromScale(0.51, 0), Color = baseTab == "Index" and C.Blue or C.Panel2, Text = ("📖 Index (%d/%d)"):format(state.IndexCount, #Figures.List), Parent = row }, function()
		baseTab = "Index"
		Menus.Refresh(true)
	end)
end

local function buildBaseList(state)
	UIKit.label({
		Size = UDim2.new(1, 0, 0, 60),
		Text = ("Einkommen: %s/s  (Basis %s/s × %.2f)\n%s"):format(Format.Money(state.Rate), Format.Money(state.BaseIncome), state.Mult, table.concat(state.MultParts, "  ")),
		TextColor3 = C.Sub,
		MaxText = 18,
		LayoutOrder = nextOrder(),
		Parent = content,
	})

	local owned = {}
	for _, slot in ipairs(state.Slots) do
		if slot.Id then
			table.insert(owned, slot)
		end
	end
	table.sort(owned, function(a, b)
		return Figures.Income(a.Id, a.Mut) > Figures.Income(b.Id, b.Mut)
	end)
	if #owned == 0 then
		UIKit.label({ Size = UDim2.new(1, 0, 0, 60), Text = "Noch keine Figuren. Kauf welche am Förderband!", LayoutOrder = nextOrder(), Parent = content })
	end
	for _, slot in ipairs(owned) do
		local fig = Figures.Get(slot.Id)
		local rarity = Config.Rarities[fig.Rarity]
		local row = card(content, UDim2.new(1, 0, 0, 64), C.Card, nextOrder())
		local bar = UIKit.new("Frame", { Size = UDim2.new(0, 10, 1, 0), BackgroundColor3 = rarity.Color, Parent = row })
		UIKit.corner(bar, 6)
		text(row, Figures.DisplayName(slot.Id, slot.Mut), UDim2.new(0.45, 0, 0.55, 0), UDim2.new(0, 20, 0, 4), C.Text, 24, Enum.TextXAlignment.Left)
		text(row, rarity.Display .. "  ·  " .. Format.Money(Figures.Income(slot.Id, slot.Mut)) .. "/s", UDim2.new(0.45, 0, 0.4, 0), UDim2.new(0, 20, 0.55, 0), rarity.Color, 18, Enum.TextXAlignment.Left)
		if slot.BeingStolen then
			text(row, "⚠ WIRD GESTOHLEN!", UDim2.new(0.38, 0, 0.8, 0), UDim2.new(0.6, 0, 0.1, 0), C.Red, 22)
		else
			UIKit.button({
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -8, 0.5, 0),
				Size = UDim2.new(0.36, 0, 0, 48),
				Color = Color3.fromRGB(230, 130, 40),
				Text = "Verkaufen +" .. Format.Money(Figures.SellValue(slot.Id, slot.Mut)),
				MaxText = 20,
				Parent = row,
			}, function()
				App.Request("Sell", slot.Index)
			end)
		end
	end

	if not state.Passes.ExtraSlots then
		local upsell = card(content, UDim2.new(1, 0, 0, 70), Color3.fromRGB(30, 80, 60), nextOrder())
		text(upsell, "🏠 Basis voll? Hol dir 5 Slots mehr – für immer!", UDim2.new(0.6, 0, 1, 0), UDim2.fromOffset(12, 0), C.Text, 22, Enum.TextXAlignment.Left)
		robuxButton(upsell, "ExtraSlots", UDim2.new(0.34, 0, 0, 50), UDim2.new(0.82, 0, 1, -10))
	end
end

local function buildIndex(state)
	local collected = {}
	for _, key in ipairs(state.Index) do
		local id, mut = string.match(key, "^(%d+)_(%a+)$")
		id = tonumber(id)
		if id then
			collected[id] = collected[id] or {}
			collected[id][mut] = true
		end
	end
	local nextTier
	for i = #Config.IndexBonus, 1, -1 do
		if state.IndexCount < Config.IndexBonus[i].Count then
			nextTier = Config.IndexBonus[i]
			break
		end
	end
	UIKit.label({
		Size = UDim2.new(1, 0, 0, 50),
		Text = ("Entdeckt: %d/%d · Bonus +%d%%%s"):format(state.IndexCount, #Figures.List, state.IndexBonus * 100,
			nextTier and ("  (bei %d: +%d%%)"):format(nextTier.Count, nextTier.Bonus * 100) or ""),
		TextColor3 = C.Accent,
		MaxText = 22,
		LayoutOrder = nextOrder(),
		Parent = content,
	})
	local cells = grid(UDim2.fromOffset(150, 96))
	for _, fig in ipairs(Figures.List) do
		local rarity = Config.Rarities[fig.Rarity]
		local found = collected[fig.Id]
		local box = card(cells, UDim2.new(), found and C.Card or C.Dark, fig.Id)
		UIKit.stroke(box, found and rarity.Color or C.Panel2, 3)
		text(box, found and fig.Name or "???", UDim2.new(1, -8, 0.5, 0), UDim2.fromOffset(4, 4), found and C.Text or C.Sub, 18)
		text(box, rarity.Display, UDim2.new(1, 0, 0.22, 0), UDim2.fromScale(0, 0.5), rarity.Color, 14)
		if found then
			local marks = {}
			for _, mut in ipairs(Config.MutationOrder) do
				if mut ~= "Normal" and found[mut] then
					table.insert(marks, mut == "Gold" and "🟡" or (mut == "Diamond" and "💎" or "🌈"))
				end
			end
			text(box, table.concat(marks, " "), UDim2.new(1, 0, 0.25, 0), UDim2.fromScale(0, 0.72), C.Text, 16)
		end
	end
end

function Base.Build(state)
	tabs(state)
	if baseTab == "Base" then
		buildBaseList(state)
	else
		buildIndex(state)
	end
end

------------------------------------------------------------------------
-- Rebirth
------------------------------------------------------------------------
local Rebirth = {}

function Rebirth.Sig(state)
	return table.concat({ state.Rebirths, tostring(state.Rebirth.HasRequirement), state.Rebirth.Requirement }, ",")
end

function Rebirth.Build(state)
	local info = state.Rebirth
	local box = card(content, UDim2.new(1, 0, 0, 380), C.Card, nextOrder())
	text(box, ("⭐ Rebirth %d  ➜  %d"):format(state.Rebirths, state.Rebirths + 1), UDim2.new(1, 0, 0, 50), UDim2.fromOffset(0, 8), C.Accent, 40)
	text(box, ("📈 Einkommen x%.1f ➜ x%.1f   🏠 +1 Slot (max. 5)   🔒 Schloss +5 s"):format(info.CurrentMult, info.NextMult), UDim2.new(1, -20, 0, 34), UDim2.fromOffset(10, 64), C.Text, 22)
	local reqRarity = Config.Rarities[info.Requirement]
	text(box, (info.HasRequirement and "✅ " or "❌ ") .. "Mindestens 1 " .. reqRarity.Display .. "-Figur in deiner Basis", UDim2.new(1, -20, 0, 32), UDim2.fromOffset(10, 104), info.HasRequirement and C.Green or C.Red, 22)
	text(box, "Kosten: " .. Format.Money(info.Cost), UDim2.new(1, -20, 0, 34), UDim2.fromOffset(10, 142), C.Text, 26)
	refs.RebirthFill, refs.RebirthText = progressBar(box, UDim2.new(1, -40, 0, 36), UDim2.fromOffset(20, 184), C.Purple)
	refs.RebirthButton = UIKit.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 234),
		Size = UDim2.new(0.6, 0, 0, 64),
		Color = C.Purple,
		Text = "⭐ REBIRTH",
		MaxText = 34,
		Parent = box,
	}, function()
		App.Request("Rebirth")
	end)
	text(box, "⚠ Setzt Cash und Figuren zurück. Rebirths, Index, Pässe bleiben.", UDim2.new(1, -20, 0, 28), UDim2.fromOffset(10, 306), C.Sub, 18)
	UIKit.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -6),
		Size = UDim2.new(0.5, 0, 0, 36),
		Color = C.Robux,
		Text = "💰 Schneller mit Cash-Paketen",
		MaxText = 18,
		Parent = box,
	}, function()
		Menus.Open("Shop", "Cash")
	end)
	Rebirth.Tick(state)
end

function Rebirth.Tick(state)
	if not refs.RebirthFill then
		return
	end
	local info = state.Rebirth
	setBar(refs.RebirthFill, state.Cash / info.Cost)
	refs.RebirthText.Text = Format.Money(state.Cash) .. " / " .. Format.Money(info.Cost)
	local ready = state.Cash >= info.Cost and info.HasRequirement
	refs.RebirthButton.BackgroundColor3 = ready and C.Purple or Color3.fromRGB(90, 90, 120)
end

------------------------------------------------------------------------
-- Täglich + Geschenke
------------------------------------------------------------------------
local Daily = {}

function Daily.Sig(state)
	local parts = { tostring(state.Daily.CanClaim), state.Daily.Streak, state.Daily.NextIndex }
	for _, gift in ipairs(state.Gifts) do
		table.insert(parts, tostring(gift.Claimed) .. tostring(gift.Remaining <= 0))
	end
	return table.concat(parts, ",")
end

function Daily.Build(state)
	local daily = state.Daily
	header(("📅 Tägliche Belohnung · Serie: %d Tage"):format(daily.Streak))
	local days = grid(UDim2.fromOffset(104, 120))
	local claimedUpTo
	if daily.CanClaim then
		claimedUpTo = daily.NextIndex - 1
	else
		claimedUpTo = (daily.Streak - 1) % #Config.Daily + 1
	end
	for i, reward in ipairs(Config.Daily) do
		local isCurrent = daily.CanClaim and i == daily.NextIndex
		local claimed = i <= claimedUpTo
		local box = card(days, UDim2.new(), isCurrent and Color3.fromRGB(40, 120, 60) or (claimed and C.Dark or C.Card), i)
		if isCurrent then
			UIKit.stroke(box, C.Accent, 4)
		end
		text(box, "Tag " .. i, UDim2.new(1, 0, 0.25, 0), UDim2.fromScale(0, 0.04), C.Accent, 20)
		local label = reward.Type == "Cash" and ("💵\n" .. Format.Money(math.max(reward.Min, state.Rate * reward.Seconds))) or (reward.Type == "Boost" and "⚡\n" .. reward.Text or "🎁\n" .. reward.Text)
		text(box, claimed and "✅" or label, UDim2.new(1, -6, 0.68, 0), UDim2.new(0, 3, 0.3, 0), C.Text, 18)
	end
	refs.DailyButton = UIKit.button({
		Size = UDim2.new(1, 0, 0, 58),
		LayoutOrder = nextOrder(),
		Color = daily.CanClaim and C.Green or Color3.fromRGB(90, 90, 120),
		Text = daily.CanClaim and "🎁 ABHOLEN!" or "",
		MaxText = 30,
		Parent = content,
	}, function()
		App.Request("ClaimDaily")
	end)
	if not state.Passes.VIP then
		UIKit.label({ Size = UDim2.new(1, 0, 0, 30), Text = "👑 VIP bekommt jede Tagesbelohnung doppelt!", TextColor3 = C.Accent, MaxText = 18, LayoutOrder = nextOrder(), Parent = content })
	end

	header("⏱ Spielzeit-Geschenke (diese Sitzung)")
	local gifts = grid(UDim2.fromOffset(104, 120))
	refs.GiftLabels = {}
	for _, gift in ipairs(state.Gifts) do
		local box = card(gifts, UDim2.new(), gift.Claimed and C.Dark or C.Card, gift.Index)
		text(box, gift.Label, UDim2.new(1, -6, 0.4, 0), UDim2.new(0, 3, 0.05, 0), C.Text, 18)
		if gift.Claimed then
			text(box, "✅", UDim2.new(1, 0, 0.45, 0), UDim2.fromScale(0, 0.5), C.Text, 26)
		elseif gift.Remaining <= 0 then
			UIKit.button({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), Size = UDim2.new(0.9, 0, 0.45, 0), Color = C.Green, Text = "Holen!", MaxText = 20, Parent = box }, function()
				App.Request("ClaimGift", gift.Index)
			end)
		else
			refs.GiftLabels[gift.Index] = text(box, Format.Time(gift.Remaining), UDim2.new(1, 0, 0.4, 0), UDim2.fromScale(0, 0.52), C.Sub, 22)
		end
	end
	Daily.Tick(state)
end

function Daily.Tick(state)
	if refs.DailyButton and not state.Daily.CanClaim then
		refs.DailyButton.Text = "Nächste Belohnung in " .. Format.Time(state.Daily.SecondsUntilNext)
	end
	for _, gift in ipairs(state.Gifts) do
		local label = refs.GiftLabels and refs.GiftLabels[gift.Index]
		if label then
			label.Text = Format.Time(gift.Remaining)
		end
	end
end

------------------------------------------------------------------------
-- Quests
------------------------------------------------------------------------
local Quests = {}

function Quests.Sig(state)
	local parts = {}
	for _, quest in ipairs(state.Quests) do
		table.insert(parts, quest.Progress .. "/" .. quest.Goal .. tostring(quest.Claimed) .. Format.Short(quest.Reward))
	end
	return table.concat(parts, ",")
end

function Quests.Build(state)
	header("📜 Tages-Quests")
	for _, quest in ipairs(state.Quests) do
		local row = card(content, UDim2.new(1, 0, 0, 96), C.Card, nextOrder())
		text(row, quest.Text, UDim2.new(0.62, 0, 0, 34), UDim2.fromOffset(14, 6), C.Text, 24, Enum.TextXAlignment.Left)
		local fill, label = progressBar(row, UDim2.new(0.6, 0, 0, 28), UDim2.fromOffset(14, 50), C.Accent)
		setBar(fill, quest.Progress / quest.Goal)
		label.Text = quest.Progress .. " / " .. quest.Goal
		if quest.Claimed then
			text(row, "✅ Erledigt", UDim2.new(0.32, 0, 0, 50), UDim2.new(0.66, 0, 0, 22), C.Green, 24)
		elseif quest.Progress >= quest.Goal then
			UIKit.button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0.32, 0, 0, 60), Color = C.Green, Text = "Holen +" .. Format.Money(quest.Reward), MaxText = 22, Parent = row }, function()
				App.Request("ClaimQuest", quest.Index)
			end)
		else
			text(row, "🎁 +" .. Format.Money(quest.Reward), UDim2.new(0.32, 0, 0, 50), UDim2.new(0.66, 0, 0, 22), C.Accent, 24)
		end
	end
	refs.QuestTimer = UIKit.label({ Size = UDim2.new(1, 0, 0, 34), Text = "", TextColor3 = C.Sub, MaxText = 20, LayoutOrder = nextOrder(), Parent = content })
	Quests.Tick(state)
end

function Quests.Tick(state)
	if refs.QuestTimer then
		refs.QuestTimer.Text = "Neue Quests in " .. Format.Time(state.Daily.SecondsUntilNext)
	end
end

------------------------------------------------------------------------
-- Panel-Verwaltung
------------------------------------------------------------------------
local PANELS = {
	Shop = { Title = "🛒 SHOP", Def = Shop },
	Base = { Title = "🎒 BASIS & INDEX", Def = Base },
	Rebirth = { Title = "⭐ REBIRTH", Def = Rebirth },
	Daily = { Title = "🎁 BELOHNUNGEN", Def = Daily },
	Quests = { Title = "📜 QUESTS", Def = Quests },
}

local function rebuild(state, keepScroll)
	local scroll = content.CanvasPosition
	UIKit.clear(content)
	refs = {}
	sections = {}
	orderCounter = 0
	PANELS[current].Def.Build(state)
	if keepScroll then
		task.defer(function()
			content.CanvasPosition = scroll
		end)
	end
end

function Menus.Refresh(keepScroll)
	if current and App.State then
		lastSig = PANELS[current].Def.Sig(App.State)
		rebuild(App.State, keepScroll)
	end
end

function Menus.Open(name, section)
	if not PANELS[name] or not App.State then
		return
	end
	if current == name and modal.Visible and not section then
		Menus.Close()
		return
	end
	current = name
	titleLabel.Text = PANELS[name].Title
	modal.Visible = true
	content.CanvasPosition = Vector2.zero
	lastSig = PANELS[name].Def.Sig(App.State)
	rebuild(App.State, false)
	if section then
		task.defer(function()
			local target = sections[section]
			if target then
				content.CanvasPosition = Vector2.new(0, target.AbsolutePosition.Y - content.AbsolutePosition.Y + content.CanvasPosition.Y)
			end
		end)
	end
end

function Menus.Close()
	modal.Visible = false
	current = nil
end

function Menus.Update(state)
	if not current or not modal.Visible then
		return
	end
	local def = PANELS[current].Def
	local sig = def.Sig(state)
	if sig ~= lastSig then
		lastSig = sig
		rebuild(state, true)
	elseif def.Tick then
		def.Tick(state)
	end
end

------------------------------------------------------------------------
-- Popups
------------------------------------------------------------------------
local function openPopup(title, bodyText, buttons, accent)
	if popup then
		popup:Destroy()
	end
	popup = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(520, 300),
		BackgroundColor3 = C.Panel,
		ZIndex = 30,
		Parent = App.Gui,
	})
	UIKit.corner(popup, 20)
	UIKit.stroke(popup, accent or C.Accent, 5)
	text(popup, title, UDim2.new(1, -20, 0, 54), UDim2.fromOffset(10, 10), accent or C.Accent, 40)
	text(popup, bodyText, UDim2.new(1, -40, 0, 120), UDim2.fromOffset(20, 70), C.Text, 24)
	local width = 1 / #buttons
	for i, def in ipairs(buttons) do
		UIKit.button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(width * (i - 0.5), 0, 1, -16),
			Size = UDim2.new(width, -20, 0, 64),
			Color = def.Color,
			Text = def.Text,
			MaxText = 26,
			Parent = popup,
		}, function()
			if def.Fn then
				def.Fn()
			end
			if popup then
				popup:Destroy()
				popup = nil
			end
		end)
	end
	local scale = UIKit.new("UIScale", { Scale = 0.5, Parent = popup })
	game:GetService("TweenService"):Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

function Menus.ShowOffline(payload)
	local body = ("Du warst %s weg und hast %s verdient!"):format(Format.Time(payload.Away or 0), Format.Money(payload.Amount or 0))
	if not payload.Vip then
		body ..= "\n👑 Mit VIP doppelt so viel und bis zu 6 Stunden!"
	end
	openPopup("😴 Willkommen zurück!", body, {
		{ Text = "Einsammeln", Color = C.Blue },
		{ Text = "3x  ·  R$ " .. App.OfferInfo("OfflineTriple").Price, Color = C.Robux, Fn = function()
			App.Buy("OfflineTriple")
		end },
	}, C.Accent)
end

function Menus.ShowStarterOffer()
	openPopup("🎁 STARTER-PAKET", "Gold Turbo Tortellino (Epic, 300 $/s)\n+ 25.000 Cash + 30 Min 2x Cash\nNur EINMAL kaufbar!", {
		{ Text = "Später", Color = Color3.fromRGB(90, 90, 120) },
		{ Text = "Holen · R$ " .. App.OfferInfo("StarterPack").Price, Color = C.Robux, Fn = function()
			App.Buy("StarterPack")
		end },
	}, C.Accent)
end

------------------------------------------------------------------------
function Menus.Init(app)
	App = app
	modal = UIKit.new("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.53, 0),
		Size = UDim2.fromOffset(860, 560),
		BackgroundColor3 = C.Panel,
		Visible = false,
		ZIndex = 20,
		Parent = app.Gui,
	})
	UIKit.corner(modal, 20)
	UIKit.stroke(modal, C.Dark, 5)
	titleLabel = UIKit.label({ Size = UDim2.new(1, -140, 0, 56), Position = UDim2.fromOffset(20, 6), Text = "", TextColor3 = C.Accent, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 40, Parent = modal })
	UIKit.button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.fromOffset(56, 56), Color = C.Red, Text = "X", MaxText = 32, Parent = modal }, Menus.Close)

	content = UIKit.new("ScrollingFrame", {
		Position = UDim2.fromOffset(16, 74),
		Size = UDim2.new(1, -32, 1, -90),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = modal,
	})
	UIKit.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = content })
	UIKit.new("UIPadding", { PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12), Parent = content })
end

return Menus
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Notify</string>
            <string name="Source"><![CDATA[--[[
	Notify  (ModuleScript)  ->  StarterPlayer/StarterPlayerScripts/ClientModules/Notify
	Toasts (mit optionalem Kauf-Button), Server-Ansagen, Effekte
	(Reveal, Alarm, Konfetti, Rebirth, Bonk, Rare-Spawn).
]]

local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Figures = require(Shared:WaitForChild("Figures"))
local Format = require(Shared:WaitForChild("Format"))

local UIKit = require(script.Parent:WaitForChild("UIKit"))
local C = UIKit.Colors

local Notify = {}
local App
local toastHolder, bannerHolder, fxLayer
local bannerQueue = {}
local bannerBusy = false
local toastCounter = 0

local KIND_COLORS = {
	info = C.Panel2,
	success = Color3.fromRGB(40, 150, 70),
	cash = Color3.fromRGB(30, 130, 60),
	error = Color3.fromRGB(170, 40, 50),
	warning = Color3.fromRGB(190, 120, 20),
}

------------------------------------------------------------------------
-- Toasts
------------------------------------------------------------------------
function Notify.Toast(text, kind, offer)
	local holder = toastHolder
	local count = 0
	for _, child in ipairs(holder:GetChildren()) do
		if child:IsA("Frame") then
			count += 1
		end
	end
	if count >= 4 then
		for _, child in ipairs(holder:GetChildren()) do
			if child:IsA("Frame") then
				child:Destroy()
				break
			end
		end
	end

	toastCounter += 1
	local hasOffer = offer ~= nil and App.OfferInfo(offer) ~= nil
	local toast = UIKit.new("Frame", {
		Size = UDim2.new(1, 0, 0, hasOffer and 64 or 46),
		BackgroundColor3 = KIND_COLORS[kind] or C.Panel2,
		LayoutOrder = toastCounter,
		Parent = holder,
	})
	UIKit.corner(toast, 12)
	UIKit.stroke(toast, C.Dark, 3)
	UIKit.label({
		Size = UDim2.new(hasOffer and 0.66 or 1, -12, 1, -8),
		Position = UDim2.fromOffset(8, 4),
		Text = text,
		MaxText = 26,
		Parent = toast,
	})
	if hasOffer then
		local info = App.OfferInfo(offer)
		UIKit.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.new(0.32, 0, 0, 48),
			Color = C.Robux,
			Text = info.Icon .. " " .. info.Short .. "\nR$ " .. info.Price,
			MaxText = 20,
			Parent = toast,
		}, function()
			App.Buy(offer)
		end)
	end

	local scale = UIKit.new("UIScale", { Scale = 0.6, Parent = toast })
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(hasOffer and 6 or 3.2, function()
		if toast.Parent then
			TweenService:Create(scale, TweenInfo.new(0.2), { Scale = 0 }):Play()
			task.wait(0.2)
			toast:Destroy()
		end
	end)
end

------------------------------------------------------------------------
-- Banner (Server-Ansagen)
------------------------------------------------------------------------
local function showNextBanner()
	if bannerBusy or #bannerQueue == 0 then
		return
	end
	bannerBusy = true
	local item = table.remove(bannerQueue, 1)
	local banner = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -80),
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundColor3 = C.Panel,
		Parent = bannerHolder,
	})
	UIKit.corner(banner, 14)
	UIKit.stroke(banner, item.Color, 3)
	UIKit.label({
		Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.fromOffset(8, 4),
		Text = item.Text,
		TextColor3 = item.Color,
		MaxText = 28,
		Parent = banner,
	})
	TweenService:Create(banner, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Position = UDim2.new(0.5, 0, 0, 0) }):Play()
	task.delay(4.2, function()
		TweenService:Create(banner, TweenInfo.new(0.25), { Position = UDim2.new(0.5, 0, 0, -80) }):Play()
		task.wait(0.3)
		banner:Destroy()
		bannerBusy = false
		showNextBanner()
	end)
end

function Notify.Announce(text, color)
	table.insert(bannerQueue, { Text = text, Color = color or C.Accent })
	while #bannerQueue > 5 do
		table.remove(bannerQueue, 1)
	end
	showNextBanner()
end

------------------------------------------------------------------------
-- Effekte
------------------------------------------------------------------------
local function flash(color, times, duration)
	local frame = UIKit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = 1,
		ZIndex = 50,
		Parent = fxLayer,
	})
	task.spawn(function()
		for _ = 1, times do
			TweenService:Create(frame, TweenInfo.new(duration / 2), { BackgroundTransparency = 0.6 }):Play()
			task.wait(duration / 2)
			TweenService:Create(frame, TweenInfo.new(duration / 2), { BackgroundTransparency = 1 }):Play()
			task.wait(duration / 2)
		end
		frame:Destroy()
	end)
end

function Notify.Confetti()
	local colors = { C.Accent, C.Pink, C.Blue, C.Green, C.Purple, C.Red }
	for _ = 1, 45 do
		local piece = UIKit.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(math.random(), -0.05),
			Size = UDim2.fromOffset(math.random(8, 16), math.random(12, 22)),
			Rotation = math.random(0, 360),
			BackgroundColor3 = colors[math.random(1, #colors)],
			BorderSizePixel = 0,
			ZIndex = 60,
			Parent = fxLayer,
		})
		local duration = 1.6 + math.random() * 1.4
		TweenService:Create(piece, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.fromScale(piece.Position.X.Scale + (math.random() - 0.5) * 0.3, 1.1),
			Rotation = piece.Rotation + math.random(-360, 360),
		}):Play()
		task.delay(duration, function()
			piece:Destroy()
		end)
	end
end

function Notify.Reveal(id, mutation, title)
	local fig = Figures.Get(id)
	if not fig then
		return
	end
	local rarity = Config.Rarities[fig.Rarity]
	local card = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(460, 230),
		BackgroundColor3 = C.Panel,
		ZIndex = 70,
		Parent = fxLayer,
	})
	UIKit.corner(card, 20)
	UIKit.stroke(card, rarity.Color, 5)
	local scale = UIKit.new("UIScale", { Scale = 0, Parent = card })
	local glow = UIKit.new("UIGradient", {
		Color = ColorSequence.new(C.Panel, rarity.Color),
		Rotation = 0,
		Parent = card,
	})
	UIKit.label({ Size = UDim2.new(1, 0, 0.22, 0), Position = UDim2.fromScale(0, 0.05), Text = title or "NEU!", TextColor3 = C.Accent, ZIndex = 71, MaxText = 36, Parent = card })
	UIKit.label({ Size = UDim2.new(1, -20, 0.32, 0), Position = UDim2.new(0, 10, 0.28, 0), Text = Figures.DisplayName(id, mutation), ZIndex = 71, MaxText = 44, Parent = card })
	UIKit.label({ Size = UDim2.new(1, 0, 0.18, 0), Position = UDim2.fromScale(0, 0.6), Text = rarity.Display, TextColor3 = rarity.Color, ZIndex = 71, MaxText = 30, Parent = card })
	UIKit.label({ Size = UDim2.new(1, 0, 0.16, 0), Position = UDim2.fromScale(0, 0.8), Text = Format.Money(Figures.Income(id, mutation)) .. "/s", TextColor3 = Color3.fromRGB(255, 230, 90), ZIndex = 71, MaxText = 26, Parent = card })

	App.Sound(rarity.Rank >= 5 and "Secret" or "Legendary")
	TweenService:Create(scale, TweenInfo.new(0.4, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	TweenService:Create(glow, TweenInfo.new(2.6, Enum.EasingStyle.Linear), { Rotation = 360 }):Play()
	if rarity.Rank >= 4 then
		Notify.Confetti()
	end
	task.delay(2.6, function()
		TweenService:Create(scale, TweenInfo.new(0.2), { Scale = 0 }):Play()
		task.wait(0.25)
		card:Destroy()
	end)
end

local function bigText(text, color, duration)
	local label = UIKit.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.35),
		Size = UDim2.fromOffset(700, 110),
		Text = text,
		TextColor3 = color,
		ZIndex = 80,
		MaxText = 80,
		Parent = fxLayer,
	})
	local scale = UIKit.new("UIScale", { Scale = 0.3, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(duration, function()
		TweenService:Create(label, TweenInfo.new(0.3), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.wait(0.3)
		label:Destroy()
	end)
end

local function shakeCamera(strength, duration)
	local camera = Workspace.CurrentCamera
	local start = os.clock()
	task.spawn(function()
		while os.clock() - start < duration do
			local offset = Vector3.new((math.random() - 0.5) * strength, (math.random() - 0.5) * strength, 0)
			camera.CFrame = camera.CFrame * CFrame.new(offset)
			task.wait()
		end
	end)
end

function Notify.Effect(kind, payload)
	payload = payload or {}
	if kind == "Reveal" then
		Notify.Reveal(payload.Id, payload.Mut, payload.Text)
	elseif kind == "Confetti" then
		Notify.Confetti()
		App.Sound("Reward")
	elseif kind == "Alarm" then
		flash(C.Red, 3, 0.5)
		bigText("⚠ DIEB! ⚠", C.Red, 1.8)
	elseif kind == "Rebirth" then
		flash(C.Accent, 1, 0.8)
		bigText(("⭐ REBIRTH %d ⭐"):format(payload.Rebirths or 0), C.Accent, 2.5)
		Notify.Confetti()
	elseif kind == "Bonked" then
		bigText("BONK!", C.Pink, 0.8)
		shakeCamera(0.6, 0.3)
		App.Sound("Bonk")
	elseif kind == "RareSpawn" then
		local fig = Figures.Get(payload.Id)
		if fig then
			local rarity = Config.Rarities[fig.Rarity]
			Notify.Toast(("🚨 %s auf dem Band: %s!"):format(rarity.Display, Figures.DisplayName(payload.Id, payload.Mut)), "warning")
			App.Sound(rarity.Rank >= 5 and "Secret" or "Legendary")
		end
	elseif kind == "Offline" then
		App.Menus.ShowOffline(payload)
	end
end

function Notify.Init(app)
	App = app
	local gui = app.Gui

	toastHolder = UIKit.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -110),
		Size = UDim2.fromOffset(460, 300),
		BackgroundTransparency = 1,
		ZIndex = 40,
		Parent = gui,
	})
	UIKit.new("UIListLayout", {
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = toastHolder,
	})

	bannerHolder = UIKit.new("Frame", {
		Name = "Banners",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 96),
		Size = UDim2.fromOffset(620, 60),
		BackgroundTransparency = 1,
		ClipsDescendants = false,
		Parent = gui,
	})

	fxLayer = UIKit.new("Frame", {
		Name = "Effects",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 50,
		Parent = gui,
	})
end

return Notify
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source"><![CDATA[--[[
	Tutorial  (ModuleScript)  ->  StarterPlayer/StarterPlayerScripts/ClientModules/Tutorial
	Führt neue Spieler mit Text + leuchtendem Pfeil durch die ersten Schritte:
	  1. Figur am Förderband kaufen
	  2. Cash am grünen Feld einsammeln
	  3. Basis abschließen
	Wird nur gezeigt, solange ein Spieler insgesamt weniger als 5.000 Cash verdient hat.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local UIKit = require(script.Parent:WaitForChild("UIKit"))
local C = UIKit.Colors

local Tutorial = {}
local App
local player = Players.LocalPlayer

local step = 0 -- 0 = noch nicht gestartet, 4 = fertig
local collected = false
local panel, label
local beam, attachTarget

local STEPS = {
	{ Text = "👉 Lauf zum FÖRDERBAND und kauf eine Figur (E drücken / antippen)!" },
	{ Text = "💰 Super! Lauf jetzt über das GRÜNE Feld in deiner Basis, um Cash einzusammeln." },
	{ Text = "🔒 Schließ deine Basis mit dem ROTEN Knopf ab, damit niemand klaut!" },
}

local function ownBase()
	local bases = Workspace:FindFirstChild("Bases")
	if not bases then
		return nil
	end
	for _, base in ipairs(bases:GetChildren()) do
		if base:GetAttribute("OwnerId") == player.UserId then
			return base
		end
	end
	return nil
end

local function targetPart()
	if step == 1 then
		local conveyor = Workspace:FindFirstChild("Conveyor")
		return conveyor and conveyor:FindFirstChild("Belt")
	end
	local base = ownBase()
	if not base then
		return nil
	end
	if step == 2 then
		return base:FindFirstChild("CashPad")
	elseif step == 3 then
		return base:FindFirstChild("LockButton")
	end
	return nil
end

local function updateBeam()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local target = targetPart()
	if not root or not target or step < 1 or step > 3 then
		if beam then
			beam.Enabled = false
		end
		return
	end
	if not beam or not beam.Parent then
		local a0 = Instance.new("Attachment")
		a0.Name = "TutorialFrom"
		a0.Parent = root
		attachTarget = Instance.new("Attachment")
		attachTarget.Name = "TutorialTo"
		beam = Instance.new("Beam")
		beam.Name = "TutorialBeam"
		beam.Attachment0 = a0
		beam.Attachment1 = attachTarget
		beam.Width0 = 1.2
		beam.Width1 = 1.2
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.Color = ColorSequence.new(Color3.fromRGB(255, 230, 60), Color3.fromRGB(90, 255, 120))
		beam.Transparency = NumberSequence.new(0.15)
		beam.Parent = root
	end
	if attachTarget.Parent ~= target then
		attachTarget.Parent = target
		attachTarget.Position = Vector3.new(0, 1.5, 0)
	end
	beam.Enabled = true
end

local function setStep(newStep)
	if newStep == step then
		return
	end
	step = newStep
	if step >= 1 and step <= 3 then
		panel.Visible = true
		label.Text = ("Schritt %d/3: %s"):format(step, STEPS[step].Text)
		local scale = panel:FindFirstChildOfClass("UIScale")
		scale.Scale = 0.7
		TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		App.Sound("Reward")
	else
		panel.Visible = false
		if beam then
			beam.Enabled = false
		end
		if step == 4 then
			App.Notify.Toast("🎉 Tutorial geschafft! Sammle seltene Figuren und werde der reichste Bandit!", "success")
			App.Notify.Confetti()
		end
	end
	updateBeam()
end

function Tutorial.OnCashCollected()
	collected = true
end

function Tutorial.Update(state)
	if step == 4 then
		return
	end
	if step == 0 then
		if state.TotalEarned >= 5000 then
			step = 4 -- erfahrener Spieler: kein Tutorial
			return
		end
		setStep(1)
	end
	local owned = false
	for _, slot in ipairs(state.Slots) do
		if slot.Id then
			owned = true
			break
		end
	end
	if step == 1 and owned then
		setStep(2)
	end
	if step == 2 and (collected or state.Passes.AutoCollect) then
		setStep(3)
	end
	if step == 3 and state.LockRemaining > 0 then
		setStep(4)
	end
	updateBeam()
end

function Tutorial.Init(app)
	App = app
	panel = UIKit.new("Frame", {
		Name = "Tutorial",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 165),
		Size = UDim2.fromOffset(640, 70),
		BackgroundColor3 = C.Panel,
		Visible = false,
		Parent = app.Gui,
	})
	UIKit.corner(panel, 16)
	UIKit.stroke(panel, C.Accent, 4)
	UIKit.new("UIScale", { Parent = panel })
	label = UIKit.label({
		Size = UDim2.new(1, -20, 1, -10),
		Position = UDim2.fromOffset(10, 5),
		Text = "",
		MaxText = 26,
		Parent = panel,
	})
	player.CharacterAdded:Connect(function()
		beam = nil
		task.wait(1)
		updateBeam()
	end)
end

return Tutorial
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">UIKit</string>
            <string name="Source"><![CDATA[--[[
	UIKit  (ModuleScript)  ->  StarterPlayer/StarterPlayerScripts/ClientModules/UIKit
	Kleine Helfer, um die UI per Code zu bauen (einheitlicher, mobilfreundlicher Look).
]]

local TweenService = game:GetService("TweenService")

local UIKit = {}

UIKit.Colors = {
	Panel = Color3.fromRGB(28, 26, 48),
	Panel2 = Color3.fromRGB(44, 40, 72),
	Card = Color3.fromRGB(56, 50, 92),
	Accent = Color3.fromRGB(255, 200, 40),
	Green = Color3.fromRGB(60, 210, 90),
	Red = Color3.fromRGB(240, 70, 70),
	Blue = Color3.fromRGB(70, 150, 255),
	Purple = Color3.fromRGB(166, 75, 255),
	Pink = Color3.fromRGB(255, 90, 170),
	Robux = Color3.fromRGB(0, 176, 111),
	Text = Color3.new(1, 1, 1),
	Sub = Color3.fromRGB(200, 195, 230),
	Dark = Color3.fromRGB(15, 14, 26),
}

UIKit.Font = Enum.Font.FredokaOne
UIKit.OnClick = nil -- wird von ClientMain gesetzt (Klick-Sound)

function UIKit.new(className, props, children)
	local inst = Instance.new(className)
	local parent
	for key, value in pairs(props or {}) do
		if key == "Parent" then
			parent = value
		else
			inst[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UIKit.corner(parent, radius)
	return UIKit.new("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = parent })
end

function UIKit.stroke(parent, color, thickness)
	return UIKit.new("UIStroke", {
		Color = color or UIKit.Colors.Dark,
		Thickness = thickness or 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function UIKit.padding(parent, px)
	return UIKit.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		Parent = parent,
	})
end

function UIKit.gradient(parent, top, bottom)
	return UIKit.new("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = 90,
		Parent = parent,
	})
end

function UIKit.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = UIKit.Font,
		TextScaled = true,
		TextColor3 = UIKit.Colors.Text,
		TextStrokeTransparency = 0.4,
		TextWrapped = true,
	}
	for k, v in pairs(props) do
		if k ~= "MaxText" and k ~= "NoConstraint" then
			defaults[k] = v
		end
	end
	local label = UIKit.new("TextLabel", defaults)
	if not props.NoConstraint then
		UIKit.new("UITextSizeConstraint", { MaxTextSize = props.MaxText or 40, Parent = label })
	end
	return label
end

function UIKit.button(props, onClick)
	local color = props.Color or UIKit.Colors.Green
	props.Color = nil
	local defaults = {
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Font = UIKit.Font,
		TextScaled = true,
		TextColor3 = UIKit.Colors.Text,
		TextStrokeTransparency = 0.3,
		Text = "",
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	local maxText = defaults.MaxText or 34
	defaults.MaxText = nil
	local button = UIKit.new("TextButton", defaults)
	UIKit.corner(button, 12)
	UIKit.stroke(button, UIKit.Colors.Dark, 3)
	UIKit.gradient(button, Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 200))
	UIKit.new("UITextSizeConstraint", { MaxTextSize = maxText, Parent = button })
	UIKit.new("UIPadding", {
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		Parent = button,
	})
	local scale = UIKit.new("UIScale", { Parent = button })
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.08), { Scale = 0.92 }):Play()
	end)
	local function release()
		TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	button.MouseButton1Up:Connect(release)
	button.MouseLeave:Connect(release)
	if onClick then
		button.Activated:Connect(function()
			if UIKit.OnClick then
				UIKit.OnClick()
			end
			onClick()
		end)
	end
	return button
end

-- Kleiner roter Punkt (z. B. "Belohnung bereit")
function UIKit.badge(parent)
	local badge = UIKit.new("TextLabel", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -6, 0, 6),
		Size = UDim2.fromOffset(26, 26),
		BackgroundColor3 = UIKit.Colors.Red,
		Text = "!",
		Font = UIKit.Font,
		TextScaled = true,
		TextColor3 = UIKit.Colors.Text,
		Visible = false,
		ZIndex = 5,
		Parent = parent,
	})
	UIKit.corner(badge, 13)
	UIKit.stroke(badge, UIKit.Colors.Dark, 2)
	return badge
end

function UIKit.pulse(guiObject)
	local scale = guiObject:FindFirstChild("PulseScale") or UIKit.new("UIScale", { Name = "PulseScale", Parent = guiObject })
	local tween = TweenService:Create(scale, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.08 })
	tween:Play()
	return tween
end

function UIKit.clear(container)
	for _, child in ipairs(container:GetChildren()) do
		if not child:IsA("UIGridStyleLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

return UIKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[--[[
	World  (ModuleScript)  ->  StarterPlayer/StarterPlayerScripts/ClientModules/World
	Rein optische Client-Effekte:
	  - Prompts filtern (eigene Figuren: Verkaufen statt Stehlen)
	  - Meisterdieb: kürzere Haltezeit anzeigen (Server prüft selbst)
	  - Regenbogen-Figuren, Secret-Namen in Regenbogenfarben
	  - laufende Streifen auf dem Förderband
	  - "DEINE BASIS"-Markierung
	  - VIP-Tag im Chat, Musik
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local SoundService = game:GetService("SoundService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local World = {}
local App
local player = Players.LocalPlayer
local hasMasterThief = false

local function applyPrompt(prompt, tag)
	local isMine = prompt:GetAttribute("OwnerId") == player.UserId
	if tag == "StealPrompt" then
		prompt.Enabled = not isMine
		prompt.HoldDuration = hasMasterThief and Config.Steal.MasterHoldTime or Config.Steal.HoldTime
	elseif tag == "OwnerOnlyPrompt" then
		prompt.Enabled = isMine
	end
end

local function watchTag(tag)
	for _, prompt in ipairs(CollectionService:GetTagged(tag)) do
		applyPrompt(prompt, tag)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(function(prompt)
		applyPrompt(prompt, tag)
	end)
end

local function rainbowLoop()
	while true do
		task.wait(0.1)
		local hue = (os.clock() * 0.25) % 1
		local color = Color3.fromHSV(hue, 0.85, 1)
		for _, model in ipairs(CollectionService:GetTagged("RainbowFigure")) do
			for _, part in ipairs(model:GetDescendants()) do
				if part:IsA("BasePart") and part.Name ~= "Root" and not part:GetAttribute("NoTint") then
					part.Color = color
				end
			end
		end
		for _, model in ipairs(CollectionService:GetTagged("SecretFigure")) do
			local root = model.PrimaryPart
			local info = root and root:FindFirstChild("Info")
			if info and info:FindFirstChild("RarityLabel") then
				info.RarityLabel.TextColor3 = color
			end
		end
	end
end

local function animateBelt()
	local conveyor = Workspace:WaitForChild("Conveyor", 30)
	local stripesFolder = conveyor and conveyor:WaitForChild("Stripes", 10)
	if not stripesFolder then
		return
	end
	local stripes = stripesFolder:GetChildren()
	local origins = {}
	for i, stripe in ipairs(stripes) do
		origins[i] = stripe.CFrame
	end
	local length = 180
	local speed = length / Config.Conveyor.TravelTime
	RunService.RenderStepped:Connect(function()
		local offset = (os.clock() * speed) % 10
		for i, stripe in ipairs(stripes) do
			local origin = origins[i]
			local x = origin.Position.X + offset
			if x > 90 then
				x -= length
			end
			stripe.CFrame = CFrame.new(x, origin.Position.Y, origin.Position.Z)
		end
	end)
end

local function markOwnBase()
	local bases = Workspace:WaitForChild("Bases")
	local function check(base)
		if base:GetAttribute("OwnerId") ~= player.UserId then
			return
		end
		local sign = base:WaitForChild("Sign", 10)
		if not sign or sign:FindFirstChild("MineMarker") then
			return
		end
		local gui = Instance.new("BillboardGui")
		gui.Name = "MineMarker"
		gui.Size = UDim2.new(14, 0, 3, 0)
		gui.StudsOffset = Vector3.new(0, 6, 0)
		gui.AlwaysOnTop = true
		gui.MaxDistance = 1000
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.Text = "⬇ DEINE BASIS ⬇"
		label.TextColor3 = Color3.fromRGB(120, 255, 140)
		label.TextStrokeTransparency = 0
		label.Parent = gui
		gui.Parent = sign
	end
	for _, base in ipairs(bases:GetChildren()) do
		task.spawn(check, base)
	end
	bases.ChildAdded:Connect(function(base)
		task.wait(0.5)
		check(base)
	end)
end

local function setupChatTags()
	TextChatService.OnIncomingMessage = function(message)
		local props = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		if source then
			local sender = Players:GetPlayerByUserId(source.UserId)
			if sender and sender:GetAttribute("VIP") then
				props.PrefixText = "<font color='#FFD700'>[👑 VIP]</font> " .. message.PrefixText
			end
		end
		return props
	end
end

function World.Update(state)
	local master = state.Passes.MasterThief == true
	if master ~= hasMasterThief then
		hasMasterThief = master
		for _, prompt in ipairs(CollectionService:GetTagged("StealPrompt")) do
			applyPrompt(prompt, "StealPrompt")
		end
	end
end

function World.Init(app)
	App = app
	watchTag("StealPrompt")
	watchTag("OwnerOnlyPrompt")
	task.spawn(rainbowLoop)
	task.spawn(animateBelt)
	task.spawn(markOwnBase)
	pcall(setupChatTags)

	local music = SoundService:FindFirstChild("Music")
	if music and music.SoundId ~= "" then
		music:Play()
	end
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="36">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>