<roblox version="4">
  <Item class="ReplicatedStorage" referent="0">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="1">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config  (ModuleScript)  ->  ReplicatedStorage/Shared/Config
	Alle Balancing-Werte und Robux-IDs an einer Stelle.
	Nach dem Anlegen der Game Passes / Developer Products im Creator Dashboard
	die IDs unten eintragen (0 = noch nicht angelegt).
	Optional pro Pass/Product: Image = "rbxassetid://123..." zeigt im Shop ein Bild statt Emoji
	(Bilder liegen fertig in marketing/icons/).
]]

local Config = {}

------------------------------------------------------------------------
-- Allgemein
------------------------------------------------------------------------
Config.GameName = "Brainrot Bandits"
Config.GroupId = 0 -- deine Roblox-Gruppen-ID (Gruppen-Bonus +10 %), 0 = aus

Config.StartCash = 100
Config.BaseSlots = 10
Config.MaxRebirthSlots = 5
Config.PassSlots = 5
Config.PremiumSlot = 21
Config.SellRatio = 0.5
Config.WalkSpeed = 16
Config.SpeedPassWalkSpeed = 21

Config.Conveyor = {
	SpawnInterval = 2.5,
	TravelTime = 18,
	MaxFigures = 12,
	PityThreshold = 400,
	BuyDistance = 16,
	ReserveSeconds = 12, -- Mythic-Drop: so lange darf nur der Käufer kaufen
}

------------------------------------------------------------------------
-- Seltenheiten
------------------------------------------------------------------------
Config.RarityOrder = { "Common", "Rare", "Epic", "Legendary", "Mythic", "Secret" }

Config.Rarities = {
	Common = { Rank = 1, Display = "Common", Color = Color3.fromRGB(180, 180, 180), Weight = 62, LuckyWeight = 50 },
	Rare = { Rank = 2, Display = "Rare", Color = Color3.fromRGB(60, 140, 255), Weight = 25, LuckyWeight = 28 },
	Epic = { Rank = 3, Display = "Epic", Color = Color3.fromRGB(166, 75, 255), Weight = 9, LuckyWeight = 13.5 },
	Legendary = { Rank = 4, Display = "Legendary", Color = Color3.fromRGB(255, 180, 0), Weight = 3.2, LuckyWeight = 6 },
	Mythic = { Rank = 5, Display = "Mythic", Color = Color3.fromRGB(255, 60, 60), Weight = 0.7, LuckyWeight = 2.2 },
	Secret = { Rank = 6, Display = "SECRET", Color = Color3.fromRGB(255, 255, 255), Weight = 0.1, LuckyWeight = 0.3 },
}

------------------------------------------------------------------------
-- Mutationen
------------------------------------------------------------------------
Config.MutationOrder = { "Normal", "Gold", "Diamond", "Rainbow" }

Config.Mutations = {
	Normal = { Display = "", Chance = 94.8, PriceMult = 1, IncomeMult = 1 },
	Gold = { Display = "Gold", Chance = 4, PriceMult = 1.5, IncomeMult = 2, Color = Color3.fromRGB(255, 200, 40) },
	Diamond = { Display = "Diamant", Chance = 1, PriceMult = 3, IncomeMult = 5, Color = Color3.fromRGB(110, 230, 255) },
	Rainbow = { Display = "Regenbogen", Chance = 0.2, PriceMult = 6, IncomeMult = 12, Color = Color3.fromRGB(255, 120, 220) },
}
Config.LuckyMutationMult = 2 -- bei Lucky Spawn doppelte Mutations-Chancen

------------------------------------------------------------------------
-- Einkommen
------------------------------------------------------------------------
Config.Multipliers = {
	DoubleCash = 2,
	VIP = 1.1,
	Premium = 1.1,
	Group = 1.1,
	FriendPer = 0.1,
	FriendMax = 3,
	Boost = 2,
	RebirthPer = 0.5,
}
Config.IndexBonus = { { Count = 30, Bonus = 0.15 }, { Count = 20, Bonus = 0.10 }, { Count = 10, Bonus = 0.05 } }

Config.Offline = {
	MinSeconds = 60,
	Ratio = 0.2,
	MaxSeconds = 2 * 3600,
	VipRatio = 0.4,
	VipMaxSeconds = 6 * 3600,
}

------------------------------------------------------------------------
-- Stehlen, Klatsche, Schloss
------------------------------------------------------------------------
Config.Steal = {
	HoldTime = 2,
	MasterHoldTime = 1,
	CarrySpeedMult = 0.7,
	MasterCarrySpeedMult = 0.85,
	MaxCarryTime = 40,
	Cooldown = 20,
	NewbieProtection = 300,
	PromptDistance = 10,
}

Config.Bonk = {
	Range = 9,
	SuperRange = 14,
	Stun = 1.5,
	SuperStun = 2.5,
	Cooldown = 0.8,
}

Config.Lock = {
	BaseDuration = 60,
	PerRebirth = 5,
	MaxDuration = 120,
	ExtendSeconds = 300,
}

------------------------------------------------------------------------
-- Rebirth
------------------------------------------------------------------------
Config.Rebirth = {
	BaseCost = 2500000,
	CostFactor = 3,
}

function Config.RebirthCost(currentRebirths)
	return Config.Rebirth.BaseCost * Config.Rebirth.CostFactor ^ currentRebirths
end

function Config.RebirthRequirement(currentRebirths)
	local nextRebirth = currentRebirths + 1
	if nextRebirth <= 2 then
		return "Legendary"
	elseif nextRebirth <= 4 then
		return "Mythic"
	end
	return "Secret"
end

------------------------------------------------------------------------
-- Robux: Game Passes  (Id im Creator Dashboard anlegen und hier eintragen)
------------------------------------------------------------------------
Config.GamePassOrder = { "DoubleCash", "VIP", "ExtraSlots", "AutoCollect", "MasterThief", "Speed", "SuperBonk" }

Config.GamePasses = {
	DoubleCash = { Id = 0, Price = 249, Icon = "💰", Name = "2x Cash", Desc = "Verdoppelt dein komplettes Einkommen. Für immer!" },
	VIP = { Id = 0, Price = 349, Icon = "👑", Name = "VIP", Desc = "+10 % Cash, VIP-Tag im Chat, doppelte Tagesbelohnung, 40 % Offline-Einkommen bis 6 h" },
	ExtraSlots = { Id = 0, Price = 299, Icon = "🏠", Name = "+5 Basis-Slots", Desc = "5 zusätzliche Plätze für deine Brainrots" },
	AutoCollect = { Id = 0, Price = 179, Icon = "🧲", Name = "Auto-Collect", Desc = "Cash landet automatisch auf deinem Konto" },
	MasterThief = { Id = 0, Price = 199, Icon = "🦹", Name = "Meisterdieb", Desc = "Doppelt so schnell stehlen und schneller wegrennen" },
	Speed = { Id = 0, Price = 129, Icon = "👟", Name = "Turbo-Schuhe", Desc = "+30 % Laufgeschwindigkeit" },
	SuperBonk = { Id = 0, Price = 149, Icon = "🔨", Name = "Mega-Klatsche", Desc = "Mehr Reichweite und Diebe sind länger betäubt" },
}

------------------------------------------------------------------------
-- Robux: Developer Products
------------------------------------------------------------------------
Config.ProductOrder = {
	"StarterPack", "Boost2x", "CashSmall", "CashMedium", "CashLarge", "CashMega",
	"LuckySpawn", "MythicDrop", "LockExtend", "OfflineTriple",
}

Config.Products = {
	StarterPack = { Id = 0, Price = 49, Icon = "🎁", Name = "Starter-Paket", Desc = "Gold-Turbo-Tortellino (Epic) + 25K Cash + 30 Min 2x Cash. Nur einmal!" },
	Boost2x = { Id = 0, Price = 49, Icon = "⚡", Name = "2x Cash (30 Min)", Desc = "Verdoppelt dein Einkommen 30 Minuten lang. Stapelbar!", Seconds = 1800 },
	CashSmall = { Id = 0, Price = 25, Icon = "💵", Name = "Cash-Beutel", Seconds = 300, Min = 1000 },
	CashMedium = { Id = 0, Price = 79, Icon = "💰", Name = "Cash-Koffer", Seconds = 1200, Min = 5000 },
	CashLarge = { Id = 0, Price = 199, Icon = "🏦", Name = "Cash-Tresor", Seconds = 3600, Min = 25000 },
	CashMega = { Id = 0, Price = 499, Icon = "💎", Name = "Cash-Berg", Seconds = 10800, Min = 100000 },
	LuckySpawn = { Id = 0, Price = 99, Icon = "🍀", Name = "Lucky Spawn", Desc = "10 Min bessere Chancen auf dem Förderband, für den ganzen Server!", Seconds = 600 },
	MythicDrop = { Id = 0, Price = 249, Icon = "🔥", Name = "Mythic-Drop", Desc = "Ein Mythic erscheint sofort auf dem Band, 12 s nur für dich reserviert" },
	LockExtend = { Id = 0, Price = 29, Icon = "🔐", Name = "Schloss +5 Min", Desc = "Deine Basis ist sofort 5 Minuten extra gesichert" },
	OfflineTriple = { Id = 0, Price = 25, Icon = "😴", Name = "Offline-Cash x3", Desc = "Verdreifacht dein letztes Offline-Einkommen" },
}

------------------------------------------------------------------------
-- Retention
------------------------------------------------------------------------
-- Tagesbelohnung (7-Tage-Zyklus). Cash = max(Min, Einkommen/s * Seconds)
Config.Daily = {
	{ Type = "Cash", Seconds = 300, Min = 500, Text = "Cash" },
	{ Type = "Cash", Seconds = 600, Min = 1500, Text = "Cash" },
	{ Type = "Boost", Seconds = 900, Text = "15 Min 2x Cash" },
	{ Type = "Cash", Seconds = 1200, Min = 5000, Text = "Cash" },
	{ Type = "Cash", Seconds = 1800, Min = 10000, Text = "Cash" },
	{ Type = "Boost", Seconds = 1800, Text = "30 Min 2x Cash" },
	{ Type = "Figure", Rarity = "Epic", Text = "Epic-Figur!" },
}

-- Spielzeit-Geschenke pro Sitzung
Config.PlaytimeGifts = {
	{ Minutes = 2, Seconds = 120, Min = 200 },
	{ Minutes = 5, Seconds = 240, Min = 600 },
	{ Minutes = 10, Seconds = 360, Min = 1500 },
	{ Minutes = 15, Seconds = 480, Min = 3000 },
	{ Minutes = 25, Seconds = 600, Min = 6000 },
	{ Minutes = 40, Seconds = 900, Min = 12000 },
	{ Minutes = 60, Boost = 900 },
}

-- Tages-Quests (3 pro Tag zufällig)
Config.QuestPool = {
	{ Key = "Buy", Goal = 15, Text = "Kaufe 15 Figuren", Seconds = 600, Min = 2000 },
	{ Key = "BuyRare", Goal = 3, Text = "Kaufe 3 Rare oder besser", Seconds = 900, Min = 5000 },
	{ Key = "Collect", Goal = 10, Text = "Sammle 10x dein Cash ein", Seconds = 600, Min = 2000 },
	{ Key = "Steal", Goal = 2, Text = "Stiehl 2 Figuren", Seconds = 1200, Min = 8000 },
	{ Key = "Defend", Goal = 1, Text = "Erwische einen Dieb mit der Klatsche", Seconds = 1200, Min = 8000 },
	{ Key = "Bonk", Goal = 10, Text = "Triff 10x mit der Klatsche", Seconds = 600, Min = 2000 },
	{ Key = "Lock", Goal = 3, Text = "Schließ deine Basis 3x ab", Seconds = 600, Min = 2000 },
	{ Key = "Play", Goal = 15, Text = "Spiele 15 Minuten", Seconds = 900, Min = 4000 },
	{ Key = "Sell", Goal = 5, Text = "Verkaufe 5 Figuren", Seconds = 600, Min = 2000 },
}
Config.QuestsPerDay = 3

-- Events (UTC)
Config.Events = {
	WeekendCashMult = 2, -- Samstag + Sonntag
	HappyHourStartUTC = 18, -- jeden Tag 18-19 Uhr UTC: Lucky Spawn gratis
	HappyHourEndUTC = 19,
}

Config.Announce = {
	ServerMinRarity = "Legendary",
	GlobalMinRarity = "Secret",
}

-- Monetarisierungs-Popups
Config.StarterOfferAfter = 150 -- Sekunden nach dem Beitritt
Config.FavoriteHintAfter = 600

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">FigureBuilder</string>
          <string name="Source"><![CDATA[--[[
	FigureBuilder  (ModuleScript)  ->  ReplicatedStorage/Shared/FigureBuilder
	Baut ein Figuren-Modell:
	  - eigenes Modell aus ReplicatedStorage/FigureModels/<Key>, falls vorhanden
	  - sonst automatischer Platzhalter in den Figurfarben
	Danach: Mutations-Look, Seltenheits-Licht, Namensschild.
	Root ist verankert, alle anderen Teile sind per WeldConstraint an Root geschweißt.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = script.Parent
local Config = require(Shared:WaitForChild("Config"))
local Figures = require(Shared:WaitForChild("Figures"))
local Format = require(Shared:WaitForChild("Format"))
local FigureDesigns = require(Shared:WaitForChild("FigureDesigns"))

local FigureBuilder = {}

local function newPart(model, name, shape, size, cframe, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Anchored = true
	p.Parent = model
	return p
end

-- Platzhalter: Körper + Kopf + große Augen + Ohren + Füße
local function buildPlaceholder(fig)
	local model = Instance.new("Model")
	local h = fig.Height
	local w = h * 0.7

	local root = newPart(model, "Root", Enum.PartType.Block, Vector3.new(3, 0.2, 3), CFrame.new(0, 0.1, 0), Color3.new(1, 1, 1))
	root.Transparency = 1
	model.PrimaryPart = root

	local bodyCenter = CFrame.new(0, h * 0.32, 0)
	local shapeType = fig.Id % 3
	if shapeType == 0 then
		newPart(model, "Body", Enum.PartType.Block, Vector3.new(w, h * 0.55, w * 0.85), bodyCenter, fig.Color1)
	elseif shapeType == 1 then
		newPart(model, "Body", Enum.PartType.Ball, Vector3.new(w, w, w), bodyCenter, fig.Color1)
	else
		newPart(model, "Body", Enum.PartType.Cylinder, Vector3.new(h * 0.55, w, w), bodyCenter * CFrame.Angles(0, 0, math.rad(90)), fig.Color1)
	end

	local headSize = h * 0.45
	local headCenter = CFrame.new(0, h * 0.78, -h * 0.05)
	newPart(model, "Head", Enum.PartType.Ball, Vector3.new(headSize, headSize, headSize), headCenter, fig.Color1)

	-- Augen schauen nach vorne (-Z)
	for _, side in ipairs({ -1, 1 }) do
		local eye = newPart(model, "Eye", Enum.PartType.Ball, Vector3.one * h * 0.16,
			headCenter * CFrame.new(side * h * 0.1, h * 0.04, -headSize * 0.42), Color3.new(1, 1, 1))
		eye:SetAttribute("NoTint", true)
		local pupil = newPart(model, "Pupil", Enum.PartType.Ball, Vector3.one * h * 0.075,
			headCenter * CFrame.new(side * h * 0.1, h * 0.04, -headSize * 0.42 - h * 0.06), Color3.new(0.05, 0.05, 0.05))
		pupil:SetAttribute("NoTint", true)

		newPart(model, "Ear", Enum.PartType.Block, Vector3.new(h * 0.1, h * 0.16, h * 0.1),
			headCenter * CFrame.new(side * headSize * 0.32, headSize * 0.48, 0) * CFrame.Angles(0, 0, math.rad(-side * 15)), fig.Color2)
		newPart(model, "Foot", Enum.PartType.Ball, Vector3.new(h * 0.2, h * 0.12, h * 0.26),
			CFrame.new(side * w * 0.28, h * 0.06, -w * 0.2), fig.Color2)
	end

	newPart(model, "Mouth", Enum.PartType.Block, Vector3.new(h * 0.16, h * 0.03, h * 0.03),
		headCenter * CFrame.new(0, -h * 0.08, -headSize * 0.48), Color3.new(0.1, 0.05, 0.05)):SetAttribute("NoTint", true)
	newPart(model, "Belly", Enum.PartType.Ball, Vector3.new(w * 0.55, h * 0.3, w * 0.2),
		bodyCenter * CFrame.new(0, 0, -w * 0.38), fig.Color2)

	return model
end

-- Baut eine Figur aus den 3D-Daten in FigureDesigns (Basis-Höhe 4 Studs)
local function buildFromDesign(fig, design)
	local model = Instance.new("Model")
	local scale = fig.Height / 4

	local root = newPart(model, "Root", Enum.PartType.Block, Vector3.new(3, 0.2, 3) * scale, CFrame.new(0, 0.1 * scale, 0), Color3.new(1, 1, 1))
	root.Transparency = 1
	model.PrimaryPart = root

	for i, d in ipairs(design) do
		local shape, sx, sy, sz, px, py, pz, hex, rx, ry, rz, material, tintable, alpha =
			d[1], d[2], d[3], d[4], d[5], d[6], d[7], d[8], d[9], d[10], d[11], d[12], d[13], d[14]
		local cf = CFrame.new(px * scale, py * scale, pz * scale) * CFrame.Angles(math.rad(rx), math.rad(ry), math.rad(rz))
		local size = Vector3.new(sx, sy, sz) * scale
		local part
		if shape == "C" then
			part = newPart(model, "Part" .. i, Enum.PartType.Cylinder, Vector3.new(size.Y, size.X, size.Z), cf * CFrame.Angles(0, 0, math.rad(90)), Color3.fromHex(hex))
		else
			part = newPart(model, "Part" .. i, Enum.PartType.Block, size, cf, Color3.fromHex(hex))
			if shape == "E" then
				local mesh = Instance.new("SpecialMesh")
				mesh.MeshType = Enum.MeshType.Sphere
				mesh.Parent = part
			end
		end
		local ok, mat = pcall(function()
			return Enum.Material[material]
		end)
		part.Material = ok and mat or Enum.Material.SmoothPlastic
		part.Transparency = alpha or 0
		if not tintable then
			part:SetAttribute("NoTint", true)
		end
	end
	return model
end

local function getModel(fig)
	local folder = ReplicatedStorage:FindFirstChild("FigureModels")
	local template = folder and folder:FindFirstChild(fig.Key)
	if template and template:IsA("Model") and template.PrimaryPart then
		local clone = template:Clone()
		clone.PrimaryPart.Name = "Root"
		return clone
	end
	if template then
		warn(("[FigureBuilder] Modell '%s' braucht ein PrimaryPart namens Root. Nutze das Standard-Design."):format(fig.Key))
	end
	local design = FigureDesigns[fig.Key]
	if design then
		return buildFromDesign(fig, design)
	end
	return buildPlaceholder(fig)
end

local function applyMutation(model, mutation)
	if mutation == "Normal" or not Config.Mutations[mutation] then
		return
	end
	local info = Config.Mutations[mutation]
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "Root" and not part:GetAttribute("NoTint") then
			if mutation == "Gold" then
				part.Color = part.Color:Lerp(info.Color, 0.65)
				part.Material = Enum.Material.Metal
				part.Reflectance = 0.15
			elseif mutation == "Diamond" then
				part.Color = part.Color:Lerp(info.Color, 0.6)
				part.Material = Enum.Material.Glass
				part.Transparency = math.max(part.Transparency, 0.15)
				part.Reflectance = 0.25
			elseif mutation == "Rainbow" then
				part.Material = Enum.Material.Neon
			end
		end
	end
	if mutation == "Rainbow" then
		CollectionService:AddTag(model, "RainbowFigure")
	end
	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = info.Color
	sparkles.Parent = model.PrimaryPart
end

local function applyRarityFx(model, fig)
	local rarity = Config.Rarities[fig.Rarity]
	if rarity.Rank >= 4 then
		local light = Instance.new("PointLight")
		light.Color = rarity.Color
		light.Range = 8 + rarity.Rank * 2
		light.Brightness = 1.5
		light.Parent = model.PrimaryPart
	end
	if fig.Rarity == "Secret" then
		CollectionService:AddTag(model, "SecretFigure")
	end
end

local function addInfo(model, fig, mutation, mode)
	local height = model:GetExtentsSize().Y
	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.new(8, 0, 2.7, 0)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height + 1.4, 0)
	gui.MaxDistance = 70
	gui.LightInfluence = 0
	gui.Adornee = model.PrimaryPart

	local function label(name, text, color, y, hgt)
		local l = Instance.new("TextLabel")
		l.Name = name
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromScale(0, y)
		l.Size = UDim2.fromScale(1, hgt)
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.Text = text
		l.TextColor3 = color
		l.TextStrokeTransparency = 0
		l.Parent = gui
		return l
	end

	local rarity = Config.Rarities[fig.Rarity]
	local mut = Figures.Mutation(mutation)
	local nameColor = mut.Color or Color3.new(1, 1, 1)
	label("NameLabel", Figures.DisplayName(fig.Id, mutation), nameColor, 0, 0.38)
	label("RarityLabel", rarity.Display, rarity.Color, 0.38, 0.28)
	if mode == "Conveyor" then
		label("ValueLabel", Format.Money(Figures.Price(fig.Id, mutation)), Color3.fromRGB(120, 255, 140), 0.66, 0.34)
	else
		label("ValueLabel", Format.Money(Figures.Income(fig.Id, mutation)) .. "/s", Color3.fromRGB(255, 230, 90), 0.66, 0.34)
	end
	gui.Parent = model.PrimaryPart
end

local function weldToRoot(model)
	local root = model.PrimaryPart
	root.Anchored = true
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = part == root
			part.Massless = true
			if part ~= root then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = root
				weld.Part1 = part
				weld.Parent = part
				part.Anchored = false
			end
		elseif part:IsA("Script") or part:IsA("LocalScript") or part:IsA("Sound") then
			part:Destroy()
		end
	end
end

--[[
	opts.Mode:  "Conveyor" (Preis), "Base" (Einkommen), "Carry" (klein, ohne Schild)
	opts.Ghost: halb durchsichtig (wird gerade gestohlen)
]]
function FigureBuilder.Build(id, mutation, opts)
	opts = opts or {}
	local fig = Figures.Get(id)
	if not fig then
		return nil
	end
	mutation = mutation or "Normal"

	local model = getModel(fig)
	model.Name = fig.Key
	model:SetAttribute("FigureId", id)
	model:SetAttribute("Mutation", mutation)
	model:PivotTo(CFrame.new())

	applyMutation(model, mutation)
	applyRarityFx(model, fig)
	weldToRoot(model)

	if opts.Mode == "Carry" then
		pcall(function()
			model:ScaleTo(0.6)
		end)
	else
		addInfo(model, fig, mutation, opts.Mode)
	end

	if opts.Ghost then
		for _, part in ipairs(model:GetDescendants()) do
			if part:IsA("BasePart") and part.Name ~= "Root" then
				part.Transparency = math.max(part.Transparency, 0.75)
			end
		end
		local info = model.PrimaryPart:FindFirstChild("Info")
		if info then
			info.ValueLabel.Text = "⚠ WIRD GESTOHLEN!"
			info.ValueLabel.TextColor3 = Color3.fromRGB(255, 70, 70)
		end
	end

	return model
end

-- Stellt das Modell mit der Unterseite von Root auf eine Oberfläche
function FigureBuilder.PlaceOn(model, surfaceCFrame)
	local root = model.PrimaryPart
	model:PivotTo(surfaceCFrame * CFrame.new(0, root.Size.Y / 2, 0))
end

return FigureBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">FigureDesigns</string>
          <string name="Source"><![CDATA[--[[
	FigureDesigns  (ModuleScript)  ->  ReplicatedStorage/Shared/FigureDesigns
	AUTOMATISCH ERZEUGT von tools/figure_designs.py. Nicht von Hand ändern.
	3D-Designs aller Figuren aus Roblox-Parts (Basis-Höhe 4, -Z = vorne).
	Format pro Teil: { Form, sx, sy, sz, px, py, pz, Farbe, rx, ry, rz, Material, Färbbar, Transparenz }
	Form: E = Ellipsoid, B = Block, C = Zylinder (stehend)
]]

return {
	SpagettoGecko = {
		{ "E", 2.2, 1.3, 3, 0, 0.8, 0.3, "#F2D16B", 0, 0, 0, "SmoothPlastic", true, 0 },
