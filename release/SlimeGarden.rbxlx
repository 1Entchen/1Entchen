      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Stock</string>
          <string name="Source"><![CDATA[--!strict
-- Seed shop restock roll. Every restock rolls each species independently
-- against its published stock chance; quantities are per player, so nobody
-- can buy out the shop on someone else.

local Species = require(script.Parent.Species)

local Stock = {}

function Stock.roll(rng: () -> number): { [string]: number }
	local stock: { [string]: number } = {}
	for _, species in Species.shopOrder do
		if rng() < species.stockChance then
			local span = species.stockMax - species.stockMin
			stock[species.id] = species.stockMin + math.floor(rng() * (span + 1))
		end
	end
	return stock
end

return Stock
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- Shared type definitions that cross the client/server boundary or are
-- persisted. Persisted shapes must stay JSON-encodable (string keys or
-- dense arrays only, no Instances).

export type Rarity = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary" | "Mythic" | "Exclusive"

export type Species = {
	id: string,
	name: string,
	tier: number, -- 1..10 for shop seeds, 0 for exclusives
	rarity: Rarity,
	price: number, -- coin price in the seed shop (0 = not sold for coins)
	growTime: number, -- seconds of growth at 1x speed
	value: number, -- base coin value of a 1.0 weight slime
	color: Color3,
	accent: Color3,
	material: Enum.Material,
	transparency: number,
	stockChance: number, -- probability [0,1] the seed appears in a restock
	stockMin: number,
	stockMax: number,
	requiresRebirth: number,
	flavor: string,
}

export type MutationKind = "variant" | "weather"

export type Mutation = {
	id: string,
	name: string,
	kind: MutationKind,
	multiplier: number,
	color: Color3,
	-- variant: chance rolled once when a slime ripens.
	-- weather: chance per minute while the matching weather is active.
	chance: number,
	weather: string?,
	order: number,
}

-- A slime growing on a garden tile (persisted).
export type PlantData = {
	tile: number,
	s: string, -- species id
	w: number, -- weight multiplier
	e: number, -- growth-seconds accumulated
	m: { string }, -- mutation ids
	r: boolean, -- variant roll done (happens once, at ripening)
	b: number?, -- base value override (exclusive seeds)
}

-- A harvested slime in the backpack (persisted).
export type SlimeData = {
	id: number,
	s: string,
	w: number,
	m: { string },
	b: number?,
	f: boolean?, -- favorited: protected from Sell All and kept on rebirth
}

export type QuestData = {
	kind: string,
	target: number,
	progress: number,
	claimed: boolean,
	rewardCoins: number,
	rewardItem: string?,
}

export type Profile = {
	version: number,
	coins: number,
	totalEarned: number,
	rebirths: number,
	bestTier: number,
	seeds: { [string]: number },
	slimes: { SlimeData },
	nextSlimeId: number,
	plants: { PlantData },
	unlockedTiles: number,
	potions: { [string]: number },
	boostExpiry: { [string]: number }, -- unix time a timed boost ends
	instantGrowCharges: number,
	index: { [string]: boolean }, -- "goo" or "goo:golden"
	daily: { lastClaimDay: number, streak: number },
	quests: { day: number, list: { QuestData } },
	tutorialStep: number,
	stats: {
		harvested: number,
		planted: number,
		seedsBought: number,
		robuxSpent: number,
		sessions: number,
		playSeconds: number,
		firstJoin: number,
	},
	receipts: { string },
	passCache: { [string]: boolean },
	starterPackClaimed: boolean,
	autoHarvest: boolean,
	lastSeen: number,
}

export type BoostEntry = {
	key: string,
	label: string,
	icon: string,
	expiresAt: number?, -- server time (workspace:GetServerTimeNow scale) when it ends
}

export type Multipliers = {
	sell: number,
	growth: number,
	luck: number,
}

export type WeatherState = {
	id: string?,
	endsAt: number, -- server time
	summonedBy: string?,
	nextAt: number, -- server time of the next natural event (approximate)
}

export type StockState = {
	restockId: number,
	nextRestockAt: number, -- server time
	stock: { [string]: number },
}

return nil
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Weathers</string>
          <string name="Source"><![CDATA[--!strict
-- Server-wide weather events. Each one boosts the whole server and can add a
-- matching mutation to ripe slimes, which rewards players for being online
-- (and harvesting at the right moment) without punishing anyone.

export type Weather = {
	id: string,
	name: string,
	icon: string,
	description: string,
	weight: number, -- relative chance when a natural event is picked
	growthMultiplier: number,
	tint: Color3,
}

local Weathers = {}

local list: { Weather } = {
	{
		id = "goorain",
		name = "Goo Rain",
		icon = "🌧️",
		description = "Slimes grow 1.5x faster and may become Drenched (x2).",
		weight = 40,
		growthMultiplier = 1.5,
		tint = Color3.fromRGB(180, 255, 200),
	},
	{
		id = "goldenhour",
		name = "Golden Hour",
		icon = "🌅",
		description = "Ripe slimes may become Sunkissed (x2.5).",
		weight = 30,
		growthMultiplier = 1,
		tint = Color3.fromRGB(255, 210, 150),
	},
	{
		id = "snowfall",
		name = "Snowfall",
		icon = "❄️",
		description = "Ripe slimes may become Frozen (x3).",
		weight = 22,
		growthMultiplier = 1,
		tint = Color3.fromRGB(200, 225, 255),
	},
	{
		id = "starfall",
		name = "Starfall",
		icon = "🌠",
		description = "Ripe slimes may become Starstruck (x8)!",
		weight = 8,
		growthMultiplier = 1,
		tint = Color3.fromRGB(200, 170, 255),
	},
}

local byId: { [string]: Weather } = {}
local totalWeight = 0
for _, weather in list do
	byId[weather.id] = weather
	totalWeight += weather.weight
end

Weathers.list = list
Weathers.byId = byId
Weathers.totalWeight = totalWeight

function Weathers.get(id: string?): Weather?
	if id == nil then
		return nil
	end
	return byId[id]
end

-- Picks a weather id from a uniform number in [0, 1).
function Weathers.pick(roll: number): string
	local target = roll * totalWeight
	local acc = 0
	for _, weather in list do
		acc += weather.weight
		if target < acc then
			return weather.id
		end
	end
	return list[#list].id
end

return Weathers
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="23">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="24">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- The single server entry point. Systems load in dependency order; every
-- system's init() runs before any start(), so cross-system registration
-- (remotes, sync sections, product handlers) is complete before gameplay.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local Systems = script:WaitForChild("Systems")

local ORDER = {
	"DataService",
	"Sync",
	"Analytics",
	"Monetization",
	"Weather",
	"Boosts",
	"Tutorial",
	"Retention",
	"Index",
	"Plots",
	"Garden",
	"Shop",
	"Sell",
	"Rebirth",
	"Leaderboard",
}

type System = { init: (() -> ())?, start: (() -> ())? }

Net.setup()

local loaded: { { name: string, system: System } } = {}
for _, name in ORDER do
	local module = Systems:WaitForChild(name) :: ModuleScript
	local system = (require :: any)(module) :: System
	table.insert(loaded, { name = name, system = system })
end

for _, entry in loaded do
	local init = entry.system.init
	if init then
		local ok, err = pcall(init :: any)
		if not ok then
			warn(`[Server] {entry.name}.init failed: {err}`)
		end
	end
end

for _, entry in loaded do
	local start = entry.system.start
	if start then
		task.spawn(function()
			local ok, err = pcall(start :: any)
			if not ok then
				warn(`[Server] {entry.name}.start failed: {err}`)
			end
		end)
	end
end

-- Begin loading players only once every system is listening.
task.defer(function()
	local DataService = require(Systems:WaitForChild("DataService")) :: any
	DataService.listen()
	print("[Slime Garden] server started")
end)
]]></string>
      </Properties>
      <Item class="Folder" referent="25">
        <Properties>
          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Schema</string>
            <string name="Source"><![CDATA[--!strict
-- Player profile schema: defaults, migrations and reconciliation. Pure
-- functions so they can be tested outside Roblox.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Species = require(Shared:WaitForChild("Species"))
local Types = require(Shared:WaitForChild("Types"))

type Profile = Types.Profile

local Schema = {}

Schema.CURRENT_VERSION = 1

function Schema.defaults(now: number): Profile
	return {
		version = Schema.CURRENT_VERSION,
		coins = 30,
		totalEarned = 0,
		rebirths = 0,
		bestTier = 1,
		seeds = { goo = 3 },
		slimes = {},
		nextSlimeId = 1,
		plants = {},
		unlockedTiles = Config.Plots.StartingTiles,
		potions = {},
		boostExpiry = {},
		instantGrowCharges = 0,
		index = {},
		daily = { lastClaimDay = -1, streak = 0 },
		quests = { day = -1, list = {} },
		tutorialStep = 0,
		stats = {
			harvested = 0,
			planted = 0,
			seedsBought = 0,
			robuxSpent = 0,
			sessions = 0,
			playSeconds = 0,
			firstJoin = now,
		},
		receipts = {},
		passCache = {},
		starterPackClaimed = false,
		autoHarvest = true,
		lastSeen = now,
	}
end

-- Migrations from version N to N+1. Add entries as the schema evolves, never
-- edit an entry that has shipped.
local MIGRATIONS: { [number]: (any) -> any } = {}

function Schema.migrate(data: any): any
	local version = tonumber(data.version) or 1
	while version < Schema.CURRENT_VERSION do
		local step = MIGRATIONS[version]
		assert(step, `missing profile migration from v{version}`)
		data = step(data)
		version += 1
		data.version = version
	end
	return data
end

local function isFiniteNumber(value: unknown): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function number(value: unknown, fallback: number, minimum: number?): number
	if not isFiniteNumber(value) then
		return fallback
	end
	local n = value :: number
	if minimum and n < minimum then
		return minimum
	end
	return n
end

local function stringList(value: unknown): { string }
	local result = {}
	if typeof(value) == "table" then
		for _, item in value :: { any } do
			if typeof(item) == "string" then
				table.insert(result, item)
			end
		end
	end
	return result
end

local function countMap(value: unknown): { [string]: number }
	local result = {}
	if typeof(value) == "table" then
		for key, count in value :: { [any]: any } do
			if typeof(key) == "string" and isFiniteNumber(count) and count > 0 then
				result[key] = math.floor(count)
			end
		end
	end
	return result
end

-- Fills missing fields and repairs corrupt ones so gameplay code can trust
-- the shape. Unknown keys are kept (forward compatibility with newer
-- servers during a rolling update).
function Schema.reconcile(raw: any, now: number): Profile
	local defaults = Schema.defaults(now)
	if typeof(raw) ~= "table" then
		return defaults
	end
	local data = raw :: any

	data.version = number(data.version, Schema.CURRENT_VERSION)
	data.coins = number(data.coins, defaults.coins, 0)
	data.totalEarned = number(data.totalEarned, 0, 0)
	data.rebirths = math.floor(number(data.rebirths, 0, 0))
	data.bestTier = math.clamp(math.floor(number(data.bestTier, 1, 1)), 1, Species.MaxTier)
	data.seeds = countMap(data.seeds)
	data.potions = countMap(data.potions)
	data.nextSlimeId = math.floor(number(data.nextSlimeId, 1, 1))
	data.unlockedTiles = math.clamp(
		math.floor(number(data.unlockedTiles, defaults.unlockedTiles)),
		0,
		Config.Plots.FreeTileLimit
	)
	data.instantGrowCharges = math.floor(number(data.instantGrowCharges, 0, 0))
	data.tutorialStep = math.floor(number(data.tutorialStep, 0, 0))
	data.starterPackClaimed = data.starterPackClaimed == true
	data.autoHarvest = data.autoHarvest ~= false
	data.lastSeen = number(data.lastSeen, now)

	local boostExpiry = {}
	if typeof(data.boostExpiry) == "table" then
		for key, value in data.boostExpiry do
			if typeof(key) == "string" and isFiniteNumber(value) then
				boostExpiry[key] = value
			end
		end
	end
	data.boostExpiry = boostExpiry

	local index = {}
	if typeof(data.index) == "table" then
		for key, value in data.index do
			if typeof(key) == "string" and value == true then
				index[key] = true
			end
		end
	end
	data.index = index

	local passCache = {}
	if typeof(data.passCache) == "table" then
		for key, value in data.passCache do
			if typeof(key) == "string" and value == true then
				passCache[key] = true
			end
		end
	end
	data.passCache = passCache

	local slimes = {}
	local maxId = 0
	if typeof(data.slimes) == "table" then
		for _, slime in data.slimes do
			if
				typeof(slime) == "table"
				and Species.isValidId(slime.s)
				and isFiniteNumber(slime.id)
				and isFiniteNumber(slime.w)
			then
				local entry: Types.SlimeData = {
					id = math.floor(slime.id),
					s = slime.s,
					w = slime.w,
					m = stringList(slime.m),
					b = if isFiniteNumber(slime.b) then slime.b else nil,
					f = if slime.f == true then true else nil,
				}
				maxId = math.max(maxId, entry.id)
				table.insert(slimes, entry)
			end
		end
	end
	data.slimes = slimes
	data.nextSlimeId = math.max(data.nextSlimeId, maxId + 1)

	local plants = {}
	local usedTiles = {}
	if typeof(data.plants) == "table" then
		for _, plant in data.plants do
			if
				typeof(plant) == "table"
				and Species.isValidId(plant.s)
				and isFiniteNumber(plant.tile)
				and isFiniteNumber(plant.w)
				and not usedTiles[plant.tile]
			then
				usedTiles[plant.tile] = true
				table.insert(plants, {
					tile = math.floor(plant.tile),
					s = plant.s,
					w = plant.w,
					e = number(plant.e, 0, 0),
					m = stringList(plant.m),
					r = plant.r == true,
					b = if isFiniteNumber(plant.b) then plant.b else nil,
				})
			end
		end
	end
	data.plants = plants

	local daily = if typeof(data.daily) == "table" then data.daily else {}
	data.daily = {
		lastClaimDay = math.floor(number(daily.lastClaimDay, -1)),
		streak = math.floor(number(daily.streak, 0, 0)),
	}

	local quests = if typeof(data.quests) == "table" then data.quests else {}
	local questList = {}
	if typeof(quests.list) == "table" then
		for _, quest in quests.list do
			if typeof(quest) == "table" and typeof(quest.kind) == "string" then
				table.insert(questList, {
					kind = quest.kind,
					target = number(quest.target, 1, 1),
					progress = number(quest.progress, 0, 0),
					claimed = quest.claimed == true,
					rewardCoins = number(quest.rewardCoins, 0, 0),
					rewardItem = if typeof(quest.rewardItem) == "string" then quest.rewardItem else nil,
				})
			end
		end
	end
	data.quests = { day = math.floor(number(quests.day, -1)), list = questList }

	local stats = if typeof(data.stats) == "table" then data.stats else {}
	data.stats = {
		harvested = number(stats.harvested, 0, 0),
		planted = number(stats.planted, 0, 0),
		seedsBought = number(stats.seedsBought, 0, 0),
		robuxSpent = number(stats.robuxSpent, 0, 0),
		sessions = number(stats.sessions, 0, 0),
		playSeconds = number(stats.playSeconds, 0, 0),
		firstJoin = number(stats.firstJoin, now),
	}

	data.receipts = stringList(data.receipts)
	while #data.receipts > Config.Data.MaxReceipts do
		table.remove(data.receipts, 1)
	end

	return data :: Profile
end

-- Deep copy for JSON-shaped data (used before handing data to a DataStore so
-- later in-memory mutation can't race the write).
function Schema.deepCopy<T>(value: T): T
	if typeof(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, child in value :: any do
		copy[key] = Schema.deepCopy(child)
	end
	return copy :: any
end

return Schema
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Store</string>
            <string name="Source"><![CDATA[--!strict
-- Thin adapter over DataStoreService. In Studio without API access it falls
-- back to an in-memory store (with a loud warning) so the game is playable
-- before publishing. Live servers never fall back.

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

export type Transform = (any, any) -> any

export type Store = {
	name: string,
	isMemory: boolean,
	update: (self: Store, key: string, transform: Transform) -> any,
	get: (self: Store, key: string) -> any,
}

local Store = {}

local memoryData: { [string]: { [string]: any } } = {}

local function deepCopy(value: any): any
	if typeof(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

function Store.memory(name: string): Store
	local bucket = memoryData[name]
	if not bucket then
		bucket = {}
		memoryData[name] = bucket
	end
	local store = { name = name, isMemory = true }
	function store.update(_: any, key: string, transform: Transform): any
		-- Copy in and out to mimic serialization: callers never share tables
		-- with the "stored" value.
		local result = transform(deepCopy(bucket[key]), nil)
		if result == nil then
			return deepCopy(bucket[key])
		end
		bucket[key] = deepCopy(result)
		return deepCopy(result)
	end
	function store.get(_: any, key: string): any
		return deepCopy(bucket[key])
	end
	return (store :: any) :: Store
end

local function isStudioAccessError(message: string): boolean
	local lower = string.lower(message)
	return string.find(lower, "studio", 1, true) ~= nil
		or string.find(lower, "publish", 1, true) ~= nil
		or string.find(lower, "403", 1, true) ~= nil
		or string.find(lower, "api services", 1, true) ~= nil
end

function Store.open(name: string): Store
	local ok, dataStore = pcall(function()
		return DataStoreService:GetDataStore(name)
	end)

	if ok and RunService:IsStudio() then
		local probeOk, probeError = pcall(function()
			return dataStore:GetAsync("__studio_probe")
		end)
		if not probeOk and isStudioAccessError(tostring(probeError)) then
			ok = false
		end
	end

	if not ok then
		if RunService:IsStudio() then
			warn(
				`[Store] DataStores unavailable in Studio ({name}). Using TEMPORARY in-memory saves. `
					.. "Publish the place and enable 'Studio Access to API Services' to test real saving."
			)
			return Store.memory(name)
		end
		error(`[Store] could not open DataStore {name}: {dataStore}`)
	end

	local store = { name = name, isMemory = false }
	function store.update(_: any, key: string, transform: Transform): any
		return (dataStore :: DataStore):UpdateAsync(key, transform)
	end
	function store.get(_: any, key: string): any
		return (dataStore :: DataStore):GetAsync(key)
	end
	return (store :: any) :: Store
end

return Store
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Systems</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Analytics</string>
            <string name="Source"><![CDATA[--!strict
-- Wrapper over AnalyticsService. Every call is pcall-protected so analytics
-- can never break gameplay. View results in Creator Dashboard > Analytics
-- (Economy, Funnels, Progression, Custom events).

local AnalyticsService = game:GetService("AnalyticsService")

local Analytics = {}

local function safe(fn: () -> ())
	local ok, err = pcall(fn :: any)
	if not ok then
		warn(`[Analytics] {err}`)
	end
end

-- Coins entering the economy (selling, rewards, purchases).
function Analytics.coinSource(
	player: Player,
	amount: number,
	balance: number,
	transaction: Enum.AnalyticsEconomyTransactionType,
	sku: string
)
	if amount <= 0 then
		return
	end
	safe(function()
		AnalyticsService:LogEconomyEvent(
			player,
			Enum.AnalyticsEconomyFlowType.Source,
			"Coins",
			amount,
			balance,
			transaction.Name,
			sku
		)
	end)
end

-- Coins leaving the economy (seeds, tiles, rebirth).
function Analytics.coinSink(
	player: Player,
	amount: number,
	balance: number,
	transaction: Enum.AnalyticsEconomyTransactionType,
	sku: string
)
	if amount <= 0 then
		return
	end
	safe(function()
		AnalyticsService:LogEconomyEvent(
			player,
			Enum.AnalyticsEconomyFlowType.Sink,
			"Coins",
			amount,
			balance,
			transaction.Name,
			sku
		)
	end)
end

function Analytics.onboarding(player: Player, step: number, stepName: string)
	safe(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(player, step, stepName)
	end)
end

function Analytics.funnel(player: Player, funnel: string, sessionId: string?, step: number, stepName: string)
	safe(function()
		AnalyticsService:LogFunnelStepEvent(player, funnel, sessionId, step, stepName)
	end)
end

function Analytics.progression(player: Player, path: string, level: number, levelName: string?)
	safe(function()
		AnalyticsService:LogProgressionCompleteEvent(player, path, level, levelName)
	end)
end

function Analytics.custom(player: Player, eventName: string, value: number?)
	safe(function()
		AnalyticsService:LogCustomEvent(player, eventName, value)
	end)
end

return Analytics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Boosts</string>
            <string name="Source"><![CDATA[--!strict
-- Computes each player's sell / growth / luck multipliers from passes,
-- potions, weather, Premium, group membership and friends in the server.
-- Fires Changed when a player's multipliers change so growth can be
-- re-based without losing progress.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Signal"))
local Types = require(Shared:WaitForChild("Types"))
local Weathers = require(Shared:WaitForChild("Weathers"))

local Util = script.Parent.Parent:WaitForChild("Util")
local Notify = require(Util:WaitForChild("Notify"))
local RateLimiter = require(Util:WaitForChild("RateLimiter"))
local Validate = require(Util:WaitForChild("Validate"))

local DataService = require(script.Parent.DataService)
local Monetization = require(script.Parent.Monetization)
local Sync = require(script.Parent.Sync)
local Weather = require(script.Parent.Weather)

type Multipliers = Types.Multipliers
type Profile = Types.Profile

local Boosts = {}

Boosts.Changed = Signal.new() :: Signal.Signal<Player, Multipliers>

local POTIONS: { [string]: string } = { growth = "Growth Potion", luck = "Luck Potion" }

local cache: { [Player]: Multipliers } = {}
local friendCache: { [Player]: { [number]: boolean } } = {}
local inGroup: { [Player]: boolean } = {}

local function friendsInServer(player: Player): number
	local known = friendCache[player]
	if not known then
		return 0
	end
	local count = 0
	for _, other in Players:GetPlayers() do
		if other ~= player and known[other.UserId] then
			count += 1
		end
	end
	return count
end

local function isPremium(player: Player): boolean
	return player.MembershipType == Enum.MembershipType.Premium
end

local function compute(player: Player, data: Profile): Multipliers
	local t = os.time()
	local growthPotion = (data.boostExpiry.growth or 0) > t
	local luckPotion = (data.boostExpiry.luck or 0) > t
	return {
		sell = Economy.sellMultiplier({
			rebirths = data.rebirths,
			doubleCoins = Monetization.owns(player, "double_coins"),
			vip = Monetization.owns(player, "vip"),
			premium = isPremium(player),
			friends = friendsInServer(player),
			inGroup = inGroup[player] == true,
		}),
		growth = Economy.growthRate(
			Monetization.owns(player, "fast_grow"),
			growthPotion,
			Weather.growthMultiplier()
		),
		luck = Economy.luck(Monetization.owns(player, "lucky"), luckPotion),
	}
end

function Boosts.get(player: Player): Multipliers
	local cached = cache[player]
	if cached then
		return cached
	end
	local data = DataService.get(player)
	if not data then
		return { sell = 1, growth = 1, luck = 1 }
	end
	local fresh = compute(player, data)
	cache[player] = fresh
	return fresh
end

function Boosts.refresh(player: Player)
	local data = DataService.get(player)
	if not data then
		return
	end
	local fresh = compute(player, data)
	local old = cache[player]
	cache[player] = fresh
	Sync.mark(player, "boosts")
	if not old or old.sell ~= fresh.sell or old.growth ~= fresh.growth or old.luck ~= fresh.luck then
		Boosts.Changed:Fire(player, fresh)
	end
end

local function refreshAll()
	for _, player in Players:GetPlayers() do
		Boosts.refresh(player)
	end
end

-- Adds `seconds` to a timed boost (stacks duration).
function Boosts.activate(player: Player, data: Profile, kind: string, seconds: number)
	local t = os.time()
	data.boostExpiry[kind] = math.max(data.boostExpiry[kind] or 0, t) + seconds
	Boosts.refresh(player)
end

local function serverTimeFor(unixTime: number): number
	return Workspace:GetServerTimeNow() + (unixTime - os.time())
end

local function buildSection(player: Player, data: Profile): any
	local multipliers = Boosts.get(player)
	local list: { Types.BoostEntry } = {}
	local t = os.time()
	for kind, label in POTIONS do
		local expiry = data.boostExpiry[kind] or 0
		if expiry > t then
			table.insert(list, {
				key = kind,
				label = label,
				icon = if kind == "luck" then "🔮" else "🧪",
				expiresAt = serverTimeFor(expiry),
			})
		end
	end
	local weather = Weathers.get(Weather.current())
	if weather and weather.growthMultiplier > 1 then
		table.insert(list, {
			key = "weather",
			label = `{weather.name} x{weather.growthMultiplier} growth`,
			icon = weather.icon,
			expiresAt = Weather.state().endsAt,
		})
	end
	local friends = friendsInServer(player)
	if friends > 0 then
		table.insert(list, {
			key = "friends",
			label = `{math.min(friends, Config.Bonuses.MaxFriends)} friend(s) +{math.floor(
				Config.Bonuses.FriendBonus * math.min(friends, Config.Bonuses.MaxFriends) * 100
			)}% coins`,
			icon = "🤝",
		})
	end
	if isPremium(player) then
		table.insert(list, { key = "premium", label = "Premium +10% coins", icon = "⭐" })
	end
	if inGroup[player] then
		table.insert(list, { key = "group", label = "Group member +10% coins", icon = "🏠" })
	end
	return {
		multipliers = multipliers,
		list = list,
		premium = isPremium(player),
		groupEnabled = Config.GroupId ~= 0,
		inGroup = inGroup[player] == true,
	}
end

local function loadSocial(player: Player)
	local known: { [number]: boolean } = {}
	friendCache[player] = known
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local ok, isFriend = pcall(function()
				return player:IsFriendsWith(other.UserId)
			end)
			if ok and isFriend then
				known[other.UserId] = true
				local otherKnown = friendCache[other]
				if otherKnown then
					otherKnown[player.UserId] = true
				end
			end
		end
	end
	if Config.GroupId ~= 0 then
		local ok, member = pcall(function()
			return player:IsInGroup(Config.GroupId)
		end)
		inGroup[player] = ok and member == true
	end
	refreshAll()
end

local function onUsePotion(player: Player, kind: unknown)
	if not RateLimiter.allow(player, "UsePotion", 2, 4) then
		return
	end
	local data = DataService.get(player)
	local potion = Validate.shortString(kind, 16)
	if not data or not potion or not POTIONS[potion] then
		return
	end
	local count = data.potions[potion] or 0
	if count < 1 then
		return
	end
	if count > 1 then
		data.potions[potion] = count - 1
	else
		data.potions[potion] = nil
	end
	Boosts.activate(player, data, potion, Config.Boosts.PotionDuration)
	Notify.player(player, `{POTIONS[potion]} active for 15 minutes!`, "success")
	Sync.mark(player, "main")
end

local function potionProduct(kind: string): Monetization.ProductHandler
	return function(player: Player, data: Profile): boolean
		Boosts.activate(player, data, kind, Config.Boosts.PotionDuration)
		Notify.player(player, `{POTIONS[kind]} active! +15 minutes. Thank you 💚`, "reward")
		return true
	end
end

function Boosts.init()
	Sync.register("boosts", buildSection)
	Monetization.registerProduct("growth_potion", potionProduct("growth"))
	Monetization.registerProduct("luck_potion", potionProduct("luck"))
end

function Boosts.start()
	Monetization.PlayerReady:Connect(function(player, data)
		-- Potions that ran out while offline expire silently.
		local t = os.time()
		for kind, expiry in data.boostExpiry do
			if expiry <= t then
				data.boostExpiry[kind] = nil
			end
		end
		Boosts.refresh(player)
		task.spawn(loadSocial, player)
	end)
	Monetization.PassesChanged:Connect(function(player)
		Boosts.refresh(player)
	end)
	Weather.Changed:Connect(refreshAll)
	Players.PlayerMembershipChanged:Connect(function(player)
		Boosts.refresh(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		cache[player] = nil
		friendCache[player] = nil
		inGroup[player] = nil
		-- Defer so the leaving player is no longer counted as a friend in server.
		task.defer(refreshAll)
	end)
	Net.event("UsePotion").OnServerEvent:Connect(onUsePotion)

	-- Expire timed boosts.
	task.spawn(function()
		while true do
			task.wait(1)
			local t = os.time()
			for _, player in Players:GetPlayers() do
				local data = DataService.get(player)
				local cached = cache[player]
				if data and cached then
					for kind, label in POTIONS do
						local expiry = data.boostExpiry[kind]
						if expiry and expiry <= t then
							data.boostExpiry[kind] = nil
							Notify.player(player, `{label} has worn off.`, "info")
							Boosts.refresh(player)
						end
					end
				end
			end
		end
	end)
end

return Boosts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
-- Owns every player profile. One server holds a player's data at a time
-- (session lock); gameplay mutates the in-memory profile only and this
-- module persists it on autosave, on leave and on shutdown.
--
-- Safety rules implemented here:
--  * all writes use UpdateAsync and re-check that this server owns the lock
--  * a failed load kicks the player instead of handing out a blank profile
--  * a fresh lock held by another server blocks loading (no dupes)
--  * a lost lock kicks the player instead of overwriting newer data

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Signal = require(Shared:WaitForChild("Signal"))
local Types = require(Shared:WaitForChild("Types"))

local DataFolder = script.Parent.Parent:WaitForChild("Data")
local Schema = require(DataFolder:WaitForChild("Schema"))
local StoreModule = require(DataFolder:WaitForChild("Store"))

type Profile = Types.Profile
type Store = StoreModule.Store

export type Session = {
	player: Player,
	userId: number,
	key: string,
	data: Profile,
	lastSave: number,
	isNew: boolean,
	lockLost: boolean,
}

local DataService = {}

DataService.ProfileLoaded = Signal.new() :: Signal.Signal<Player, Profile>
-- Fired after a player's profile is no longer active (before the final save
-- completes). Systems clean up runtime state here, never mutating data.
DataService.ProfileReleased = Signal.new() :: Signal.Signal<Player>

local JOB_ID = if game.JobId ~= "" then game.JobId else "studio-" .. HttpService:GenerateGUID(false)
local LOAD_ATTEMPTS = 5
local LOCK_WAIT_ATTEMPTS = 6
local LOCK_WAIT_SECONDS = 5
local SAVE_ATTEMPTS = 3

local store: Store? = nil
local sessions: { [Player]: Session } = {}
local loading: { [Player]: boolean } = {}
local releasing: { [number]: boolean } = {}
local saveHooks: { (Player, Profile) -> () } = {}
local shuttingDown = false

DataService.jobId = JOB_ID

local function getStore(): Store
	if not store then
		store = StoreModule.open(Config.Data.StoreName)
	end
	return store :: Store
end

local function keyFor(userId: number): string
	return `u_{userId}`
end

-- Registers a synchronous callback that runs right before every save so
-- systems can flush runtime state (e.g. growth progress) into the profile.
function DataService.addSaveHook(hook: (Player, Profile) -> ())
	table.insert(saveHooks, hook)
end

local function runSaveHooks(player: Player, data: Profile)
	for _, hook in saveHooks do
		local ok, err = pcall(hook :: any, player, data)
		if not ok then
			warn(`[DataService] save hook failed: {err}`)
		end
	end
end

type ClaimResult = { status: "ok", data: Profile, isNew: boolean } | { status: "locked" } | { status: "error" }

local function tryClaim(key: string): ClaimResult
	local now = os.time()
	local lockedByOther = false
	local loaded: Profile? = nil
	local isNew = false

	local ok, err = pcall(function()
		getStore():update(key, function(old: any)
			lockedByOther = false
			loaded = nil
			if typeof(old) ~= "table" then
				old = nil
			end
			local lock = old and old.lock
			if
				typeof(lock) == "table"
				and lock.jobId ~= JOB_ID
				and now - (tonumber(lock.time) or 0) < Config.Data.LockStaleAfter
			then
				lockedByOther = true
				return nil -- abort the write; another live server owns this profile
			end
			isNew = old == nil or old.data == nil
			local raw = if old and old.data then Schema.migrate(old.data) else Schema.defaults(now)
			local data = Schema.reconcile(raw, now)
			loaded = data
			return { data = data, lock = { jobId = JOB_ID, time = now } }
		end)
	end)

	if not ok then
		warn(`[DataService] load failed for {key}: {err}`)
		return { status = "error" }
	end
	if lockedByOther then
		return { status = "locked" }
	end
	if not loaded then
		return { status = "error" }
	end
	return { status = "ok", data = loaded :: Profile, isNew = isNew }
end

-- Writes the profile. Returns false if every attempt failed or the lock was
-- lost (in which case session.lockLost is set).
local function writeSession(session: Session, release: boolean): boolean
	local snapshot = Schema.deepCopy(session.data)
	snapshot.lastSeen = os.time()

	for attempt = 1, SAVE_ATTEMPTS do
		local lost = false
		local ok, err = pcall(function()
			getStore():update(session.key, function(old: any)
				lost = false
				local lock = typeof(old) == "table" and old.lock
				if typeof(lock) ~= "table" or lock.jobId ~= JOB_ID then
					lost = true
					return nil
				end
				return {
					data = snapshot,
					lock = if release then nil else { jobId = JOB_ID, time = os.time() },
				}
			end)
		end)
		if ok and lost then
			session.lockLost = true
			warn(`[DataService] lost session lock for {session.key}; refusing to overwrite`)
			return false
		elseif ok then
			session.lastSave = os.clock()
			return true
		end
		warn(`[DataService] save attempt {attempt}/{SAVE_ATTEMPTS} failed for {session.key}: {err}`)
		if attempt < SAVE_ATTEMPTS and not shuttingDown then
			task.wait(2 ^ attempt)
		end
	end
	return false
end

local function kick(player: Player, message: string)
	if player.Parent then
		player:Kick(message)
	end
end

local function handleLostLock(session: Session)
	if sessions[session.player] == session then
		sessions[session.player] = nil
		DataService.ProfileReleased:Fire(session.player)
	end
	kick(session.player, "Your progress was opened on another server. Please rejoin.")
end

function DataService.loadPlayer(player: Player)
	if sessions[player] or loading[player] then
		return
	end
	loading[player] = true
	local userId = player.UserId
	local key = keyFor(userId)

	-- A quick rejoin to this same server: wait for our own release to finish.
	local waited = 0
	while releasing[userId] and waited < 30 do
		task.wait(0.25)
		waited += 0.25
	end

	local result: ClaimResult = { status = "error" }
	local errors, lockedTries = 0, 0
	while player.Parent do
		result = tryClaim(key)
		if result.status == "ok" then
			break
		elseif result.status == "locked" then
			lockedTries += 1
			if lockedTries >= LOCK_WAIT_ATTEMPTS then
				break
			end
			task.wait(LOCK_WAIT_SECONDS)
		else
			errors += 1
			if errors >= LOAD_ATTEMPTS then
				break
			end
			task.wait(math.min(2 ^ errors, 16))
		end
	end
	loading[player] = nil

	if result.status ~= "ok" then
		if result.status == "locked" then
			kick(player, "Your garden is still saving on another server. Please rejoin in a minute!")
		else
			kick(player, "We couldn't load your garden (Roblox data services may be down). Please rejoin.")
		end
		return
	end

	local session: Session = {
		player = player,
		userId = userId,
		key = key,
		data = result.data,
		lastSave = os.clock() - math.random() * Config.Data.AutosaveInterval, -- stagger autosaves
		isNew = result.isNew,
		lockLost = false,
	}

	if not player.Parent then
		-- Left while loading: give the lock straight back.
		releasing[userId] = true
		writeSession(session, true)
		releasing[userId] = nil
		return
	end

	session.data.stats.sessions += 1
	sessions[player] = session
	DataService.ProfileLoaded:Fire(player, session.data)
end

function DataService.releasePlayer(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	sessions[player] = nil
	releasing[session.userId] = true
	runSaveHooks(player, session.data)
	DataService.ProfileReleased:Fire(player)
	writeSession(session, true)
	releasing[session.userId] = nil
end

function DataService.get(player: Player): Profile?
	local session = sessions[player]
	return if session then session.data else nil
end

function DataService.getSession(player: Player): Session?
	return sessions[player]
end

function DataService.waitFor(player: Player, timeout: number): Profile?
	local start = os.clock()
	while player.Parent and not sessions[player] and os.clock() - start < timeout do
		task.wait(0.1)
	end
	local session = sessions[player]
	return if session then session.data else nil
end

-- Immediate save used after purchases. Returns true only when the write
-- landed, so receipts are acknowledged strictly after persistence.
function DataService.saveNow(player: Player): boolean
	local session = sessions[player]
	if not session then
		return false
	end
	runSaveHooks(player, session.data)
	local ok = writeSession(session, false)
	if session.lockLost then
		handleLostLock(session)
		return false
	end
	return ok
end

local function autosaveLoop()
	while true do
		task.wait(5)
		for player, session in sessions do
			if os.clock() - session.lastSave >= Config.Data.AutosaveInterval then
				session.lastSave = os.clock() -- prevent overlapping attempts
				task.spawn(function()
					runSaveHooks(player, session.data)
					writeSession(session, false)
					if session.lockLost then
						handleLostLock(session)
					end
				end)
			end
		end
	end
end

local function onShutdown()
	shuttingDown = true
	local pending = 0
	for player in sessions do
		pending += 1
		task.spawn(function()
			DataService.releasePlayer(player)
			pending -= 1
		end)
	end
	local start = os.clock()
	local limit = if RunService:IsStudio() and getStore().isMemory then 1 else 25
	-- Also wait for releases started by PlayerRemoving during shutdown.
	while (pending > 0 or next(releasing) ~= nil) and os.clock() - start < limit do
		task.wait(0.1)
	end
end

function DataService.init()
	getStore()
end

function DataService.start()
	Players.PlayerRemoving:Connect(DataService.releasePlayer)
	game:BindToClose(onShutdown)
	task.spawn(autosaveLoop)
end

-- Called by the bootstrap after every system has started, so no listener
-- can miss a ProfileLoaded event.
function DataService.listen()
	Players.PlayerAdded:Connect(DataService.loadPlayer)
	for _, player in Players:GetPlayers() do
		task.spawn(DataService.loadPlayer, player)
	end
end

-- Test hook: swap the backing store.
function DataService._setStore(newStore: Store)
	store = newStore
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Garden</string>
            <string name="Source"><![CDATA[--!strict
-- The core loop: plant -> grow -> ripen (variant roll) -> weather mutations
-- -> harvest. Growth is tracked as "growth-seconds" so speed boosts can
-- change at any moment without losing progress, and keeps going offline.
--
-- Persisted per plant: tile, species, weight, accumulated growth-seconds,
-- mutations and whether the ripening roll happened. Runtime adds the model
-- and the server time of the last commit.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Mutations = require(Shared:WaitForChild("Mutations"))
local Net = require(Shared:WaitForChild("Net"))
local SlimeBuilder = require(Shared:WaitForChild("SlimeBuilder"))
local Species = require(Shared:WaitForChild("Species"))
local Types = require(Shared:WaitForChild("Types"))

local Util = script.Parent.Parent:WaitForChild("Util")
local Badges = require(Util:WaitForChild("Badges"))
local Notify = require(Util:WaitForChild("Notify"))
local RateLimiter = require(Util:WaitForChild("RateLimiter"))
local Validate = require(Util:WaitForChild("Validate"))

local Boosts = require(script.Parent.Boosts)
local DataService = require(script.Parent.DataService)
local Index = require(script.Parent.Index)
local Monetization = require(script.Parent.Monetization)
local Plots = require(script.Parent.Plots)
local Retention = require(script.Parent.Retention)
local Sync = require(script.Parent.Sync)
local Tutorial = require(script.Parent.Tutorial)
local Weather = require(script.Parent.Weather)

type Profile = Types.Profile
type PlantData = Types.PlantData
type SlimeData = Types.SlimeData

type Plant = {
	data: PlantData,
	model: Model?,
	lastCommit: number, -- server time
	ripe: boolean,
}

type GardenState = {
	player: Player,
	plot: any,
	plants: { [number]: Plant },
	rate: number,
	luck: number,
}

local Garden = {}

local MAX_TILE = Config.Plots.FreeTileLimit + Config.Plots.PassTiles
local random = Random.new()
local gardens: { [Player]: GardenState } = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function rng(): number
	return random:NextNumber()
end

local function growTime(plant: Plant): number
	return Economy.growTime(plant.data.s)
end

local function writeAttributes(state: GardenState, plant: Plant)
	local model = plant.model
	if not model then
		return
	end
	model:SetAttribute("Elapsed", plant.data.e)
	model:SetAttribute("Rate", if plant.ripe then 0 else state.rate)
	model:SetAttribute("UpdatedAt", plant.lastCommit)
	model:SetAttribute("Ripe", plant.ripe)
end

local function buildModel(state: GardenState, plant: Plant)
	if plant.model then
		plant.model:Destroy()
		plant.model = nil
	end
	local top = Plots.tileTop(state.plot, plant.data.tile)
	if not top then
		return
	end
	local model = SlimeBuilder.build(plant.data.s, plant.data.m, Economy.visualSize(plant.data.w))
	model.Name = `Plant{plant.data.tile}`
	model:SetAttribute("OwnerUserId", state.player.UserId)
	model:SetAttribute("Tile", plant.data.tile)
	model:SetAttribute("Weight", plant.data.w)
	model:SetAttribute("GrowTime", growTime(plant))
	model:SetAttribute("Mutations", table.concat(plant.data.m, ","))
	model:SetAttribute("BaseValue", Economy.baseValue(plant.data))
	model:PivotTo(top)
	plant.model = model
	writeAttributes(state, plant)
	model.Parent = state.plot.plants
end

-- Folds elapsed time into each plant's stored growth at the current rate.
local function commit(state: GardenState)
	local t = now()
	for _, plant in state.plants do
		if not plant.ripe then
			plant.data.e = math.min(growTime(plant), plant.data.e + (t - plant.lastCommit) * state.rate)
		end
		plant.lastCommit = t
	end
end

local function ripen(state: GardenState, plant: Plant, quiet: boolean)
	plant.ripe = true
	plant.data.e = growTime(plant)
	local mutated = false
	if not plant.data.r then
		plant.data.r = true
		local variant = Economy.rollVariant(rng, state.luck)
		if variant then
			table.insert(plant.data.m, variant)
			mutated = true
		end
	end
	if mutated then
		buildModel(state, plant)
	else
		writeAttributes(state, plant)
	end
	local data = DataService.get(state.player)
	if data then
		Tutorial.event(state.player, data, "ripe")
	end
	if not quiet then
		Notify.effect(state.player, "ripe", { tile = plant.data.tile, mutated = mutated })
	end
end

function Garden.get(player: Player): GardenState?
	return gardens[player]
end

function Garden.ripeCount(player: Player): number
	local state = gardens[player]
	if not state then
		return 0
	end
	local count = 0
	for _, plant in state.plants do
		if plant.ripe then
			count += 1
		end
	end
	return count
end

local function setup(player: Player, plot: any, data: Profile)
	local multipliers = Boosts.get(player)
	local state: GardenState = {
		player = player,
		plot = plot,
		plants = {},
		rate = multipliers.growth,
		luck = multipliers.luck,
	}
	gardens[player] = state

	-- Offline growth at the base rate (+ Fast Grow, which is permanent).
	local offline = math.clamp(os.time() - data.lastSeen, 0, Config.Growth.MaxOfflineSeconds)
	local offlineRate = Economy.growthRate(Monetization.owns(player, "fast_grow"), false, 1)
	local t = now()
	for _, plantData in data.plants do
		-- Plants stay on their tile even if it is no longer usable (e.g. a
		-- deleted Big Garden pass) so nothing the player owns disappears.
		plantData.e = math.min(Economy.growTime(plantData.s), plantData.e + offline * offlineRate)
		local plant: Plant = { data = plantData, model = nil, lastCommit = t, ripe = false }
		state.plants[plantData.tile] = plant
		buildModel(state, plant)
	end
	for _, plant in state.plants do
		if plant.data.e >= growTime(plant) then
			ripen(state, plant, true)
		end
	end
	Sync.mark(player, "main")
end

local function teardown(player: Player)
	local state = gardens[player]
	if not state then
		return
	end
	gardens[player] = nil
	for _, plant in state.plants do
		if plant.model then
			plant.model:Destroy()
		end
	end
end

local function removePlant(state: GardenState, data: Profile, tile: number)
	local plant = state.plants[tile]
	if not plant then
		return
	end
	state.plants[tile] = nil
	if plant.model then
		plant.model:Destroy()
	end
	for i, stored in data.plants do
		if stored.tile == tile then
			table.remove(data.plants, i)
			break
		end
	end
end

local function backpackCapacity(player: Player): number
	return Economy.backpackCapacity(Monetization.owns(player, "vip"))
end

local function announce(player: Player, slime: SlimeData)
	local species = Species.byId[slime.s]
	if not species then
		return
	end
	local multiplier = Economy.mutationMultiplier(slime.m)
	local weightLabel = Economy.weightLabel(slime.w)
	local tier = Economy.effectiveTier(slime.s)
	if
		tier < Config.AnnounceMinTier
		and multiplier < Config.AnnounceMinMultiplier
		and weightLabel ~= "Titanic"
	then
		return
	end
	local parts = {}
	local mutationText = SlimeBuilder.mutationNames(slime.m)
	if mutationText ~= "" then
		table.insert(parts, mutationText)
	end
	if weightLabel then
		table.insert(parts, weightLabel)
	end
	table.insert(parts, species.name)
	Notify.all(
		`🌟 {player.DisplayName} harvested a {table.concat(parts, " ")}!`,
		Species.RarityColors[species.rarity]
	)
end

-- Harvests one ripe plant. Returns the slime, or nil (with reason) if not possible.
local function harvestTile(state: GardenState, data: Profile, tile: number): (SlimeData?, string?)
	local plant = state.plants[tile]
	if not plant or not plant.ripe then
		return nil, "not ripe"
	end
	if #data.slimes >= backpackCapacity(state.player) then
		return nil, "full"
	end
	local slime: SlimeData = {
		id = data.nextSlimeId,
		s = plant.data.s,
		w = plant.data.w,
		m = table.clone(plant.data.m),
		b = plant.data.b,
	}
	data.nextSlimeId += 1
	table.insert(data.slimes, slime)
	removePlant(state, data, tile)
	data.stats.harvested += 1

	local player = state.player
	Index.discover(player, data, slime)
	Retention.progress(player, data, "harvest", 1)
	if #slime.m > 0 then
		Retention.progress(player, data, "mutated", 1)
	end
	local tier = Economy.effectiveTier(slime.s)
	if tier >= 5 then
		Retention.progress(player, data, "rare", 1)
	end
	if data.stats.harvested == 1 then
		Badges.award(player, "FirstHarvest")
	end
	if tier >= 9 then
		Badges.award(player, "LegendaryHarvest")
	end
	announce(player, slime)
	return slime, nil
end

local function reportHarvest(player: Player, data: Profile, harvested: { SlimeData }, failure: string?)
	if #harvested > 0 then
		local multiplier = Boosts.get(player).sell
		local total = 0
		local best: SlimeData = harvested[1]
		for _, slime in harvested do
			total += Economy.slimeValue(slime, multiplier)
			if Economy.slimeValue(slime, 1) > Economy.slimeValue(best, 1) then
				best = slime
			end
		end
		Notify.effect(player, "harvest", {
			count = #harvested,
			value = total,
			species = best.s,
			mutations = best.m,
			weight = best.w,
		})
		Tutorial.event(player, data, "harvested")
		Sync.mark(player, "main")
		Sync.mark(player, "backpack")
	end
	if failure == "full" then
		Notify.player(player, "🎒 Backpack full! Sell slimes at the Sell Stand.", "error")
	end
end

local function nearPlot(player: Player, state: GardenState): boolean
	return Validate.near(player, state.plot.origin.Position, Config.Plots.ReachDistance)
end

local function onPlant(player: Player, rawTile: unknown, rawSpecies: unknown)
	if not RateLimiter.allow(player, "Plant", 15, 30) then
		return
	end
	local tile = Validate.integer(rawTile, 1, MAX_TILE)
	local speciesId = Validate.shortString(rawSpecies, 24)
	local data = DataService.get(player)
	local state = gardens[player]
	if not tile or not speciesId or not data or not state then
		return
	end
	local species = Species.byId[speciesId]
	if not species then
		return
	end
	if (data.seeds[speciesId] or 0) < 1 then
		return
	end
	if not Economy.isTileUsable(tile, data.unlockedTiles, Monetization.owns(player, "big_garden")) then
		return
	end
	if state.plants[tile] then
		return
	end
	local top = Plots.tileTop(state.plot, tile)
	if not top or not Validate.near(player, top.Position, Config.Plots.ReachDistance) then
		return
	end

	local count = data.seeds[speciesId]
	if count > 1 then
		data.seeds[speciesId] = count - 1
	else
		data.seeds[speciesId] = nil
	end

	commit(state)
	local plantData: PlantData = {
		tile = tile,
		s = speciesId,
		w = Economy.rollWeight(rng),
		e = 0,
		m = {},
		r = false,
		b = if species.tier == 0 then Economy.prismBaseValue(data.bestTier) else nil,
	}
	table.insert(data.plants, plantData)
	local plant: Plant = { data = plantData, model = nil, lastCommit = now(), ripe = false }
	state.plants[tile] = plant
	buildModel(state, plant)

	data.stats.planted += 1
	if species.tier > data.bestTier then
		data.bestTier = species.tier
	end
	Retention.progress(player, data, "plant", 1)
	Tutorial.event(player, data, "planted")
	Notify.effect(player, "plant", { tile = tile, species = speciesId })
	Sync.mark(player, "main")
end

local function onHarvest(player: Player, rawTile: unknown)
	if not RateLimiter.allow(player, "Harvest", 10, 15) then
		return
	end
	local tile = Validate.integer(rawTile, 1, MAX_TILE)
	local data = DataService.get(player)
	local state = gardens[player]
	if not tile or not data or not state then
		return
	end
	local top = Plots.tileTop(state.plot, tile)
	if not top or not Validate.near(player, top.Position, Config.Plots.ReachDistance) then
		return
	end
	local slime, failure = harvestTile(state, data, tile)
	reportHarvest(player, data, if slime then { slime } else {}, failure)
end

function Garden.harvestAll(player: Player, requireNear: boolean): number
	local data = DataService.get(player)
	local state = gardens[player]
	if not data or not state then
		return 0
	end
	if requireNear and not nearPlot(player, state) then
		Notify.player(player, "Go to your garden to harvest!", "error")
		return 0
	end
	local harvested = {}
	local failure: string? = nil
	local tiles = {}
	for tile, plant in state.plants do
		if plant.ripe then
			table.insert(tiles, tile)
		end
	end
	table.sort(tiles)
	for _, tile in tiles do
		local slime, reason = harvestTile(state, data, tile)
		if slime then
			table.insert(harvested, slime)
		elseif reason == "full" then
			failure = reason
			break
		end
	end
	reportHarvest(player, data, harvested, failure)
	return #harvested
end

local function onHarvestAll(player: Player)
	if not RateLimiter.allow(player, "HarvestAll", 1, 3) then
		return
	end
	Garden.harvestAll(player, true)
end

-- Ripens everything that is still growing. Returns how many plants ripened.
function Garden.ripenAll(player: Player): number
	local state = gardens[player]
	if not state then
		return 0
	end
	commit(state)
	local count = 0
	for _, plant in state.plants do
		if not plant.ripe then
			ripen(state, plant, false)
			count += 1
		end
	end
	return count
end

local function growingCount(player: Player): number
	local state = gardens[player]
	if not state then
		return 0
	end
	local count = 0
	for _, plant in state.plants do
		if not plant.ripe then
			count += 1
		end
	end
	return count
end

local function useInstantGrow(player: Player, data: Profile): boolean
	if data.instantGrowCharges < 1 or growingCount(player) == 0 then
		return false
	end
	data.instantGrowCharges -= 1
	local count = Garden.ripenAll(player)
	Notify.player(player, `⏩ {count} slime(s) ripened instantly!`, "success")
	Sync.mark(player, "main")
	return true
end

local function onUseInstantGrow(player: Player)
	if not RateLimiter.allow(player, "UseInstantGrow", 1, 2) then
		return
	end
	local data = DataService.get(player)
	if data and not useInstantGrow(player, data) and data.instantGrowCharges > 0 then
		Notify.player(player, "Nothing is growing right now. Your Instant Grow is saved.", "info")
	end
end

local function onSetAutoHarvest(player: Player, rawEnabled: unknown)
	if not RateLimiter.allow(player, "SetAutoHarvest", 2, 4) then
		return
	end
	local enabled = Validate.boolean(rawEnabled)
	local data = DataService.get(player)
	if enabled == nil or not data then
		return
	end
	data.autoHarvest = enabled
	Sync.mark(player, "main")
end

-- Removes every plant (rebirth).
function Garden.clearAll(player: Player)
	local state = gardens[player]
	local data = DataService.get(player)
	if not state or not data then
		return
	end
	for tile in state.plants do
		removePlant(state, data, tile)
	end
	table.clear(data.plants)
end

local function growthTick()
	local t = now()
	for _, state in gardens do
		for _, plant in state.plants do
			if not plant.ripe and plant.data.e + (t - plant.lastCommit) * state.rate >= growTime(plant) then
				ripen(state, plant, false)
			end
		end
	end
end

local function weatherTick()
	local weatherId = Weather.current()
	if not weatherId then
		return
	end
	local mutation = Mutations.byWeather[weatherId]
	if not mutation then
		return
	end
	for player, state in gardens do
		local chance = Economy.weatherTickChance(mutation.chance, state.luck, Config.Weather.MutationTick)
		local gained = 0
		for _, plant in state.plants do
			if plant.ripe and not table.find(plant.data.m, mutation.id) and rng() < chance then
				table.insert(plant.data.m, mutation.id)
				buildModel(state, plant)
				gained += 1
			end
		end
		if gained > 0 then
			Notify.effect(player, "mutation", { mutation = mutation.id, count = gained })
		end
	end
end

local function autoHarvestTick()
	for player in gardens do
		local data = DataService.get(player)
		if data and data.autoHarvest and Monetization.owns(player, "auto_harvest") then
			if Garden.ripeCount(player) > 0 then
				Garden.harvestAll(player, false)
			end
		end
	end
end

function Garden.init()
	Monetization.registerProduct("instant_grow", function(player, data)
		data.instantGrowCharges += 1
		if not useInstantGrow(player, data) then
			Notify.player(
				player,
				"⏩ Instant Grow saved! Use it from the menu when slimes are growing.",
				"reward"
			)
		end
		return true
	end)

	DataService.addSaveHook(function(player)
		local state = gardens[player]
		if state then
			commit(state)
		end
	end)
end

function Garden.start()
	Plots.Assigned:Connect(setup)
	Plots.Released:Connect(teardown)
	DataService.ProfileReleased:Connect(teardown)

	Boosts.Changed:Connect(function(player, multipliers)
		local state = gardens[player]
		if not state then
			return
		end
		commit(state)
		state.rate = multipliers.growth
		state.luck = multipliers.luck
		for _, plant in state.plants do
			writeAttributes(state, plant)
		end
	end)

	Net.event("Plant").OnServerEvent:Connect(onPlant)
	Net.event("Harvest").OnServerEvent:Connect(onHarvest)
	Net.event("HarvestAll").OnServerEvent:Connect(onHarvestAll)
	Net.event("UseInstantGrow").OnServerEvent:Connect(onUseInstantGrow)
	Net.event("SetAutoHarvest").OnServerEvent:Connect(onSetAutoHarvest)

	task.spawn(function()
		local weatherAcc, autoAcc = 0, 0
		while true do
			local dt = task.wait(0.5)
			growthTick()
			weatherAcc += dt
			autoAcc += dt
			if weatherAcc >= Config.Weather.MutationTick then
				weatherAcc = 0
				weatherTick()
			end
			if autoAcc >= Config.Growth.AutoHarvestInterval then
				autoAcc = 0
				autoHarvestTick()
			end
		end
	end)
end

return Garden
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Index</string>
            <string name="Source"><![CDATA[--!strict
-- Slimepedia: records each species and species+mutation combination a
-- player has harvested. First discoveries pay a one-time coin bonus.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))
local Mutations = require(Shared:WaitForChild("Mutations"))
local Species = require(Shared:WaitForChild("Species"))
local Types = require(Shared:WaitForChild("Types"))

local Notify = require(script.Parent.Parent:WaitForChild("Util"):WaitForChild("Notify"))

local Analytics = require(script.Parent.Analytics)

type Profile = Types.Profile
type SlimeData = Types.SlimeData

local Index = {}

local SPECIES_REWARD_UNITS = 5
local MUTATION_REWARD_UNITS = 2

function Index.discover(player: Player, data: Profile, slime: SlimeData)
	local species = Species.byId[slime.s]
	if not species then
		return
	end
	local reward = 0
	local messages = {}
	if not data.index[slime.s] then
		data.index[slime.s] = true
		reward += Economy.niceRound(SPECIES_REWARD_UNITS * math.max(Economy.baseValue(slime), 20))
		table.insert(messages, `📖 New species: {species.name}!`)
		Analytics.custom(player, "Discover_" .. slime.s)
	end
	for _, mutationId in slime.m do
		local key = `{slime.s}:{mutationId}`
		local mutation = Mutations.byId[mutationId]
		if mutation and not data.index[key] then
			data.index[key] = true
			reward += Economy.niceRound(MUTATION_REWARD_UNITS * math.max(Economy.baseValue(slime), 20))
			table.insert(messages, `📖 New variant: {mutation.name} {species.name}!`)
		end
	end
	if reward > 0 then
		data.coins += reward
		Analytics.coinSource(
			player,
			reward,
			data.coins,
			Enum.AnalyticsEconomyTransactionType.Gameplay,
			"index_discovery"
		)
		Notify.player(player, `{table.concat(messages, " ")} +{Format.short(reward)} coins`, "reward")
	end
end

return Index
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Leaderboard</string>
            <string name="Source"><![CDATA[--!strict
-- In-server leaderstats plus a global "Top Gardeners" board backed by an
-- OrderedDataStore of lifetime coins earned from selling.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local DataService = require(script.Parent.DataService)
local Plots = require(script.Parent.Plots)

local Leaderboard = {}

local ordered: OrderedDataStore? = nil
local lastPublished: { [Player]: number } = {}
local nameCache: { [number]: string } = {}

local function getOrdered(): OrderedDataStore?
	if ordered then
		return ordered
	end
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.Data.LeaderboardStoreName)
	end)
	if ok then
		ordered = store
	end
	return ordered
end

local function setupLeaderstats(player: Player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local coins = Instance.new("StringValue")
	coins.Name = "Coins"
	coins.Value = "0"
	coins.Parent = folder
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = folder
	folder.Parent = player
end

local function updateLeaderstats(player: Player)
	local data = DataService.get(player)
	local folder = player:FindFirstChild("leaderstats")
	if not data or not folder then
		return
	end
	local coins = folder:FindFirstChild("Coins") :: StringValue?
	local rebirths = folder:FindFirstChild("Rebirths") :: IntValue?
	if coins then
		coins.Value = Format.short(data.coins)
	end
	if rebirths then
		rebirths.Value = data.rebirths
	end
end

local function publish(player: Player, force: boolean)
	local data = DataService.get(player)
	local store = getOrdered()
	if not data or not store then
		return
	end
	local last = lastPublished[player] or 0
	if not force and os.clock() - last < Config.Leaderboard.PublishInterval then
		return
	end
	lastPublished[player] = os.clock()
	local value = math.floor(math.min(data.totalEarned, 2 ^ 53))
	if value <= 0 then
		return
	end
	local userId = player.UserId
	task.spawn(function()
		pcall(function()
			(store :: OrderedDataStore):SetAsync(tostring(userId), value)
		end)
	end)
end

local function nameFor(userId: number): string
	local cached = nameCache[userId]
	if cached then
		return cached
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and name then name else "Gardener"
	nameCache[userId] = result
	return result
end

local function render(entries: { { name: string, value: number } }?, message: string?)
	local gui = Plots.world().leaderboard
	gui:ClearAllChildren()

	local list = Instance.new("Frame")
	list.BackgroundTransparency = 1
	list.Size = UDim2.fromScale(1, 1)
	list.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0.01, 0)
	layout.Parent = list
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0.03, 0)
	padding.PaddingLeft = UDim.new(0.04, 0)
	padding.PaddingRight = UDim.new(0.04, 0)
	padding.Parent = list

	local function row(text: string, order: number, color: Color3, height: number)
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, height)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextColor3 = color
		label.Text = text
		label.LayoutOrder = order
		label.Parent = list
	end

	row("🏆 TOP GARDENERS", 0, Color3.fromRGB(255, 220, 90), 0.12)
	if message then
		row(message, 1, Color3.new(1, 1, 1), 0.08)
		return
	end
	local rows: { { name: string, value: number } } = entries or {}
	for i, entry in rows do
		local medal = if i == 1 then "🥇" elseif i == 2 then "🥈" elseif i == 3 then "🥉" else `{i}.`
		row(`{medal} {entry.name} — {Format.short(entry.value)}`, i + 1, Color3.new(1, 1, 1), 0.075)
	end
end

local function refreshBoard()
	local store = getOrdered()
	if not store then
		render(nil, "Leaderboard unavailable")
		return
	end
	local ok, pages = pcall(function()
		return (store :: OrderedDataStore):GetSortedAsync(false, Config.Leaderboard.Size)
	end)
	if not ok then
		render(nil, "Leaderboard loading…")
		return
	end
	local entries = {}
	for _, item in (pages :: DataStorePages):GetCurrentPage() do
		local userId = tonumber(item.key)
		if userId then
			table.insert(entries, { name = nameFor(userId), value = item.value })
		end
	end
	if #entries == 0 then
		render(nil, "Be the first on the board!")
	else
		render(entries, nil)
	end
end

function Leaderboard.start()
	Players.PlayerAdded:Connect(setupLeaderstats)
	for _, player in Players:GetPlayers() do
		setupLeaderstats(player)
	end
	DataService.addSaveHook(function(player)
		publish(player, false)
	end)
	DataService.ProfileReleased:Connect(function(player)
		publish(player, true)
		lastPublished[player] = nil
	end)

	task.spawn(function()
		while true do
			for _, player in Players:GetPlayers() do
				updateLeaderstats(player)
			end
			task.wait(1)
		end
	end)
	task.spawn(function()
		render(nil, "Loading…")
		while true do
			refreshBoard()
			task.wait(Config.Leaderboard.RefreshInterval)
		end
	end)
end

return Leaderboard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Monetization</string>
            <string name="Source"><![CDATA[--!strict
-- Game passes and developer products. Rewards are granted only on the
-- server: passes via UserOwnsGamePassAsync / PromptGamePassPurchaseFinished,
-- products via MarketplaceService.ProcessReceipt.
--
-- Receipt handling is idempotent: the PurchaseId is recorded in the
-- player's profile in the same synchronous step as the reward, and
-- PurchaseGranted is returned only after that profile has been saved. A
-- crash before the save loses both reward and record, so Roblox retries and
-- the reward is granted exactly once.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))
local Net = require(Shared:WaitForChild("Net"))
local Products = require(Shared:WaitForChild("Products"))
local Signal = require(Shared:WaitForChild("Signal"))
local Types = require(Shared:WaitForChild("Types"))

local Util = script.Parent.Parent:WaitForChild("Util")
local Notify = require(Util:WaitForChild("Notify"))
local RateLimiter = require(Util:WaitForChild("RateLimiter"))
local Validate = require(Util:WaitForChild("Validate"))

local Analytics = require(script.Parent.Analytics)
local DataService = require(script.Parent.DataService)
local Sync = require(script.Parent.Sync)

type Profile = Types.Profile
export type ProductHandler = (Player, Profile) -> boolean

local Monetization = {}

-- Fired after a player's pass ownership is known (right after their profile
-- loads). Gameplay systems that depend on passes start from here.
Monetization.PlayerReady = Signal.new() :: Signal.Signal<Player, Profile>
Monetization.PassesChanged = Signal.new() :: Signal.Signal<Player, string>

local owned: { [Player]: { [string]: boolean } } = {}
local ready: { [Player]: boolean } = {}
local handlers: { [string]: ProductHandler } = {}
local inFlight: { [string]: boolean } = {}

function Monetization.owns(player: Player, passKey: string): boolean
	local set = owned[player]
	return set ~= nil and set[passKey] == true
end

function Monetization.isReady(player: Player): boolean
	return ready[player] == true
end

function Monetization.registerProduct(key: string, handler: ProductHandler)
	local product = Products.byKey[key]
	assert(product and product.kind == "product", `unknown developer product {key}`)
	assert(handlers[key] == nil, `duplicate handler for {key}`)
	handlers[key] = handler
end

local function grantStarterPack(player: Player, data: Profile)
	if data.starterPackClaimed then
		return
	end
	data.starterPackClaimed = true
	data.coins += 2500
	data.seeds.ember = (data.seeds.ember or 0) + 3
	data.seeds.frost = (data.seeds.frost or 0) + 2
	data.potions.growth = (data.potions.growth or 0) + 1
	data.potions.luck = (data.potions.luck or 0) + 1
	Analytics.coinSource(player, 2500, data.coins, Enum.AnalyticsEconomyTransactionType.IAP, "starter_pack")
	Notify.player(player, "🎁 Starter Pack unlocked! Seeds, coins and potions added.", "reward")
	Sync.mark(player, "main")
end

local function setOwned(player: Player, data: Profile, key: string)
	local set = owned[player]
	if not set or set[key] then
		return
	end
	set[key] = true
	data.passCache[key] = true
	if key == "starter_pack" then
		grantStarterPack(player, data)
	end
	if key == "vip" then
		player:SetAttribute("VIP", true)
	end
	Sync.mark(player, "passes")
	Sync.mark(player, "boosts")
	Monetization.PassesChanged:Fire(player, key)
end

local function loadOwnership(player: Player, data: Profile)
	local set: { [string]: boolean } = {}
	owned[player] = set
	local pending = 0
	for _, product in Products.list do
		if product.kind ~= "pass" then
			continue
		end
		if product.id == 0 then
			-- Unconfigured pass: only Studio test grants count.
			if RunService:IsStudio() and data.passCache[product.key] then
				set[product.key] = true
			end
			continue
		end
		pending += 1
		task.spawn(function()
			local ok, result = false, nil
			for attempt = 1, 3 do
				ok, result = pcall(function()
					return MarketplaceService:UserOwnsGamePassAsync(player.UserId, product.id)
				end)
				if ok then
					break
				end
				task.wait(attempt)
			end
			if ok then
				set[product.key] = result == true
				if result == true then
					data.passCache[product.key] = true
				else
					data.passCache[product.key] = nil
				end
			elseif data.passCache[product.key] then
				-- API outage: trust the last verified ownership.
				set[product.key] = true
			end
			pending -= 1
		end)
	end
	local start = os.clock()
	while pending > 0 and os.clock() - start < 15 do
		task.wait(0.1)
	end

	if set.starter_pack then
		grantStarterPack(player, data)
	end
	player:SetAttribute("VIP", set.vip == true)
	ready[player] = true
	Sync.mark(player, "passes")
	Sync.mark(player, "boosts")
	Monetization.PlayerReady:Fire(player, data)
end

-- ProcessReceipt: return PurchaseGranted only once the grant is persisted.
local function processReceipt(receipt: { [any]: any }): Enum.ProductPurchaseDecision
	local purchaseId = tostring(receipt.PurchaseId)
	local product = Products.byProductId[tonumber(receipt.ProductId) or -1]
	if not product then
		warn(`[Monetization] receipt for unknown product id {receipt.ProductId}; leaving unprocessed`)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local handler = handlers[product.key]
	if not handler then
		warn(`[Monetization] no handler for {product.key}`)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local player = Players:GetPlayerByUserId(tonumber(receipt.PlayerId) or -1)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.waitFor(player, 20)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if inFlight[purchaseId] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	inFlight[purchaseId] = true

	local decision = Enum.ProductPurchaseDecision.NotProcessedYet
	local ok, err = pcall(function(): any
		if table.find(data.receipts, purchaseId) then
			-- Already granted in memory (an earlier save may have failed).
			if DataService.saveNow(player) then
				decision = Enum.ProductPurchaseDecision.PurchaseGranted
			end
			return nil
		end

		local granted = handler(player, data)
		if not granted then
			return nil
		end
		table.insert(data.receipts, purchaseId)
		while #data.receipts > Config.Data.MaxReceipts do
			table.remove(data.receipts, 1)
		end
		local spent = tonumber(receipt.CurrencySpent) or 0
		data.stats.robuxSpent += spent
		Analytics.custom(player, "RobuxPurchase_" .. product.key, spent)
		Sync.mark(player, "main")

		if DataService.saveNow(player) then
			decision = Enum.ProductPurchaseDecision.PurchaseGranted
		end
		return nil
	end)
	inFlight[purchaseId] = nil
	if not ok then
		warn(`[Monetization] receipt {purchaseId} failed: {err}`)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return decision
end

local function grantCoinPack(key: string): ProductHandler
	return function(player: Player, data: Profile): boolean
		local amount = Economy.coinPackAmount(key, data.bestTier)
		data.coins += amount
		Analytics.coinSource(player, amount, data.coins, Enum.AnalyticsEconomyTransactionType.IAP, key)
		Notify.player(player, `+{Format.short(amount)} coins! Thank you for your support 💚`, "reward")
		Notify.effect(player, "coins", { amount = amount })
		return true
	end
end

-- Studio-only purchase simulation for unconfigured ids and QA shortcuts.
local function onDevGrant(player: Player, key: unknown)
	if not RunService:IsStudio() then
		return -- never available in live servers
	end
	if not RateLimiter.allow(player, "DevGrant", 4, 6) then
		return
	end
	local productKey = Validate.shortString(key, 40)
	local data = DataService.get(player)
	if not productKey or not data then
		return
	end
	if productKey == "dev_coins" then
		data.coins += 1_000_000_000
		Sync.mark(player, "main")
		return
	elseif productKey == "dev_seeds" then
		for _, id in { "berry", "ember", "frost", "toxic", "crystal", "shadow", "king", "cosmic" } do
			data.seeds[id] = (data.seeds[id] or 0) + 5
		end
		Sync.mark(player, "main")
		return
	end
	local product = Products.byKey[productKey]
	if not product then
		return
	end
	if product.kind == "pass" then
		setOwned(player, data, product.key)
		Notify.player(player, `[Studio] Granted pass: {product.name}`, "success")
	else
		local handler = handlers[product.key]
		if handler and handler(player, data) then
			Sync.mark(player, "main")
			Notify.player(player, `[Studio] Simulated purchase: {product.name}`, "success")
		end
	end
end

function Monetization.init()
	for key in Products.CoinPackUnits do
		Monetization.registerProduct(key, grantCoinPack(key))
	end
	Monetization.registerProduct("prism_seed", function(player, data)
		data.seeds.prism = (data.seeds.prism or 0) + 1
		Notify.player(player, "🌈 Prism Seed added! Plant it in your garden.", "reward")
		return true
	end)

	Sync.register("passes", function(player)
		return owned[player] or {}
	end)
end

function Monetization.start()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local product = Products.byPassId[passId]
		local data = DataService.get(player)
		if product and data then
			setOwned(player, data, product.key)
			Analytics.custom(player, "PassPurchase_" .. product.key, product.price)
			Notify.player(player, `{product.icon} {product.name} unlocked! Thank you 💚`, "reward")
		end
	end)

	DataService.ProfileLoaded:Connect(loadOwnership)
	DataService.ProfileReleased:Connect(function(player)
		owned[player] = nil
		ready[player] = nil
	end)
	Players.PlayerRemoving:Connect(function(player)
		-- Profile may never have loaded (kicked during load).
		task.delay(60, function()
			if not player.Parent then
				owned[player] = nil
				ready[player] = nil
			end
		end)
	end)

	Net.event("DevGrant").OnServerEvent:Connect(onDevGrant)
end

-- Test hook.
Monetization._processReceipt = processReceipt

return Monetization
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Plots</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the world, assigns each player a garden plot, keeps tile visuals in
-- sync with their unlocks, sells tile expansions and teleports characters
-- home.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Signal"))
local Types = require(Shared:WaitForChild("Types"))

local ServerRoot = script.Parent.Parent
local Notify = require(ServerRoot:WaitForChild("Util"):WaitForChild("Notify"))
local RateLimiter = require(ServerRoot:WaitForChild("Util"):WaitForChild("RateLimiter"))
local World = require(ServerRoot:WaitForChild("World"):WaitForChild("World"))

local Analytics = require(script.Parent.Analytics)
local DataService = require(script.Parent.DataService)
local Monetization = require(script.Parent.Monetization)
local Sync = require(script.Parent.Sync)

type Profile = Types.Profile
type PlotRecord = World.PlotRecord

local Plots = {}

-- Fired once a player owns a plot and their passes are known.
Plots.Assigned = Signal.new() :: Signal.Signal<Player, PlotRecord, Profile>
Plots.Released = Signal.new() :: Signal.Signal<Player, PlotRecord>

local world: World.WorldRecord? = nil
local owners: { [number]: Player } = {}
local byPlayer: { [Player]: PlotRecord } = {}

local SOIL = Color3.fromRGB(122, 84, 56)
local LOCKED = Color3.fromRGB(88, 82, 78)
local PASS_LOCKED = Color3.fromRGB(150, 120, 60)

function Plots.world(): World.WorldRecord
	return world :: World.WorldRecord
end

function Plots.get(player: Player): PlotRecord?
	return byPlayer[player]
end

function Plots.tileTop(plot: PlotRecord, tileIndex: number): CFrame?
	local tile = plot.tiles[tileIndex]
	if not tile then
		return nil
	end
	return tile.CFrame * CFrame.new(0, tile.Size.Y / 2, 0)
end

local function setTileLabel(tile: BasePart, text: string?)
	local existing = tile:FindFirstChild("LockLabel")
	if not text then
		if existing then
			existing:Destroy()
		end
		return
	end
	local gui = existing :: SurfaceGui?
	if not gui then
		local newGui = Instance.new("SurfaceGui")
		newGui.Name = "LockLabel"
		newGui.Face = Enum.NormalId.Top
		newGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		newGui.PixelsPerStud = 50
		newGui.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = Color3.new(1, 1, 1)
		label.Rotation = 180 -- readable from the plot entrance
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 3
		stroke.Parent = label
		label.Parent = newGui
		newGui.Parent = tile
		gui = newGui
	end
	((gui :: SurfaceGui):FindFirstChild("Text") :: TextLabel).Text = text
end

function Plots.refreshTiles(player: Player)
	local plot = byPlayer[player]
	local data = DataService.get(player)
	if not plot or not data then
		return
	end
	local hasBigGarden = Monetization.owns(player, "big_garden")
	local nextTile = data.unlockedTiles + 1
	for index, tile in plot.tiles do
		local usable = Economy.isTileUsable(index, data.unlockedTiles, hasBigGarden)
		tile:SetAttribute("Usable", usable)
		if usable then
			tile.Color = SOIL
			tile.Transparency = 0
			setTileLabel(tile, nil)
		elseif index > Config.Plots.FreeTileLimit then
			tile.Color = PASS_LOCKED
			tile.Transparency = 0.2
			local middle = Config.Plots.FreeTileLimit + math.ceil(Config.Plots.PassTiles / 2)
			setTileLabel(tile, if index == middle then "⭐ Big Garden" else nil)
		else
			tile.Color = LOCKED
			tile.Transparency = 0.25
			setTileLabel(
				tile,
				if index == nextTile then `🔒 {Format.short(Economy.tileCost(index))}` else nil
			)
		end
	end
end

local function resetPlot(plot: PlotRecord)
	plot.model:SetAttribute("OwnerUserId", 0)
	local label = plot.sign:FindFirstChild("Label") :: TextLabel
	label.Text = "Empty Plot"
	local avatar = plot.sign:FindFirstChild("Avatar") :: ImageLabel
	avatar.Image = ""
	for _, tile in plot.tiles do
		tile.Color = LOCKED
		tile.Transparency = 0.25
		tile:SetAttribute("Usable", false)
		setTileLabel(tile, nil)
	end
end

function Plots.teleportHome(player: Player)
	local plot = byPlayer[player]
	local character = player.Character
	if not plot or not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		character:PivotTo(plot.spawn)
	end
end

local function assign(player: Player, data: Profile)
	if byPlayer[player] or not player.Parent then
		return
	end
	local w = world :: World.WorldRecord
	local plot: PlotRecord? = nil
	for _, candidate in w.plots do
		if not owners[candidate.index] then
			plot = candidate
			break
		end
	end
	if not plot then
		player:Kick("This server is full of gardens! Please join another server.")
		return
	end
	owners[plot.index] = player
	byPlayer[player] = plot
	plot.model:SetAttribute("OwnerUserId", player.UserId)
	player:SetAttribute("PlotIndex", plot.index)

	local label = plot.sign:FindFirstChild("Label") :: TextLabel
	label.Text = `{player.DisplayName}'s Garden`
	local avatar = plot.sign:FindFirstChild("Avatar") :: ImageLabel
	avatar.Image = `rbxthumb://type=AvatarHeadShot&id={player.UserId}&w=150&h=150`

	Plots.refreshTiles(player)
	Plots.teleportHome(player)
	Plots.Assigned:Fire(player, plot, data)
end

local function release(player: Player)
	local plot = byPlayer[player]
	if not plot then
		return
	end
	byPlayer[player] = nil
	owners[plot.index] = nil
	resetPlot(plot)
	Plots.Released:Fire(player, plot)
end

local function onUnlockTile(player: Player)
	if not RateLimiter.allow(player, "UnlockTile", 2, 3) then
		return
	end
	local data = DataService.get(player)
	if not data or not byPlayer[player] then
		return
	end
	local nextTile = data.unlockedTiles + 1
	if nextTile > Config.Plots.FreeTileLimit then
		Notify.player(player, "All coin tiles unlocked! Get Big Garden for 6 more.", "info")
		return
	end
	local cost = Economy.tileCost(nextTile)
	if data.coins < cost then
		Notify.player(player, `You need {Format.short(cost)} coins to unlock this tile.`, "error")
		return
	end
	data.coins -= cost
	data.unlockedTiles = nextTile
	Analytics.coinSink(player, cost, data.coins, Enum.AnalyticsEconomyTransactionType.Shop, "tile")
	Analytics.progression(player, "GardenSize", nextTile)
	Notify.player(player, `🌱 Tile unlocked! Your garden now has {nextTile} tiles.`, "success")
	Notify.effect(player, "unlock", { tile = nextTile })
	Plots.refreshTiles(player)
	Sync.mark(player, "main")
end

function Plots.init()
	world = World.build()
end

function Plots.start()
	Monetization.PlayerReady:Connect(assign)
	-- Released only after DataService has flushed growth into the profile.
	DataService.ProfileReleased:Connect(release)
	Monetization.PassesChanged:Connect(function(player, key)
		if key == "big_garden" then
			Plots.refreshTiles(player)
		end
	end)

	local function onCharacter(player: Player, character: Model)
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.1)
		if byPlayer[player] and character.Parent then
			Plots.teleportHome(player)
		end
	end
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end

	Net.event("UnlockTile").OnServerEvent:Connect(onUnlockTile)
end

return Plots
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Rebirth</string>
            <string name="Source"><![CDATA[--!strict
-- Rebirth: spend coins to reset the garden for a permanent +50% coin bonus,
-- an extra starting tile and (from Rebirth 1) Cosmic seeds in the shop.
-- Favorited slimes, the Slimepedia, passes and potions are kept.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))
local Net = require(Shared:WaitForChild("Net"))
local Types = require(Shared:WaitForChild("Types"))

local Util = script.Parent.Parent:WaitForChild("Util")
local Badges = require(Util:WaitForChild("Badges"))
local Notify = require(Util:WaitForChild("Notify"))
local RateLimiter = require(Util:WaitForChild("RateLimiter"))

local Analytics = require(script.Parent.Analytics)
local Boosts = require(script.Parent.Boosts)
local DataService = require(script.Parent.DataService)
local Garden = require(script.Parent.Garden)
local Plots = require(script.Parent.Plots)
local Sync = require(script.Parent.Sync)

type SlimeData = Types.SlimeData

local Rebirth = {}

local function onRebirth(player: Player)
	if not RateLimiter.allow(player, "Rebirth", 0.2, 1) then
		return
	end
	local data = DataService.get(player)
	if not data then
		return
	end
	local cost = Economy.rebirthCost(data.rebirths)
	if data.coins < cost then
		Notify.player(player, `You need {Format.short(cost)} coins to rebirth.`, "error")
		return
	end

	Garden.clearAll(player)
	local favorites: { SlimeData } = {}
	for _, slime in data.slimes do
		if slime.f then
			table.insert(favorites, slime)
		end
	end
	local spent = data.coins
	data.rebirths += 1
	data.coins = 30
	data.seeds = { goo = 3 }
	data.slimes = favorites
	data.unlockedTiles = Economy.startingTiles(data.rebirths)
	table.clear(data.plants)

	Analytics.coinSink(player, spent, data.coins, Enum.AnalyticsEconomyTransactionType.Gameplay, "rebirth")
	Analytics.progression(player, "Rebirth", data.rebirths)
	if data.rebirths == 1 then
		Badges.award(player, "FirstRebirth")
	end
	Boosts.refresh(player)
	Plots.refreshTiles(player)
	Sync.markAll(player)
	Notify.all(`⭐ {player.DisplayName} reached Rebirth {data.rebirths}!`, Color3.fromRGB(255, 220, 90))
	Notify.effect(player, "rebirth", { rebirths = data.rebirths })
end

function Rebirth.start()
	Net.event("Rebirth").OnServerEvent:Connect(onRebirth)
end

return Rebirth
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Retention</string>
            <string name="Source"><![CDATA[--!strict
-- Daily login streak rewards and daily quests.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DailyRewards = require(Shared:WaitForChild("DailyRewards"))
local Format = require(Shared:WaitForChild("Format"))
local Net = require(Shared:WaitForChild("Net"))
local Quests = require(Shared:WaitForChild("Quests"))
local Types = require(Shared:WaitForChild("Types"))

local Util = script.Parent.Parent:WaitForChild("Util")
local Notify = require(Util:WaitForChild("Notify"))
local RateLimiter = require(Util:WaitForChild("RateLimiter"))
local Validate = require(Util:WaitForChild("Validate"))

local Analytics = require(script.Parent.Analytics)
local DataService = require(script.Parent.DataService)
local Sync = require(script.Parent.Sync)

type Profile = Types.Profile

local Retention = {}

local function today(): number
	return DailyRewards.dayNumber(os.time())
end

local function ensureQuests(player: Player, data: Profile)
	local day = Quests.dayNumber(os.time())
	if data.quests.day ~= day then
		data.quests = { day = day, list = Quests.generate(day, player.UserId, data.bestTier) }
	end
end

function Retention.progress(player: Player, data: Profile, kind: string, amount: number)
	ensureQuests(player, data)
	local changed = false
	for _, quest in data.quests.list do
		if quest.kind == kind and not quest.claimed and quest.progress < quest.target then
			quest.progress = math.min(quest.target, quest.progress + amount)
			changed = true
			if quest.progress >= quest.target then
				Notify.player(player, "📜 Quest complete! Claim your reward.", "success")
			end
		end
	end
	if changed then
		Sync.mark(player, "daily")
	end
end

local function grantReward(
	player: Player,
	data: Profile,
	coins: number,
	seeds: { [string]: number },
	potions: { [string]: number },
	sku: string
)
	if coins > 0 then
		data.coins += coins
		Analytics.coinSource(player, coins, data.coins, Enum.AnalyticsEconomyTransactionType.TimedReward, sku)
	end
	for id, count in seeds do
		data.seeds[id] = (data.seeds[id] or 0) + count
	end
	for id, count in potions do
		data.potions[id] = (data.potions[id] or 0) + count
	end
end

local function onClaimDaily(player: Player)
	if not RateLimiter.allow(player, "ClaimDaily", 1, 3) then
		return
	end
	local data = DataService.get(player)
	if not data then
		return
	end
	local day = today()
	local status = DailyRewards.status(data.daily.lastClaimDay, data.daily.streak, day)
	if not status.canClaim then
		return
	end
	local reward = DailyRewards.resolve(status.cycleDay, data.bestTier)
	data.daily.lastClaimDay = day
	data.daily.streak = status.nextStreak
	grantReward(player, data, reward.coins, reward.seeds, reward.potions, `daily_{status.cycleDay}`)
	Analytics.custom(player, "DailyClaim", status.nextStreak)
	Notify.player(player, `🎁 Day {status.cycleDay} reward: {reward.label}`, "reward")
	Notify.effect(player, "reward", { icon = reward.icon })
	Sync.mark(player, "main")
	Sync.mark(player, "daily")
end

local function onClaimQuest(player: Player, rawIndex: unknown)
	if not RateLimiter.allow(player, "ClaimQuest", 2, 4) then
		return
	end
	local data = DataService.get(player)
	local index = Validate.integer(rawIndex, 1, 3)
	if not data or not index then
		return
	end
	ensureQuests(player, data)
	local quest = data.quests.list[index]
	if not quest or quest.claimed or quest.progress < quest.target then
		return
	end
	quest.claimed = true
	local potions = {}
	if quest.rewardItem then
		potions[quest.rewardItem] = 1
	end
	grantReward(player, data, quest.rewardCoins, {}, potions, `quest_{quest.kind}`)
	Analytics.custom(player, "QuestClaim_" .. quest.kind, index)
	local extra = if quest.rewardItem
		then ` + 1 {if quest.rewardItem == "luck" then "Luck" else "Growth"} Potion`
		else ""
	Notify.player(player, `📜 Quest reward: {Format.short(quest.rewardCoins)} coins{extra}`, "reward")
	Sync.mark(player, "main")
	Sync.mark(player, "daily")
end

local function buildSection(player: Player, data: Profile): any
	ensureQuests(player, data)
	local day = today()
	local status = DailyRewards.status(data.daily.lastClaimDay, data.daily.streak, day)
	local preview = {}
	for cycleDay = 1, #DailyRewards.cycle do
		local reward = DailyRewards.resolve(cycleDay, data.bestTier)
		preview[cycleDay] = { label = reward.label, icon = reward.icon }
	end
	local quests = {}
	for i, quest in data.quests.list do
		quests[i] = {
			text = Quests.describe(quest, Format.short),
			progress = quest.progress,
			target = quest.target,
			claimed = quest.claimed,
			rewardCoins = quest.rewardCoins,
			rewardItem = quest.rewardItem,
		}
	end
	return {
		canClaim = status.canClaim,
		cycleDay = status.cycleDay,
		streak = data.daily.streak,
		preview = preview,
		quests = quests,
		secondsToReset = 86400 - (os.time() % 86400),
	}
end

function Retention.init()
	Sync.register("daily", buildSection)
end

function Retention.start()
	Net.event("ClaimDaily").OnServerEvent:Connect(onClaimDaily)
	Net.event("ClaimQuest").OnServerEvent:Connect(onClaimQuest)

	-- Refresh at UTC midnight so new quests / rewards appear without rejoining.
	task.spawn(function()
		local lastDay = today()
		while true do
			task.wait(15)
			local day = today()
			if day ~= lastDay then
				lastDay = day
				for _, player in Players:GetPlayers() do
					if DataService.get(player) then
						Sync.mark(player, "daily")
						Notify.player(
							player,
							"🌅 A new day! Fresh quests and your daily reward are ready.",
							"info"
						)
					end
				end
			end
		end
	end)
end

return Retention
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Sell</string>
            <string name="Source"><![CDATA[--!strict
-- Selling slimes for coins at the Sell Stand (or anywhere with the pass).
-- Prices come only from the server catalog and current multipliers.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))
local Net = require(Shared:WaitForChild("Net"))
local Types = require(Shared:WaitForChild("Types"))

local Util = script.Parent.Parent:WaitForChild("Util")
local Notify = require(Util:WaitForChild("Notify"))
local RateLimiter = require(Util:WaitForChild("RateLimiter"))
local Validate = require(Util:WaitForChild("Validate"))

local Analytics = require(script.Parent.Analytics)
local Boosts = require(script.Parent.Boosts)
local DataService = require(script.Parent.DataService)
local Monetization = require(script.Parent.Monetization)
local Plots = require(script.Parent.Plots)
local Retention = require(script.Parent.Retention)
local Sync = require(script.Parent.Sync)
local Tutorial = require(script.Parent.Tutorial)

type Profile = Types.Profile
type SlimeData = Types.SlimeData

local Sell = {}

local function canSellHere(player: Player): boolean
	if Monetization.owns(player, "sell_anywhere") then
		return true
	end
	return Validate.near(player, Plots.world().sellCounter.CFrame.Position, Config.Sell.ReachDistance)
end

local function finishSale(player: Player, data: Profile, total: number, count: number)
	data.coins += total
	data.totalEarned += total
	Analytics.coinSource(player, total, data.coins, Enum.AnalyticsEconomyTransactionType.Gameplay, "sell")
	Retention.progress(player, data, "sell", total)
	Tutorial.event(player, data, "sold")
	Notify.effect(player, "sell", { amount = total, count = count })
	Sync.mark(player, "main")
	Sync.mark(player, "backpack")
end

function Sell.sellAll(player: Player)
	local data = DataService.get(player)
	if not data then
		return
	end
	if not canSellHere(player) then
		Notify.player(player, "Walk to the Sell Stand in the hub to sell!", "error")
		return
	end
	local multiplier = Boosts.get(player).sell
	local kept: { SlimeData } = {}
	local total, count = 0, 0
	for _, slime in data.slimes do
		if slime.f then
			table.insert(kept, slime)
		else
			total += Economy.slimeValue(slime, multiplier)
			count += 1
		end
	end
	if count == 0 then
		Notify.player(player, "Nothing to sell! Harvest ripe slimes in your garden first.", "info")
		return
	end
	data.slimes = kept
	finishSale(player, data, total, count)
	Notify.player(player, `💰 Sold {count} slime(s) for {Format.short(total)} coins!`, "success")
end

local function onSellAll(player: Player)
	if not RateLimiter.allow(player, "SellAll", 1, 3) then
		return
	end
	Sell.sellAll(player)
end

local function onSellSlime(player: Player, rawId: unknown)
	if not RateLimiter.allow(player, "SellSlime", 6, 10) then
		return
	end
	local id = Validate.integer(rawId, 1, 2 ^ 31)
	local data = DataService.get(player)
	if not id or not data then
		return
	end
	if not canSellHere(player) then
		Notify.player(player, "Walk to the Sell Stand in the hub to sell!", "error")
		return
	end
	for i, slime in data.slimes do
		if slime.id == id then
			if slime.f then
				Notify.player(player, "Unfavorite this slime to sell it.", "info")
				return
			end
			table.remove(data.slimes, i)
			local value = Economy.slimeValue(slime, Boosts.get(player).sell)
			finishSale(player, data, value, 1)
			return
		end
	end
end

local function onToggleFavorite(player: Player, rawId: unknown)
	if not RateLimiter.allow(player, "ToggleFavorite", 6, 10) then
		return
	end
	local id = Validate.integer(rawId, 1, 2 ^ 31)
	local data = DataService.get(player)
	if not id or not data then
		return
	end
	local favorites = 0
	local target: SlimeData? = nil
	for _, slime in data.slimes do
		if slime.f then
			favorites += 1
		end
		if slime.id == id then
			target = slime
		end
	end
	if not target then
		return
	end
	if target.f then
		target.f = nil
	elseif favorites >= Config.Backpack.MaxFavorites then
		Notify.player(player, `You can favorite up to {Config.Backpack.MaxFavorites} slimes.`, "error")
		return
	else
		target.f = true
	end
	Sync.mark(player, "backpack")
end

function Sell.start()
	Net.event("SellAll").OnServerEvent:Connect(onSellAll)
	Net.event("SellSlime").OnServerEvent:Connect(onSellSlime)
	Net.event("ToggleFavorite").OnServerEvent:Connect(onToggleFavorite)

	local prompt = Plots.world().sellCounter:FindFirstChild("SellPrompt") :: ProximityPrompt?
	if prompt then
		prompt.Triggered:Connect(function(player)
			if RateLimiter.allow(player, "SellAll", 1, 3) then
				Sell.sellAll(player)
			end
		end)
	end
end

return Sell
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[--!strict
-- Seed shop with a server-wide restock every few minutes. Stock is per
-- player (everyone can buy the full listed amount), so it creates a reason
-- to check back without letting anyone grief others.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Net = require(Shared:WaitForChild("Net"))
local Species = require(Shared:WaitForChild("Species"))
local Stock = require(Shared:WaitForChild("Stock"))
local Types = require(Shared:WaitForChild("Types"))

local Util = script.Parent.Parent:WaitForChild("Util")
local Notify = require(Util:WaitForChild("Notify"))
local RateLimiter = require(Util:WaitForChild("RateLimiter"))
local Validate = require(Util:WaitForChild("Validate"))

local Analytics = require(script.Parent.Analytics)
local DataService = require(script.Parent.DataService)
local Plots = require(script.Parent.Plots)
local Retention = require(script.Parent.Retention)
local Sync = require(script.Parent.Sync)
local Tutorial = require(script.Parent.Tutorial)

type Profile = Types.Profile
type StockState = Types.StockState

local Shop = {}

local random = Random.new()
local state: StockState = { restockId = 0, nextRestockAt = 0, stock = {} }
local bought: { [Player]: { restockId: number, counts: { [string]: number } } } = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function rng(): number
	return random:NextNumber()
end

function Shop.state(): StockState
	return state
end

local function purchasesFor(player: Player): { [string]: number }
	local entry = bought[player]
	if entry and entry.restockId == state.restockId then
		return entry.counts
	end
	local counts: { [string]: number } = {}
	bought[player] = { restockId = state.restockId, counts = counts }
	return counts
end

local function restock(silent: boolean)
	state.restockId += 1
	state.stock = Stock.roll(rng)
	state.nextRestockAt = now() + Config.Shop.RestockInterval
	Net.event("Stock"):FireAllClients(state)
	for _, player in Players:GetPlayers() do
		Sync.mark(player, "shop")
	end
	if silent then
		return
	end
	-- Call out rare stock so players in the server can react.
	local rare = {}
	for _, species in Species.shopOrder do
		if state.stock[species.id] and species.tier >= 6 then
			table.insert(rare, species.name)
		end
	end
	if #rare > 0 then
		Notify.all(
			`🌱 Seed Shop restocked with RARE seeds: {table.concat(rare, ", ")}!`,
			Color3.fromRGB(255, 220, 90)
		)
	else
		Notify.all("🌱 The Seed Shop has restocked!", nil)
	end
end

local function onBuySeed(player: Player, rawSpecies: unknown, rawQuantity: unknown)
	if not RateLimiter.allow(player, "BuySeed", 8, 12) then
		return
	end
	local speciesId = Validate.shortString(rawSpecies, 24)
	local quantity = Validate.integer(rawQuantity, 1, 50)
	local data = DataService.get(player)
	if not speciesId or not quantity or not data then
		return
	end
	local species = Species.byId[speciesId]
	if not species or species.price <= 0 then
		return
	end
	if data.rebirths < species.requiresRebirth then
		Notify.player(player, `{species.name} seeds unlock after Rebirth {species.requiresRebirth}.`, "error")
		return
	end
	if not Validate.near(player, Plots.world().shopCounter.CFrame.Position, Config.Shop.ReachDistance) then
		Notify.player(player, "Visit the Seed Shop to buy seeds.", "error")
		return
	end
	local counts = purchasesFor(player)
	local remaining = (state.stock[speciesId] or 0) - (counts[speciesId] or 0)
	local affordable = math.floor(data.coins / species.price)
	local amount = math.min(quantity, remaining, affordable)
	if remaining <= 0 then
		Notify.player(player, `{species.name} is sold out until the next restock.`, "error")
		return
	elseif amount <= 0 then
		Notify.player(
			player,
			`You need {Format.short(species.price)} coins for a {species.name} seed.`,
			"error"
		)
		return
	end

	local cost = amount * species.price
	data.coins -= cost
	data.seeds[speciesId] = (data.seeds[speciesId] or 0) + amount
	data.stats.seedsBought += amount
	counts[speciesId] = (counts[speciesId] or 0) + amount

	Analytics.coinSink(
		player,
		cost,
		data.coins,
		Enum.AnalyticsEconomyTransactionType.Shop,
		"seed_" .. speciesId
	)
	Retention.progress(player, data, "buy", amount)
	Tutorial.event(player, data, "bought")
	Notify.effect(player, "buy", { species = speciesId, amount = amount })
	Sync.mark(player, "main")
	Sync.mark(player, "shop")
end

function Shop.init()
	Sync.register("shop", function(player: Player)
		return { restockId = state.restockId, bought = purchasesFor(player) }
	end)
	restock(true)
end

function Shop.start()
	Net.event("BuySeed").OnServerEvent:Connect(onBuySeed)
	Net.event("RequestSync").OnServerEvent:Connect(function(player)
		if RateLimiter.allow(player, "RequestSyncStock", 0.2, 2) then
			Net.event("Stock"):FireClient(player, state)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		bought[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if now() >= state.nextRestockAt then
				restock(false)
			end
		end
	end)
end

return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Sync</string>
            <string name="Source"><![CDATA[--!strict
-- Replicates each player's own state to their client. Systems mark sections
-- dirty; dirty sections are rebuilt and sent at most every 0.15 s, so a burst
-- of changes (Harvest All, Sell All) costs one message.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Types = require(Shared:WaitForChild("Types"))

local RateLimiter = require(script.Parent.Parent:WaitForChild("Util"):WaitForChild("RateLimiter"))

local DataService = require(script.Parent.DataService)

type Profile = Types.Profile
type Builder = (Player, Profile) -> any

local FLUSH_INTERVAL = 0.15

local Sync = {}

local builders: { [string]: Builder } = {}
local dirty: { [Player]: { [string]: boolean } } = {}

function Sync.register(section: string, builder: Builder)
	assert(builders[section] == nil, `duplicate sync section {section}`)
	builders[section] = builder
end

function Sync.mark(player: Player, section: string?)
	local sections = dirty[player]
	if not sections then
		sections = {}
		dirty[player] = sections
	end
	sections[section or "main"] = true
end

function Sync.markAll(player: Player)
	for section in builders do
		Sync.mark(player, section)
	end
end

local function buildMain(_: Player, data: Profile): any
	return {
		coins = data.coins,
		totalEarned = data.totalEarned,
		rebirths = data.rebirths,
		bestTier = data.bestTier,
		seeds = data.seeds,
		unlockedTiles = data.unlockedTiles,
		potions = data.potions,
		instantGrowCharges = data.instantGrowCharges,
		index = data.index,
		tutorialStep = data.tutorialStep,
		autoHarvest = data.autoHarvest,
		stats = { harvested = data.stats.harvested },
	}
end

local function buildBackpack(_: Player, data: Profile): any
	return data.slimes
end

local function flush()
	for player, sections in dirty do
		local data = DataService.get(player)
		if not data then
			if not player.Parent then
				dirty[player] = nil
			end
			continue
		end
		dirty[player] = nil
		local payload = {}
		for section in sections do
			local builder = builders[section]
			if builder then
				local ok, result = pcall(builder, player, data)
				if ok then
					payload[section] = result
				else
					warn(`[Sync] section {section} failed: {result}`)
				end
			end
		end
		Net.event("Sync"):FireClient(player, payload)
	end
end

function Sync.init()
	Sync.register("main", buildMain)
	Sync.register("backpack", buildBackpack)
end

function Sync.start()
	DataService.ProfileLoaded:Connect(function(player)
		Sync.markAll(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
	end)
	Net.event("RequestSync").OnServerEvent:Connect(function(player)
		if RateLimiter.allow(player, "RequestSync", 0.2, 2) then
			Sync.markAll(player)
		end
	end)
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed >= FLUSH_INTERVAL then
			elapsed = 0
			flush()
		end
	end)
end

return Sync
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source"><![CDATA[--!strict
-- Five-step onboarding driven by real gameplay events:
--   0 plant -> 1 wait for growth -> 2 harvest -> 3 sell -> 4 buy a seed -> 5 done
-- Each step is logged to the onboarding funnel in Creator Analytics.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))

local Notify = require(script.Parent.Parent:WaitForChild("Util"):WaitForChild("Notify"))

local Analytics = require(script.Parent.Analytics)
local Monetization = require(script.Parent.Monetization)
local Sync = require(script.Parent.Sync)

type Profile = Types.Profile

local Tutorial = {}

Tutorial.DONE = 5

local STEP_NAMES = { "Plant", "Grow", "Harvest", "Sell", "BuySeed", "Complete" }

-- event -> { fromStep, toStep }
local TRANSITIONS: { [string]: { number } } = {
	planted = { 0, 1 },
	ripe = { 1, 2 },
	harvested = { 2, 3 },
	sold = { 3, 4 },
	bought = { 4, 5 },
}

local function setStep(player: Player, data: Profile, step: number)
	data.tutorialStep = step
	Analytics.onboarding(player, step + 1, STEP_NAMES[step + 1])
	if step == Tutorial.DONE then
		data.potions.growth = (data.potions.growth or 0) + 1
		data.coins += 50
		Notify.player(player, "🎉 Tutorial complete! You got a Growth Potion and 50 coins.", "reward")
	end
	Sync.mark(player, "main")
end

function Tutorial.event(player: Player, data: Profile, event: string)
	local transition = TRANSITIONS[event]
	if not transition or data.tutorialStep >= Tutorial.DONE then
		return
	end
	local from, to = transition[1], transition[2]
	if data.tutorialStep == from then
		setStep(player, data, to)
	elseif event == "harvested" and data.tutorialStep < 2 then
		-- harvested a slime that ripened while we weren't watching
		setStep(player, data, 3)
	end
end

function Tutorial.onReady(player: Player, data: Profile)
	if data.tutorialStep >= Tutorial.DONE then
		return
	end
	if data.tutorialStep == 0 then
		Analytics.onboarding(player, 1, STEP_NAMES[1])
	end
	-- Never strand a new player without a seed to plant.
	local hasSeeds = next(data.seeds) ~= nil
	if not hasSeeds and #data.plants == 0 and #data.slimes == 0 and data.coins < 10 then
		data.seeds.goo = 1
		Sync.mark(player, "main")
	end
end

function Tutorial.start()
	Monetization.PlayerReady:Connect(Tutorial.onReady)
end

return Tutorial
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Weather</string>
            <string name="Source"><![CDATA[--!strict
-- Server-wide weather events on a randomized timer, plus purchasable
-- "summon" events that benefit everyone in the server (social, non-random,
-- clearly described in the store).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Signal"))
local Types = require(Shared:WaitForChild("Types"))
local Weathers = require(Shared:WaitForChild("Weathers"))

local Util = script.Parent.Parent:WaitForChild("Util")
local Notify = require(Util:WaitForChild("Notify"))
local RateLimiter = require(Util:WaitForChild("RateLimiter"))

local Monetization = require(script.Parent.Monetization)

type WeatherState = Types.WeatherState

local Weather = {}

Weather.Changed = Signal.new() :: Signal.Signal<string?>

type QueuedEvent = { id: string, summonedBy: string }

local random = Random.new()
local state: WeatherState = {
	id = nil,
	endsAt = 0,
	summonedBy = nil,
	nextAt = 0,
}
local queue: { QueuedEvent } = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

function Weather.current(): string?
	return state.id
end

function Weather.state(): WeatherState
	return state
end

function Weather.growthMultiplier(): number
	local weather = Weathers.get(state.id)
	return if weather then weather.growthMultiplier else 1
end

local function broadcast()
	Net.event("Weather"):FireAllClients(state)
end

local function startEvent(id: string, summonedBy: string?)
	local weather = Weathers.get(id)
	if not weather then
		return
	end
	state.id = id
	state.endsAt = now() + Config.Weather.Duration
	state.summonedBy = summonedBy
	broadcast()
	if summonedBy then
		Notify.all(
			`{weather.icon} {summonedBy} summoned {weather.name} for everyone! {weather.description}`,
			weather.tint
		)
	else
		Notify.all(`{weather.icon} {weather.name} has started! {weather.description}`, weather.tint)
	end
	Weather.Changed:Fire(id)
end

local function endEvent()
	state.id = nil
	state.summonedBy = nil
	state.nextAt = now() + random:NextNumber(Config.Weather.MinInterval, Config.Weather.MaxInterval)
	broadcast()
	Weather.Changed:Fire(nil)
end

-- Summoned events start immediately if the sky is clear, otherwise right
-- after the current event; the buyer is told which.
function Weather.queue(id: string, summonedBy: string): boolean
	if not Weathers.get(id) then
		return false
	end
	if state.id == nil then
		startEvent(id, summonedBy)
	else
		table.insert(queue, { id = id, summonedBy = summonedBy })
	end
	return true
end

local function loop()
	while true do
		task.wait(1)
		local t = now()
		if state.id then
			if t >= state.endsAt then
				endEvent()
			end
		elseif #queue > 0 then
			local nextEvent = table.remove(queue, 1) :: QueuedEvent
			startEvent(nextEvent.id, nextEvent.summonedBy)
		elseif t >= state.nextAt then
			startEvent(Weathers.pick(random:NextNumber()), nil)
		end
	end
end

local function summonHandler(id: string): Monetization.ProductHandler
	return function(player: Player)
		local weather = Weathers.get(id)
		if not weather then
			return false
		end
		local startsNow = state.id == nil
		Weather.queue(id, player.DisplayName)
		if not startsNow then
			Notify.player(
				player,
				`{weather.icon} {weather.name} will start right after the current weather. Thank you!`,
				"reward"
			)
		end
		return true
	end
end

function Weather.init()
	state.nextAt = now() + random:NextNumber(90, 180) -- first event early in a server's life
	Monetization.registerProduct("weather_goorain", summonHandler("goorain"))
	Monetization.registerProduct("weather_starfall", summonHandler("starfall"))
end

function Weather.start()
	Net.event("RequestSync").OnServerEvent:Connect(function(player)
		if RateLimiter.allow(player, "RequestSyncWeather", 0.2, 2) then
			Net.event("Weather"):FireClient(player, state)
		end
	end)
	task.spawn(loop)
end

-- Test / QA hook.
function Weather._force(id: string?)
	if id then
		startEvent(id, nil)
	else
		endEvent()
	end
end

return Weather
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="44">
