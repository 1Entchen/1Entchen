    <Item class="StarterPlayerScripts" referent="53">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="54">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- The single client entry point.

local Controllers = script:WaitForChild("Controllers")
local UI = script:WaitForChild("UI")

local Kit = require(UI:WaitForChild("Kit"))
local State = require(script:WaitForChild("State"))

local ORDER = {
	"Sounds",
	"Notifications",
	"GardenView",
	"HUD",
	"ShopWindow",
	"BackpackWindow",
	"StoreWindow",
	"IndexWindow",
	"RewardsWindow",
	"RebirthWindow",
	"Tutorial",
	"WeatherFX",
	"ChatTags",
	"DevPanel",
}

type Controller = { start: (() -> ())? }

local Sounds = require(Controllers:WaitForChild("Sounds")) :: any
Kit.setClickSound(function()
	Sounds.play("Click")
end)

for _, name in ORDER do
	local module = Controllers:WaitForChild(name) :: ModuleScript
	local controller = (require :: any)(module) :: Controller
	if controller.start then
		task.spawn(function()
			local ok, err = pcall(controller.start :: any)
			if not ok then
				warn(`[Client] {name}.start failed: {err}`)
			end
		end)
	end
end

-- Ask for a full state push once every controller is listening.
task.defer(State.start)
]]></string>
        </Properties>
        <Item class="Folder" referent="55">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">BackpackWindow</string>
              <string name="Source"><![CDATA[--!strict
-- Backpack: every harvested slime with its value; favorite to protect it
-- from Sell All (and keep it through rebirth); sell singles at the stand.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))
local Net = require(Shared:WaitForChild("Net"))
local SlimeBuilder = require(Shared:WaitForChild("SlimeBuilder"))
local Species = require(Shared:WaitForChild("Species"))

local UI = script.Parent.Parent:WaitForChild("UI")
local Kit = require(UI:WaitForChild("Kit"))
local Theme = require(UI:WaitForChild("Theme"))
local Windows = require(UI:WaitForChild("Windows"))

local State = require(script.Parent.Parent:WaitForChild("State"))

local BackpackWindow = {}

local grid: ScrollingFrame
local summary: TextLabel
local detail: Frame
local selectedId: number? = nil
local dirty = true

local function sellMultiplier(): number
	local boosts = State.get("boosts")
	return if boosts then boosts.multipliers.sell else 1
end

local function slimeTitle(slime: any): string
	local species = Species.byId[slime.s]
	local parts = {}
	local mutationText = SlimeBuilder.mutationNames(slime.m)
	if mutationText ~= "" then
		table.insert(parts, mutationText)
	end
	local weightLabel = Economy.weightLabel(slime.w)
	if weightLabel then
		table.insert(parts, weightLabel)
	end
	table.insert(parts, if species then species.name else slime.s)
	return table.concat(parts, " ")
end

local function findSlime(id: number?): any
	local backpack = State.get("backpack")
	if not backpack or not id then
		return nil
	end
	for _, slime in backpack do
		if slime.id == id then
			return slime
		end
	end
	return nil
end

local function renderDetail()
	for _, child in detail:GetChildren() do
		if not child:IsA("UICorner") and not child:IsA("UIStroke") then
			child:Destroy()
		end
	end
	local slime = findSlime(selectedId)
	if not slime then
		Kit.label({
			Text = "Tap a slime to inspect it",
			Font = Theme.BodyFont,
			TextColor3 = Theme.Colors.TextDim,
			Size = UDim2.new(1, -20, 0, 60),
			Position = UDim2.fromOffset(10, 20),
			TextWrapped = true,
			NoStroke = true,
			MaxTextSize = 22,
			Parent = detail,
		})
		return
	end
	Kit.slimeViewport(slime.s, slime.m, {
		Size = UDim2.new(1, -20, 0, 130),
		Position = UDim2.fromOffset(10, 6),
		Parent = detail,
	})
	Kit.label({
		Text = slimeTitle(slime),
		Size = UDim2.new(1, -16, 0, 48),
		Position = UDim2.fromOffset(8, 138),
		TextWrapped = true,
		MaxTextSize = 22,
		Parent = detail,
	})
	Kit.label({
		Text = `Weight {Format.multiplier(slime.w)} · Mutations {Format.multiplier(
			Economy.mutationMultiplier(slime.m)
		)}`,
		Font = Theme.BodyFont,
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, -16, 0, 20),
		Position = UDim2.fromOffset(8, 188),
		NoStroke = true,
		MaxTextSize = 16,
		Parent = detail,
	})
	Kit.label({
		Text = `🪙 {Format.short(Economy.slimeValue(slime, sellMultiplier()))}`,
		TextColor3 = Theme.Colors.Coin,
		Size = UDim2.new(1, -16, 0, 30),
		Position = UDim2.fromOffset(8, 210),
		MaxTextSize = 28,
		Parent = detail,
	})
	Kit.button({
		text = if slime.f then "★ Unfavorite" else "☆ Favorite",
		color = Theme.Colors.Gold,
		size = UDim2.new(1, -16, 0, 42),
		position = UDim2.new(0, 8, 1, -100),
		parent = detail,
		onClick = function()
			Net.event("ToggleFavorite"):FireServer(slime.id)
		end,
	})
	local sell = Kit.button({
		text = "Sell",
		color = Theme.Colors.Green,
		size = UDim2.new(1, -16, 0, 42),
		position = UDim2.new(0, 8, 1, -52),
		parent = detail,
		onClick = function()
			Net.event("SellSlime"):FireServer(slime.id)
			selectedId = nil
		end,
	})
	Kit.setEnabled(sell, not slime.f, Theme.Colors.Green)
end

local function render()
	dirty = false
	for _, child in grid:GetChildren() do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
	local backpack = State.get("backpack") or {}
	local multiplier = sellMultiplier()
	local sorted: { any } = table.clone(backpack)
	table.sort(sorted, function(a: any, b: any)
		if (a.f == true) ~= (b.f == true) then
			return a.f == true
		end
		return Economy.slimeValue(a, 1) > Economy.slimeValue(b, 1)
	end)
	local total = 0
	for order, slime in sorted do
		local value = Economy.slimeValue(slime, multiplier)
		if not slime.f then
			total += value
		end
		local species = Species.byId[slime.s]
		local cell: TextButton = Kit.new("TextButton", {
			Name = tostring(slime.id),
			Text = "",
			AutoButtonColor = true,
			BackgroundColor3 = Theme.Colors.PanelLight,
			LayoutOrder = order,
			Parent = grid,
		})
		Kit.corner(12).Parent = cell
		Kit.stroke(if species then Species.RarityColors[species.rarity] else Theme.Colors.Stroke, 2).Parent =
			cell
		local blob: Frame = Kit.new("Frame", {
			BackgroundColor3 = SlimeBuilder.displayColor(slime.s, slime.m),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 8),
			Size = UDim2.fromOffset(46, 38),
			Parent = cell,
		})
		Kit.new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = blob })
		Kit.stroke(Theme.Colors.Stroke, 2).Parent = blob
		Kit.label({
			Text = "• •",
			TextColor3 = Theme.Colors.Stroke,
			Size = UDim2.fromScale(1, 0.6),
			Position = UDim2.fromScale(0, 0.15),
			NoStroke = true,
			Parent = blob,
		})
		if #slime.m > 0 then
			Kit.label({
				Text = "✨",
				Size = UDim2.fromOffset(22, 22),
				Position = UDim2.fromOffset(4, 4),
				NoStroke = true,
				Parent = cell,
			})
		end
		if slime.f then
			Kit.label({
				Text = "★",
				TextColor3 = Theme.Colors.Gold,
				Size = UDim2.fromOffset(22, 22),
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -4, 0, 4),
				Parent = cell,
			})
		end
		Kit.label({
			Text = Format.short(value),
			TextColor3 = Theme.Colors.Coin,
			Size = UDim2.new(1, -6, 0, 22),
			Position = UDim2.new(0, 3, 1, -26),
			MaxTextSize = 18,
			Parent = cell,
		})
		cell.Activated:Connect(function()
			selectedId = slime.id
			renderDetail()
		end)
	end
	local capacity = Economy.backpackCapacity(State.owns("vip"))
	summary.Text =
		`{#backpack}/{capacity} slimes · worth 🪙 {Format.short(total)}  (★ favorites are never sold, max {Config.Backpack.MaxFavorites})`
	renderDetail()
end

local function build(content: Frame)
	summary = Kit.label({
		Text = "",
		Font = Theme.BodyFont,
		Size = UDim2.new(1, -190, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 18,
		Parent = content,
	})
	Kit.button({
		text = "💰 Sell All",
		color = Theme.Colors.Gold,
		size = UDim2.fromOffset(170, 40),
		position = UDim2.new(1, 0, 0, -6),
		anchor = Vector2.new(1, 0),
		parent = content,
		onClick = function()
			Net.event("SellAll"):FireServer()
		end,
	})
	grid = Kit.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -210, 1, -40),
		Position = UDim2.fromOffset(0, 40),
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = content,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(84, 92),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	detail = Kit.new("Frame", {
		BackgroundColor3 = Theme.Colors.PanelDark,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 40),
		Size = UDim2.new(0, 200, 1, -40),
		Parent = content,
	})
	Kit.corner(14).Parent = detail
	render()
end

function BackpackWindow.start()
	Windows.register("Backpack", {
		title = "🎒 Backpack",
		color = Theme.Colors.Blue,
		size = Vector2.new(820, 520),
		build = build,
		onOpen = function()
			if dirty then
				render()
			end
		end,
	})
	State.Changed:Connect(function(section)
		if section == "backpack" or section == "boosts" then
			dirty = true
			if Windows.isOpen("Backpack") then
				render()
			end
		end
	end)
end

return BackpackWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">ChatTags</string>
              <string name="Source"><![CDATA[--!strict
-- VIP chat tag (the VIP attribute is set by the server from verified pass
-- ownership; it is purely cosmetic).

local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local ChatTags = {}

function ChatTags.start()
	TextChatService.OnIncomingMessage = function(message: TextChatMessage): TextChatMessageProperties?
		local source = message.TextSource
		if not source then
			return nil
		end
		local speaker = Players:GetPlayerByUserId(source.UserId)
		if not speaker or not speaker:GetAttribute("VIP") then
			return nil
		end
		local properties = Instance.new("TextChatMessageProperties")
		properties.PrefixText = `<font color="#FFC42E">[VIP]</font> {message.PrefixText}`
		return properties
	end
end

return ChatTags
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">DevPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Studio-only QA shortcuts. The server rejects these requests in live
-- servers (RunService:IsStudio() is checked server-side), and this panel is
-- never created outside Studio.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local UI = script.Parent.Parent:WaitForChild("UI")
local Kit = require(UI:WaitForChild("Kit"))
local Theme = require(UI:WaitForChild("Theme"))

local DevPanel = {}

function DevPanel.start()
	if not RunService:IsStudio() then
		return
	end
	local _, canvas = Kit.screen("SlimeDevPanel", 30)
	local panel: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.Colors.PanelDark,
		BackgroundTransparency = 0.2,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 10, 1, -110),
		Size = UDim2.fromOffset(132, 176),
		Parent = canvas,
	})
	Kit.corner(10).Parent = panel
	Kit.padding(6).Parent = panel
	Kit.list(Enum.FillDirection.Vertical, 4).Parent = panel
	Kit.label({ Text = "STUDIO QA", Size = UDim2.new(1, 0, 0, 18), MaxTextSize = 14, Parent = panel })
	for i, entry in
		{
			{ "+1B coins", "dev_coins" },
			{ "+5 rare seeds", "dev_seeds" },
			{ "Ripen all", "instant_grow" },
			{ "Starfall", "weather_starfall" },
		}
	do
		Kit.button({
			text = entry[1],
			color = Theme.Colors.Grey,
			size = UDim2.new(1, 0, 0, 32),
			textSize = 15,
			layoutOrder = i,
			parent = panel,
			onClick = function()
				Net.event("DevGrant"):FireServer(entry[2])
			end,
		})
	end
end

return DevPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">GardenView</string>
              <string name="Source"><![CDATA[--!strict
-- Garden interaction and visuals on the client:
--  * tap / click a tile to plant the selected seed, tap a ripe slime to harvest
--  * grows slime models locally from replicated growth attributes
--  * bouncing ripe slimes, rainbow colour cycling, orbiting stars
--  * timers / "READY" labels and harvest prompts on the player's own garden
-- The server validates every request; nothing here is authoritative.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Signal"))
local Species = require(Shared:WaitForChild("Species"))

local UI = script.Parent.Parent:WaitForChild("UI")
local Kit = require(UI:WaitForChild("Kit"))
local Theme = require(UI:WaitForChild("Theme"))
local Windows = require(UI:WaitForChild("Windows"))

local State = require(script.Parent.Parent:WaitForChild("State"))
local Notifications = require(script.Parent.Notifications)

local GardenView = {}

GardenView.SelectionChanged = Signal.new() :: Signal.Signal<string?>
GardenView.selectedSeed = nil :: string?

local player = Players.LocalPlayer

type Tracked = {
	model: Model,
	own: boolean,
	base: CFrame,
	scale: number,
	phase: number,
	billboard: BillboardGui?,
	prompt: ProximityPrompt?,
}

local tracked: { [Model]: Tracked } = {}
local plotsFolder: Folder? = nil
local hoverHighlight: Highlight? = nil

local function ownPlot(): Model?
	local index = player:GetAttribute("PlotIndex")
	if typeof(index) ~= "number" or not plotsFolder then
		return nil
	end
	local plot = (plotsFolder :: Folder):FindFirstChild(`Plot{index}`)
	return if plot and plot:IsA("Model") then plot else nil
end

function GardenView.ownPlot(): Model?
	return ownPlot()
end

function GardenView.select(speciesId: string?)
	GardenView.selectedSeed = speciesId
	GardenView.SelectionChanged:Fire(speciesId)
end

-- Picks the most valuable seed the player owns.
local function bestOwnedSeed(): string?
	local main = State.main()
	if not main then
		return nil
	end
	local best: string? = nil
	local bestTier = -1
	for id, count in main.seeds do
		local species = Species.byId[id]
		if species and count > 0 then
			local tier = if species.tier == 0 then 100 else species.tier
			if tier > bestTier then
				best, bestTier = id, tier
			end
		end
	end
	return best
end

local function ensureSelection()
	local main = State.main()
	if not main then
		return
	end
	local selected = GardenView.selectedSeed
	if selected and (main.seeds[selected] or 0) > 0 then
		return
	end
	GardenView.select(bestOwnedSeed())
end

local function progressOf(model: Model): number
	if model:GetAttribute("Ripe") then
		return 1
	end
	local growTime = model:GetAttribute("GrowTime")
	local elapsed = model:GetAttribute("Elapsed")
	local rate = model:GetAttribute("Rate")
	local updatedAt = model:GetAttribute("UpdatedAt")
	if
		typeof(growTime) ~= "number"
		or typeof(elapsed) ~= "number"
		or typeof(rate) ~= "number"
		or typeof(updatedAt) ~= "number"
	then
		return 0
	end
	local current = elapsed + (Workspace:GetServerTimeNow() - updatedAt) * rate
	return math.clamp(current / math.max(growTime, 0.001), 0, 1)
end

local function remainingSeconds(model: Model): number
	local growTime = model:GetAttribute("GrowTime")
	local rate = model:GetAttribute("Rate")
	if typeof(growTime) ~= "number" or typeof(rate) ~= "number" or rate <= 0 then
		return 0
	end
	return (1 - progressOf(model)) * growTime / rate
end

local function slimeValue(model: Model): number
	local mutationsText = model:GetAttribute("Mutations")
	local mutations = {}
	if typeof(mutationsText) == "string" and mutationsText ~= "" then
		mutations = string.split(mutationsText, ",")
	end
	local weight = model:GetAttribute("Weight")
	local base = model:GetAttribute("BaseValue")
	local boosts = State.get("boosts")
	local multiplier = if boosts then boosts.multipliers.sell else 1
	return Economy.slimeValue({
		s = tostring(model:GetAttribute("Species")),
		w = if typeof(weight) == "number" then weight else 1,
		m = mutations,
		b = if typeof(base) == "number" then base else nil,
	}, multiplier)
end

local function buildBillboard(record: Tracked)
	local body = record.model:FindFirstChild("Body")
	if not body or not body:IsA("BasePart") then
		return
	end
	local billboard: BillboardGui = Kit.new("BillboardGui", {
		Name = "SlimeLabel",
		Adornee = body,
		Size = UDim2.new(4.2, 0, 1.7, 0),
		ExtentsOffsetWorldSpace = Vector3.new(0, 0.6, 0),
		MaxDistance = 80,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Parent = body,
	})
	local title = Kit.label({
		Name = "Title",
		Text = "",
		Size = UDim2.fromScale(1, 0.55),
		MaxTextSize = 60,
		Parent = billboard,
	})
	title.TextScaled = true
	local barBack: Frame = Kit.new("Frame", {
		Name = "Bar",
		BackgroundColor3 = Theme.Colors.PanelDark,
		Size = UDim2.fromScale(0.9, 0.3),
		Position = UDim2.fromScale(0.05, 0.62),
		Parent = billboard,
	})
	Kit.corner(8).Parent = barBack
	Kit.stroke(Theme.Colors.Stroke, 2).Parent = barBack
	local fill: Frame = Kit.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = Theme.Colors.Green,
		Size = UDim2.fromScale(0, 1),
		Parent = barBack,
	})
	Kit.corner(8).Parent = fill
	record.billboard = billboard
end

local function updateBillboard(record: Tracked)
	local billboard = record.billboard
	if not billboard then
		return
	end
	local title = billboard:FindFirstChild("Title") :: TextLabel
	local bar = billboard:FindFirstChild("Bar") :: Frame
	local fill = bar:FindFirstChild("Fill") :: Frame
	if record.model:GetAttribute("Ripe") then
		local mutationsText = record.model:GetAttribute("Mutations")
		local hasMutation = typeof(mutationsText) == "string" and mutationsText ~= ""
		title.Text = `✋ {Format.short(slimeValue(record.model))} 🪙`
		title.TextColor3 = if hasMutation then Theme.Colors.Pink else Theme.Colors.Coin
		bar.Visible = false
	else
		title.Text = `⏳ {Format.clock(remainingSeconds(record.model))}`
		title.TextColor3 = Theme.Colors.Text
		bar.Visible = true
		fill.Size = UDim2.fromScale(progressOf(record.model), 1)
	end
end

local function updatePrompt(record: Tracked)
	if not record.own then
		return
	end
	local ripe = record.model:GetAttribute("Ripe") == true
	if ripe and not record.prompt then
		local body = record.model:FindFirstChild("Body")
		if body and body:IsA("BasePart") then
			local speciesId = record.model:GetAttribute("Species")
			local species = if typeof(speciesId) == "string" then Species.byId[speciesId] else nil
			local prompt: ProximityPrompt = Kit.new("ProximityPrompt", {
				Name = "HarvestPrompt",
				ActionText = "Harvest",
				ObjectText = if species then species.name else "Slime",
				HoldDuration = 0,
				MaxActivationDistance = 11,
				RequiresLineOfSight = false,
				KeyboardKeyCode = Enum.KeyCode.E,
				Parent = body,
			})
			prompt:SetAttribute("Tile", record.model:GetAttribute("Tile"))
			record.prompt = prompt
		end
	elseif not ripe and record.prompt then
		record.prompt:Destroy()
		record.prompt = nil
	end
end

local function track(model: Instance)
	if not model:IsA("Model") or tracked[model] then
		return
	end
	local owner = model:GetAttribute("OwnerUserId")
	local record: Tracked = {
		model = model,
		own = owner == player.UserId,
		base = model:GetPivot(),
		scale = 1,
		phase = math.random() * math.pi * 2,
		billboard = nil,
		prompt = nil,
	}
	tracked[model] = record
	if record.own then
		buildBillboard(record)
		updateBillboard(record)
		updatePrompt(record)
	end
	model:GetAttributeChangedSignal("Ripe"):Connect(function()
		updatePrompt(record)
		updateBillboard(record)
	end)
	model.AncestryChanged:Connect(function(_, parent)
		if not parent then
			tracked[model] = nil
		end
	end)
end

local function watchFolder(folder: Instance)
	for _, child in folder:GetChildren() do
		track(child)
	end
	folder.ChildAdded:Connect(track)
end

-- Ambient slimes (shopkeepers, fountain) bounce too.
local function trackAmbient(root: Instance)
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("Model") and descendant:GetAttribute("Bounce") then
			tracked[descendant] = {
				model = descendant,
				own = false,
				base = descendant:GetPivot(),
				scale = 1,
				phase = math.random() * math.pi * 2,
				billboard = nil,
				prompt = nil,
			}
		end
	end
end

function GardenView.ripeCount(): number
	local count = 0
	for model, record in tracked do
		if record.own and model:GetAttribute("Ripe") then
			count += 1
		end
	end
	return count
end

function GardenView.growingCount(): number
	local count = 0
	for model, record in tracked do
		if
			record.own
			and model.Parent
			and model.Parent.Name == "Plants"
			and not model:GetAttribute("Ripe")
		then
			count += 1
		end
	end
	return count
end

local function plantOnTile(plot: Model, tileIndex: number): boolean
	local plants = plot:FindFirstChild("Plants")
	return plants ~= nil and plants:FindFirstChild(`Plant{tileIndex}`) ~= nil
end

function GardenView.plant(tileIndex: number): boolean
	local main = State.main()
	local plot = ownPlot()
	if not main or not plot then
		return false
	end
	ensureSelection()
	local seed = GardenView.selectedSeed
	if not seed or (main.seeds[seed] or 0) < 1 then
		Notifications.toast("Out of seeds! Buy more at the Seed Shop 🌱", "info")
		return false
	end
	if plantOnTile(plot, tileIndex) then
		return false
	end
	Net.event("Plant"):FireServer(tileIndex, seed)
	return true
end

-- Plants the selected seed on every empty usable tile (paced under the
-- server's rate limit).
function GardenView.plantAll()
	local plot = ownPlot()
	local main = State.main()
	if not plot or not main then
		return
	end
	ensureSelection()
	local seed = GardenView.selectedSeed
	if not seed then
		Notifications.toast("Out of seeds! Buy more at the Seed Shop 🌱", "info")
		return
	end
	local available = main.seeds[seed] or 0
	local tiles = {}
	for _, child in plot:GetChildren() do
		local index = child:GetAttribute("TileIndex")
		if typeof(index) == "number" and child:GetAttribute("Usable") and not plantOnTile(plot, index) then
			table.insert(tiles, index)
		end
	end
	table.sort(tiles)
	if #tiles == 0 then
		Notifications.toast("No empty tiles! Harvest or unlock more.", "info")
		return
	end
	task.spawn(function()
		for i = 1, math.min(#tiles, available) do
			Net.event("Plant"):FireServer(tiles[i], seed)
			task.wait(0.08)
		end
	end)
end

local function onTileTapped(tile: BasePart, tileIndex: number)
	local main = State.main()
	local plot = ownPlot()
	if not main or not plot then
		return
	end
	if tile:GetAttribute("Usable") then
		GardenView.plant(tileIndex)
		return
	end
	if tileIndex > Config.Plots.FreeTileLimit then
		Windows.open("Store")
		Notifications.toast("⭐ This row comes with the Big Garden pass.", "info")
		return
	end
	local nextTile = main.unlockedTiles + 1
	local cost = Economy.tileCost(nextTile)
	if tileIndex ~= nextTile then
		Notifications.toast(
			`Unlock tiles in order — the next one costs {Format.short(cost)} coins.`,
			"info"
		)
		return
	end
	Windows.confirm("Unlock Tile", `Expand your garden for {Format.short(cost)} coins?`, "Unlock", function()
		Net.event("UnlockTile"):FireServer()
	end)
end

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Include

local function raycastOwnPlot(screenPosition: Vector2): RaycastResult?
	local plot = ownPlot()
	local camera = Workspace.CurrentCamera
	if not plot or not camera then
		return nil
	end
	raycastParams.FilterDescendantsInstances = { plot }
	local ray = camera:ScreenPointToRay(screenPosition.X, screenPosition.Y)
	return Workspace:Raycast(ray.Origin, ray.Direction * 600, raycastParams)
end

local function plantModelFrom(instance: Instance): Model?
	local current: Instance? = instance
	while current do
		if current:IsA("Model") and current.Parent and current.Parent.Name == "Plants" then
			return current
		end
		current = current.Parent
	end
	return nil
end

local function onWorldTap(screenPosition: Vector2)
	local result = raycastOwnPlot(screenPosition)
	if not result then
		return
	end
	local plantModel = plantModelFrom(result.Instance)
	if plantModel then
		local tileIndex = plantModel:GetAttribute("Tile")
		if plantModel:GetAttribute("Ripe") then
			Net.event("Harvest"):FireServer(tileIndex)
		else
			Notifications.toast(`Still growing… ⏳ {Format.clock(remainingSeconds(plantModel))}`, "info")
		end
		return
	end
	local tileIndex = result.Instance:GetAttribute("TileIndex")
	if typeof(tileIndex) == "number" and result.Instance:IsA("BasePart") then
		onTileTapped(result.Instance, tileIndex)
	end
end

local function updateHover(screenPosition: Vector2)
	local highlight = hoverHighlight
	if not highlight then
		return
	end
	local result = raycastOwnPlot(screenPosition)
	local target: Instance? = nil
	if result then
		local plantModel = plantModelFrom(result.Instance)
		if plantModel and plantModel:GetAttribute("Ripe") then
			target = plantModel
		elseif result.Instance:GetAttribute("TileIndex") then
			target = result.Instance
		end
	end
	highlight.Adornee = target
	highlight.Enabled = target ~= nil
end

local function animate()
	local t = os.clock()
	local camera = Workspace.CurrentCamera
	local cameraPosition = if camera then camera.CFrame.Position else Vector3.zero
	for model, record in tracked do
		if not model.Parent then
			tracked[model] = nil
			continue
		end
		local isPlant = model.Parent.Name == "Plants"
		local ripe = not isPlant or model:GetAttribute("Ripe") == true

		local near = (record.base.Position - cameraPosition).Magnitude < 170
		if isPlant and (near or ripe) then
			local minScale = Config.Growth.MinVisualScale
			local target = if ripe then 1 else minScale + (1 - minScale) * progressOf(model)
			-- ~35 visible growth steps per plant keeps ScaleTo calls cheap.
			if math.abs(target - record.scale) > 0.02 or (ripe and record.scale ~= 1) then
				record.scale = target
				model:PivotTo(record.base)
				model:ScaleTo(target)
			end
		end

		if ripe and near then
			local hop = math.abs(math.sin(t * 3.2 + record.phase)) * 0.35 * record.scale
			model:PivotTo(record.base * CFrame.new(0, hop, 0))
			if model:GetAttribute("Rainbow") then
				local body = model:FindFirstChild("Body")
				if body and body:IsA("BasePart") then
					body.Color = Color3.fromHSV((t * 0.25 + record.phase) % 1, 0.7, 1)
				end
			end
			-- Orbiting stars (Cosmic / Prism): placed directly each frame so
			-- they never drift relative to the bouncing body.
			local orbit = model:FindFirstChild("Orbit")
			local body = model.PrimaryPart
			if orbit and body then
				local center = body.Position
				local radius = body.Size.X * 0.68
				for _, star in orbit:GetChildren() do
					if star:IsA("BasePart") then
						local index = tonumber(string.match(star.Name, "%d+")) or 0
						local angle = index / 8 * math.pi * 2 + t * 1.2
						star.CFrame = CFrame.new(
							center
								+ Vector3.new(
									math.cos(angle) * radius,
									math.sin(angle) * radius * 0.35,
									math.sin(angle) * radius
								)
						)
					end
				end
			end
		end
	end
end

function GardenView.start()
	local world = Workspace:WaitForChild("SlimeGarden")
	plotsFolder = world:WaitForChild("Plots") :: Folder
	for _, plot in (plotsFolder :: Folder):GetChildren() do
		local plants = plot:WaitForChild("Plants")
		watchFolder(plants)
	end
	trackAmbient(world:WaitForChild("Hub"))

	-- Billboards refresh 4x per second; motion runs every frame.
	task.spawn(function()
		while true do
			task.wait(0.25)
			for _, record in tracked do
				if record.own then
					updateBillboard(record)
				end
			end
		end
	end)
	RunService.RenderStepped:Connect(animate)

	-- Input: taps on touch devices, clicks on desktop.
	UserInputService.TouchTapInWorld:Connect(function(position, processedByUI)
		if not processedByUI then
			onWorldTap(position)
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			onWorldTap(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)
	if UserInputService.MouseEnabled then
		hoverHighlight = Kit.new("Highlight", {
			Name = "TileHover",
			FillColor = Color3.fromRGB(255, 255, 200),
			FillTransparency = 0.75,
			OutlineColor = Color3.fromRGB(255, 255, 255),
			OutlineTransparency = 0.2,
			DepthMode = Enum.HighlightDepthMode.Occluded,
			Enabled = false,
			Parent = player:WaitForChild("PlayerGui"),
		})
		local lastHover = 0
		UserInputService.InputChanged:Connect(function(input, processed)
			if input.UserInputType == Enum.UserInputType.MouseMovement and os.clock() - lastHover > 0.05 then
				lastHover = os.clock()
				if processed then
					(hoverHighlight :: Highlight).Enabled = false
				else
					updateHover(Vector2.new(input.Position.X, input.Position.Y))
				end
			end
		end)
	end

	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if who ~= player then
			return
		end
		if prompt.Name == "HarvestPrompt" then
			local tileIndex = prompt:GetAttribute("Tile")
			if typeof(tileIndex) == "number" then
				Net.event("Harvest"):FireServer(tileIndex)
			end
		end
	end)

	State.Changed:Connect(function(section)
		if section == "main" then
			ensureSelection()
		end
	end)
end

return GardenView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--!strict
-- Always-on HUD: coins, restock / weather / boost status, menu buttons
-- (left), context actions (right) and the seed hotbar (bottom).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))
local Net = require(Shared:WaitForChild("Net"))
local Species = require(Shared:WaitForChild("Species"))
local Weathers = require(Shared:WaitForChild("Weathers"))

local UI = script.Parent.Parent:WaitForChild("UI")
local Kit = require(UI:WaitForChild("Kit"))
local Theme = require(UI:WaitForChild("Theme"))
local Windows = require(UI:WaitForChild("Windows"))

local State = require(script.Parent.Parent:WaitForChild("State"))
local GardenView = require(script.Parent.GardenView)
local Notifications = require(script.Parent.Notifications)

local HUD = {}

local root: Frame
local coinsLabel: TextLabel
local coinsPill: Frame
local statusLabel: TextLabel
local weatherPill: Frame
local weatherLabel: TextLabel
local boostRow: Frame
local seedBar: ScrollingFrame
local seedHint: TextLabel
local menuButtons: { [string]: TextButton } = {}
local actionButtons: { [string]: TextButton } = {}

local displayedCoins = Instance.new("NumberValue")

local function menuButton(
	name: string,
	icon: string,
	caption: string,
	color: Color3,
	order: number,
	parent: Instance,
	onClick: () -> ()
): TextButton
	local button = Kit.button({
		name = name,
		text = "",
		color = color,
		size = UDim2.fromOffset(72, 72),
		layoutOrder = order,
		onClick = onClick,
	})
	Kit.label({
		Text = icon,
		Size = UDim2.new(1, 0, 0.62, 0),
		NoStroke = true,
		MaxTextSize = 40,
		Parent = button,
	})
	Kit.label({
		Text = caption,
		Size = UDim2.new(1, 8, 0.34, 0),
		Position = UDim2.new(0, -4, 0.66, 0),
		MaxTextSize = 15,
		Parent = button,
	})
	Kit.badge(button)
	button.Parent = parent
	menuButtons[name] = button
	return button
end

local function actionButton(
	name: string,
	text: string,
	color: Color3,
	order: number,
	parent: Instance,
	onClick: () -> ()
): TextButton
	local button = Kit.button({
		name = name,
		text = text,
		color = color,
		size = UDim2.fromOffset(158, 50),
		layoutOrder = order,
		textSize = 22,
		onClick = onClick,
	})
	button.Visible = false
	button.Parent = parent
	actionButtons[name] = button
	return button
end

local function setBadge(button: GuiObject, visible: boolean, text: string?)
	local badge = button:FindFirstChild("Badge") :: TextLabel?
	if badge then
		badge.Visible = visible
		if text then
			badge.Text = text
		end
	end
end

local seedSlots: { [string]: TextButton } = {}

local function refreshSeedSelection()
	for id, slot in seedSlots do
		local stroke = slot:FindFirstChildOfClass("UIStroke")
		if stroke then
			local selected = GardenView.selectedSeed == id
			stroke.Color = if selected then Theme.Colors.Gold else Theme.Colors.Stroke
			stroke.Thickness = if selected then 5 else 3
		end
	end
	local selected = GardenView.selectedSeed
	local species = if selected then Species.byId[selected] else nil
	seedHint.Text = if species
		then `Tap an empty soil tile to plant: {species.name}`
		else "No seeds — visit the Seed Shop 🌱"
end

local function rebuildSeedBar()
	local main = State.main()
	if not main then
		return
	end
	local ids = {}
	for id, count in main.seeds do
		if count > 0 and Species.byId[id] then
			table.insert(ids, id)
		end
	end
	table.sort(ids, function(a, b)
		local ta, tb = Species.byId[a].tier, Species.byId[b].tier
		ta = if ta == 0 then 100 else ta
		tb = if tb == 0 then 100 else tb
		return ta < tb
	end)

	local wanted: { [string]: boolean } = {}
	for order, id in ids do
		wanted[id] = true
		local slot = seedSlots[id]
		if not slot then
			local newSlot = Kit.button({
				name = id,
				text = "",
				color = Theme.Colors.PanelLight,
				size = UDim2.fromOffset(74, 74),
				onClick = function()
					GardenView.select(id)
				end,
			})
			local viewport = Kit.slimeViewport(id, {}, {
				Size = UDim2.fromScale(1, 1),
				Position = UDim2.fromScale(0, -0.04),
			})
			viewport.Parent = newSlot
			Kit.label({
				Name = "Count",
				Text = "",
				Size = UDim2.fromOffset(46, 24),
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, 4, 1, 2),
				TextXAlignment = Enum.TextXAlignment.Right,
				MaxTextSize = 20,
				ZIndex = 3,
				Parent = newSlot,
			})
			newSlot.Parent = seedBar
			seedSlots[id] = newSlot
			slot = newSlot
		end
		local s = slot :: TextButton
		s.LayoutOrder = order
		local countLabel = s:FindFirstChild("Count") :: TextLabel
		countLabel.Text = `x{main.seeds[id]}`
	end
	for id, slot in seedSlots do
		if not wanted[id] then
			slot:Destroy()
			seedSlots[id] = nil
		end
	end
	refreshSeedSelection()
end

local function nearSellStand(): boolean
	local world = Workspace:FindFirstChild("SlimeGarden")
	local hub = world and world:FindFirstChild("Hub")
	local stand = hub and hub:FindFirstChild("SellStand")
	local counter = stand and stand:FindFirstChild("Counter")
	local character = Players.LocalPlayer.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if counter and counter:IsA("BasePart") and rootPart and rootPart:IsA("BasePart") then
		return (counter.Position - rootPart.Position).Magnitude < 28
	end
	return false
end

local function refreshMain()
	local main = State.main()
	if not main then
		return
	end
	TweenService:Create(displayedCoins, Theme.Tween.Smooth, { Value = main.coins }):Play()

	local backpack = State.get("backpack")
	local count = if backpack then #backpack else 0
	local capacity = Economy.backpackCapacity(State.owns("vip"))
	setBadge(menuButtons.Backpack, count > 0, tostring(count))
	if count >= capacity then
		setBadge(menuButtons.Backpack, true, "FULL")
	end
	setBadge(menuButtons.Rebirth, main.coins >= Economy.rebirthCost(main.rebirths))

	local potions = main.potions or {}
	actionButtons.GrowthPotion.Visible = (potions.growth or 0) > 0
	actionButtons.GrowthPotion.Text = `🧪 Growth x{potions.growth or 0}`
	actionButtons.LuckPotion.Visible = (potions.luck or 0) > 0
	actionButtons.LuckPotion.Text = `🔮 Luck x{potions.luck or 0}`
	actionButtons.InstantGrow.Visible = (main.instantGrowCharges or 0) > 0
	actionButtons.InstantGrow.Text = `⏩ Grow x{main.instantGrowCharges or 0}`
	actionButtons.AutoHarvest.Visible = State.owns("auto_harvest")
	actionButtons.AutoHarvest.Text = if main.autoHarvest then "🤖 Auto: ON" else "🤖 Auto: OFF"
	actionButtons.AutoHarvest.BackgroundColor3 = if main.autoHarvest
		then Theme.Colors.Green
		else Theme.Colors.Grey
end

local function refreshDaily()
	local daily = State.get("daily")
	if not daily then
		return
	end
	setBadge(menuButtons.Rewards, daily.canClaim)
	local claimable = false
	for _, quest in daily.quests do
		if not quest.claimed and quest.progress >= quest.target then
			claimable = true
		end
	end
	setBadge(menuButtons.Quests, claimable)
end

local function refreshBoosts()
	local boosts = State.get("boosts")
	for _, child in boostRow:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	if not boosts then
		return
	end
	for i, entry in boosts.list do
		if entry.key == "weather" then
			continue
		end
		local chip = Kit.label({
			Name = entry.key,
			Text = entry.icon,
			Size = UDim2.fromOffset(92, 30),
			BackgroundTransparency = 0.2,
			BackgroundColor3 = Theme.Colors.PanelDark,
			LayoutOrder = i,
			MaxTextSize = 18,
			Parent = boostRow,
		})
		chip:SetAttribute("ExpiresAt", entry.expiresAt)
		chip:SetAttribute("Icon", entry.icon)
		chip:SetAttribute("Label", entry.label)
		Kit.corner(10).Parent = chip
	end
end

local function tickStatus()
	local now = Workspace:GetServerTimeNow()
	local stock = State.stock
	if stock then
		statusLabel.Text = `🌱 Seed restock in {Format.clock(stock.nextRestockAt - now)}`
	end
	local weatherState = State.weather
	local weather = if weatherState then Weathers.get(weatherState.id) else nil
	if weather and weatherState then
		weatherPill.Visible = true
		weatherLabel.Text = `{weather.icon} {weather.name} — {Format.clock(weatherState.endsAt - now)}`
	else
		weatherPill.Visible = false
	end
	for _, chip in boostRow:GetChildren() do
		if chip:IsA("TextLabel") then
			local expiresAt = chip:GetAttribute("ExpiresAt")
			local icon = chip:GetAttribute("Icon")
			if typeof(expiresAt) == "number" then
				chip.Text = `{icon} {Format.clock(expiresAt - now)}`
			else
				local label = chip:GetAttribute("Label")
				chip.Text =
					`{icon} {if typeof(label) == "string" then string.match(label, "%+%d+%%") or "" else ""}`
			end
		end
	end

	local ripe = GardenView.ripeCount()
	actionButtons.HarvestAll.Visible = ripe > 0
	actionButtons.HarvestAll.Text = `✋ Harvest ({ripe})`
	local backpack = State.get("backpack")
	local hasSlimes = backpack ~= nil and #backpack > 0
	actionButtons.Sell.Visible = hasSlimes and (State.owns("sell_anywhere") or nearSellStand())
	actionButtons.PlantAll.Visible = GardenView.selectedSeed ~= nil
end

function HUD.start()
	local _, canvas = Kit.screen("SlimeHUD", 1)
	root = canvas

	-- Coins pill (top centre).
	coinsPill = Kit.new("Frame", {
		Name = "Coins",
		BackgroundColor3 = Theme.Colors.Panel,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(250, 52),
		Parent = root,
	})
	Kit.corner(26).Parent = coinsPill
	Kit.stroke(Theme.Colors.Stroke, 3).Parent = coinsPill
	coinsLabel = Kit.label({
		Text = "🪙 0",
		TextColor3 = Theme.Colors.Coin,
		Size = UDim2.new(1, -24, 1, -8),
		Position = UDim2.fromOffset(12, 4),
		MaxTextSize = 34,
		Parent = coinsPill,
	})
	Notifications.setCoinTarget(coinsPill)
	displayedCoins.Changed:Connect(function(value)
		coinsLabel.Text = `🪙 {Format.short(value)}`
	end)

	statusLabel = Kit.label({
		Text = "",
		TextColor3 = Theme.Colors.TextDim,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 60),
		Size = UDim2.fromOffset(300, 22),
		MaxTextSize = 18,
		Parent = root,
	})
	weatherPill = Kit.new("Frame", {
		Name = "Weather",
		BackgroundColor3 = Theme.Colors.Blue,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 86),
		Size = UDim2.fromOffset(300, 34),
		Visible = false,
		Parent = root,
	})
	Kit.corner(17).Parent = weatherPill
	Kit.stroke(Theme.Colors.Stroke, 3).Parent = weatherPill
	weatherLabel = Kit.label({
		Text = "",
		Size = UDim2.new(1, -16, 1, -6),
		Position = UDim2.fromOffset(8, 3),
		MaxTextSize = 22,
		Parent = weatherPill,
	})
	boostRow = Kit.new("Frame", {
		Name = "Boosts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 124),
		Size = UDim2.fromOffset(420, 30),
		Parent = root,
	})
	Kit.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center).Parent = boostRow

	-- Menu buttons (left, 2 columns).
	local menu: Frame = Kit.new("Frame", {
		Name = "Menu",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.45, 0),
		Size = UDim2.fromOffset(156, 240),
		Parent = root,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(72, 72),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = menu,
	})
	menuButton("Store", "🛒", "Store", Theme.Colors.Gold, 1, menu, function()
		Windows.toggle("Store")
	end)
	menuButton("Backpack", "🎒", "Backpack", Theme.Colors.Blue, 2, menu, function()
		Windows.toggle("Backpack")
	end)
	menuButton("Index", "📖", "Slimepedia", Theme.Colors.Purple, 3, menu, function()
		Windows.toggle("Index")
	end)
	menuButton("Rewards", "🎁", "Daily", Theme.Colors.Pink, 4, menu, function()
		Windows.toggle("Rewards")
	end)
	menuButton("Quests", "📜", "Quests", Theme.Colors.Green, 5, menu, function()
		Windows.toggle("Quests")
	end)
	menuButton("Rebirth", "⭐", "Rebirth", Theme.Colors.GoldDark, 6, menu, function()
		Windows.toggle("Rebirth")
	end)

	-- Context actions (right).
	local actions: Frame = Kit.new("Frame", {
		Name = "Actions",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.42, 0),
		Size = UDim2.fromOffset(158, 380),
		Parent = root,
	})
	Kit.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center).Parent =
		actions
	actionButton("HarvestAll", "✋ Harvest", Theme.Colors.Green, 1, actions, function()
		Net.event("HarvestAll"):FireServer()
	end)
	actionButton("PlantAll", "🌱 Plant All", Theme.Colors.GreenDark, 2, actions, function()
		GardenView.plantAll()
	end)
	actionButton("Sell", "💰 Sell All", Theme.Colors.Gold, 3, actions, function()
		Net.event("SellAll"):FireServer()
	end)
	actionButton("InstantGrow", "⏩ Grow", Theme.Colors.Blue, 4, actions, function()
		Net.event("UseInstantGrow"):FireServer()
	end)
	actionButton("GrowthPotion", "🧪 Growth", Theme.Colors.Purple, 5, actions, function()
		Net.event("UsePotion"):FireServer("growth")
	end)
	actionButton("LuckPotion", "🔮 Luck", Theme.Colors.Purple, 6, actions, function()
		Net.event("UsePotion"):FireServer("luck")
	end)
	actionButton("AutoHarvest", "🤖 Auto", Theme.Colors.Green, 7, actions, function()
		local main = State.main()
		if main then
			Net.event("SetAutoHarvest"):FireServer(not main.autoHarvest)
		end
	end)

	-- Seed hotbar (bottom centre).
	seedHint = Kit.label({
		Text = "",
		TextColor3 = Theme.Colors.Text,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -100),
		Size = UDim2.fromOffset(460, 24),
		MaxTextSize = 20,
		Parent = root,
	})
	seedBar = Kit.new("ScrollingFrame", {
		Name = "Seeds",
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.15,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.fromOffset(460, 90),
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		Parent = root,
	})
	Kit.corner(16).Parent = seedBar
	Kit.stroke(Theme.Colors.Stroke, 3).Parent = seedBar
	Kit.padding(8).Parent = seedBar
	Kit.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center).Parent =
		seedBar

	GardenView.SelectionChanged:Connect(refreshSeedSelection)
	State.Changed:Connect(function(section)
		if section == "main" then
			refreshMain()
			rebuildSeedBar()
		elseif section == "backpack" or section == "passes" then
			refreshMain()
		elseif section == "daily" then
			refreshDaily()
		elseif section == "boosts" then
			refreshBoosts()
		end
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function()
		task.delay(1, refreshMain)
	end)

	task.spawn(function()
		while true do
			tickStatus()
			task.wait(0.25)
		end
	end)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">IndexWindow</string>
              <string name="Source"><![CDATA[--!strict
-- Slimepedia (collection book) plus a full, plain-language odds sheet so
-- every random outcome in the game is disclosed.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local Mutations = require(Shared:WaitForChild("Mutations"))
local Species = require(Shared:WaitForChild("Species"))
local Weathers = require(Shared:WaitForChild("Weathers"))

local UI = script.Parent.Parent:WaitForChild("UI")
local Kit = require(UI:WaitForChild("Kit"))
local Theme = require(UI:WaitForChild("Theme"))
local Windows = require(UI:WaitForChild("Windows"))

local State = require(script.Parent.Parent:WaitForChild("State"))

local IndexWindow = {}

local cards: { [string]: { frame: Frame, cover: TextLabel, progress: TextLabel } } = {}
local summary: TextLabel
local collectionPage: ScrollingFrame
local oddsPage: ScrollingFrame
local oddsText: TextLabel
local tabButtons: { [string]: TextButton } = {}

local function currentLuck(): number
	local boosts = State.get("boosts")
	return if boosts then boosts.multipliers.luck else 1
end

local function buildOddsText(): string
	local luck = currentLuck()
	local lines = {
		"<b>SIZE (rolled when planted)</b>",
		"Normal x0.8–1.25: 75.5%   ·   Big x1.25–2: 20%",
		"Huge x2–4: 4%   ·   Titanic x4–6: 0.5%",
		"",
		`<b>VARIANTS (rolled once when a slime ripens) — your luck: x{luck}</b>`,
	}
	for _, mutation in Mutations.list do
		if mutation.kind == "variant" then
			table.insert(
				lines,
				`{mutation.name} ({Format.multiplier(mutation.multiplier)} value): {Format.percent(
					mutation.chance
				)} base, {Format.percent(math.min(mutation.chance * luck, 0.5))} for you`
			)
		end
	end
	table.insert(lines, "")
	table.insert(lines, "<b>WEATHER MUTATIONS (ripe slimes, per minute of weather)</b>")
	for _, mutation in Mutations.list do
		if mutation.kind == "weather" then
			local weather = Weathers.get(mutation.weather)
			table.insert(
				lines,
				`{mutation.name} ({Format.multiplier(mutation.multiplier)}) during {if weather
					then weather.name
					else "?"}: {Format.percent(mutation.chance)}/min base, {Format.percent(
					math.min(mutation.chance * luck, 0.95)
				)}/min for you`
			)
		end
	end
	table.insert(lines, "")
	table.insert(lines, "<b>WEATHER EVENTS</b> (every 9–13 min, 2.5 min long)")
	for _, weather in Weathers.list do
		table.insert(
			lines,
			`{weather.icon} {weather.name}: {Format.percent(weather.weight / Weathers.totalWeight)}`
		)
	end
	table.insert(lines, "")
	table.insert(lines, "<b>SEED SHOP RESTOCK</b> (every 5 min, chance a seed is in stock)")
	for _, species in Species.shopOrder do
		table.insert(
			lines,
			`{species.name}: {Format.percent(species.stockChance)} ({species.stockMin}–{species.stockMax} seeds)`
		)
	end
	table.insert(lines, "")
	table.insert(lines, "Robux purchases never contain random items. Luck boosts are listed in the Store.")
	return table.concat(lines, "\n")
end

local function refresh()
	local main = State.main()
	if not main then
		return
	end
	local index = main.index or {}
	local found, total = 0, 0
	for id, card in cards do
		local discovered = index[id] == true
		local variants = 0
		for _, mutation in Mutations.list do
			if index[`{id}:{mutation.id}`] then
				variants += 1
			end
		end
		total += 1 + #Mutations.list
		found += (if discovered then 1 else 0) + variants
		card.cover.Visible = not discovered
		card.progress.Text = if discovered
			then `✨ {variants}/{#Mutations.list} variants`
			else "Not discovered"
	end
	summary.Text =
		`Collection {found}/{total} ({math.floor(found / math.max(total, 1) * 100)}%) · first discoveries pay bonus coins!`
	oddsText.Text = buildOddsText()
end

local function selectTab(name: string)
	collectionPage.Visible = name == "Collection"
	oddsPage.Visible = name == "Odds"
	for tabName, button in tabButtons do
		button.BackgroundColor3 = if tabName == name then Theme.Colors.Purple else Theme.Colors.PanelLight
	end
end

local function build(content: Frame)
	local tabRow: Frame =
		Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 42), Parent = content })
	Kit.list(Enum.FillDirection.Horizontal, 8).Parent = tabRow
	for i, name in { "Collection", "Odds" } do
		tabButtons[name] = Kit.button({
			text = if name == "Odds" then "🎲 Odds" else "📖 Collection",
			color = Theme.Colors.PanelLight,
			size = UDim2.fromOffset(170, 40),
			layoutOrder = i,
			parent = tabRow,
			onClick = function()
				selectTab(name)
			end,
		})
	end
	summary = Kit.label({
		Text = "",
		Font = Theme.BodyFont,
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.fromOffset(0, 48),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 18,
		Parent = content,
	})

	collectionPage = Kit.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, -78),
		Position = UDim2.fromOffset(0, 78),
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = content,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(172, 200),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = collectionPage,
	})
	for _, species in Species.list do
		local frame: Frame = Kit.new("Frame", {
			Name = species.id,
			BackgroundColor3 = Theme.Colors.PanelLight,
			LayoutOrder = if species.tier == 0 then 99 else species.tier,
			Parent = collectionPage,
		})
		Kit.corner(14).Parent = frame
		Kit.stroke(Species.RarityColors[species.rarity], 3).Parent = frame
		Kit.slimeViewport(species.id, {}, {
			Size = UDim2.new(1, -20, 0, 100),
			Position = UDim2.fromOffset(10, 4),
			Parent = frame,
		})
		Kit.label({
			Text = species.name,
			TextColor3 = Species.RarityColors[species.rarity],
			Size = UDim2.new(1, -12, 0, 26),
			Position = UDim2.fromOffset(6, 106),
			MaxTextSize = 22,
			Parent = frame,
		})
		Kit.label({
			Text = if species.tier == 0
				then "Robux / Day 7 exclusive"
				else `{species.rarity} · {Format.short(species.value)} 🪙 · {Format.duration(
					species.growTime
				)}`,
			Font = Theme.BodyFont,
			TextColor3 = Theme.Colors.TextDim,
			Size = UDim2.new(1, -12, 0, 20),
			Position = UDim2.fromOffset(6, 134),
			NoStroke = true,
			MaxTextSize = 15,
			Parent = frame,
		})
		local progress = Kit.label({
			Text = "",
			Size = UDim2.new(1, -12, 0, 22),
			Position = UDim2.fromOffset(6, 160),
			MaxTextSize = 17,
			Parent = frame,
		})
		local cover = Kit.label({
			Text = "❓",
			BackgroundTransparency = 0.15,
			BackgroundColor3 = Theme.Colors.PanelDark,
			Size = UDim2.new(1, -20, 0, 100),
			Position = UDim2.fromOffset(10, 4),
			MaxTextSize = 60,
			NoStroke = true,
			Parent = frame,
		})
		Kit.corner(12).Parent = cover
		cards[species.id] = { frame = frame, cover = cover, progress = progress }
	end

	oddsPage = Kit.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, -78),
		Position = UDim2.fromOffset(0, 78),
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Visible = false,
		Parent = content,
	})
	oddsText = Kit.label({
		Text = "",
		Font = Theme.BodyFont,
		RichText = true,
		TextScaled = false,
		TextSize = 18,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, -16, 0, 0),
		NoStroke = true,
		Parent = oddsPage,
	})
	selectTab("Collection")
	refresh()
end

function IndexWindow.start()
	Windows.register("Index", {
		title = "📖 Slimepedia",
		color = Theme.Colors.Purple,
		size = Vector2.new(820, 540),
		build = build,
		onOpen = refresh,
	})
	State.Changed:Connect(function(section)
		if Windows.isOpen("Index") and (section == "main" or section == "boosts") then
			refresh()
		end
	end)
end

-- Used by the store/odds links.
function IndexWindow.openOdds()
	Windows.open("Index")
	selectTab("Odds")
end

return IndexWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--!strict
-- Toasts, server-wide announcements (also mirrored into chat), floating
-- reward text and the reaction to server "Effect" events.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local Mutations = require(Shared:WaitForChild("Mutations"))
local Net = require(Shared:WaitForChild("Net"))
local SlimeBuilder = require(Shared:WaitForChild("SlimeBuilder"))
local Species = require(Shared:WaitForChild("Species"))
local Economy = require(Shared:WaitForChild("Economy"))

local UI = script.Parent.Parent:WaitForChild("UI")
local Kit = require(UI:WaitForChild("Kit"))
local Theme = require(UI:WaitForChild("Theme"))

local Sounds = require(script.Parent.Sounds)

local Notifications = {}

local root: Frame
local toastList: Frame
local announceFrame: Frame

local KIND_COLORS: { [string]: Color3 } = {
	info = Theme.Colors.PanelLight,
	success = Theme.Colors.GreenDark,
	error = Color3.fromRGB(170, 50, 60),
	reward = Theme.Colors.GoldDark,
}

function Notifications.toast(text: string, kind: string?)
	local color = KIND_COLORS[kind or "info"] or KIND_COLORS.info
	local toast: Frame = Kit.new("Frame", {
		BackgroundColor3 = color,
		Size = UDim2.fromOffset(460, 44),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 0.05,
		Parent = toastList,
	})
	Kit.corner(12).Parent = toast
	Kit.stroke(Theme.Colors.Stroke, 3).Parent = toast
	Kit.padding(8).Parent = toast
	Kit.label({
		Text = text,
		Font = Theme.Font,
		TextScaled = false,
		TextSize = 20,
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 22),
		Parent = toast,
	})
	Kit.pop(toast, 0.8)
	if kind == "error" then
		Sounds.play("Error", 0.7)
	end
	-- Keep at most 4 toasts on screen.
	local toasts = {}
	for _, child in toastList:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 4 then
		toasts[1]:Destroy()
	end
	task.delay(3.5, function()
		if toast.Parent then
			TweenService:Create(toast, Theme.Tween.Smooth, { BackgroundTransparency = 1 }):Play()
			task.wait(0.3)
			toast:Destroy()
		end
	end)
end

local function systemChat(text: string, color: Color3?)
	local channels = TextChatService:FindFirstChild("TextChannels")
	local system = channels and channels:FindFirstChild("RBXSystem")
	if system and system:IsA("TextChannel") then
		local hex = (color or Theme.Colors.Gold):ToHex()
		pcall(function()
			system:DisplaySystemMessage(`<font color="#{hex}">{text}</font>`)
		end)
	end
end

function Notifications.announce(text: string, color: Color3?)
	local banner = announceFrame:FindFirstChild("Banner") :: TextLabel
	banner.Text = text
	banner.TextColor3 = color or Theme.Colors.Gold
	announceFrame.Visible = true
	Kit.pop(announceFrame, 0.7)
	local previous = announceFrame:GetAttribute("Token")
	local token = (if typeof(previous) == "number" then previous else 0) + 1
	announceFrame:SetAttribute("Token", token)
	task.delay(5, function()
		if announceFrame:GetAttribute("Token") == token then
			announceFrame.Visible = false
		end
	end)
	systemChat(text, color)
end

-- Text that floats up from the screen centre (or a given position) and fades.
function Notifications.float(text: string, color: Color3?, position: UDim2?)
	local label = Kit.label({
		Text = text,
		TextColor3 = color or Theme.Colors.Coin,
		Size = UDim2.fromOffset(420, 48),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position or UDim2.fromScale(0.5, 0.42),
		MaxTextSize = 40,
		ZIndex = 30,
		Parent = root,
	})
	Kit.pop(label, 0.6)
	local target = label.Position - UDim2.fromOffset(0, 70)
	TweenService:Create(label, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = target,
		TextTransparency = 1,
	}):Play()
	local stroke = label:FindFirstChildOfClass("UIStroke")
	if stroke then
		TweenService:Create(stroke, TweenInfo.new(1.4), { Transparency = 1 }):Play()
	end
	task.delay(1.5, function()
		label:Destroy()
	end)
end

-- Coin icons flying to the coin counter.
local coinTarget: GuiObject? = nil
function Notifications.setCoinTarget(target: GuiObject)
	coinTarget = target
end

local function coinBurst(count: number)
	if not coinTarget then
		return
	end
	local target = coinTarget :: GuiObject
	local rootPos = root.AbsolutePosition
	local scaleObj = root:FindFirstAncestorOfClass("ScreenGui")
	local uiScale = if scaleObj then scaleObj:FindFirstChildOfClass("UIScale") else nil
	local s = if uiScale then uiScale.Scale else 1
	local targetPos = (target.AbsolutePosition + target.AbsoluteSize / 2 - rootPos) / s
	for i = 1, math.clamp(count, 3, 10) do
		local coin = Kit.label({
			Text = "🪙",
			Size = UDim2.fromOffset(34, 34),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.random(-120, 120), 0.55, math.random(-60, 60)),
			NoStroke = true,
			ZIndex = 31,
			Parent = root,
		})
		task.delay(i * 0.04, function()
			local tween = TweenService:Create(
				coin,
				TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{
					Position = UDim2.fromOffset(targetPos.X, targetPos.Y),
				}
			)
			tween:Play()
			tween.Completed:Wait()
			coin:Destroy()
			Kit.pop(target, 1.08)
		end)
	end
end

local function describeSlime(speciesId: string, mutations: { string }, weight: number): string
	local species = Species.byId[speciesId]
	local parts = {}
	local mutationText = SlimeBuilder.mutationNames(mutations)
	if mutationText ~= "" then
		table.insert(parts, mutationText)
	end
	local weightLabel = Economy.weightLabel(weight)
	if weightLabel then
		table.insert(parts, weightLabel)
	end
	table.insert(parts, if species then species.name else speciesId)
	return table.concat(parts, " ")
end

local function onEffect(kind: string, data: any)
	if typeof(data) ~= "table" then
		return
	end
	if kind == "harvest" then
		local multiplier = Economy.mutationMultiplier(data.mutations or {})
		local rare = multiplier >= 6 or (Economy.effectiveTier(data.species) >= 7)
		Sounds.play(if rare then "Rare" else "Harvest")
		local text = if data.count == 1
			then `+1 {describeSlime(data.species, data.mutations or {}, data.weight or 1)}`
			else `+{data.count} slimes!`
		Notifications.float(text, if rare then Theme.Colors.Pink else Theme.Colors.Green)
	elseif kind == "sell" then
		Sounds.play("Sell")
		Notifications.float(`+{Format.short(data.amount or 0)} 🪙`, Theme.Colors.Coin)
		coinBurst(data.count or 3)
	elseif kind == "coins" then
		Sounds.play("Sell")
		coinBurst(8)
	elseif kind == "plant" then
		Sounds.play("Plant", 1.2)
	elseif kind == "buy" then
		Sounds.play("Click", 1.3)
	elseif kind == "ripe" then
		Sounds.play("Harvest", 1.4)
	elseif kind == "mutation" then
		local mutation = Mutations.byId[data.mutation]
		if mutation then
			Sounds.play("Rare", 1.2)
			Notifications.toast(
				`✨ {data.count} slime(s) became {mutation.name} (x{mutation.multiplier})!`,
				"reward"
			)
		end
	elseif kind == "unlock" then
		Sounds.play("Rare", 1.4)
	elseif kind == "rebirth" then
		Sounds.play("Rare", 0.9)
		Notifications.float(`⭐ REBIRTH {data.rebirths}! ⭐`, Theme.Colors.Gold, UDim2.fromScale(0.5, 0.35))
	elseif kind == "reward" then
		Sounds.play("Rare", 1.1)
		Notifications.float(`{data.icon or "🎁"} Reward!`, Theme.Colors.Gold)
	end
end

function Notifications.start()
	local _, canvas = Kit.screen("SlimeNotifications", 20)
	root = canvas
	toastList = Kit.new("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 222),
		Size = UDim2.fromOffset(460, 200),
		Parent = canvas,
	})
	Kit.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center).Parent = toastList

	announceFrame = Kit.new("Frame", {
		Name = "Announcement",
		BackgroundColor3 = Theme.Colors.PanelDark,
		BackgroundTransparency = 0.15,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 96),
		Size = UDim2.fromOffset(640, 48),
		Visible = false,
		Parent = canvas,
	})
	Kit.corner(14).Parent = announceFrame
	Kit.stroke(Theme.Colors.Gold, 3).Parent = announceFrame
	Kit.label({
		Name = "Banner",
		Text = "",
		Size = UDim2.new(1, -20, 1, -8),
		Position = UDim2.fromOffset(10, 4),
		MaxTextSize = 26,
		Parent = announceFrame,
	})

	Net.event("Notify").OnClientEvent:Connect(function(text: any, kind: any)
		if typeof(text) == "string" then
			Notifications.toast(text, if typeof(kind) == "string" then kind else nil)
		end
	end)
	Net.event("Announce").OnClientEvent:Connect(function(text: any, color: any)
		if typeof(text) == "string" then
			Notifications.announce(text, if typeof(color) == "Color3" then color else nil)
		end
	end)
	Net.event("Effect").OnClientEvent:Connect(onEffect)

	-- Welcome line in chat.
	task.delay(4, function()
		systemChat(`Welcome to Slime Garden, {Players.LocalPlayer.DisplayName}! 🌱`, Theme.Colors.Green)
	end)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">RebirthWindow</string>
              <string name="Source"><![CDATA[--!strict
-- Rebirth: clear explanation of what is gained, reset and kept.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))
local Net = require(Shared:WaitForChild("Net"))

local UI = script.Parent.Parent:WaitForChild("UI")
local Kit = require(UI:WaitForChild("Kit"))
local Theme = require(UI:WaitForChild("Theme"))
local Windows = require(UI:WaitForChild("Windows"))

local State = require(script.Parent.Parent:WaitForChild("State"))

local RebirthWindow = {}

local info: TextLabel
local fill: Frame
local progressLabel: TextLabel
local button: TextButton

local function refresh()
	local main = State.main()
	if not main or not info then
		return
	end
	local cost = Economy.rebirthCost(main.rebirths)
	local nextBonus = Config.Bonuses.RebirthBonus * (main.rebirths + 1)
	info.Text = table.concat({
		`<b>Rebirth {main.rebirths} → {main.rebirths + 1}</b>`,
		"",
		`<font color="#7CE070">GAIN</font>  Permanent coin bonus x{1 + nextBonus} (now x{1 + Config.Bonuses.RebirthBonus * main.rebirths})`,
		`<font color="#7CE070">GAIN</font>  Start with {Economy.startingTiles(main.rebirths + 1)} garden tiles`,
		if main.rebirths == 0
			then `<font color="#7CE070">GAIN</font>  Cosmic Slime seeds appear in the shop`
			else "",
		"",
		`<font color="#FF8080">RESET</font>  Coins, seeds, garden tiles and growing slimes`,
		`<font color="#FFD25A">KEPT</font>  ★ Favorited slimes, Slimepedia, passes, potions, daily streak`,
	}, "\n")
	local pct = math.clamp(main.coins / cost, 0, 1)
	fill.Size = UDim2.fromScale(pct, 1)
	progressLabel.Text = `🪙 {Format.short(main.coins)} / {Format.short(cost)}`
	Kit.setEnabled(button, main.coins >= cost, Theme.Colors.Gold)
end

local function build(content: Frame)
	info = Kit.label({
		Text = "",
		Font = Theme.BodyFont,
		RichText = true,
		TextScaled = false,
		TextSize = 20,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Size = UDim2.new(1, 0, 1, -130),
		NoStroke = true,
		Parent = content,
	})
	local bar: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.Colors.PanelDark,
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.new(0, 0, 1, -122),
		Parent = content,
	})
	Kit.corner(15).Parent = bar
	fill =
		Kit.new("Frame", { BackgroundColor3 = Theme.Colors.Gold, Size = UDim2.fromScale(0, 1), Parent = bar })
	Kit.corner(15).Parent = fill
	progressLabel = Kit.label({ Text = "", Size = UDim2.fromScale(1, 1), MaxTextSize = 20, Parent = bar })
	button = Kit.button({
		text = "⭐ REBIRTH",
		color = Theme.Colors.Gold,
		size = UDim2.fromOffset(300, 60),
		position = UDim2.new(0.5, 0, 1, -8),
		anchor = Vector2.new(0.5, 1),
		textSize = 30,
		parent = content,
		onClick = function()
			Windows.confirm(
				"Rebirth?",
				"Your coins, seeds, tiles and growing slimes reset. Favorites are kept.",
				"Rebirth!",
				function()
					Net.event("Rebirth"):FireServer()
				end
			)
		end,
	})
	refresh()
end

function RebirthWindow.start()
	Windows.register("Rebirth", {
		title = "⭐ Rebirth",
		color = Theme.Colors.GoldDark,
		size = Vector2.new(640, 440),
		build = build,
		onOpen = refresh,
	})
	State.Changed:Connect(function(section)
		if section == "main" and Windows.isOpen("Rebirth") then
			refresh()
		end
	end)
end

return RebirthWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">RewardsWindow</string>
              <string name="Source"><![CDATA[--!strict
-- Daily login rewards (7-day streak) and daily quests.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local Net = require(Shared:WaitForChild("Net"))

local UI = script.Parent.Parent:WaitForChild("UI")
local Kit = require(UI:WaitForChild("Kit"))
local Theme = require(UI:WaitForChild("Theme"))
local Windows = require(UI:WaitForChild("Windows"))

local State = require(script.Parent.Parent:WaitForChild("State"))

local RewardsWindow = {}

local dayCards: { Frame } = {}
local claimButton: TextButton
local streakLabel: TextLabel
local questRows: { { frame: Frame, text: TextLabel, fill: Frame, progress: TextLabel, claim: TextButton } } =
	{}
local resetLabel: TextLabel

local function refreshDaily()
	local daily = State.get("daily")
	if not daily or not claimButton then
		return
	end
	streakLabel.Text =
		`🔥 Streak: {daily.streak} day(s) · come back every day — missing a day restarts at Day 1`
	for day, card in dayCards do
		local preview = daily.preview[day]
		local icon = card:FindFirstChild("Icon") :: TextLabel
		local label = card:FindFirstChild("Reward") :: TextLabel
		if preview then
			icon.Text = preview.icon
			label.Text = preview.label
		end
		local isNext = day == daily.cycleDay
		local stroke = card:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = if isNext and daily.canClaim then Theme.Colors.Gold else Theme.Colors.Stroke
			stroke.Thickness = if isNext and daily.canClaim then 5 else 3
		end
		card.BackgroundColor3 = if isNext and daily.canClaim
			then Theme.Colors.GoldDark
			else Theme.Colors.PanelLight
	end
	if daily.canClaim then
		claimButton.Text = `🎁 Claim Day {daily.cycleDay}!`
		Kit.setEnabled(claimButton, true, Theme.Colors.Green)
	else
		claimButton.Text = `Next reward in {Format.duration(daily.secondsToReset)}`
		Kit.setEnabled(claimButton, false, Theme.Colors.Green)
	end
end

local function refreshQuests()
	local daily = State.get("daily")
	if not daily or #questRows == 0 then
		return
	end
	for i, row in questRows do
		local quest = daily.quests[i]
		row.frame.Visible = quest ~= nil
		if quest then
			row.text.Text = quest.text
			local pct = math.clamp(quest.progress / math.max(quest.target, 1), 0, 1)
			row.fill.Size = UDim2.fromScale(pct, 1)
			local reward = `🪙 {Format.short(quest.rewardCoins)}`
			if quest.rewardItem then
				reward ..= if quest.rewardItem == "luck" then " + 🔮" else " + 🧪"
			end
			row.progress.Text = `{Format.short(quest.progress)}/{Format.short(quest.target)} · {reward}`
			if quest.claimed then
				row.claim.Text = "Done ✓"
				Kit.setEnabled(row.claim, false, Theme.Colors.Green)
			elseif quest.progress >= quest.target then
				row.claim.Text = "Claim!"
				Kit.setEnabled(row.claim, true, Theme.Colors.Green)
			else
				row.claim.Text = "In progress"
				Kit.setEnabled(row.claim, false, Theme.Colors.Green)
			end
		end
	end
	resetLabel.Text = `New quests in {Format.duration(daily.secondsToReset)}`
end

local function buildDaily(content: Frame)
	streakLabel = Kit.label({
		Text = "",
		Font = Theme.BodyFont,
		Size = UDim2.new(1, 0, 0, 24),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 18,
		Parent = content,
	})
	local row: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 220),
		Position = UDim2.fromOffset(0, 34),
		Parent = content,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.new(1 / 7, -8, 1, 0),
		CellPadding = UDim2.fromOffset(8, 0),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = row,
	})
	for day = 1, 7 do
		local card: Frame = Kit.new("Frame", {
			Name = `Day{day}`,
			BackgroundColor3 = Theme.Colors.PanelLight,
			LayoutOrder = day,
			Parent = row,
		})
		Kit.corner(14).Parent = card
		Kit.stroke(Theme.Colors.Stroke, 3).Parent = card
		Kit.label({
			Text = `Day {day}`,
			Size = UDim2.new(1, -8, 0, 26),
			Position = UDim2.fromOffset(4, 6),
			MaxTextSize = 20,
			Parent = card,
		})
		Kit.label({
			Name = "Icon",
			Text = "🎁",
			Size = UDim2.new(1, 0, 0, 60),
			Position = UDim2.fromOffset(0, 36),
			NoStroke = true,
			MaxTextSize = 46,
			Parent = card,
		})
		Kit.label({
			Name = "Reward",
			Text = "",
			Font = Theme.BodyFont,
			TextWrapped = true,
			Size = UDim2.new(1, -8, 0, 100),
			Position = UDim2.fromOffset(4, 104),
			MaxTextSize = 16,
			NoStroke = true,
			Parent = card,
		})
		dayCards[day] = card
	end
	claimButton = Kit.button({
		text = "Claim",
		size = UDim2.fromOffset(320, 56),
		position = UDim2.new(0.5, 0, 1, -6),
		anchor = Vector2.new(0.5, 1),
		parent = content,
		onClick = function()
			Net.event("ClaimDaily"):FireServer()
		end,
	})
	refreshDaily()
end

local function buildQuests(content: Frame)
	resetLabel = Kit.label({
		Text = "",
		Font = Theme.BodyFont,
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, 0, 0, 22),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 18,
		Parent = content,
	})
	for i = 1, 3 do
		local frame: Frame = Kit.new("Frame", {
			BackgroundColor3 = Theme.Colors.PanelLight,
			Size = UDim2.new(1, 0, 0, 96),
			Position = UDim2.fromOffset(0, 30 + (i - 1) * 106),
			Parent = content,
		})
		Kit.corner(14).Parent = frame
		Kit.stroke(Theme.Colors.Stroke, 3).Parent = frame
		local text = Kit.label({
			Text = "",
			Size = UDim2.new(1, -190, 0, 32),
			Position = UDim2.fromOffset(14, 8),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 24,
			Parent = frame,
		})
		local bar: Frame = Kit.new("Frame", {
			BackgroundColor3 = Theme.Colors.PanelDark,
			Size = UDim2.new(1, -190, 0, 18),
			Position = UDim2.fromOffset(14, 46),
			Parent = frame,
		})
		Kit.corner(9).Parent = bar
		local fill: Frame = Kit.new(
			"Frame",
			{ BackgroundColor3 = Theme.Colors.Green, Size = UDim2.fromScale(0, 1), Parent = bar }
		)
		Kit.corner(9).Parent = fill
		local progress = Kit.label({
			Text = "",
			Font = Theme.BodyFont,
			TextColor3 = Theme.Colors.TextDim,
			Size = UDim2.new(1, -190, 0, 20),
			Position = UDim2.fromOffset(14, 68),
			TextXAlignment = Enum.TextXAlignment.Left,
			NoStroke = true,
			MaxTextSize = 17,
			Parent = frame,
		})
		local claim = Kit.button({
			text = "Claim",
			size = UDim2.fromOffset(150, 52),
			position = UDim2.new(1, -14, 0.5, 0),
			anchor = Vector2.new(1, 0.5),
			parent = frame,
			onClick = function()
				Net.event("ClaimQuest"):FireServer(i)
			end,
		})
		questRows[i] = { frame = frame, text = text, fill = fill, progress = progress, claim = claim }
	end
	refreshQuests()
end

function RewardsWindow.start()
	Windows.register("Rewards", {
		title = "🎁 Daily Rewards",
		color = Theme.Colors.Pink,
		size = Vector2.new(820, 400),
		build = buildDaily,
		onOpen = refreshDaily,
	})
	Windows.register("Quests", {
		title = "📜 Daily Quests",
		color = Theme.Colors.Green,
		size = Vector2.new(700, 420),
		build = buildQuests,
		onOpen = refreshQuests,
	})
	State.Changed:Connect(function(section)
		if section == "daily" then
			if Windows.isOpen("Rewards") then
				refreshDaily()
			elseif Windows.isOpen("Quests") then
				refreshQuests()
			end
		end
	end)
	-- Pop the daily reward open once when there is something to claim.
	local shown = false
	State.Changed:Connect(function(section)
		local daily = State.get("daily")
		local main = State.main()
		if
			section == "daily"
			and not shown
			and daily
			and daily.canClaim
			and main
			and main.tutorialStep >= 5
		then
			shown = true
			task.delay(2, function()
				if not Windows.current() then
					Windows.open("Rewards")
				end
			end)
		end
	end)
end

return RewardsWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">ShopWindow</string>
              <string name="Source"><![CDATA[--!strict
-- Seed Shop window: opened from the shop counter prompt. Shows this
-- restock's stock (per player), prices, growth times, values and the
-- published chance of each seed appearing in a restock.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Net = require(Shared:WaitForChild("Net"))
local Species = require(Shared:WaitForChild("Species"))

local UI = script.Parent.Parent:WaitForChild("UI")
local Kit = require(UI:WaitForChild("Kit"))
local Theme = require(UI:WaitForChild("Theme"))
local Windows = require(UI:WaitForChild("Windows"))

local State = require(script.Parent.Parent:WaitForChild("State"))

local ShopWindow = {}

type Row = {
	frame: Frame,
	stock: TextLabel,
	buyOne: TextButton,
	buyAll: TextButton,
}

local rows: { [string]: Row } = {}
local header: TextLabel? = nil

local function shopCounter(): BasePart?
	local world = Workspace:FindFirstChild("SlimeGarden")
	local hub = world and world:FindFirstChild("Hub")
	local shop = hub and hub:FindFirstChild("SeedShop")
	local counter = shop and shop:FindFirstChild("Counter")
	return if counter and counter:IsA("BasePart") then counter else nil
end

local function remainingFor(id: string): number
	local stock = State.stock
	local shop = State.get("shop")
	local listed = if stock then stock.stock[id] or 0 else 0
	local bought = 0
	if shop and stock and shop.restockId == stock.restockId then
		bought = shop.bought[id] or 0
	end
	return math.max(0, listed - bought)
end

local function refresh()
	local main = State.main()
	if not main then
		return
	end
	local stock = State.stock
	for id, row in rows do
		local species = Species.byId[id]
		local listed = if stock then stock.stock[id] else nil
		local remaining = remainingFor(id)
		local locked = main.rebirths < species.requiresRebirth
		if locked then
			row.stock.Text = `🔒 Unlocks at Rebirth {species.requiresRebirth}`
			row.stock.TextColor3 = Theme.Colors.TextDim
		elseif listed == nil then
			row.stock.Text = `Not in stock · appears in {Format.percent(species.stockChance)} of restocks`
			row.stock.TextColor3 = Theme.Colors.TextDim
		elseif remaining == 0 then
			row.stock.Text = "Sold out until next restock"
			row.stock.TextColor3 = Theme.Colors.Red
		else
			row.stock.Text = `x{remaining} in stock`
			row.stock.TextColor3 = Theme.Colors.Green
		end
		local affordable = main.coins >= species.price
		local canBuy = not locked and remaining > 0
		Kit.setEnabled(row.buyOne, canBuy and affordable, Theme.Colors.Green)
		Kit.setEnabled(row.buyAll, canBuy and affordable and remaining > 1, Theme.Colors.GreenDark)
		row.frame.BackgroundTransparency = if canBuy then 0 else 0.35
	end
end

local function buy(id: string, all: boolean)
	local main = State.main()
	if not main then
		return
	end
	local species = Species.byId[id]
	local quantity = 1
	if all then
		quantity = math.clamp(math.min(remainingFor(id), math.floor(main.coins / species.price)), 1, 50)
	end
	Net.event("BuySeed"):FireServer(id, quantity)
end

local function build(content: Frame)
	header = Kit.label({
		Text = "",
		Size = UDim2.new(1, 0, 0, 28),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 22,
		Parent = content,
	})
	local list: ScrollingFrame = Kit.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, -34),
		Position = UDim2.fromOffset(0, 34),
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = content,
	})
	Kit.list(Enum.FillDirection.Vertical, 8).Parent = list
	Kit.new("UIPadding", { PaddingRight = UDim.new(0, 12), Parent = list })

	for order, species in Species.shopOrder do
		local frame: Frame = Kit.new("Frame", {
			Name = species.id,
			BackgroundColor3 = Theme.Colors.PanelLight,
			Size = UDim2.new(1, 0, 0, 92),
			LayoutOrder = order,
			Parent = list,
		})
		Kit.corner(14).Parent = frame
		Kit.stroke(Species.RarityColors[species.rarity], 2).Parent = frame
		Kit.slimeViewport(species.id, {}, {
			Size = UDim2.fromOffset(84, 84),
			Position = UDim2.fromOffset(4, 4),
			Parent = frame,
		})
		Kit.label({
			Text = species.name,
			TextColor3 = Species.RarityColors[species.rarity],
			Size = UDim2.new(0.5, -90, 0, 30),
			Position = UDim2.fromOffset(94, 6),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 26,
			Parent = frame,
		})
		Kit.label({
			Text = `{species.rarity} · grows in {Format.duration(species.growTime)} · sells ~{Format.short(
				species.value
			)}`,
			Font = Theme.BodyFont,
			TextColor3 = Theme.Colors.TextDim,
			Size = UDim2.new(0.62, -90, 0, 22),
			Position = UDim2.fromOffset(94, 36),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 18,
			NoStroke = true,
			Parent = frame,
		})
		local stockLabel = Kit.label({
			Text = "",
			Size = UDim2.new(0.62, -90, 0, 22),
			Position = UDim2.fromOffset(94, 62),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 18,
			Parent = frame,
		})
		Kit.label({
			Text = `🪙 {Format.short(species.price)}`,
			TextColor3 = Theme.Colors.Coin,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 6),
			Size = UDim2.fromOffset(200, 30),
			TextXAlignment = Enum.TextXAlignment.Right,
			MaxTextSize = 26,
			Parent = frame,
		})
		local buyOne = Kit.button({
			text = "Buy 1",
			size = UDim2.fromOffset(96, 42),
			position = UDim2.new(1, -116, 1, -8),
			anchor = Vector2.new(1, 1),
			onClick = function()
				buy(species.id, false)
			end,
		})
		buyOne.Parent = frame
		local buyAll = Kit.button({
			text = "Buy Max",
			color = Theme.Colors.GreenDark,
			size = UDim2.fromOffset(100, 42),
			position = UDim2.new(1, -10, 1, -8),
			anchor = Vector2.new(1, 1),
			onClick = function()
				buy(species.id, true)
			end,
		})
		buyAll.Parent = frame
		rows[species.id] = { frame = frame, stock = stockLabel, buyOne = buyOne, buyAll = buyAll }
	end
	refresh()
end

function ShopWindow.start()
	Windows.register("Shop", {
		title = "🌱 Seed Shop",
		color = Theme.Colors.Green,
		size = Vector2.new(780, 520),
		build = build,
		onOpen = refresh,
	})

	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if who == Players.LocalPlayer and prompt.Name == "ShopPrompt" then
			Windows.open("Shop")
		end
	end)

	State.Changed:Connect(function(section)
		if Windows.isOpen("Shop") and (section == "main" or section == "shop" or section == "stock") then
			refresh()
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.5)
			if Windows.isOpen("Shop") then
				local stock = State.stock
				local main = State.main()
				if header and stock and main then
					header.Text = `🪙 {Format.short(main.coins)}   ·   Restock in {Format.clock(
						stock.nextRestockAt - Workspace:GetServerTimeNow()
					)}`
				end
				-- Close when the player walks away from the counter.
				local counter = shopCounter()
				local character = Players.LocalPlayer.Character
				local rootPart = character and character:FindFirstChild("HumanoidRootPart")
				if counter and rootPart and rootPart:IsA("BasePart") then
					if (rootPart.Position - counter.Position).Magnitude > Config.Shop.ReachDistance + 6 then
						Windows.close()
					end
				end
			end
		end
	end)
end

return ShopWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">Sounds</string>
              <string name="Source"><![CDATA[--!strict
-- Local sound effects with slight pitch variation to avoid fatigue.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Sounds = {}

local cache: { [string]: Sound } = {}

local VOLUMES: { [string]: number } = {
	Click = 0.35,
	Plant = 0.5,
	Harvest = 0.45,
	Sell = 0.6,
	Rare = 0.6,
	Error = 0.25,
}

function Sounds.play(name: string, pitch: number?)
	local id = (Config.Sounds :: { [string]: string })[name]
	if not id or id == "" then
		return
	end
	local sound = cache[name]
	if not sound then
		local newSound = Instance.new("Sound")
		newSound.Name = "Sfx_" .. name
		newSound.SoundId = id
		newSound.Volume = VOLUMES[name] or 0.5
		newSound.Parent = SoundService
		cache[name] = newSound
		sound = newSound
	end
	sound.PlaybackSpeed = (pitch or 1) * (0.94 + math.random() * 0.12)
	SoundService:PlayLocalSound(sound)
end

return Sounds
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">StoreWindow</string>
              <string name="Source"><![CDATA[--!strict
-- Robux store. Prices shown are fetched live from Roblox for configured
-- ids, so the store never disagrees with the purchase prompt. Grants happen
-- only on the server (pass ownership / ProcessReceipt).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))
local Net = require(Shared:WaitForChild("Net"))
local Products = require(Shared:WaitForChild("Products"))

local UI = script.Parent.Parent:WaitForChild("UI")
local Kit = require(UI:WaitForChild("Kit"))
local Theme = require(UI:WaitForChild("Theme"))
local Windows = require(UI:WaitForChild("Windows"))

local State = require(script.Parent.Parent:WaitForChild("State"))
local Notifications = require(script.Parent.Notifications)

local StoreWindow = {}

local player = Players.LocalPlayer
local livePrices: { [string]: number } = {}
local cards: { [string]: { frame: Frame, buy: TextButton, extra: TextLabel? } } = {}
local pages: { [string]: ScrollingFrame } = {}
local tabs: { [string]: TextButton } = {}
local currentTab = "Passes"

local CATEGORY_LABELS: { [string]: string } = {
	Passes = "⭐ Passes",
	Boosts = "🧪 Boosts",
	Coins = "🪙 Coins",
	Events = "🌠 Events",
}

local function priceOf(product: Products.Product): number
	return livePrices[product.key] or product.price
end

local function fetchPrices()
	for _, product in Products.list do
		if product.id ~= 0 then
			task.spawn(function()
				local ok, info = pcall(function()
					return MarketplaceService:GetProductInfo(
						product.id,
						if product.kind == "pass" then Enum.InfoType.GamePass else Enum.InfoType.Product
					)
				end)
				if ok and typeof(info) == "table" and typeof(info.PriceInRobux) == "number" then
					livePrices[product.key] = info.PriceInRobux
					StoreWindow.refresh()
				end
			end)
		end
	end
end

local function purchase(product: Products.Product)
	if product.id == 0 then
		if RunService:IsStudio() then
			Net.event("DevGrant"):FireServer(product.key)
		else
			Notifications.toast("This item isn't available yet — check back soon!", "info")
		end
		return
	end
	if product.kind == "pass" then
		MarketplaceService:PromptGamePassPurchase(player, product.id)
	else
		MarketplaceService:PromptProductPurchase(player, product.id)
	end
end

function StoreWindow.refresh()
	local main = State.main()
	for key, card in cards do
		local product = Products.byKey[key]
		if product.kind == "pass" and State.owns(key) then
			card.buy.Text = "Owned ✓"
			Kit.setEnabled(card.buy, false, Theme.Colors.Robux)
		else
			card.buy.Text = `R$ {priceOf(product)}`
			Kit.setEnabled(card.buy, true, Theme.Colors.Robux)
		end
		if card.extra and main and Products.CoinPackUnits[key] then
			local amount = Economy.coinPackAmount(key, main.bestTier)
			local perRobux = amount / priceOf(product)
			local base = Products.byKey.coins_small
			local baseRate = Economy.coinPackAmount("coins_small", main.bestTier) / priceOf(base)
			local bonus = math.floor((perRobux / baseRate - 1) * 100 + 0.5)
			card.extra.Text = if bonus > 0
				then `+{Format.short(amount)} coins ({bonus}% more per R$)`
				else `+{Format.short(amount)} coins`
		end
	end
end

local function selectTab(category: string)
	currentTab = category
	for name, page in pages do
		page.Visible = name == category
	end
	for name, tab in tabs do
		tab.BackgroundColor3 = if name == category then Theme.Colors.Gold else Theme.Colors.PanelLight
	end
end

local function buildCard(product: Products.Product, parent: Instance)
	local frame: Frame = Kit.new("Frame", {
		Name = product.key,
		BackgroundColor3 = Theme.Colors.PanelLight,
		LayoutOrder = product.order,
		Parent = parent,
	})
	Kit.corner(16).Parent = frame
	Kit.stroke(if product.highlight then Theme.Colors.Gold else Theme.Colors.Stroke, 3).Parent = frame
	Kit.label({
		Text = product.icon,
		Size = UDim2.new(0, 56, 0, 56),
		Position = UDim2.fromOffset(10, 10),
		NoStroke = true,
		MaxTextSize = 48,
		Parent = frame,
	})
	Kit.label({
		Text = product.name,
		Size = UDim2.new(1, -80, 0, 30),
		Position = UDim2.fromOffset(72, 12),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 24,
		Parent = frame,
	})
	if product.highlight then
		local ribbon = Kit.label({
			Text = product.highlight,
			BackgroundTransparency = 0,
			BackgroundColor3 = Theme.Colors.Pink,
			Size = UDim2.fromOffset(110, 22),
			Position = UDim2.fromOffset(72, 42),
			MaxTextSize = 14,
			Parent = frame,
		})
		Kit.corner(8).Parent = ribbon
	end
	Kit.label({
		Text = product.description,
		Font = Theme.BodyFont,
		TextColor3 = Theme.Colors.TextDim,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Size = UDim2.new(1, -20, 0, 62),
		Position = UDim2.fromOffset(10, 72),
		NoStroke = true,
		MaxTextSize = 17,
		Parent = frame,
	})
	local extra: TextLabel? = nil
	if Products.CoinPackUnits[product.key] then
		extra = Kit.label({
			Text = "",
			TextColor3 = Theme.Colors.Coin,
			Size = UDim2.new(1, -20, 0, 24),
			Position = UDim2.new(0, 10, 1, -82),
			MaxTextSize = 20,
			Parent = frame,
		})
	end
	local buy = Kit.button({
		text = `R$ {product.price}`,
		color = Theme.Colors.Robux,
		size = UDim2.new(1, -20, 0, 46),
		position = UDim2.new(0, 10, 1, -10),
		anchor = Vector2.new(0, 1),
		onClick = function()
			purchase(product)
		end,
	})
	buy.Parent = frame
	cards[product.key] = { frame = frame, buy = buy, extra = extra }
end

local function build(content: Frame)
	local tabRow: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 44),
		Parent = content,
	})
	Kit.list(Enum.FillDirection.Horizontal, 8).Parent = tabRow
	for i, category in Products.Categories do
		tabs[category] = Kit.button({
			text = CATEGORY_LABELS[category],
			color = Theme.Colors.PanelLight,
			size = UDim2.fromOffset(150, 42),
			layoutOrder = i,
			parent = tabRow,
			onClick = function()
				selectTab(category)
			end,
		})
		local page: ScrollingFrame = Kit.new("ScrollingFrame", {
			Name = category,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, -54),
			Position = UDim2.fromOffset(0, 54),
			ScrollBarThickness = 8,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
			Visible = false,
			Parent = content,
		})
		Kit.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(236, 236),
			CellPadding = UDim2.fromOffset(10, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = page,
		})
		pages[category] = page
	end
	for _, product in Products.list do
		buildCard(product, pages[product.category])
	end

	-- Roblox Premium perk card (members also earn the game engagement payouts).
	if player.MembershipType ~= Enum.MembershipType.Premium then
		local card: Frame = Kit.new("Frame", {
			Name = "Premium",
			BackgroundColor3 = Theme.Colors.PanelLight,
			LayoutOrder = 100,
			Parent = pages.Passes,
		})
		Kit.corner(16).Parent = card
		Kit.stroke(Theme.Colors.Purple, 3).Parent = card
		Kit.label({
			Text = "⭐ Roblox Premium",
			Size = UDim2.new(1, -20, 0, 30),
			Position = UDim2.fromOffset(10, 14),
			MaxTextSize = 24,
			Parent = card,
		})
		Kit.label({
			Text = "Premium members earn +10% coins in Slime Garden.",
			Font = Theme.BodyFont,
			TextColor3 = Theme.Colors.TextDim,
			TextWrapped = true,
			Size = UDim2.new(1, -20, 0, 60),
			Position = UDim2.fromOffset(10, 60),
			NoStroke = true,
			MaxTextSize = 17,
			Parent = card,
		})
		Kit.button({
			text = "Learn more",
			color = Theme.Colors.Purple,
			size = UDim2.new(1, -20, 0, 46),
			position = UDim2.new(0, 10, 1, -10),
			anchor = Vector2.new(0, 1),
			parent = card,
			onClick = function()
				pcall(function()
					MarketplaceService:PromptPremiumPurchase(player)
				end)
			end,
		})
	end

	selectTab(currentTab)
	StoreWindow.refresh()
end

function StoreWindow.start()
	Windows.register("Store", {
		title = "🛒 Store",
		color = Theme.Colors.Gold,
		size = Vector2.new(800, 540),
		build = build,
		onOpen = StoreWindow.refresh,
	})
	fetchPrices()
	State.Changed:Connect(function(section)
		if Windows.isOpen("Store") and (section == "passes" or section == "main") then
			StoreWindow.refresh()
		end
	end)
end

return StoreWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--!strict
-- First-session guidance: a hint bubble plus a glowing beam and bouncing
-- arrow pointing at the next thing to do. Steps are driven by the server.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local UI = script.Parent.Parent:WaitForChild("UI")
local Kit = require(UI:WaitForChild("Kit"))
local Theme = require(UI:WaitForChild("Theme"))

local State = require(script.Parent.Parent:WaitForChild("State"))
local GardenView = require(script.Parent.GardenView)

local Tutorial = {}

local player = Players.LocalPlayer

local HINTS = {
	[0] = "👋 Welcome! Tap the glowing soil to plant your Goo Seed 🌱",
	[1] = "⏳ Your slime is growing! Slimes keep growing even while you're offline.",
	[2] = "✨ It's ripe! Tap your slime (or ✋ Harvest) to collect it.",
	[3] = "💰 Follow the arrow to the Sell Stand and sell your slimes!",
	[4] = "🌱 Now buy more seeds at the Seed Shop — then plant them all!",
}

local bubble: Frame
local bubbleText: TextLabel
local beam: Beam
local fromAttachment: Attachment?
local targetAttachment: Attachment
local anchorPart: Part
local arrow: BillboardGui
local tileHighlight: Highlight

local function hubPart(stall: string): BasePart?
	local world = Workspace:FindFirstChild("SlimeGarden")
	local hub = world and world:FindFirstChild("Hub")
	local model = hub and hub:FindFirstChild(stall)
	local counter = model and model:FindFirstChild("Counter")
	return if counter and counter:IsA("BasePart") then counter else nil
end

local function firstPlant(wantRipe: boolean?): Model?
	local plot = GardenView.ownPlot()
	local plants = plot and plot:FindFirstChild("Plants")
	if not plants then
		return nil
	end
	for _, model in plants:GetChildren() do
		if model:IsA("Model") and (wantRipe == nil or (model:GetAttribute("Ripe") == true) == wantRipe) then
			return model
		end
	end
	return nil
end

local function firstEmptyTile(): BasePart?
	local plot = GardenView.ownPlot()
	if not plot then
		return nil
	end
	local plants = plot:FindFirstChild("Plants")
	local best: BasePart? = nil
	local bestIndex = math.huge
	for _, child in plot:GetChildren() do
		local index = child:GetAttribute("TileIndex")
		if
			child:IsA("BasePart")
			and typeof(index) == "number"
			and child:GetAttribute("Usable")
			and index < bestIndex
			and not (plants and plants:FindFirstChild(`Plant{index}`))
		then
			best, bestIndex = child, index
		end
	end
	return best
end

local function targetFor(step: number): (BasePart?, BasePart?)
	if step == 0 then
		local tile = firstEmptyTile()
		return tile, tile
	elseif step == 1 then
		local plant = firstPlant(false)
		return if plant then plant.PrimaryPart else nil, nil
	elseif step == 2 then
		local plant = firstPlant(true)
		return if plant then plant.PrimaryPart else nil, nil
	elseif step == 3 then
		return hubPart("SellStand"), nil
	elseif step == 4 then
		return hubPart("SeedShop"), nil
	end
	return nil, nil
end

local function ensureFromAttachment(): Attachment?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	if fromAttachment and fromAttachment.Parent == root then
		return fromAttachment
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "TutorialFrom"
	attachment.Parent = root
	fromAttachment = attachment
	return attachment
end

local function update()
	local main = State.main()
	local step = if main then main.tutorialStep else 99
	local hint = HINTS[step]
	bubble.Visible = hint ~= nil
	if not hint then
		beam.Enabled = false
		arrow.Enabled = false
		tileHighlight.Enabled = false
		return
	end
	bubbleText.Text = hint
	if step == 0 and GardenView.selectedSeed == nil then
		GardenView.select("goo")
	end

	local target, highlightTarget = targetFor(step)
	local from = ensureFromAttachment()
	if target and from then
		anchorPart.CFrame = CFrame.new(target.Position + Vector3.new(0, target.Size.Y / 2 + 0.5, 0))
		beam.Attachment0 = from
		beam.Attachment1 = targetAttachment
		beam.Enabled = (from.WorldPosition - targetAttachment.WorldPosition).Magnitude > 8
		arrow.Enabled = true
	else
		beam.Enabled = false
		arrow.Enabled = false
	end
	tileHighlight.Adornee = highlightTarget
	tileHighlight.Enabled = highlightTarget ~= nil
end

function Tutorial.start()
	local _, canvas = Kit.screen("SlimeTutorial", 3)
	bubble = Kit.new("Frame", {
		Name = "Hint",
		BackgroundColor3 = Theme.Colors.Green,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 158),
		Size = UDim2.fromOffset(560, 56),
		Visible = false,
		Parent = canvas,
	})
	Kit.corner(18).Parent = bubble
	Kit.stroke(Theme.Colors.Stroke, 4).Parent = bubble
	bubbleText = Kit.label({
		Text = "",
		Size = UDim2.new(1, -24, 1, -10),
		Position = UDim2.fromOffset(12, 5),
		MaxTextSize = 24,
		Parent = bubble,
	})

	anchorPart = Instance.new("Part")
	anchorPart.Name = "TutorialTarget"
	anchorPart.Anchored = true
	anchorPart.CanCollide = false
	anchorPart.CanQuery = false
	anchorPart.CanTouch = false
	anchorPart.Transparency = 1
	anchorPart.Size = Vector3.one * 0.2
	anchorPart.Parent = Workspace
	targetAttachment = Instance.new("Attachment")
	targetAttachment.Parent = anchorPart

	beam = Instance.new("Beam")
	beam.Color = ColorSequence.new(Color3.fromRGB(140, 255, 120))
	beam.LightEmission = 1
	beam.FaceCamera = true
	beam.Width0 = 0.7
	beam.Width1 = 0.7
	beam.Transparency = NumberSequence.new(0.25)
	beam.Segments = 1
	beam.Enabled = false
	beam.Parent = anchorPart

	arrow = Kit.new("BillboardGui", {
		Name = "TutorialArrow",
		Adornee = anchorPart,
		Size = UDim2.fromOffset(70, 70),
		StudsOffsetWorldSpace = Vector3.new(0, 4, 0),
		AlwaysOnTop = true,
		Enabled = false,
		Parent = anchorPart,
	})
	Kit.label({
		Text = "⬇️",
		Size = UDim2.fromScale(1, 1),
		NoStroke = true,
		MaxTextSize = 64,
		Parent = arrow,
	})

	tileHighlight = Kit.new("Highlight", {
		FillColor = Color3.fromRGB(140, 255, 120),
		FillTransparency = 0.45,
		OutlineColor = Color3.new(1, 1, 1),
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})

	RunService.RenderStepped:Connect(function()
		if arrow.Enabled then
			local t = os.clock()
			arrow.StudsOffsetWorldSpace = Vector3.new(0, 4 + math.abs(math.sin(t * 4)) * 1.2, 0)
			tileHighlight.FillTransparency = 0.35 + math.sin(t * 5) * 0.15
		end
	end)
	task.spawn(function()
		while true do
			update()
			task.wait(0.3)
		end
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">WeatherFX</string>
              <string name="Source"><![CDATA[--!strict
-- Local weather visuals: particles around the camera plus a lighting tint.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Weathers = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Weathers"))

local State = require(script.Parent.Parent:WaitForChild("State"))

local WeatherFX = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local DEFAULT_CLOCK = 14.2

local emitterPart: Part
local emitter: ParticleEmitter
local tint: ColorCorrectionEffect
local current: string? = nil

type Preset = {
	color: ColorSequence,
	rate: number,
	speed: NumberRange,
	size: NumberSequence,
	lifetime: NumberRange,
	acceleration: Vector3,
	spread: Vector2,
	clockTime: number,
}

local PRESETS: { [string]: Preset } = {
	goorain = {
		color = ColorSequence.new(Color3.fromRGB(140, 255, 150), Color3.fromRGB(90, 220, 255)),
		rate = 260,
		speed = NumberRange.new(55, 70),
		size = NumberSequence.new(0.35),
		lifetime = NumberRange.new(1.2, 1.6),
		acceleration = Vector3.new(0, -20, 0),
		spread = Vector2.new(5, 5),
		clockTime = 13,
	},
	goldenhour = {
		color = ColorSequence.new(Color3.fromRGB(255, 220, 120)),
		rate = 50,
		speed = NumberRange.new(1, 3),
		size = NumberSequence.new(0.4, 0),
		lifetime = NumberRange.new(4, 6),
		acceleration = Vector3.new(0, -1, 0),
		spread = Vector2.new(180, 180),
		clockTime = 17.4,
	},
	snowfall = {
		color = ColorSequence.new(Color3.new(1, 1, 1)),
		rate = 180,
		speed = NumberRange.new(6, 10),
		size = NumberSequence.new(0.45),
		lifetime = NumberRange.new(5, 7),
		acceleration = Vector3.new(1.5, -2, 0),
		spread = Vector2.new(20, 20),
		clockTime = 12.5,
	},
	starfall = {
		color = ColorSequence.new(Color3.fromRGB(210, 170, 255), Color3.fromRGB(120, 210, 255)),
		rate = 40,
		speed = NumberRange.new(70, 90),
		size = NumberSequence.new(1.4, 0.2),
		lifetime = NumberRange.new(0.9, 1.2),
		acceleration = Vector3.zero,
		spread = Vector2.new(25, 25),
		clockTime = 20.5,
	},
}

local function apply(id: string?)
	if id == current then
		return
	end
	current = id
	local weather = Weathers.get(id)
	local preset = if id then PRESETS[id] else nil
	local tweenInfo = TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	if weather and preset then
		emitter.Color = preset.color
		emitter.Rate = preset.rate
		emitter.Speed = preset.speed
		emitter.Size = preset.size
		emitter.Lifetime = preset.lifetime
		emitter.Acceleration = preset.acceleration
		emitter.SpreadAngle = preset.spread
		emitter.Enabled = true
		TweenService:Create(tint, tweenInfo, { TintColor = weather.tint }):Play()
		TweenService:Create(Lighting, tweenInfo, { ClockTime = preset.clockTime }):Play()
	else
		emitter.Enabled = false
		TweenService:Create(tint, tweenInfo, { TintColor = Color3.new(1, 1, 1) }):Play()
		TweenService:Create(Lighting, tweenInfo, { ClockTime = DEFAULT_CLOCK }):Play()
	end
end

function WeatherFX.start()
	emitterPart = Instance.new("Part")
	emitterPart.Name = "WeatherEmitter"
	emitterPart.Anchored = true
	emitterPart.CanCollide = false
	emitterPart.CanQuery = false
	emitterPart.CanTouch = false
	emitterPart.Transparency = 1
	emitterPart.Size = Vector3.new(140, 1, 140)
	emitterPart.Parent = Workspace

	emitter = Instance.new("ParticleEmitter")
	emitter.Texture = SPARKLE
	emitter.EmissionDirection = Enum.NormalId.Bottom
	emitter.LightEmission = 0.7
	emitter.Enabled = false
	emitter.Parent = emitterPart

	tint = Instance.new("ColorCorrectionEffect")
	tint.Name = "WeatherTint"
	tint.Parent = Lighting

	RunService.RenderStepped:Connect(function()
		local camera = Workspace.CurrentCamera
		if camera and emitter.Enabled then
			local position = camera.CFrame.Position
			emitterPart.CFrame = CFrame.new(position.X, position.Y + 45, position.Z)
		end
	end)

	State.Changed:Connect(function(section)
		if section == "weather" then
			local weather = State.weather
			apply(if weather then weather.id else nil)
		end
	end)
end

return WeatherFX
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
-- Client mirror of the player's server state. UI reads from here and
-- listens to Changed; it never computes authoritative values.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Signal"))
local Types = require(Shared:WaitForChild("Types"))

local State = {}

-- Sections: main, backpack, boosts, passes, daily, shop (see server Sync).
State.sections = {} :: { [string]: any }
State.stock = nil :: Types.StockState?
State.weather = nil :: Types.WeatherState?

State.Changed = Signal.new() :: Signal.Signal<string>

function State.get(section: string): any
	return State.sections[section]
end

function State.main(): any
	return State.sections.main
end

function State.owns(passKey: string): boolean
	local passes = State.sections.passes
	return passes ~= nil and passes[passKey] == true
end

function State.start()
	Net.event("Sync").OnClientEvent:Connect(function(payload: any)
		if typeof(payload) ~= "table" then
			return
		end
		for section, value in payload do
			State.sections[section] = value
			State.Changed:Fire(section)
		end
	end)
	Net.event("Stock").OnClientEvent:Connect(function(stock: any)
		State.stock = stock
		State.Changed:Fire("stock")
	end)
	Net.event("Weather").OnClientEvent:Connect(function(weather: any)
		State.weather = weather
		State.Changed:Fire("weather")
	end)
	Net.event("RequestSync"):FireServer()
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="71">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--!strict
-- UI construction helpers. Everything is authored in "virtual pixels" on a
-- root canvas that a UIScale maps to the real screen (see Kit.screen).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local SlimeBuilder = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SlimeBuilder"))

local Theme = require(script.Parent.Theme)

local Kit = {}

local player = Players.LocalPlayer
local clickSound: (() -> ())? = nil

function Kit.setClickSound(fn: () -> ())
	clickSound = fn
end

function Kit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Kit.corner(radius: number?): UICorner
	return Kit.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Kit.stroke(color: Color3?, thickness: number?): UIStroke
	return Kit.new("UIStroke", {
		Color = color or Theme.Colors.Stroke,
		Thickness = thickness or 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Kit.textStroke(thickness: number?): UIStroke
	return Kit.new("UIStroke", { Color = Theme.Colors.Stroke, Thickness = thickness or 2 })
end

function Kit.padding(px: number): UIPadding
	return Kit.new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
	})
end

function Kit.list(
	direction: Enum.FillDirection,
	padding: number,
	hAlign: Enum.HorizontalAlignment?,
	vAlign: Enum.VerticalAlignment?
): UIListLayout
	return Kit.new("UIListLayout", {
		FillDirection = direction,
		Padding = UDim.new(0, padding),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
	})
end

function Kit.gradient(top: Color3, bottom: Color3): UIGradient
	return Kit.new("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = 90,
	})
end

function Kit.label(props: { [string]: any }): TextLabel
	local defaults: { [string]: any } = {
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextColor3 = Theme.Colors.Text,
		TextScaled = true,
		Size = UDim2.new(1, 0, 0, 24),
	}
	for key, value in props do
		if key ~= "MaxTextSize" and key ~= "NoStroke" and key ~= "StrokeThickness" then
			defaults[key] = value
		end
	end
	local label = Kit.new("TextLabel", defaults)
	if props.TextScaled ~= false then
		Kit.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 40, Parent = label })
	end
	if props.NoStroke ~= true then
		Kit.textStroke(props.StrokeThickness).Parent = label
	end
	return label
end

-- Scale "pop" feedback on any GuiObject (uses a UIScale child).
function Kit.pop(gui: GuiObject, amount: number?)
	local scale = gui:FindFirstChild("PopScale") :: UIScale?
	if not scale then
		scale = Kit.new("UIScale", { Name = "PopScale", Parent = gui })
	end
	local s = scale :: UIScale
	s.Scale = amount or 1.15
	TweenService:Create(s, Theme.Tween.Pop, { Scale = 1 }):Play()
end

export type ButtonOptions = {
	text: string,
	color: Color3?,
	size: UDim2?,
	position: UDim2?,
	anchor: Vector2?,
	textSize: number?,
	layoutOrder: number?,
	parent: Instance?,
	onClick: (() -> ())?,
	name: string?,
}

-- Chunky candy button with gradient, stroke, press animation and sound.
function Kit.button(options: ButtonOptions): TextButton
	local color = options.color or Theme.Colors.Green
	local button: TextButton = Kit.new("TextButton", {
		Name = options.name or "Button",
		AutoButtonColor = false,
		BackgroundColor3 = color,
		Size = options.size or UDim2.fromOffset(160, 50),
		Position = options.position or UDim2.new(),
		AnchorPoint = options.anchor or Vector2.zero,
		Font = Theme.Font,
		Text = options.text,
		TextColor3 = Theme.Colors.Text,
		TextScaled = true,
		LayoutOrder = options.layoutOrder or 0,
	})
	Kit.corner(12).Parent = button
	Kit.stroke(Theme.Colors.Stroke, 3).Parent = button
	Kit.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 205)),
		Rotation = 90,
		Parent = button,
	})
	Kit.new("UITextSizeConstraint", { MaxTextSize = options.textSize or 26, Parent = button })
	Kit.new("UIPadding", {
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		Parent = button,
	})
	Kit.textStroke(2).Parent = button
	local scale: UIScale = Kit.new("UIScale", { Name = "PopScale", Parent = button })

	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, Theme.Tween.Fast, { Scale = 0.92 }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(scale, Theme.Tween.Pop, { Scale = 1 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, Theme.Tween.Pop, { Scale = 1 }):Play()
	end)
	button.Activated:Connect(function()
		if button:GetAttribute("Disabled") then
			return
		end
		if clickSound then
			clickSound()
		end
		if options.onClick then
			options.onClick()
		end
	end)
	if options.parent then
		button.Parent = options.parent
	end
	return button
end

function Kit.setEnabled(button: GuiButton, enabled: boolean, enabledColor: Color3)
	button:SetAttribute("Disabled", not enabled)
	button.BackgroundColor3 = if enabled then enabledColor else Theme.Colors.Grey
end

-- Red dot used on HUD buttons for "something to claim".
function Kit.badge(parent: GuiObject, text: string?): TextLabel
	local badge = Kit.label({
		Name = "Badge",
		Text = text or "!",
		Size = UDim2.fromOffset(24, 24),
		Position = UDim2.new(1, -6, 0, -6),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Colors.Red,
		ZIndex = 5,
		MaxTextSize = 18,
		Visible = false,
		Parent = parent,
	})
	Kit.corner(12).Parent = badge
	return badge
end

-- Slime preview inside a ViewportFrame, framed from its bounding box.
function Kit.slimeViewport(speciesId: string, mutations: { string }, props: { [string]: any }?): ViewportFrame
	local viewport: ViewportFrame = Kit.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(80, 80),
		Ambient = Color3.fromRGB(170, 170, 185),
		LightColor = Color3.new(1, 1, 1),
		LightDirection = Vector3.new(-1, -2, 1),
	})
	if props then
		for key, value in props do
			(viewport :: any)[key] = value
		end
	end
	local ok, model = pcall(SlimeBuilder.build, speciesId, mutations, 1)
	if ok and model then
		model:PivotTo(CFrame.new())
		model.Parent = viewport
		local cf, size = model:GetBoundingBox()
		local camera = Instance.new("Camera")
		camera.FieldOfView = 40
		local distance = math.max(size.X, size.Y, size.Z) * 1.9
		local target = cf.Position
		camera.CFrame = CFrame.lookAt(target + Vector3.new(0.35, 0.45, -1).Unit * distance, target)
		camera.Parent = viewport
		viewport.CurrentCamera = camera
	end
	return viewport
end

-- Root ScreenGui + virtual canvas. The UIScale is recomputed on resize.
function Kit.screen(name: string, displayOrder: number?): (ScreenGui, Frame)
	local gui: ScreenGui = Kit.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = displayOrder or 0,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local scale: UIScale = Kit.new("UIScale", { Parent = gui })
	local root: Frame = Kit.new("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	})

	local function update()
		local camera = Workspace.CurrentCamera
		if not camera then
			return
		end
		local viewport = camera.ViewportSize
		if viewport.X < 2 or viewport.Y < 2 then
			return
		end
		local s = math.min(viewport.Y / Theme.ReferenceHeight, viewport.X / Theme.ReferenceWidth)
		if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
			s *= Theme.TouchBoost
		end
		s = math.clamp(s, 0.45, 1.6)
		scale.Scale = s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	update()
	local function watchCamera()
		local camera = Workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
		end
	end
	watchCamera()
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		watchCamera()
		update()
	end)
	return gui, root
end

-- Size of the virtual canvas in virtual pixels.
function Kit.canvasSize(root: Frame): Vector2
	local gui = root:FindFirstAncestorOfClass("ScreenGui")
	local scale = if gui then gui:FindFirstChildOfClass("UIScale") else nil
	local s = if scale then scale.Scale else 1
	return root.AbsoluteSize / s
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
-- Visual identity: candy-bright slime colours on deep purple panels, chunky
-- rounded type. One place to restyle the whole UI.

local Theme = {}

Theme.Font = Enum.Font.FredokaOne
Theme.BodyFont = Enum.Font.BuilderSansBold

Theme.Colors = {
	Panel = Color3.fromRGB(43, 33, 66),
	PanelLight = Color3.fromRGB(62, 50, 92),
	PanelDark = Color3.fromRGB(28, 21, 44),
	Stroke = Color3.fromRGB(22, 16, 36),
	Text = Color3.fromRGB(255, 255, 255),
	TextDim = Color3.fromRGB(200, 190, 225),
	Green = Color3.fromRGB(96, 214, 86),
	GreenDark = Color3.fromRGB(52, 150, 60),
	Gold = Color3.fromRGB(255, 196, 46),
	GoldDark = Color3.fromRGB(214, 140, 20),
	Pink = Color3.fromRGB(255, 104, 170),
	Blue = Color3.fromRGB(80, 168, 255),
	Purple = Color3.fromRGB(170, 110, 255),
	Red = Color3.fromRGB(240, 80, 80),
	Grey = Color3.fromRGB(120, 115, 135),
	Coin = Color3.fromRGB(255, 214, 70),
	Robux = Color3.fromRGB(80, 220, 120),
}

Theme.Tween = {
	Fast = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	Pop = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
	Smooth = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
	Slow = TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
}

-- Reference "virtual screen" height. The UI is authored in virtual pixels
-- and a UIScale maps them to the device; touch devices get larger targets.
Theme.ReferenceHeight = 620
Theme.ReferenceWidth = 1000
Theme.TouchBoost = 1.15

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">Windows</string>
              <string name="Source"><![CDATA[--!strict
-- Modal window manager: one window open at a time, dimmed backdrop, pop-in
-- animation, close button and tap-outside-to-close.

local TweenService = game:GetService("TweenService")

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

export type WindowSpec = {
	title: string,
	color: Color3?,
	size: Vector2?, -- preferred virtual size
	build: (content: Frame) -> (),
	onOpen: (() -> ())?,
	onClose: (() -> ())?,
}

type WindowRecord = {
	spec: WindowSpec,
	frame: Frame,
	content: Frame,
	built: boolean,
}

local Windows = {}

local root: Frame? = nil
local backdrop: TextButton? = nil
local windows: { [string]: WindowRecord } = {}
local current: string? = nil
local listeners: { (string?) -> () } = {}

local function ensureRoot(): Frame
	if root then
		return root
	end
	local _, canvas = Kit.screen("SlimeWindows", 10)
	root = canvas
	backdrop = Kit.new("TextButton", {
		Name = "Backdrop",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = canvas,
	});
	(backdrop :: TextButton).Activated:Connect(function()
		Windows.close()
	end)
	return canvas
end

local function fitSize(record: WindowRecord)
	local canvas = Kit.canvasSize(ensureRoot())
	local preferred = record.spec.size or Vector2.new(760, 470)
	local width = math.min(preferred.X, canvas.X - 40)
	local height = math.min(preferred.Y, canvas.Y - 70)
	record.frame.Size = UDim2.fromOffset(width, height)
end

function Windows.register(name: string, spec: WindowSpec)
	local parent = ensureRoot()
	local color = spec.color or Theme.Colors.Green
	local frame: Frame = Kit.new("Frame", {
		Name = name,
		BackgroundColor3 = Theme.Colors.Panel,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 12),
		Visible = false,
		ZIndex = 2,
		Parent = parent,
	})
	Kit.corner(18).Parent = frame
	Kit.stroke(Theme.Colors.Stroke, 4).Parent = frame
	Kit.new("UIScale", { Name = "OpenScale", Parent = frame })

	local titleBar: Frame = Kit.new("Frame", {
		Name = "TitleBar",
		BackgroundColor3 = color,
		Size = UDim2.new(1, 0, 0, 52),
		ZIndex = 3,
		Parent = frame,
	})
	Kit.corner(18).Parent = titleBar
	Kit.gradient(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)).Parent = titleBar
	-- square off the bottom corners of the title bar
	Kit.new("Frame", {
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.new(0, 0, 1, -18),
		ZIndex = 3,
		Parent = titleBar,
	})
	Kit.label({
		Name = "Title",
		Text = spec.title,
		Size = UDim2.new(1, -120, 0, 40),
		Position = UDim2.new(0, 20, 0, 6),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 4,
		MaxTextSize = 34,
		Parent = titleBar,
	})
	local close = Kit.button({
		text = "X",
		color = Theme.Colors.Red,
		size = UDim2.fromOffset(44, 44),
		position = UDim2.new(1, -8, 0, 4),
		anchor = Vector2.new(1, 0),
		onClick = function()
			Windows.close()
		end,
	})
	close.ZIndex = 5
	close.Parent = titleBar

	local content: Frame = Kit.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -24, 1, -70),
		Position = UDim2.fromOffset(12, 60),
		ZIndex = 3,
		Parent = frame,
	})

	windows[name] = { spec = spec, frame = frame, content = content, built = false }
end

function Windows.isOpen(name: string): boolean
	return current == name
end

function Windows.current(): string?
	return current
end

function Windows.onChanged(fn: (string?) -> ())
	table.insert(listeners, fn)
end

local function notify()
	for _, fn in listeners do
		task.spawn(fn, current)
	end
end

function Windows.close()
	if not current then
		return
	end
	local record = windows[current]
	current = nil
	if record then
		record.frame.Visible = false
		if record.spec.onClose then
			record.spec.onClose()
		end
	end
	local b = backdrop :: TextButton
	TweenService:Create(b, Theme.Tween.Fast, { BackgroundTransparency = 1 }):Play()
	task.delay(0.12, function()
		if not current then
			b.Visible = false
		end
	end)
	notify()
end

function Windows.open(name: string)
	local record = windows[name]
	if not record then
		return
	end
	if current == name then
		return
	end
	if current then
		local previous = windows[current]
		current = nil
		previous.frame.Visible = false
		if previous.spec.onClose then
			previous.spec.onClose()
		end
	end
	current = name
	if not record.built then
		record.built = true
		record.spec.build(record.content)
	end
	fitSize(record)
	local b = backdrop :: TextButton
	b.Visible = true
	TweenService:Create(b, Theme.Tween.Fast, { BackgroundTransparency = 0.45 }):Play()
	record.frame.Visible = true
	local scale = record.frame:FindFirstChild("OpenScale") :: UIScale
	scale.Scale = 0.8
	TweenService:Create(scale, Theme.Tween.Pop, { Scale = 1 }):Play()
	if record.spec.onOpen then
		record.spec.onOpen()
	end
	notify()
end

function Windows.toggle(name: string)
	if current == name then
		Windows.close()
	else
		Windows.open(name)
	end
end

-- Small yes/no dialog on top of everything.
function Windows.confirm(title: string, body: string, confirmText: string, onConfirm: () -> ())
	local parent = ensureRoot()
	local existing = parent:FindFirstChild("Confirm")
	if existing then
		existing:Destroy()
	end
	local frame: Frame = Kit.new("Frame", {
		Name = "Confirm",
		BackgroundColor3 = Theme.Colors.Panel,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(420, 230),
		ZIndex = 20,
		Parent = parent,
	})
	Kit.corner(18).Parent = frame
	Kit.stroke(Theme.Colors.Stroke, 4).Parent = frame
	Kit.label({
		Text = title,
		Size = UDim2.new(1, -30, 0, 40),
		Position = UDim2.fromOffset(15, 12),
		ZIndex = 21,
		MaxTextSize = 30,
		Parent = frame,
	})
	Kit.label({
		Text = body,
		Font = Theme.BodyFont,
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, -30, 0, 80),
		Position = UDim2.fromOffset(15, 58),
		TextWrapped = true,
		ZIndex = 21,
		MaxTextSize = 22,
		NoStroke = true,
		Parent = frame,
	})
	local yes = Kit.button({
		text = confirmText,
		color = Theme.Colors.Green,
		size = UDim2.fromOffset(170, 52),
		position = UDim2.new(0.5, 8, 1, -16),
		anchor = Vector2.new(0, 1),
		onClick = function()
			frame:Destroy()
			onConfirm()
		end,
	})
	yes.ZIndex = 21
	yes.Parent = frame
	local no = Kit.button({
		text = "Cancel",
		color = Theme.Colors.Grey,
		size = UDim2.fromOffset(170, 52),
		position = UDim2.new(0.5, -8, 1, -16),
		anchor = Vector2.new(1, 1),
		onClick = function()
			frame:Destroy()
		end,
	})
	no.ZIndex = 21
	no.Parent = frame
	Kit.pop(frame, 0.85)
end

return Windows
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
