      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">DailyRewards</string>
          <string name="Source"><![CDATA[--!strict
-- Seven-day login streak. Missing a day restarts the streak at day 1; the
-- cycle repeats after day 7. Rewards scale with progress.

local Economy = require(script.Parent.Economy)
local Format = require(script.Parent.Format)
local Species = require(script.Parent.Species)

export type RewardDef = {
	kind: "coins" | "seeds" | "potion" | "prism",
	units: number?,
	amount: number?,
	tierOffset: number?,
	potion: string?,
}

export type Reward = {
	label: string,
	icon: string,
	coins: number,
	seeds: { [string]: number },
	potions: { [string]: number },
}

local DailyRewards = {}

DailyRewards.cycle = {
	{ kind = "coins", units = 10 },
	{ kind = "seeds", tierOffset = 0, amount = 3 },
	{ kind = "potion", potion = "growth", amount = 1 },
	{ kind = "coins", units = 25 },
	{ kind = "potion", potion = "luck", amount = 1 },
	{ kind = "seeds", tierOffset = 1, amount = 2 },
	{ kind = "prism", amount = 1, units = 60 },
} :: { RewardDef }

function DailyRewards.dayNumber(unixTime: number): number
	return unixTime // 86400
end

export type Status = {
	canClaim: boolean,
	nextStreak: number, -- streak value after the next claim
	cycleDay: number, -- 1..7 reward slot of the next claim
}

function DailyRewards.status(lastClaimDay: number, streak: number, today: number): Status
	if lastClaimDay == today then
		local cycleDay = (streak % #DailyRewards.cycle) + 1
		return { canClaim = false, nextStreak = streak + 1, cycleDay = cycleDay }
	end
	local nextStreak = if lastClaimDay == today - 1 then streak + 1 else 1
	return {
		canClaim = true,
		nextStreak = nextStreak,
		cycleDay = ((nextStreak - 1) % #DailyRewards.cycle) + 1,
	}
end

local function seedTier(bestTier: number, offset: number): number
	-- Never hand out Cosmic seeds (rebirth-locked) or tier-1 filler.
	return math.clamp(bestTier + offset, 2, Species.MaxTier - 1)
end

function DailyRewards.resolve(cycleDay: number, bestTier: number): Reward
	local def = DailyRewards.cycle[cycleDay]
	local unit = Economy.unit(bestTier)
	local reward: Reward = { label = "", icon = "🎁", coins = 0, seeds = {}, potions = {} }
	if def.kind == "coins" then
		reward.coins = Economy.niceRound((def.units or 0) * unit)
		reward.icon = "🪙"
	elseif def.kind == "seeds" then
		local species = Species.byTier[seedTier(bestTier, def.tierOffset or 0)]
		reward.seeds[species.id] = def.amount or 1
		reward.icon = "🌱"
	elseif def.kind == "potion" then
		reward.potions[def.potion or "growth"] = def.amount or 1
		reward.icon = if def.potion == "luck" then "🔮" else "🧪"
	elseif def.kind == "prism" then
		reward.seeds.prism = def.amount or 1
		reward.coins = Economy.niceRound((def.units or 0) * unit)
		reward.icon = "🌈"
	end

	local parts = {}
	if reward.coins > 0 then
		table.insert(parts, `{Format.short(reward.coins)} coins`)
	end
	for id, count in reward.seeds do
		local species = Species.byId[id]
		table.insert(parts, `{count}x {if species then species.name else id} Seed`)
	end
	for potion, count in reward.potions do
		table.insert(parts, `{count}x {if potion == "luck" then "Luck" else "Growth"} Potion`)
	end
	reward.label = table.concat(parts, " + ")
	return reward
end

return DailyRewards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--!strict
-- Pure economy math shared by server (authoritative) and client (display
-- only). No Roblox services here so it can be unit tested under Lune.

local Config = require(script.Parent.Config)
local Mutations = require(script.Parent.Mutations)
local Products = require(script.Parent.Products)
local Species = require(script.Parent.Species)

type SlimeLike = { s: string, w: number, m: { string }, b: number? }

local Economy = {}

-- Rounds to two significant digits so prices read cleanly (1,641 -> 1,600).
function Economy.niceRound(n: number): number
	if n < 100 then
		return math.floor(n + 0.5)
	end
	local magnitude = 10 ^ (math.floor(math.log10(n)) - 1)
	return math.floor(n / magnitude + 0.5) * magnitude
end

function Economy.tileCost(tileIndex: number): number
	local first = Config.Plots.StartingTiles + 1
	if tileIndex < first then
		return 0
	end
	return Economy.niceRound(100 * 1.75 ^ (tileIndex - first))
end

function Economy.startingTiles(rebirths: number): number
	return Config.Plots.StartingTiles + math.min(rebirths, Config.Plots.MaxRebirthBonusTiles)
end

function Economy.totalTiles(unlockedTiles: number, hasBigGarden: boolean): number
	local tiles = math.clamp(unlockedTiles, 0, Config.Plots.FreeTileLimit)
	if hasBigGarden then
		tiles += Config.Plots.PassTiles
	end
	return tiles
end

-- A tile index is plantable if it is among the coin-unlocked tiles, or in the
-- pass-only row while the player owns Big Garden.
function Economy.isTileUsable(tileIndex: number, unlockedTiles: number, hasBigGarden: boolean): boolean
	if tileIndex < 1 or tileIndex ~= math.floor(tileIndex) then
		return false
	end
	if tileIndex <= Config.Plots.FreeTileLimit then
		return tileIndex <= unlockedTiles
	end
	return hasBigGarden and tileIndex <= Config.Plots.FreeTileLimit + Config.Plots.PassTiles
end

function Economy.rebirthCost(rebirths: number): number
	return Config.Rebirth.BaseCost * Config.Rebirth.CostGrowth ^ rebirths
end

-- Scaling unit for rewards and coin packs: the value of the best slime the
-- player has grown, so rewards stay meaningful at every stage.
function Economy.unit(bestTier: number): number
	local species = Species.byTier[math.clamp(bestTier, 1, Species.MaxTier)]
	return math.max(24, species.value)
end

function Economy.coinPackAmount(packKey: string, bestTier: number): number
	local units = Products.CoinPackUnits[packKey]
	assert(units, `unknown coin pack {packKey}`)
	return Economy.niceRound(units * Economy.unit(bestTier))
end

function Economy.prismBaseValue(bestTier: number): number
	return Economy.niceRound(8 * Economy.unit(bestTier))
end

function Economy.mutationMultiplier(mutations: { string }): number
	local multiplier = 1
	for _, id in mutations do
		local mutation = Mutations.byId[id]
		if mutation then
			multiplier *= mutation.multiplier
		end
	end
	return multiplier
end

function Economy.baseValue(slime: SlimeLike): number
	if slime.b then
		return slime.b
	end
	local species = Species.byId[slime.s]
	return if species then species.value else 0
end

function Economy.slimeValue(slime: SlimeLike, sellMultiplier: number): number
	return math.floor(
		Economy.baseValue(slime) * slime.w * Economy.mutationMultiplier(slime.m) * sellMultiplier
	)
end

-- Weight distribution: 0.5% Titanic, 4% Huge, 20% Big, otherwise Normal.
-- `rng` returns uniform numbers in [0, 1).
function Economy.rollWeight(rng: () -> number): number
	local roll = rng()
	local low, high
	if roll < 0.005 then
		low, high = 4, 6
	elseif roll < 0.045 then
		low, high = 2, 4
	elseif roll < 0.245 then
		low, high = 1.25, 2
	else
		low, high = 0.8, 1.25
	end
	local weight = low + (high - low) * rng()
	return math.floor(weight * 100 + 0.5) / 100
end

function Economy.weightLabel(weight: number): string?
	if weight >= 4 then
		return "Titanic"
	elseif weight >= 2 then
		return "Huge"
	elseif weight >= 1.25 then
		return "Big"
	end
	return nil
end

function Economy.visualSize(weight: number): number
	return math.clamp(weight, 0.5, 8) ^ 0.45
end

-- Rolls at most one variant, rarest first. Luck multiplies every chance.
function Economy.rollVariant(rng: () -> number, luck: number): string?
	for _, mutation in Mutations.variants do
		if rng() < math.min(mutation.chance * luck, 0.5) then
			return mutation.id
		end
	end
	return nil
end

-- Converts a per-minute weather mutation chance into the chance for one tick.
function Economy.weatherTickChance(perMinute: number, luck: number, tickSeconds: number): number
	local perMinuteBoosted = math.min(perMinute * luck, 0.95)
	return 1 - (1 - perMinuteBoosted) ^ (tickSeconds / 60)
end

export type BonusInputs = {
	rebirths: number,
	doubleCoins: boolean,
	vip: boolean,
	premium: boolean,
	friends: number,
	inGroup: boolean,
}

function Economy.sellMultiplier(inputs: BonusInputs): number
	local additive = 1
	if inputs.vip then
		additive += Config.Bonuses.VipBonus
	end
	if inputs.premium then
		additive += Config.Bonuses.PremiumBonus
	end
	if inputs.inGroup then
		additive += Config.Bonuses.GroupBonus
	end
	additive += Config.Bonuses.FriendBonus * math.clamp(inputs.friends, 0, Config.Bonuses.MaxFriends)
	local rebirth = 1 + Config.Bonuses.RebirthBonus * inputs.rebirths
	local double = if inputs.doubleCoins then 2 else 1
	return additive * rebirth * double
end

function Economy.growthRate(fastGrow: boolean, potion: boolean, weatherMultiplier: number): number
	local rate = 1
	if fastGrow then
		rate *= Config.Bonuses.FastGrowMultiplier
	end
	if potion then
		rate *= Config.Boosts.GrowthPotionMultiplier
	end
	return rate * weatherMultiplier
end

function Economy.luck(luckyPass: boolean, potion: boolean): number
	local luck = 1
	if luckyPass then
		luck *= 2
	end
	if potion then
		luck *= Config.Boosts.LuckPotionMultiplier
	end
	return math.min(luck, Config.Boosts.MaxLuck)
end

function Economy.backpackCapacity(vip: boolean): number
	return Config.Backpack.BaseCapacity + (if vip then Config.Backpack.VipBonus else 0)
end

-- Growth time for a plant (exclusive species use their own catalog time).
function Economy.growTime(speciesId: string): number
	local species = Species.byId[speciesId]
	return if species then species.growTime else math.huge
end

-- Rarity tier used for announcements / quests; exclusives count as epic.
function Economy.effectiveTier(speciesId: string): number
	local species = Species.byId[speciesId]
	if not species then
		return 0
	end
	return if species.tier == 0 then 7 else species.tier
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
-- Number and time formatting for UI.

local Format = {}

-- "1.50" -> "1.5", "2.00" -> "2", "120" -> "120"
local function trimZeros(text: string): string
	if not string.find(text, ".", 1, true) then
		return text
	end
	text = string.gsub(text, "0+$", "")
	text = string.gsub(text, "%.$", "")
	return text
end

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- 999 -> "999", 1234 -> "1.23K", 12345678 -> "12.3M"
function Format.short(n: number): string
	if n ~= n then
		return "0"
	end
	local negative = n < 0
	n = math.abs(n)
	if n < 1000 then
		local text = tostring(math.floor(n))
		return if negative then "-" .. text else text
	end
	local index = 1
	while n >= 1000 and index < #SUFFIXES do
		n /= 1000
		index += 1
	end
	local text
	if n >= 100 then
		text = string.format("%d", math.floor(n))
	elseif n >= 10 then
		text = string.format("%.1f", math.floor(n * 10) / 10)
	else
		text = string.format("%.2f", math.floor(n * 100) / 100)
	end
	text = trimZeros(text)
	return (if negative then "-" else "") .. text .. SUFFIXES[index]
end

-- 1234567 -> "1,234,567"
function Format.commas(n: number): string
	local text = tostring(math.floor(math.abs(n)))
	local formatted = string.reverse((string.gsub(string.reverse(text), "(%d%d%d)", "%1,")))
	formatted = string.gsub(formatted, "^,", "")
	return (if n < 0 then "-" else "") .. formatted
end

-- 75 -> "1:15", 3725 -> "1:02:05", 9 -> "0:09"
function Format.clock(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	local hours = seconds // 3600
	local minutes = (seconds % 3600) // 60
	local secs = seconds % 60
	if hours > 0 then
		return string.format("%d:%02d:%02d", hours, minutes, secs)
	end
	return string.format("%d:%02d", minutes, secs)
end

-- 45 -> "45s", 125 -> "2m 5s", 7200 -> "2h"
function Format.duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	if seconds < 60 then
		return `{seconds}s`
	elseif seconds < 3600 then
		local m, s = seconds // 60, seconds % 60
		return if s == 0 then `{m}m` else `{m}m {s}s`
	end
	local h, m = seconds // 3600, (seconds % 3600) // 60
	return if m == 0 then `{h}h` else `{h}h {m}m`
end

function Format.percent(chance: number): string
	local pct = chance * 100
	if pct >= 10 then
		return string.format("%d%%", math.floor(pct + 0.5))
	elseif pct >= 1 then
		return trimZeros(string.format("%.1f", pct)) .. "%"
	end
	return trimZeros(string.format("%.2f", pct)) .. "%"
end

function Format.multiplier(m: number): string
	if m == math.floor(m) then
		return `x{m}`
	end
	return "x" .. trimZeros(string.format("%.2f", m))
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Mutations</string>
          <string name="Source"><![CDATA[--!strict
-- Mutations multiply a slime's value. A slime can carry at most one variant
-- (rolled once when it ripens) plus one of each weather mutation (rolled
-- while it sits ripe in the garden during matching weather). All odds are
-- shown to players in the Slimepedia.

local Types = require(script.Parent.Types)

type Mutation = Types.Mutation

local Mutations = {}

local list: { Mutation } = {
	{
		id = "shiny",
		name = "Shiny",
		kind = "variant",
		multiplier = 2,
		color = Color3.fromRGB(255, 255, 210),
		chance = 0.05,
		order = 1,
	},
	{
		id = "golden",
		name = "Golden",
		kind = "variant",
		multiplier = 6,
		color = Color3.fromRGB(255, 205, 50),
		chance = 0.012,
		order = 2,
	},
	{
		id = "rainbow",
		name = "Rainbow",
		kind = "variant",
		multiplier = 15,
		color = Color3.fromRGB(255, 120, 220),
		chance = 0.0025,
		order = 3,
	},
	{
		id = "drenched",
		name = "Drenched",
		kind = "weather",
		multiplier = 2,
		color = Color3.fromRGB(90, 210, 255),
		chance = 0.25,
		weather = "goorain",
		order = 4,
	},
	{
		id = "sunkissed",
		name = "Sunkissed",
		kind = "weather",
		multiplier = 2.5,
		color = Color3.fromRGB(255, 170, 60),
		chance = 0.2,
		weather = "goldenhour",
		order = 5,
	},
	{
		id = "frozen",
		name = "Frozen",
		kind = "weather",
		multiplier = 3,
		color = Color3.fromRGB(180, 230, 255),
		chance = 0.2,
		weather = "snowfall",
		order = 6,
	},
	{
		id = "starstruck",
		name = "Starstruck",
		kind = "weather",
		multiplier = 8,
		color = Color3.fromRGB(200, 160, 255),
		chance = 0.12,
		weather = "starfall",
		order = 7,
	},
}

local byId: { [string]: Mutation } = {}
local variants: { Mutation } = {}
local byWeather: { [string]: Mutation } = {}

for _, mutation in list do
	byId[mutation.id] = mutation
	if mutation.kind == "variant" then
		table.insert(variants, mutation)
	elseif mutation.weather then
		byWeather[mutation.weather] = mutation
	end
end

-- Rarest first so a single roll picks the most valuable variant it hits.
table.sort(variants, function(a, b)
	return a.chance < b.chance
end)

Mutations.list = list
Mutations.byId = byId
Mutations.variants = variants
Mutations.byWeather = byWeather

function Mutations.get(id: string): Mutation?
	return byId[id]
end

return Mutations
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Remote access for both sides. The server calls Net.setup() once during
-- init to create every remote from Remotes.luau; clients call Net.event(),
-- which waits for the server-created instance.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = require(script.Parent.Remotes)

local FOLDER_NAME = "Remotes"

local Net = {}

local folder: Folder? = nil
local cache: { [string]: RemoteEvent } = {}

function Net.setup()
	assert(RunService:IsServer(), "Net.setup is server-only")
	local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if existing then
		existing:Destroy()
	end
	local newFolder = Instance.new("Folder")
	newFolder.Name = FOLDER_NAME
	for _, list in { Remotes.ClientToServer, Remotes.ServerToClient } do
		for _, name in list do
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = newFolder
			cache[name] = remote
		end
	end
	newFolder.Parent = ReplicatedStorage
	folder = newFolder
end

local function getFolder(): Folder
	if folder then
		return folder
	end
	assert(RunService:IsClient(), "Net.setup() must run before remotes are used on the server")
	local found = ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
	folder = found
	return found
end

function Net.event(name: string): RemoteEvent
	local cached = cache[name]
	if cached then
		return cached
	end
	local remote = getFolder():WaitForChild(name, 30)
	assert(remote and remote:IsA("RemoteEvent"), `missing remote {name}`)
	cache[name] = remote
	return remote
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Products</string>
          <string name="Source"><![CDATA[--!strict
-- Robux catalog. Create each pass / developer product in the Creator
-- Dashboard, set its price there, and paste the id into `id`. `price` is the
-- intended Robux price; the client always displays the live price fetched
-- from MarketplaceService when an id is set, so players never see a price
-- that differs from the purchase prompt.
--
-- While an id is 0 the item cannot be bought in live servers. In Studio the
-- store grants it directly so the full flow can be tested before publishing.

export type Category = "Passes" | "Boosts" | "Coins" | "Events"

export type Product = {
	key: string,
	kind: "pass" | "product",
	id: number,
	price: number,
	name: string,
	icon: string,
	description: string,
	category: Category,
	order: number,
	highlight: string?,
}

local Products = {}

local list: { Product } = {
	-- Game passes: permanent benefits.
	{
		key = "starter_pack",
		kind = "pass",
		id = 0,
		price = 49,
		name = "Starter Pack",
		icon = "🎁",
		description = "One-time bundle: 3 Ember + 2 Frost seeds, 2,500 coins, a Growth and a Luck Potion.",
		category = "Passes",
		order = 1,
		highlight = "BEST VALUE",
	},
	{
		key = "big_garden",
		kind = "pass",
		id = 0,
		price = 149,
		name = "Big Garden",
		icon = "🌱",
		description = "+6 extra garden tiles (a whole new row) forever.",
		category = "Passes",
		order = 2,
	},
	{
		key = "sell_anywhere",
		kind = "pass",
		id = 0,
		price = 149,
		name = "Sell Anywhere",
		icon = "💰",
		description = "Sell your slimes from anywhere with one tap.",
		category = "Passes",
		order = 3,
	},
	{
		key = "vip",
		kind = "pass",
		id = 0,
		price = 199,
		name = "VIP",
		icon = "👑",
		description = "+15% coins, +50 backpack space and a golden VIP tag in chat.",
		category = "Passes",
		order = 4,
	},
	{
		key = "lucky",
		kind = "pass",
		id = 0,
		price = 249,
		name = "Lucky Gardener",
		icon = "🍀",
		description = "Doubles every mutation chance, forever. Odds are listed in the Slimepedia.",
		category = "Passes",
		order = 5,
	},
	{
		key = "fast_grow",
		kind = "pass",
		id = 0,
		price = 299,
		name = "Fast Grow",
		icon = "⚡",
		description = "Slimes grow 30% faster, even while you are offline.",
		category = "Passes",
		order = 6,
	},
	{
		key = "auto_harvest",
		kind = "pass",
		id = 0,
		price = 349,
		name = "Auto Harvest",
		icon = "🤖",
		description = "Ripe slimes harvest themselves while you play (toggle any time).",
		category = "Passes",
		order = 7,
	},
	{
		key = "double_coins",
		kind = "pass",
		id = 0,
		price = 399,
		name = "2x Coins",
		icon = "💎",
		description = "Every slime sells for double, forever.",
		category = "Passes",
		order = 8,
		highlight = "POPULAR",
	},

	-- Developer products: repeatable purchases.
	{
		key = "instant_grow",
		kind = "product",
		id = 0,
		price = 29,
		name = "Instant Grow",
		icon = "⏩",
		description = "Instantly ripens every slime in your garden. Saved for later if nothing is growing.",
		category = "Boosts",
		order = 1,
	},
	{
		key = "growth_potion",
		kind = "product",
		id = 0,
		price = 39,
		name = "Growth Potion",
		icon = "🧪",
		description = "2x growth speed for 15 minutes. Stacks duration.",
		category = "Boosts",
		order = 2,
	},
	{
		key = "luck_potion",
		kind = "product",
		id = 0,
		price = 39,
		name = "Luck Potion",
		icon = "🔮",
		description = "2x mutation chances for 15 minutes. Stacks duration.",
		category = "Boosts",
		order = 3,
	},
	{
		key = "prism_seed",
		kind = "product",
		id = 0,
		price = 99,
		name = "Prism Seed",
		icon = "🌈",
		description = "An exclusive seed that grows in 5 minutes into a slime worth 8x your best species.",
		category = "Boosts",
		order = 4,
	},
	{
		key = "coins_small",
		kind = "product",
		id = 0,
		price = 25,
		name = "Pouch of Coins",
		icon = "🪙",
		description = "Scales with your progress.",
		category = "Coins",
		order = 1,
	},
	{
		key = "coins_medium",
		kind = "product",
		id = 0,
		price = 75,
		name = "Bag of Coins",
		icon = "💰",
		description = "Scales with your progress.",
		category = "Coins",
		order = 2,
	},
	{
		key = "coins_large",
		kind = "product",
		id = 0,
		price = 199,
		name = "Chest of Coins",
		icon = "🧰",
		description = "Scales with your progress.",
		category = "Coins",
		order = 3,
	},
	{
		key = "coins_huge",
		kind = "product",
		id = 0,
		price = 449,
		name = "Vault of Coins",
		icon = "🏦",
		description = "Scales with your progress.",
		category = "Coins",
		order = 4,
		highlight = "BEST RATE",
	},
	{
		key = "weather_goorain",
		kind = "product",
		id = 0,
		price = 79,
		name = "Summon Goo Rain",
		icon = "🌧️",
		description = "Starts Goo Rain for EVERYONE in the server: 1.5x growth and Drenched mutations.",
		category = "Events",
		order = 1,
	},
	{
		key = "weather_starfall",
		kind = "product",
		id = 0,
		price = 199,
		name = "Summon Starfall",
		icon = "🌠",
		description = "Starts a Starfall for EVERYONE in the server: Starstruck (x8) mutations.",
		category = "Events",
		order = 2,
	},
}

local byKey: { [string]: Product } = {}
local byPassId: { [number]: Product } = {}
local byProductId: { [number]: Product } = {}

for _, product in list do
	assert(byKey[product.key] == nil, `duplicate product key {product.key}`)
	byKey[product.key] = product
	if product.id ~= 0 then
		if product.kind == "pass" then
			byPassId[product.id] = product
		else
			byProductId[product.id] = product
		end
	end
end

Products.list = list
Products.byKey = byKey
Products.byPassId = byPassId
Products.byProductId = byProductId

Products.CoinPackUnits = {
	coins_small = 10,
	coins_medium = 35,
	coins_large = 100,
	coins_huge = 300,
} :: { [string]: number }

Products.Categories = { "Passes", "Boosts", "Coins", "Events" } :: { Category }

function Products.get(key: string): Product?
	return byKey[key]
end

return Products
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Quests</string>
          <string name="Source"><![CDATA[--!strict
-- Daily quests: three per UTC day, generated deterministically from the
-- player's id and the day so they survive rejoins and server hops.

local Economy = require(script.Parent.Economy)
local Rng = require(script.Parent.Rng)
local Types = require(script.Parent.Types)

type QuestData = Types.QuestData

export type Template = {
	kind: string,
	text: string,
	targets: { number }?,
	scaledUnits: { number }?,
	minTier: number?,
}

local Quests = {}

Quests.Kinds = {
	Harvest = "harvest",
	Plant = "plant",
	Sell = "sell",
	Mutated = "mutated",
	Buy = "buy",
	Rare = "rare",
}

local templates: { Template } = {
	{ kind = "harvest", text = "Harvest {n} slimes", targets = { 15, 30, 50 } },
	{ kind = "plant", text = "Plant {n} seeds", targets = { 15, 30 } },
	{ kind = "sell", text = "Earn {n} coins by selling", scaledUnits = { 30, 60 } },
	{ kind = "mutated", text = "Harvest {n} mutated slimes", targets = { 1, 3 } },
	{ kind = "buy", text = "Buy {n} seeds at the Seed Shop", targets = { 10, 20 } },
	{ kind = "rare", text = "Harvest {n} Rare-or-better slimes", targets = { 1, 2 }, minTier = 5 },
}

local byKind: { [string]: Template } = {}
for _, template in templates do
	byKind[template.kind] = template
end

Quests.templates = templates
Quests.byKind = byKind

local REWARD_UNITS = { 6, 8, 12 }

function Quests.dayNumber(unixTime: number): number
	return unixTime // 86400
end

function Quests.generate(day: number, userId: number, bestTier: number): { QuestData }
	local rng = Rng.new(Rng.hash(day, userId, 7919))
	local pool: { Template } = {}
	for _, template in templates do
		if (template.minTier or 0) <= bestTier then
			table.insert(pool, template)
		end
	end

	local unit = Economy.unit(bestTier)
	local quests: { QuestData } = {}
	for i = 1, 3 do
		local pick = math.floor(rng() * #pool) + 1
		local template = table.remove(pool, pick) :: Template
		local target
		if template.scaledUnits then
			local units = template.scaledUnits[math.floor(rng() * #template.scaledUnits) + 1]
			target = Economy.niceRound(units * unit)
		else
			local targets = template.targets :: { number }
			target = targets[math.floor(rng() * #targets) + 1]
		end
		table.insert(quests, {
			kind = template.kind,
			target = target,
			progress = 0,
			claimed = false,
			rewardCoins = Economy.niceRound(REWARD_UNITS[i] * unit),
			rewardItem = if i == 3 then (if day % 2 == 0 then "growth" else "luck") else nil,
		})
	end
	return quests
end

function Quests.describe(quest: QuestData, formatNumber: (number) -> string): string
	local template = byKind[quest.kind]
	if not template then
		return quest.kind
	end
	return (string.gsub(template.text, "{n}", formatNumber(quest.target)))
end

return Quests
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- The single list of remotes. The server creates them at startup; clients
-- only wait for them. Adding a remote = one line here.

local Remotes = {}

-- Client -> server requests. Every handler validates and rate limits.
Remotes.ClientToServer = {
	"Plant", -- (tile: number, speciesId: string)
	"Harvest", -- (tile: number)
	"HarvestAll", -- ()
	"SellAll", -- ()
	"SellSlime", -- (slimeId: number)
	"ToggleFavorite", -- (slimeId: number)
	"BuySeed", -- (speciesId: string)
	"UnlockTile", -- ()
	"ClaimDaily", -- ()
	"ClaimQuest", -- (index: number)
	"Rebirth", -- ()
	"UsePotion", -- (potion: string)
	"UseInstantGrow", -- ()
	"SetAutoHarvest", -- (enabled: boolean)
	"RequestSync", -- () client finished loading; resend full state
	"DevGrant", -- (productKey: string) -- Studio only, rejected in live servers
}

-- Server -> client pushes.
Remotes.ServerToClient = {
	"Sync", -- (sections: { [string]: any })
	"Stock", -- (StockState)
	"Weather", -- (WeatherState)
	"Notify", -- (text: string, kind: string?)
	"Announce", -- (text: string, color: Color3?)
	"Effect", -- (kind: string, data: { [string]: any })
}

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Rng</string>
          <string name="Source"><![CDATA[--!strict
-- Small deterministic PRNG (xorshift32) so seeded rolls (daily quests) give
-- identical results on any server and under the Lune test runner, where
-- Roblox's Random class is unavailable.

local Rng = {}

function Rng.new(seed: number): () -> number
	local state = math.floor(math.abs(seed)) % 4294967296
	if state == 0 then
		state = 2463534242
	end
	return function(): number
		state = bit32.bxor(state, bit32.lshift(state, 13))
		state = bit32.bxor(state, bit32.rshift(state, 17))
		state = bit32.bxor(state, bit32.lshift(state, 5))
		return state / 4294967296
	end
end

-- Mixes several integers into one seed.
function Rng.hash(...: number): number
	local h = 2166136261
	for i = 1, select("#", ...) do
		local value = math.floor(math.abs((select(i, ...))))
		for _ = 1, 4 do
			h = bit32.bxor(h, value % 256)
			h = (h * 16777619) % 4294967296
			value = value // 256
		end
	end
	return h
end

return Rng
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--!strict
-- Minimal synchronous signal used for in-process events between systems.
-- Handlers run in the firing thread via task.spawn so one failing handler
-- cannot break the others.

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal<T...> = {
	Connect: (self: Signal<T...>, handler: (T...) -> ()) -> Connection,
	Fire: (self: Signal<T...>, T...) -> (),
	DisconnectAll: (self: Signal<T...>) -> (),
}

local Signal = {}

function Signal.new<T...>(): Signal<T...>
	local handlers: { [Connection]: (T...) -> () } = {}

	local self = {}

	function self.Connect(_: any, handler: (T...) -> ()): Connection
		local connection = { Connected = true } :: any
		function connection.Disconnect(conn: Connection)
			conn.Connected = false
			handlers[conn] = nil
		end
		handlers[connection] = handler
		return connection
	end

	function self.Fire(_: any, ...: T...)
		for _, handler in handlers do
			task.spawn(handler, ...)
		end
	end

	function self.DisconnectAll(_: any)
		for connection in handlers do
			connection.Connected = false
		end
		table.clear(handlers)
	end

	return (self :: any) :: Signal<T...>
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">SlimeBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Builds slime models entirely from primitive parts (no uploaded assets
-- needed). The model's pivot is the centre of its base so PivotTo() drops it
-- onto a surface, and Model:ScaleTo() grows it from the ground up.

local Mutations = require(script.Parent.Mutations)
local Species = require(script.Parent.Species)

local SlimeBuilder = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local BODY_DIAMETER = 2.6
local SINK = 0.3 -- fraction of the body sphere hidden below the base

local function part(props: { [string]: any }, parent: Instance): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		(p :: any)[key] = value
	end
	p.Parent = parent
	return p
end

local function ball(name: string, diameter: number, cf: CFrame, color: Color3, parent: Instance): BasePart
	return part({
		Name = name,
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * diameter,
		CFrame = cf,
		Color = color,
	}, parent)
end

local function emitter(parent: BasePart, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.LightEmission = 0.6
	e.Rate = 4
	e.Lifetime = NumberRange.new(0.8, 1.4)
	e.Speed = NumberRange.new(0.5, 1.5)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new(0.25, 0)
	e.Texture = SPARKLE
	for key, value in props do
		(e :: any)[key] = value
	end
	e.Parent = parent
	return e
end

local function hasMutation(mutations: { string }, id: string): boolean
	return table.find(mutations, id) ~= nil
end

local function addAccessories(speciesId: string, model: Model, body: BasePart, s: number, accent: Color3)
	local radius = BODY_DIAMETER * s / 2
	local top = body.CFrame.Position + Vector3.new(0, radius * 0.92, 0)

	if speciesId == "bubble" then
		local b = ball("Bubble", 0.7 * s, CFrame.new(top + Vector3.new(0.6 * s, 0.2 * s, 0)), accent, model)
		b.Material = Enum.Material.Glass
		b.Transparency = 0.45
	elseif speciesId == "berry" then
		for i, angle in { -35, 35 } do
			part({
				Name = "Leaf" .. i,
				Size = Vector3.new(0.75, 0.12, 0.38) * s,
				CFrame = CFrame.new(top + Vector3.new(0, 0.1 * s, 0))
					* CFrame.Angles(0, math.rad(angle + 90), math.rad(25))
					* CFrame.new(0.3 * s, 0, 0),
				Color = accent,
			}, model)
		end
	elseif speciesId == "ember" then
		local flame = ball("Flame", 0.6 * s, CFrame.new(top + Vector3.new(0, 0.15 * s, 0)), accent, model)
		flame.Material = Enum.Material.Neon
		emitter(flame, {
			Texture = FIRE,
			Color = ColorSequence.new(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 80, 20)),
			Size = NumberSequence.new(0.45 * s, 0),
			Speed = NumberRange.new(1, 2),
			SpreadAngle = Vector2.new(10, 10),
			Rate = 12,
			Lifetime = NumberRange.new(0.4, 0.7),
		})
	elseif speciesId == "frost" or speciesId == "crystal" then
		local count = if speciesId == "crystal" then 3 else 4
		for i = 1, count do
			local angle = (i / count) * math.pi * 2
			local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * radius * 0.35
			local height = (if speciesId == "crystal" then 1.1 else 0.7) * s
			local shard = part({
				Name = "Shard" .. i,
				Size = Vector3.new(0.35 * s, height, 0.35 * s),
				CFrame = CFrame.new(top + offset - Vector3.new(0, 0.15 * s, 0))
					* CFrame.Angles(math.cos(angle) * 0.35, angle, math.sin(angle) * 0.35)
					* CFrame.new(0, height / 2, 0),
				Color = accent,
				Material = if speciesId == "crystal" then Enum.Material.Neon else Enum.Material.Ice,
				Transparency = 0.15,
			}, model)
			shard.CastShadow = false
		end
	elseif speciesId == "toxic" then
		emitter(body, {
			Texture = SMOKE,
			Color = ColorSequence.new(Color3.fromRGB(190, 255, 80)),
			Size = NumberSequence.new(0.3 * s, 0.6 * s),
			Transparency = NumberSequence.new(0.3, 1),
			Acceleration = Vector3.new(0, 2, 0),
			Rate = 3,
		})
	elseif speciesId == "king" then
		local crownY = top + Vector3.new(0, 0.05 * s, 0)
		part({
			Name = "CrownBand",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.35 * s, 1.3 * s, 1.3 * s),
			CFrame = CFrame.new(crownY) * CFrame.Angles(0, 0, math.rad(90)),
			Color = accent,
			Material = Enum.Material.Foil,
		}, model)
		for i = 1, 5 do
			local angle = (i / 5) * math.pi * 2
			part({
				Name = "CrownSpike" .. i,
				Size = Vector3.new(0.22, 0.45, 0.22) * s,
				CFrame = CFrame.new(crownY + Vector3.new(math.cos(angle), 0, math.sin(angle)) * 0.55 * s)
					* CFrame.new(0, 0.35 * s, 0)
					* CFrame.Angles(0, angle, math.rad(45)),
				Color = accent,
				Material = Enum.Material.Foil,
			}, model)
		end
		local gem = ball(
			"Gem",
			0.28 * s,
			CFrame.new(crownY + Vector3.new(0, 0.05 * s, -0.66 * s)),
			Color3.fromRGB(230, 40, 70),
			model
		)
		gem.Material = Enum.Material.Neon
	elseif speciesId == "cosmic" or speciesId == "prism" then
		local orbit = Instance.new("Model")
		orbit.Name = "Orbit"
		orbit.Parent = model
		for i = 1, 8 do
			local angle = (i / 8) * math.pi * 2
			local position = body.CFrame.Position
				+ Vector3.new(
					math.cos(angle) * radius * 1.35,
					math.sin(angle) * radius * 0.35,
					math.sin(angle) * radius * 1.35
				)
			local star = ball("Star" .. i, 0.22 * s, CFrame.new(position), accent, orbit)
			star.Material = Enum.Material.Neon
		end
		emitter(body, { Color = ColorSequence.new(accent), Rate = 5 })
	end
end

local function applyMutations(model: Model, body: BasePart, mutations: { string }, s: number)
	if hasMutation(mutations, "golden") then
		body.Color = Color3.fromRGB(255, 205, 50)
		body.Material = Enum.Material.Foil
		body.Transparency = 0
	elseif hasMutation(mutations, "rainbow") then
		body.Material = Enum.Material.SmoothPlastic
		model:SetAttribute("Rainbow", true)
	end
	if hasMutation(mutations, "frozen") then
		body.Color = body.Color:Lerp(Color3.fromRGB(190, 235, 255), 0.55)
		body.Material = Enum.Material.Ice
	end
	if hasMutation(mutations, "sunkissed") then
		body.Color = body.Color:Lerp(Color3.fromRGB(255, 160, 60), 0.35)
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 180, 90)
		light.Range = 8 * s
		light.Brightness = 1.2
		light.Parent = body
	end
	if hasMutation(mutations, "drenched") then
		body.Transparency = math.min(body.Transparency + 0.25, 0.5)
		emitter(body, {
			Texture = SPARKLE,
			Color = ColorSequence.new(Color3.fromRGB(90, 200, 255)),
			Acceleration = Vector3.new(0, -12, 0),
			Speed = NumberRange.new(0.2, 0.5),
			Rate = 6,
			Size = NumberSequence.new(0.18 * s, 0.05),
		})
	end
	if hasMutation(mutations, "shiny") then
		emitter(body, {
			Color = ColorSequence.new(Color3.fromRGB(255, 255, 220)),
			Rate = 6,
			Size = NumberSequence.new(0.35 * s, 0),
		})
	end
	if hasMutation(mutations, "starstruck") then
		emitter(body, {
			Color = ColorSequence.new(Color3.fromRGB(210, 170, 255), Color3.fromRGB(120, 200, 255)),
			Rate = 10,
			Size = NumberSequence.new(0.5 * s, 0),
			Speed = NumberRange.new(1, 3),
		})
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(190, 150, 255)
		light.Range = 10 * s
		light.Brightness = 1.5
		light.Parent = body
	end
end

-- size: overall scale (from Economy.visualSize(weight)).
function SlimeBuilder.build(speciesId: string, mutations: { string }, size: number): Model
	local species = Species.byId[speciesId]
	assert(species, `unknown species {speciesId}`)
	local s = size

	local model = Instance.new("Model")
	model.Name = species.name

	local diameter = BODY_DIAMETER * s
	local center = Vector3.new(0, diameter * (0.5 - SINK), 0)

	local body = ball("Body", diameter, CFrame.new(center), species.color, model)
	body.Material = species.material
	body.Transparency = species.transparency
	body.CanQuery = true
	body.CastShadow = true
	model.PrimaryPart = body

	-- Puddle-like base ring so the slime reads as squishy on the ground.
	local base = part({
		Name = "Base",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2 * s, diameter * 1.08, diameter * 1.08),
		CFrame = CFrame.new(0, 0.1 * s, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = species.color,
		Material = species.material,
		Transparency = math.min(species.transparency + 0.1, 0.6),
	}, model)
	base.CastShadow = false

	local radius = diameter / 2
	local front = -radius * 0.86
	local eyeHeight = center.Y + radius * 0.22
	local eyeWhite = if speciesId == "shadow" then Color3.fromRGB(30, 20, 45) else Color3.new(1, 1, 1)
	local pupilColor = if speciesId == "shadow"
		then Color3.fromRGB(220, 120, 255)
		else Color3.fromRGB(25, 25, 35)
	for _, side in { -1, 1 } do
		ball(
			if side < 0 then "EyeL" else "EyeR",
			0.58 * s,
			CFrame.new(side * 0.42 * s, eyeHeight, front),
			eyeWhite,
			model
		)
		local pupil = ball(
			if side < 0 then "PupilL" else "PupilR",
			0.32 * s,
			CFrame.new(side * 0.42 * s, eyeHeight - 0.03 * s, front - 0.2 * s),
			pupilColor,
			model
		)
		if speciesId == "shadow" then
			pupil.Material = Enum.Material.Neon
		end
		local cheek = ball(
			if side < 0 then "CheekL" else "CheekR",
			0.32 * s,
			CFrame.new(side * 0.78 * s, eyeHeight - 0.38 * s, front * 0.86),
			Color3.fromRGB(255, 130, 160),
			model
		)
		cheek.Transparency = 0.35
	end

	local shine = ball(
		"Shine",
		0.48 * s,
		CFrame.new(-0.55 * s, center.Y + radius * 0.6, -radius * 0.45),
		Color3.new(1, 1, 1),
		model
	)
	shine.Transparency = 0.4

	addAccessories(speciesId, model, body, s, species.accent)
	applyMutations(model, body, mutations, s)

	model:SetAttribute("Species", speciesId)
	model.WorldPivot = CFrame.new(0, 0, 0)
	return model
end

-- Colour for UI chips that represent a slime with mutations.
function SlimeBuilder.displayColor(speciesId: string, mutations: { string }): Color3
	if table.find(mutations, "golden") then
		return Color3.fromRGB(255, 205, 50)
	end
	local species = Species.byId[speciesId]
	local color = if species then species.color else Color3.new(1, 1, 1)
	if table.find(mutations, "frozen") then
		color = color:Lerp(Color3.fromRGB(190, 235, 255), 0.55)
	end
	return color
end

function SlimeBuilder.mutationNames(mutations: { string }): string
	local names = {}
	local sorted = table.clone(mutations)
	table.sort(sorted, function(a, b)
		local ma, mb = Mutations.byId[a], Mutations.byId[b]
		return (if ma then ma.order else 99) < (if mb then mb.order else 99)
	end)
	for _, id in sorted do
		local mutation = Mutations.byId[id]
		if mutation then
			table.insert(names, mutation.name)
		end
	end
	return table.concat(names, " ")
end

return SlimeBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Species</string>
          <string name="Source"><![CDATA[--!strict
-- Slime species catalog. Value/price ratio sits around 2.4x per harvest and
-- profit per tile-second grows roughly 2.5x per tier, so every new seed is a
-- clear upgrade while stock scarcity keeps high tiers aspirational.

local Types = require(script.Parent.Types)

type Species = Types.Species

local Species = {}

local list: { Species } = {
	{
		id = "goo",
		name = "Goo Slime",
		tier = 1,
		rarity = "Common",
		price = 10,
		growTime = 12,
		value = 24,
		color = Color3.fromRGB(110, 222, 96),
		accent = Color3.fromRGB(60, 160, 60),
		material = Enum.Material.SmoothPlastic,
		transparency = 0.12,
		stockChance = 1,
		stockMin = 10,
		stockMax = 20,
		requiresRebirth = 0,
