	{
		id = "bubble",
		name = "Bubble Slime",
		tier = 2,
		rarity = "Common",
		price = 60,
		growTime = 30,
		value = 150,
		color = Color3.fromRGB(96, 178, 255),
		accent = Color3.fromRGB(200, 235, 255),
		material = Enum.Material.Glass,
		transparency = 0.2,
		stockChance = 1,
		stockMin = 6,
		stockMax = 12,
		requiresRebirth = 0,
		flavor = "Pops with joy when it is harvested.",
	},
	{
		id = "berry",
		name = "Berry Slime",
		tier = 3,
		rarity = "Uncommon",
		price = 300,
		growTime = 60,
		value = 720,
		color = Color3.fromRGB(255, 110, 170),
		accent = Color3.fromRGB(90, 190, 80),
		material = Enum.Material.SmoothPlastic,
		transparency = 0.1,
		stockChance = 0.85,
		stockMin = 4,
		stockMax = 8,
		requiresRebirth = 0,
		flavor = "Smells like strawberry jam.",
	},
	{
		id = "ember",
		name = "Ember Slime",
		tier = 4,
		rarity = "Uncommon",
		price = 1_500,
		growTime = 120,
		value = 3_600,
		color = Color3.fromRGB(255, 136, 46),
		accent = Color3.fromRGB(255, 220, 90),
		material = Enum.Material.SmoothPlastic,
		transparency = 0.05,
		stockChance = 0.75,
		stockMin = 3,
		stockMax = 6,
		requiresRebirth = 0,
		flavor = "Warm to the touch. Do not hug.",
	},
	{
		id = "frost",
		name = "Frost Slime",
		tier = 5,
		rarity = "Rare",
		price = 7_500,
		growTime = 240,
		value = 18_000,
		color = Color3.fromRGB(170, 235, 255),
		accent = Color3.fromRGB(255, 255, 255),
		material = Enum.Material.Ice,
		transparency = 0.15,
		stockChance = 0.55,
		stockMin = 2,
		stockMax = 4,
		requiresRebirth = 0,
		flavor = "Keeps your garden nice and chilly.",
	},
	{
		id = "toxic",
		name = "Toxic Slime",
		tier = 6,
		rarity = "Rare",
		price = 38_000,
		growTime = 480,
		value = 92_000,
		color = Color3.fromRGB(170, 255, 40),
		accent = Color3.fromRGB(120, 60, 200),
